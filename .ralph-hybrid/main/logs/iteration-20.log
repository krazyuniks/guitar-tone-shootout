for;\n   144→        proxy_set_header X-Forwarded-Proto $scheme;\n   145→    }\n   146→}\n   147→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"35bb324a-1e63-425e-90e3-ed5868453123","uuid":"0ef8b983-5597-4961-97ac-5393d0190cae","tool_use_result":{"type":"text","file":{"filePath":"/home/ryan/Work/guitar-tone-worktrees/main/infrastructure/nginx/nginx.conf.template","content":"upstream backend {\n    server ${BACKEND_HOST}:${BACKEND_PORT};\n}\n\nserver {\n    listen 80;\n    server_name _;\n\n    # Security headers\n    add_header X-Frame-Options \"DENY\" always;\n    add_header X-Content-Type-Options \"nosniff\" always;\n    add_header Referrer-Policy \"strict-origin-when-cross-origin\" always;\n    add_header X-XSS-Protection \"1; mode=block\" always;\n\n    # Content Security Policy (report-only for initial rollout)\n    add_header Content-Security-Policy-Report-Only \"default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' ws: wss:; frame-ancestors 'none';\" always;\n\n    # Gzip compression\n    gzip on;\n    gzip_vary on;\n    gzip_min_length 1024;\n    gzip_proxied any;\n    gzip_types text/plain text/css text/xml text/javascript application/javascript application/json application/xml;\n\n    # Static files from Astro build\n    location /static/ {\n        alias /usr/share/nginx/html/static/;\n        expires 1y;\n        add_header Cache-Control \"public, immutable\";\n        try_files $uri $uri/ =404;\n    }\n\n    # Astro assets (CSS, JS bundles)\n    location /_astro/ {\n        alias /usr/share/nginx/html/static/_astro/;\n        expires 1y;\n        add_header Cache-Control \"public, immutable\";\n        try_files $uri $uri/ =404;\n    }\n\n    # Static pages (home, about, login) - served from Astro dist\n    location = / {\n        root /usr/share/nginx/html/static;\n        try_files /index.html =404;\n    }\n\n    location = /about {\n        root /usr/share/nginx/html/static;\n        try_files /about.html /about/index.html =404;\n    }\n\n    location = /login {\n        root /usr/share/nginx/html/static;\n        try_files /login.html /login/index.html =404;\n    }\n\n    # Block admin routes externally (only accessible via direct backend port)\n    location /admin/ {\n        return 404;\n    }\n\n    # API routes - proxy to backend\n    location /api/ {\n        proxy_pass http://backend;\n        proxy_set_header Host $host;\n        proxy_set_header X-Real-IP $remote_addr;\n        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n        proxy_set_header X-Forwarded-Proto $scheme;\n\n        # WebSocket support for live updates\n        proxy_http_version 1.1;\n        proxy_set_header Upgrade $http_upgrade;\n        proxy_set_header Connection \"upgrade\";\n    }\n\n    # Auth routes - proxy to backend\n    location /auth/ {\n        proxy_pass http://backend;\n        proxy_set_header Host $host;\n        proxy_set_header X-Real-IP $remote_addr;\n        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n        proxy_set_header X-Forwarded-Proto $scheme;\n    }\n\n    # SSR pages (gear, shootouts, library, etc.) - proxy to backend\n    location /gear {\n        proxy_pass http://backend;\n        proxy_set_header Host $host;\n        proxy_set_header X-Real-IP $remote_addr;\n        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n        proxy_set_header X-Forwarded-Proto $scheme;\n    }\n\n    location /shootouts {\n        proxy_pass http://backend;\n        proxy_set_header Host $host;\n        proxy_set_header X-Real-IP $remote_addr;\n        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n        proxy_set_header X-Forwarded-Proto $scheme;\n    }\n\n    location /shootout/ {\n        proxy_pass http://backend;\n        proxy_set_header Host $host;\n        proxy_set_header X-Real-IP $remote_addr;\n        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n        proxy_set_header X-Forwarded-Proto $scheme;\n    }\n\n    location /library/ {\n        proxy_pass http://backend;\n        proxy_set_header Host $host;\n        proxy_set_header X-Real-IP $remote_addr;\n        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n        proxy_set_header X-Forwarded-Proto $scheme;\n    }\n\n    location /chain/ {\n        proxy_pass http://backend;\n        proxy_set_header Host $host;\n        proxy_set_header X-Real-IP $remote_addr;\n        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n        proxy_set_header X-Forwarded-Proto $scheme;\n    }\n\n    # Health check endpoint\n    location /health {\n        proxy_pass http://backend;\n        proxy_set_header Host $host;\n    }\n\n    # Favicon\n    location = /favicon.ico {\n        root /usr/share/nginx/html/static;\n        try_files /favicon.ico =404;\n    }\n\n    # Fallback - proxy everything else to backend\n    location / {\n        proxy_pass http://backend;\n        proxy_set_header Host $host;\n        proxy_set_header X-Real-IP $remote_addr;\n        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n        proxy_set_header X-Forwarded-Proto $scheme;\n    }\n}\n","numLines":147,"startLine":1,"totalLines":147}}}
