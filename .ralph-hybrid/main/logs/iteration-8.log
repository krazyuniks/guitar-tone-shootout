"bg-[var(--color-accent-error)] text-white px-4 py-2 rounded-lg\"\n    >\n      Delete\n    </button>\n  </div>\n</div>\n{% endfor %}\n\n{% if not items %}\n<div\n  data-testid=\"empty-state\"\n  class=\"text-center py-8 text-[var(--color-text-muted)]\"\n>\n  <p>No items found.</p>\n</div>\n{% endif %}\n`;\n\n  return new Response(html, {\n    status: 200,\n    headers: {\n      'Content-Type': 'text/html; charset=utf-8',\n    },\n  });\n}\n","structuredPatch":[],"originalFile":null}}
