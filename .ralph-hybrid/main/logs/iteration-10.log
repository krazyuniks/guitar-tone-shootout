3k\"]\nforbidden_modules = [\"audio\", \"webapp\", \"worker\", \"scheduler\"]\n\n# Webapp cannot depend on sources (worker is the bridge)\n[[tool.importlinter.contracts]]\nname = \"webapp-no-sources\"\ntype = \"forbidden\"\nsource_modules = [\"webapp\"]\nforbidden_modules = [\"source_t3k\"]\n\n# Worker cannot depend on sources directly (uses pgmq messages)\n[[tool.importlinter.contracts]]\nname = \"worker-no-sources\"\ntype = \"forbidden\"\nsource_modules = [\"worker\"]\nforbidden_modules = [\"source_t3k\"]\n\n# Scheduler can only depend on core\n[[tool.importlinter.contracts]]\nname = \"scheduler-dependencies\"\ntype = \"forbidden\"\nsource_modules = [\"scheduler\"]\nforbidden_modules = [\"audio\", \"source_t3k\", \"webapp\", \"worker\"]\n\n# =============================================================================\n# Ruff Configuration\n# =============================================================================\n\n[tool.ruff]\ntarget-version = \"py312\"\nline-length = 100\n\n[tool.ruff.lint]\nselect = [\n    \"E\",      # pycodestyle errors\n    \"W\",      # pycodestyle warnings\n    \"F\",      # Pyflakes\n    \"I\",      # isort\n    \"B\",      # flake8-bugbear\n    \"C4\",     # flake8-comprehensions\n    \"UP\",     # pyupgrade\n    \"ARG\",    # flake8-unused-arguments\n    \"SIM\",    # flake8-simplify\n    \"TCH\",    # flake8-type-checking\n    \"PTH\",    # flake8-use-pathlib\n    \"RUF\",    # Ruff-specific rules\n]\nignore = [\n    \"E501\",   # line too long (handled by formatter)\n    \"B008\",   # do not perform function calls in argument defaults (FastAPI Depends)\n    \"B904\",   # raise from err (too noisy)\n    \"ARG001\", # unused function argument (common in protocols/interfaces)\n]\n\n[tool.ruff.lint.isort]\nknown-first-party = [\"core\", \"audio\", \"source_t3k\", \"webapp\", \"worker\", \"scheduler\"]\n\n[tool.ruff.lint.per-file-ignores]\n\"tests/**/*.py\" = [\"ARG001\", \"ARG002\"]\n\"apps/webapp/src/webapp/adapters/persistence/mo