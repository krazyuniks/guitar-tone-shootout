{"type":"assistant","message":{"model":"claude-sonnet-4-5-20250929","id":"msg_01FM1MR5WAJjtZy3qnzRFWSG","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01PjY6oXwbCYV96GkDTbzV89","name":"Write","input":{"file_path":"/home/ryan/Work/guitar-tone-worktrees/main/tests/unit/audio/test_ir_loader.py","content":"\"\"\"Unit tests for IR loader.\"\"\"\n\nimport tempfile\nfrom pathlib import Path\n\nimport numpy as np\nimport pytest\nimport soundfile as sf\n\nfrom audio.processing.ir_loader import IRLoadError, load_ir\n\n\nclass TestIRLoader:\n    \"\"\"Test IR file loading.\"\"\"\n\n    def test_load_ir_from_wav(self, tmp_path: Path) -> None:\n        \"\"\"Test loading IR from WAV file.\"\"\"\n        # Create a simple impulse response (short sine wave)\n        sample_rate = 48000\n        duration = 0.1  # 100ms IR\n        t = np.linspace(0, duration, int(sample_rate * duration))\n        ir_data = np.sin(2 * np.pi * 440 * t) * np.exp(-10 * t)\n\n        # Save as WAV\n        ir_file = tmp_path / \"test_ir.wav\"\n        sf.write(str(ir_file), ir_data, sample_rate)\n\n        # Load IR\n        from pedalboard import Convolution\n\n        convolution = load_ir(ir_file)\n\n        # Verify it's a Convolution effect\n        assert isinstance(convolution, Convolution)\n\n    def test_load_ir_from_flac(self, tmp_path: Path) -> None:\n        \"\"\"Test loading IR from FLAC file.\"\"\"\n        # Create a simple impulse response\n        sample_rate = 48000\n        duration = 0.1\n        t = np.linspace(0, duration, int(sample_rate * duration))\n        ir_data = np.sin(2 * np.pi * 440 * t) * np.exp(-10 * t)\n\n        # Save as FLAC\n        ir_file = tmp_path / \"test_ir.flac\"\n        sf.write(str(ir_file), ir_data, sample_rate)\n\n        # Load IR\n        from pedalboard import Convolution\n\n        convolution = load_ir(ir_file)\n\n        # Verify it's a Convolution effect\n        assert isinstance(convolution, Convolution)\n\n    def test_load_ir_file_not_found(self, tmp_path: Path) -> None:\n        \"\"\"Test loading IR from non-existent file raises IRLoadError.\"\"\"\n        nonexistent = tmp_path / \"nonexistent.wav\"\n\n        with pytest.raises(IRLoadError, match=\"IR file not found\"):\n            load_ir(nonexistent)\n\n    def test_load_ir_invalid_file(self, tmp_path: Path) -> None:\n        \"\"\"Test loading IR from invalid file raises IRLoadError.\"\"\"\n        # Create a file with invalid content\n        invalid_file = tmp_path / \"invalid.wav\"\n        invalid_file.write_text(\"not a valid audio file\")\n\n        with pytest.raises(IRLoadError, match=\"Failed to load IR\"):\n            load_ir(invalid_file)\n\n    def test_load_ir_accepts_path_or_string(self, tmp_path: Path) -> None:\n        \"\"\"Test load_ir accepts both Path and str.\"\"\"\n        # Create IR file\n        sample_rate = 48000\n        duration = 0.05\n        t = np.linspace(0, duration, int(sample_rate * duration))\n        ir_data = np.sin(2 * np.pi * 440 * t) * np.exp(-10 * t)\n\n        ir_file = tmp_path / \"test_ir.wav\"\n        sf.write(str(ir_file), ir_data, sample_rate)\n\n        from pedalboard import Convolution\n\n        # Test with Path\n        conv1 = load_ir(ir_file)\n        assert isinstance(conv1, Convolution)\n\n        # Test with str\n        conv2 = load_ir(str(ir_file))\n        assert isinstance(conv2, Convolution)\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"cache_creation_input_tokens":343,"cache_read_input_tokens":88666,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":343},"output_tokens":1,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"b8f72499-bc49-4071-bb41-efa929c7ea78","uuid":"60dafa93-63f4-407d-a044-543b939ae200"}
