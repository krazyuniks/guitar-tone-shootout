{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ExCdJGbtagA13s8tJPeBxN","type":"tool_result","content":"     1→\"\"\"Shootout aggregate for domain layer.\"\"\"\n     2→\n     3→from dataclasses import dataclass, field\n     4→from datetime import datetime\n     5→from uuid import UUID\n     6→\n     7→from core.domain.entities.base import Entity, new_id, utcnow\n     8→from core.domain.value_objects.processing_metadata import ProcessingMetadata\n     9→\n    10→\n    11→class ShootoutError(Exception):\n    12→    \"\"\"Base exception for Shootout domain errors.\"\"\"\n    13→\n    14→    pass\n    15→\n    16→\n    17→class DuplicateChainError(ShootoutError):\n    18→    \"\"\"Raised when trying to add a duplicate chain.\"\"\"\n    19→\n    20→    pass\n    21→\n    22→\n    23→class ChainNotFoundError(ShootoutError):\n    24→    \"\"\"Raised when a chain is not found in the shootout.\"\"\"\n    25→\n    26→    pass\n    27→\n    28→\n    29→class MaxChainsExceededError(ShootoutError):\n    30→    \"\"\"Raised when max chain limit is exceeded.\"\"\"\n    31→\n    32→    pass\n    33→\n    34→\n    35→@dataclass(frozen=True, slots=True)\n    36→class ShootoutChain:\n    37→    \"\"\"Value object representing a chain in a shootout.\n    38→\n    39→    Links a signal chain to a shootout with ordering and labelling.\n    40→\n    41→    Attributes:\n    42→        id: Unique identifier for this shootout-chain link\n    43→        shootout_id: Parent shootout ID\n    44→        signal_chain_id: Reference to the SignalChain\n    45→        position: Order in the shootout (0-indexed)\n    46→        label: Display label for this chain in the shootout\n    47→    \"\"\"\n    48→\n    49→    id: UUID\n    50→    shootout_id: UUID\n    51→    signal_chain_id: UUID\n    52→    position: int\n    53→    label: str\n    54→\n    55→    def with_position(self, position: int) -> \"ShootoutChain\":\n    56→        \"\"\"Return a new chain reference with updated position.\n    57→\n    58→        Args:\n    59→            position: The new position\n    60→\n    61→        Returns:\n    62→            A new ShootoutChain with the updated position\n    63→        \"\"\"\n    64→        return ShootoutChain(\n    65→            id=self.id,\n    66→            shootout_id=self.shootout_id,\n    67→            signal_chain_id=self.signal_chain_id,\n    68→            position=position,\n    69→            label=self.label,\n    70→        )\n    71→\n    72→    def with_label(self, label: str) -> \"ShootoutChain\":\n    73→        \"\"\"Return a new chain reference with updated label.\n    74→\n    75→        Args:\n    76→            label: The new label\n    77→\n    78→        Returns:\n    79→            A new ShootoutChain with the updated label\n    80→        \"\"\"\n    81→        return ShootoutChain(\n    82→            id=self.id,\n    83→            shootout_id=self.shootout_id,\n    84→            signal_chain_id=self.signal_chain_id,\n    85→            position=self.position,\n    86→            label=label,\n    87→        )\n    88→\n    89→\n    90→@dataclass(eq=False, slots=True)\n    91→class Shootout(Entity):\n    92→    \"\"\"Aggregate root for tone comparison shootouts.\n    93→\n    94→    A Shootout represents a comparison of multiple signal chains\n    95→    using a common DI track. It manages the collection of chains\n    96→    and enforces business rules.\n    97→\n    98→    Attributes:\n    99→        id: Unique identifier\n   100→        user_id: Owner's user ID\n   101→        name: Display name for the shootout\n   102→        di_track_id: Reference to the DI track\n   103→        description: Optional description\n   104→        output_format: Output video format (mp4, etc.)\n   105→        sample_rate: Audio sample rate\n   106→        is_processed: Whether processing is complete\n   107→        output_path: Path to output video (after processing)\n   108→        processing_metadata: Processing metadata value object\n   109→        chains: List of chain references in this shootout\n   110→        created_at: When the shootout was created\n   111→        updated_at: When the shootout was last updated\n   112→    \"\"\"\n   113→\n   114→    MAX_CHAINS = 20  # Maximum number of chains allowed\n   115→\n   116→    user_id: UUID = field(default_factory=new_id)\n   117→    name: str = \"\"\n   118→    di_track_id: UUID = field(default_factory=new_id)\n   119→    description: str | None = None\n   120→    output_format: str = \"mp4\"\n   121→    sample_rate: int = 44100\n   122→    is_processed: bool = False\n   123→    output_path: str | None = None\n   124→    processing_metadata: ProcessingMetadata | None = None\n   125→    chains: list[ShootoutChain] = field(default_factory=list)\n   126→    id: UUID = field(default_factory=new_id)\n   127→    created_at: datetime = field(default_factory=utcnow)\n   128→    updated_at: datetime = field(default_factory=utcnow)\n   129→\n   130→    @property\n   131→    def chain_count(self) -> int:\n   132→        \"\"\"Return the number of chains in this shootout.\"\"\"\n   133→        return len(self.chains)\n   134→\n   135→    def add_chain(self, chain: ShootoutChain) -> None:\n   136→        \"\"\"Add a signal chain to the shootout.\n   137→\n   138→        The chain will be added at the end.\n   139→\n   140→        Args:\n   141→            chain: The chain reference to add\n   142→\n   143→        Raises:\n   144→            MaxChainsExceededError: If max chain limit would be exceeded\n   145→            DuplicateChainError: If chain already exists in shootout\n   146→        \"\"\"\n   147→        if self.chain_count >= self.MAX_CHAINS:\n   148→            raise MaxChainsExceededError(\n   149→                f\"Cannot add more than {self.MAX_CHAINS} chains to a shootout\"\n   150→            )\n   151→\n   152→        # Check for duplicate\n   153→        for existing in self.chains:\n   154→            if existing.signal_chain_id == chain.signal_chain_id:\n   155→                raise DuplicateChainError(\n   156→                    f\"Signal chain {chain.signal_chain_id} already in shootout\"\n   157→                )\n   158→\n   159→        # Set position to end of list\n   160→        next_position = (\n   161→            max(c.position for c in self.chains) + 1\n   162→            if self.chains\n   163→            else 0\n   164→        )\n   165→        new_chain = chain.with_position(next_position)\n   166→\n   167→        self.chains.append(new_chain)\n   168→        self.updated_at = utcnow()\n   169→\n   170→    def remove_chain(self, signal_chain_id: UUID) -> None:\n   171→        \"\"\"Remove a signal chain from the shootout.\n   172→\n   173→        Args:\n   174→            signal_chain_id: The signal chain ID\n   175→\n   176→        Raises:\n   177→            ChainNotFoundError: If the chain is not found\n   178→        \"\"\"\n   179→        for i, chain in enumerate(self.chains):\n   180→            if chain.signal_chain_id == signal_chain_id:\n   181→                self.chains.pop(i)\n   182→                self._reorder_positions()\n   183→                self.updated_at = utcnow()\n   184→                return\n   185→\n   186→        raise ChainNotFoundError(\n   187→            f\"Signal chain {signal_chain_id} not found in shootout\"\n   188→        )\n   189→\n   190→    def reorder_chain(self, signal_chain_id: UUID, new_position: int) -> None:\n   191→        \"\"\"Move a chain to a new position.\n   192→\n   193→        Args:\n   194→            signal_chain_id: The signal chain ID\n   195→            new_position: The new position (0-indexed)\n   196→\n   197→        Raises:\n   198→            ChainNotFoundError: If the chain is not found\n   199→            ValueError: If new_position is out of bounds\n   200→        \"\"\"\n   201→        if new_position < 0 or new_position >= self.chain_count:\n   202→            raise ValueError(f\"Invalid position {new_position}\")\n   203→\n   204→        # Find the chain\n   205→        chain_index = None\n   206→        for i, chain in enumerate(self.chains):\n   207→            if chain.signal_chain_id == signal_chain_id:\n   208→                chain_index = i\n   209→                break\n   210→\n   211→        if chain_index is None:\n   212→            raise ChainNotFoundError(\n   213→                f\"Signal chain {signal_chain_id} not found in shootout\"\n   214→            )\n   215→\n   216→        # Move the chain\n   217→        chain = self.chains.pop(chain_index)\n   218→        self.chains.insert(new_position, chain)\n   219→        self._reorder_positions()\n   220→        self.updated_at = utcnow()\n   221→\n   222→    def _reorder_positions(self) -> None:\n   223→        \"\"\"Reorder positions to be sequential starting from 0.\"\"\"\n   224→        self.chains = [\n   225→            chain.with_position(i) for i, chain in enumerate(self.chains)\n   226→        ]\n   227→\n   228→    def get_chain(self, signal_chain_id: UUID) -> ShootoutChain:\n   229→        \"\"\"Get a specific chain reference.\n   230→\n   231→        Args:\n   232→            signal_chain_id: The signal chain ID\n   233→\n   234→        Returns:\n   235→            The matching ShootoutChain\n   236→\n   237→        Raises:\n   238→            ChainNotFoundError: If the chain is not found\n   239→        \"\"\"\n   240→        for chain in self.chains:\n   241→            if chain.signal_chain_id == signal_chain_id:\n   242→                return chain\n   243→\n   244→        raise ChainNotFoundError(\n   245→            f\"Signal chain {signal_chain_id} not found in shootout\"\n   246→        )\n   247→\n   248→    def update_chain_label(self, signal_chain_id: UUID, label: str) -> None:\n   249→        \"\"\"Update the label for a chain.\n   250→\n   251→        Args:\n   252→            signal_chain_id: The signal chain ID\n   253→            label: The new label\n   254→\n   255→        Raises:\n   256→            ChainNotFoundError: If the chain is not found\n   257→        \"\"\"\n   258→        for i, chain in enumerate(self.chains):\n   259→            if chain.signal_chain_id == signal_chain_id:\n   260→                self.chains[i] = chain.with_label(label)\n   261→                self.updated_at = utcnow()\n   262→                return\n   263→\n   264→        raise ChainNotFoundError(\n   265→            f\"Signal chain {signal_chain_id} not found in shootout\"\n   266→        )\n   267→\n   268→    def mark_processed(\n   269→        self,\n   270→        output_path: str,\n   271→        metadata: ProcessingMetadata | None = None,\n   272→    ) -> None:\n   273→        \"\"\"Mark the shootout as processed.\n   274→\n   275→        Args:\n   276→            output_path: Path to the output video\n   277→            metadata: Optional processing metadata\n   278→        \"\"\"\n   279→        self.is_processed = True\n   280→        self.output_path = output_path\n   281→        self.processing_metadata = metadata\n   282→        self.updated_at = utcnow()\n   283→\n   284→    def reset_processing(self) -> None:\n   285→        \"\"\"Reset processing state for re-processing.\"\"\"\n   286→        self.is_processed = False\n   287→        self.output_path = None\n   288→        self.processing_metadata = None\n   289→        self.updated_at = utcnow()\n   290→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"8b3ba707-c57c-42a8-a2c8-1d2b5d17a602","uuid":"dc5c57b4-8a1c-47c2-906d-42c409259adf","tool_use_result":{"type":"text","file":{"filePath":"/home/ryan/Work/guitar-tone-worktrees/main/libs/core/src/core/domain/entities/shootout.py","content":"\"\"\"Shootout aggregate for domain layer.\"\"\"\n\nfrom dataclasses import dataclass, field\nfrom datetime import datetime\nfrom uuid import UUID\n\nfrom core.domain.entities.base import Entity, new_id, utcnow\nfrom core.domain.value_objects.processing_metadata import ProcessingMetadata\n\n\nclass ShootoutError(Exception):\n    \"\"\"Base exception for Shootout domain errors.\"\"\"\n\n    pass\n\n\nclass DuplicateChainError(ShootoutError):\n    \"\"\"Raised when trying to add a duplicate chain.\"\"\"\n\n    pass\n\n\nclass ChainNotFoundError(ShootoutError):\n    \"\"\"Raised when a chain is not found in the shootout.\"\"\"\n\n    pass\n\n\nclass MaxChainsExceededError(ShootoutError):\n    \"\"\"Raised when max chain limit is exceeded.\"\"\"\n\n    pass\n\n\n@dataclass(frozen=True, slots=True)\nclass ShootoutChain:\n    \"\"\"Value object representing a chain in a shootout.\n\n    Links a signal chain to a shootout with ordering and labelling.\n\n    Attributes:\n        id: Unique identifier for this shootout-chain link\n        shootout_id: Parent shootout ID\n        signal_chain_id: Reference to the SignalChain\n        position: Order in the shootout (0-indexed)\n        label: Display label for this chain in the shootout\n    \"\"\"\n\n    id: UUID\n    shootout_id: UUID\n    signal_chain_id: UUID\n    position: int\n    label: str\n\n    def with_position(self, position: int) -> \"ShootoutChain\":\n        \"\"\"Return a new chain reference with updated position.\n\n        Args:\n            position: The new position\n\n        Returns:\n            A new ShootoutChain with the updated position\n        \"\"\"\n        return ShootoutChain(\n            id=self.id,\n            shootout_id=self.shootout_id,\n            signal_chain_id=self.signal_chain_id,\n            position=position,\n            label=self.label,\n        )\n\n    def with_label(self, label: str) -> \"ShootoutChain\":\n        \"\"\"Return a new chain reference with updated label.\n\n        Args:\n            label: The new label\n\n        Returns:\n            A new ShootoutChain with the updated label\n        \"\"\"\n        return ShootoutChain(\n            id=self.id,\n            shootout_id=self.shootout_id,\n            signal_chain_id=self.signal_chain_id,\n            position=self.position,\n            label=label,\n        )\n\n\n@dataclass(eq=False, slots=True)\nclass Shootout(Entity):\n    \"\"\"Aggregate root for tone comparison shootouts.\n\n    A Shootout represents a comparison of multiple signal chains\n    using a common DI track. It manages the collection of chains\n    and enforces business rules.\n\n    Attributes:\n        id: Unique identifier\n        user_id: Owner's user ID\n        name: Display name for the shootout\n        di_track_id: Reference to the DI track\n        description: Optional description\n        output_format: Output video format (mp4, etc.)\n        sample_rate: Audio sample rate\n        is_processed: Whether processing is complete\n        output_path: Path to output video (after processing)\n        processing_metadata: Processing metadata value object\n        chains: List of chain references in this shootout\n        created_at: When the shootout was created\n        updated_at: When the shootout was last updated\n    \"\"\"\n\n    MAX_CHAINS = 20  # Maximum number of chains allowed\n\n    user_id: UUID = field(default_factory=new_id)\n    name: str = \"\"\n    di_track_id: UUID = field(default_factory=new_id)\n    description: str | None = None\n    output_format: str = \"mp4\"\n    sample_rate: int = 44100\n    is_processed: bool = False\n    output_path: str | None = None\n    processing_metadata: ProcessingMetadata | None = None\n    chains: list[ShootoutChain] = field(default_factory=list)\n    id: UUID = field(default_factory=new_id)\n    created_at: datetime = field(default_factory=utcnow)\n    updated_at: datetime = field(default_factory=utcnow)\n\n    @property\n    def chain_count(self) -> int:\n        \"\"\"Return the number of chains in this shootout.\"\"\"\n        return len(self.chains)\n\n    def add_chain(self, chain: ShootoutChain) -> None:\n        \"\"\"Add a signal chain to the shootout.\n\n        The chain will be added at the end.\n\n        Args:\n            chain: The chain reference to add\n\n        Raises:\n            MaxChainsExceededError: If max chain limit would be exceeded\n            DuplicateChainError: If chain already exists in shootout\n        \"\"\"\n        if self.chain_count >= self.MAX_CHAINS:\n            raise MaxChainsExceededError(\n                f\"Cannot add more than {self.MAX_CHAINS} chains to a shootout\"\n            )\n\n        # Check for duplicate\n        for existing in self.chains:\n            if existing.signal_chain_id == chain.signal_chain_id:\n                raise DuplicateChainError(\n                    f\"Signal chain {chain.signal_chain_id} already in shootout\"\n                )\n\n        # Set position to end of list\n        next_position = (\n            max(c.position for c in self.chains) + 1\n            if self.chains\n            else 0\n        )\n        new_chain = chain.with_position(next_position)\n\n        self.chains.append(new_chain)\n        self.updated_at = utcnow()\n\n    def remove_chain(self, signal_chain_id: UUID) -> None:\n        \"\"\"Remove a signal chain from the shootout.\n\n        Args:\n            signal_chain_id: The signal chain ID\n\n        Raises:\n            ChainNotFoundError: If the chain is not found\n        \"\"\"\n        for i, chain in enumerate(self.chains):\n            if chain.signal_chain_id == signal_chain_id:\n                self.chains.pop(i)\n                self._reorder_positions()\n                self.updated_at = utcnow()\n                return\n\n        raise ChainNotFoundError(\n            f\"Signal chain {signal_chain_id} not found in shootout\"\n        )\n\n    def reorder_chain(self, signal_chain_id: UUID, new_position: int) -> None:\n        \"\"\"Move a chain to a new position.\n\n        Args:\n            signal_chain_id: The signal chain ID\n            new_position: The new position (0-indexed)\n\n        Raises:\n            ChainNotFoundError: If the chain is not found\n            ValueError: If new_position is out of bounds\n        \"\"\"\n        if new_position < 0 or new_position >= self.chain_count:\n            raise ValueError(f\"Invalid position {new_position}\")\n\n        # Find the chain\n        chain_index = None\n        for i, chain in enumerate(self.chains):\n            if chain.signal_chain_id == signal_chain_id:\n                chain_index = i\n                break\n\n        if chain_index is None:\n            raise ChainNotFoundError(\n                f\"Signal chain {signal_chain_id} not found in shootout\"\n            )\n\n        # Move the chain\n        chain = self.chains.pop(chain_index)\n        self.chains.insert(new_position, chain)\n        self._reorder_positions()\n        self.updated_at = utcnow()\n\n    def _reorder_positions(self) -> None:\n        \"\"\"Reorder positions to be sequential starting from 0.\"\"\"\n        self.chains = [\n            chain.with_position(i) for i, chain in enumerate(self.chains)\n        ]\n\n    def get_chain(self, signal_chain_id: UUID) -> ShootoutChain:\n        \"\"\"Get a specific chain reference.\n\n        Args:\n            signal_chain_id: The signal chain ID\n\n        Returns:\n            The matching ShootoutChain\n\n        Raises:\n            ChainNotFoundError: If the chain is not found\n        \"\"\"\n        for chain in self.chains:\n            if chain.signal_chain_id == signal_chain_id:\n                return chain\n\n        raise ChainNotFoundError(\n            f\"Signal chain {signal_chain_id} not found in shootout\"\n        )\n\n    def update_chain_label(self, signal_chain_id: UUID, label: str) -> None:\n        \"\"\"Update the label for a chain.\n\n        Args:\n            signal_chain_id: The signal chain ID\n            label: The new label\n\n        Raises:\n            ChainNotFoundError: If the chain is not found\n        \"\"\"\n        for i, chain in enumerate(self.chains):\n            if chain.signal_chain_id == signal_chain_id:\n                self.chains[i] = chain.with_label(label)\n                self.updated_at = utcnow()\n                return\n\n        raise ChainNotFoundError(\n            f\"Signal chain {signal_chain_id} not found in shootout\"\n        )\n\n    def mark_processed(\n        self,\n        output_path: str,\n        metadata: ProcessingMetadata | None = None,\n    ) -> None:\n        \"\"\"Mark the shootout as processed.\n\n        Args:\n            output_path: Path to the output video\n            metadata: Optional processing metadata\n        \"\"\"\n        self.is_processed = True\n        self.output_path = output_path\n        self.processing_metadata = metadata\n        self.updated_at = utcnow()\n\n    def reset_processing(self) -> None:\n        \"\"\"Reset processing state for re-processing.\"\"\"\n        self.is_processed = False\n        self.output_path = None\n        self.processing_metadata = None\n        self.updated_at = utcnow()\n","numLines":290,"startLine":1,"totalLines":290}}}
