{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BnzWnMNS6tYvNccZhacDnJ","type":"tool_result","content":"     1→\"\"\"SignalChain ORM models for persistence layer.\"\"\"\n     2→\n     3→from __future__ import annotations\n     4→\n     5→import uuid\n     6→from typing import TYPE_CHECKING, Any\n     7→\n     8→from sqlalchemy import JSON, ForeignKey, Index, Integer, String, Text, Uuid\n     9→from sqlalchemy.orm import Mapped, mapped_column, relationship\n    10→\n    11→from core.domain.value_objects.signal_chain_enums import (  # type: ignore[import-untyped]\n    12→    GearType,\n    13→    Platform,\n    14→)\n    15→\n    16→from .base import Base, EnumByValue, TimestampMixin, UUIDMixin\n    17→\n    18→if TYPE_CHECKING:\n    19→    from .user import User\n    20→\n    21→\n    22→class BlockType(UUIDMixin, Base):\n    23→    \"\"\"Built-in processor type definitions.\n    24→\n    25→    Represents built-in audio processors (compressor, EQ, etc.) that\n    26→    can be used in signal chains beyond captured gear.\n    27→\n    28→    Attributes:\n    29→        id: Primary key (UUIDv7)\n    30→        name: Processor name (e.g., 'Compressor', 'EQ')\n    31→        category: Category (e.g., 'dynamics', 'eq', 'modulation')\n    32→        description: Optional description\n    33→        default_params: Default parameter values as JSON\n    34→    \"\"\"\n    35→\n    36→    __tablename__ = \"block_types\"\n    37→\n    38→    name: Mapped[str] = mapped_column(String(100), unique=True, nullable=False)\n    39→    category: Mapped[str] = mapped_column(String(50), nullable=False)\n    40→    description: Mapped[str | None] = mapped_column(Text, nullable=True)\n    41→    default_params: Mapped[dict[str, Any]] = mapped_column(JSON, nullable=False, default=dict)\n    42→\n    43→\n    44→class SignalChain(UUIDMixin, TimestampMixin, Base):\n    45→    \"\"\"SignalChain model for user-created signal chains.\n    46→\n    47→    Represents a composition of gear that can be processed together.\n    48→    Follows signal chain grammar rules for valid compositions.\n    49→\n    50→    Attributes:\n    51→        id: Primary key (UUIDv7)\n    52→        user_id: Foreign key to users table\n    53→        name: Display name for the signal chain\n    54→        description: Optional description\n    55→        platform: Target platform (NAM, AIDA-X, etc.)\n    56→        created_at: When the chain was created\n    57→        updated_at: When the chain was last updated\n    58→        user: Reference to the User\n    59→        blocks: List of blocks in this chain\n    60→    \"\"\"\n    61→\n    62→    __tablename__ = \"signal_chains\"\n    63→\n    64→    user_id: Mapped[uuid.UUID] = mapped_column(\n    65→        Uuid,\n    66→        ForeignKey(\"users.id\", ondelete=\"CASCADE\"),\n    67→        nullable=False,\n    68→    )\n    69→    name: Mapped[str] = mapped_column(String(255), nullable=False)\n    70→    description: Mapped[str | None] = mapped_column(Text, nullable=True)\n    71→    platform: Mapped[Platform] = mapped_column(\n    72→        EnumByValue(Platform),\n    73→        nullable=False,\n    74→    )\n    75→\n    76→    # Relationships\n    77→    user: Mapped[User] = relationship(\n    78→        \"User\",\n    79→        back_populates=\"signal_chains\",\n    80→    )\n    81→    blocks: Mapped[list[SignalChainBlock]] = relationship(\n    82→        \"SignalChainBlock\",\n    83→        back_populates=\"signal_chain\",\n    84→        cascade=\"all, delete-orphan\",\n    85→        order_by=\"SignalChainBlock.position\",\n    86→        lazy=\"selectin\",  # Eager load blocks\n    87→    )\n    88→\n    89→    # Indexes\n    90→    __table_args__ = (\n    91→        Index(\"ix_signal_chains_user_id\", \"user_id\"),\n    92→    )\n    93→\n    94→\n    95→class SignalChainBlock(UUIDMixin, Base):\n    96→    \"\"\"Individual block in a signal chain.\n    97→\n    98→    Represents one component (pedal, amp, full-rig, IR, or post-effect)\n    99→    in the signal chain. Blocks are ordered by position.\n   100→\n   101→    Attributes:\n   102→        id: Primary key (UUIDv7)\n   103→        signal_chain_id: Foreign key to signal_chains table\n   104→        position: Order in the chain (0-indexed)\n   105→        user_gear_id: Reference to UserGear item\n   106→        gear_type: Type of gear (pedal, amp, full_rig, ir, post_effect)\n   107→        signal_chain: Reference to the SignalChain\n   108→        presets: List of parameter presets for this block\n   109→    \"\"\"\n   110→\n   111→    __tablename__ = \"signal_chain_blocks\"\n   112→\n   113→    signal_chain_id: Mapped[uuid.UUID] = mapped_column(\n   114→        Uuid,\n   115→        ForeignKey(\"signal_chains.id\", ondelete=\"CASCADE\"),\n   116→        nullable=False,\n   117→    )\n   118→    position: Mapped[int] = mapped_column(Integer, nullable=False)\n   119→    user_gear_id: Mapped[uuid.UUID] = mapped_column(\n   120→        Uuid,\n   121→        nullable=False,\n   122→    )\n   123→    gear_type: Mapped[GearType] = mapped_column(\n   124→        EnumByValue(GearType),\n   125→        nullable=False,\n   126→    )\n   127→\n   128→    # Relationships\n   129→    signal_chain: Mapped[SignalChain] = relationship(\n   130→        \"SignalChain\",\n   131→        back_populates=\"blocks\",\n   132→    )\n   133→    presets: Mapped[list[Preset]] = relationship(\n   134→        \"Preset\",\n   135→        back_populates=\"signal_chain_block\",\n   136→        cascade=\"all, delete-orphan\",\n   137→    )\n   138→\n   139→    # Indexes for common query patterns\n   140→    __table_args__ = (\n   141→        Index(\"ix_signal_chain_blocks_chain_id\", \"signal_chain_id\"),\n   142→        Index(\"ix_signal_chain_blocks_position\", \"signal_chain_id\", \"position\"),\n   143→    )\n   144→\n   145→\n   146→class Preset(UUIDMixin, Base):\n   147→    \"\"\"Parameter preset for a signal chain block.\n   148→\n   149→    Stores parameter values for built-in processors or gear settings.\n   150→\n   151→    Attributes:\n   152→        id: Primary key (UUIDv7)\n   153→        signal_chain_block_id: Foreign key to signal_chain_blocks table\n   154→        name: Preset name\n   155→        params: Parameter values as JSON\n   156→        signal_chain_block: Reference to the SignalChainBlock\n   157→    \"\"\"\n   158→\n   159→    __tablename__ = \"presets\"\n   160→\n   161→    signal_chain_block_id: Mapped[uuid.UUID] = mapped_column(\n   162→        Uuid,\n   163→        ForeignKey(\"signal_chain_blocks.id\", ondelete=\"CASCADE\"),\n   164→        nullable=False,\n   165→    )\n   166→    name: Mapped[str] = mapped_column(String(100), nullable=False)\n   167→    params: Mapped[dict[str, Any]] = mapped_column(JSON, nullable=False, default=dict)\n   168→\n   169→    # Relationship\n   170→    signal_chain_block: Mapped[SignalChainBlock] = relationship(\n   171→        \"SignalChainBlock\",\n   172→        back_populates=\"presets\",\n   173→    )\n   174→\n   175→    # Index\n   176→    __table_args__ = (\n   177→        Index(\"ix_presets_block_id\", \"signal_chain_block_id\"),\n   178→    )\n   179→\n   180→\n   181→class SignalChainGroup(UUIDMixin, TimestampMixin, Base):\n   182→    \"\"\"SignalChainGroup model for permutation-based comparisons.\n   183→\n   184→    Groups allow users to compare multiple gear options at specific\n   185→    positions in a chain. The system generates permutations to test\n   186→    all combinations.\n   187→\n   188→    Attributes:\n   189→        id: Primary key (UUIDv7)\n   190→        user_id: Foreign key to users table\n   191→        name: Display name for the group\n   192→        description: Optional description\n   193→        base_chain_id: Foreign key to signal_chains table (base chain)\n   194→        slot_positions: List of positions that can vary (stored as JSON)\n   195→        gear_options: Gear options per slot (stored as JSON)\n   196→        include_null: Whether to include \"no gear\" as an option\n   197→        created_at: When created\n   198→        updated_at: When last updated\n   199→        user: Reference to the User\n   200→        base_chain: Reference to the base SignalChain\n   201→    \"\"\"\n   202→\n   203→    __tablename__ = \"signal_chain_groups\"\n   204→\n   205→    user_id: Mapped[uuid.UUID] = mapped_column(\n   206→        Uuid,\n   207→        ForeignKey(\"users.id\", ondelete=\"CASCADE\"),\n   208→        nullable=False,\n   209→    )\n   210→    name: Mapped[str] = mapped_column(String(255), nullable=False)\n   211→    description: Mapped[str | None] = mapped_column(Text, nullable=True)\n   212→    base_chain_id: Mapped[uuid.UUID | None] = mapped_column(\n   213→        Uuid,\n   214→        ForeignKey(\"signal_chains.id\", ondelete=\"SET NULL\"),\n   215→        nullable=True,\n   216→    )\n   217→    slot_positions: Mapped[list[int]] = mapped_column(JSON, nullable=False, default=list)\n   218→    gear_options: Mapped[dict[int, list[str]]] = mapped_column(JSON, nullable=False, default=dict)\n   219→    include_null: Mapped[bool] = mapped_column(nullable=False, default=False)\n   220→\n   221→    # Relationships\n   222→    user: Mapped[User] = relationship(\n   223→        \"User\",\n   224→        back_populates=\"signal_chain_groups\",\n   225→    )\n   226→    base_chain: Mapped[SignalChain | None] = relationship(\n   227→        \"SignalChain\",\n   228→    )\n   229→\n   230→    # Indexes\n   231→    __table_args__ = (\n   232→        Index(\"ix_signal_chain_groups_user_id\", \"user_id\"),\n   233→    )\n   234→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"8b3ba707-c57c-42a8-a2c8-1d2b5d17a602","uuid":"eb6dd30e-16f2-4bf4-a750-ade68d3b5117","tool_use_result":{"type":"text","file":{"filePath":"/home/ryan/Work/guitar-tone-worktrees/main/apps/webapp/src/webapp/adapters/persistence/models/signal_chain.py","content":"\"\"\"SignalChain ORM models for persistence layer.\"\"\"\n\nfrom __future__ import annotations\n\nimport uuid\nfrom typing import TYPE_CHECKING, Any\n\nfrom sqlalchemy import JSON, ForeignKey, Index, Integer, String, Text, Uuid\nfrom sqlalchemy.orm import Mapped, mapped_column, relationship\n\nfrom core.domain.value_objects.signal_chain_enums import (  # type: ignore[import-untyped]\n    GearType,\n    Platform,\n)\n\nfrom .base import Base, EnumByValue, TimestampMixin, UUIDMixin\n\nif TYPE_CHECKING:\n    from .user import User\n\n\nclass BlockType(UUIDMixin, Base):\n    \"\"\"Built-in processor type definitions.\n\n    Represents built-in audio processors (compressor, EQ, etc.) that\n    can be used in signal chains beyond captured gear.\n\n    Attributes:\n        id: Primary key (UUIDv7)\n        name: Processor name (e.g., 'Compressor', 'EQ')\n        category: Category (e.g., 'dynamics', 'eq', 'modulation')\n        description: Optional description\n        default_params: Default parameter values as JSON\n    \"\"\"\n\n    __tablename__ = \"block_types\"\n\n    name: Mapped[str] = mapped_column(String(100), unique=True, nullable=False)\n    category: Mapped[str] = mapped_column(String(50), nullable=False)\n    description: Mapped[str | None] = mapped_column(Text, nullable=True)\n    default_params: Mapped[dict[str, Any]] = mapped_column(JSON, nullable=False, default=dict)\n\n\nclass SignalChain(UUIDMixin, TimestampMixin, Base):\n    \"\"\"SignalChain model for user-created signal chains.\n\n    Represents a composition of gear that can be processed together.\n    Follows signal chain grammar rules for valid compositions.\n\n    Attributes:\n        id: Primary key (UUIDv7)\n        user_id: Foreign key to users table\n        name: Display name for the signal chain\n        description: Optional description\n        platform: Target platform (NAM, AIDA-X, etc.)\n        created_at: When the chain was created\n        updated_at: When the chain was last updated\n        user: Reference to the User\n        blocks: List of blocks in this chain\n    \"\"\"\n\n    __tablename__ = \"signal_chains\"\n\n    user_id: Mapped[uuid.UUID] = mapped_column(\n        Uuid,\n        ForeignKey(\"users.id\", ondelete=\"CASCADE\"),\n        nullable=False,\n    )\n    name: Mapped[str] = mapped_column(String(255), nullable=False)\n    description: Mapped[str | None] = mapped_column(Text, nullable=True)\n    platform: Mapped[Platform] = mapped_column(\n        EnumByValue(Platform),\n        nullable=False,\n    )\n\n    # Relationships\n    user: Mapped[User] = relationship(\n        \"User\",\n        back_populates=\"signal_chains\",\n    )\n    blocks: Mapped[list[SignalChainBlock]] = relationship(\n        \"SignalChainBlock\",\n        back_populates=\"signal_chain\",\n        cascade=\"all, delete-orphan\",\n        order_by=\"SignalChainBlock.position\",\n        lazy=\"selectin\",  # Eager load blocks\n    )\n\n    # Indexes\n    __table_args__ = (\n        Index(\"ix_signal_chains_user_id\", \"user_id\"),\n    )\n\n\nclass SignalChainBlock(UUIDMixin, Base):\n    \"\"\"Individual block in a signal chain.\n\n    Represents one component (pedal, amp, full-rig, IR, or post-effect)\n    in the signal chain. Blocks are ordered by position.\n\n    Attributes:\n        id: Primary key (UUIDv7)\n        signal_chain_id: Foreign key to signal_chains table\n        position: Order in the chain (0-indexed)\n        user_gear_id: Reference to UserGear item\n        gear_type: Type of gear (pedal, amp, full_rig, ir, post_effect)\n        signal_chain: Reference to the SignalChain\n        presets: List of parameter presets for this block\n    \"\"\"\n\n    __tablename__ = \"signal_chain_blocks\"\n\n    signal_chain_id: Mapped[uuid.UUID] = mapped_column(\n        Uuid,\n        ForeignKey(\"signal_chains.id\", ondelete=\"CASCADE\"),\n        nullable=False,\n    )\n    position: Mapped[int] = mapped_column(Integer, nullable=False)\n    user_gear_id: Mapped[uuid.UUID] = mapped_column(\n        Uuid,\n        nullable=False,\n    )\n    gear_type: Mapped[GearType] = mapped_column(\n        EnumByValue(GearType),\n        nullable=False,\n    )\n\n    # Relationships\n    signal_chain: Mapped[SignalChain] = relationship(\n        \"SignalChain\",\n        back_populates=\"blocks\",\n    )\n    presets: Mapped[list[Preset]] = relationship(\n        \"Preset\",\n        back_populates=\"signal_chain_block\",\n        cascade=\"all, delete-orphan\",\n    )\n\n    # Indexes for common query patterns\n    __table_args__ = (\n        Index(\"ix_signal_chain_blocks_chain_id\", \"signal_chain_id\"),\n        Index(\"ix_signal_chain_blocks_position\", \"signal_chain_id\", \"position\"),\n    )\n\n\nclass Preset(UUIDMixin, Base):\n    \"\"\"Parameter preset for a signal chain block.\n\n    Stores parameter values for built-in processors or gear settings.\n\n    Attributes:\n        id: Primary key (UUIDv7)\n        signal_chain_block_id: Foreign key to signal_chain_blocks table\n        name: Preset name\n        params: Parameter values as JSON\n        signal_chain_block: Reference to the SignalChainBlock\n    \"\"\"\n\n    __tablename__ = \"presets\"\n\n    signal_chain_block_id: Mapped[uuid.UUID] = mapped_column(\n        Uuid,\n        ForeignKey(\"signal_chain_blocks.id\", ondelete=\"CASCADE\"),\n        nullable=False,\n    )\n    name: Mapped[str] = mapped_column(String(100), nullable=False)\n    params: Mapped[dict[str, Any]] = mapped_column(JSON, nullable=False, default=dict)\n\n    # Relationship\n    signal_chain_block: Mapped[SignalChainBlock] = relationship(\n        \"SignalChainBlock\",\n        back_populates=\"presets\",\n    )\n\n    # Index\n    __table_args__ = (\n        Index(\"ix_presets_block_id\", \"signal_chain_block_id\"),\n    )\n\n\nclass SignalChainGroup(UUIDMixin, TimestampMixin, Base):\n    \"\"\"SignalChainGroup model for permutation-based comparisons.\n\n    Groups allow users to compare multiple gear options at specific\n    positions in a chain. The system generates permutations to test\n    all combinations.\n\n    Attributes:\n        id: Primary key (UUIDv7)\n        user_id: Foreign key to users table\n        name: Display name for the group\n        description: Optional description\n        base_chain_id: Foreign key to signal_chains table (base chain)\n        slot_positions: List of positions that can vary (stored as JSON)\n        gear_options: Gear options per slot (stored as JSON)\n        include_null: Whether to include \"no gear\" as an option\n        created_at: When created\n        updated_at: When last updated\n        user: Reference to the User\n        base_chain: Reference to the base SignalChain\n    \"\"\"\n\n    __tablename__ = \"signal_chain_groups\"\n\n    user_id: Mapped[uuid.UUID] = mapped_column(\n        Uuid,\n        ForeignKey(\"users.id\", ondelete=\"CASCADE\"),\n        nullable=False,\n    )\n    name: Mapped[str] = mapped_column(String(255), nullable=False)\n    description: Mapped[str | None] = mapped_column(Text, nullable=True)\n    base_chain_id: Mapped[uuid.UUID | None] = mapped_column(\n        Uuid,\n        ForeignKey(\"signal_chains.id\", ondelete=\"SET NULL\"),\n        nullable=True,\n    )\n    slot_positions: Mapped[list[int]] = mapped_column(JSON, nullable=False, default=list)\n    gear_options: Mapped[dict[int, list[str]]] = mapped_column(JSON, nullable=False, default=dict)\n    include_null: Mapped[bool] = mapped_column(nullable=False, default=False)\n\n    # Relationships\n    user: Mapped[User] = relationship(\n        \"User\",\n        back_populates=\"signal_chain_groups\",\n    )\n    base_chain: Mapped[SignalChain | None] = relationship(\n        \"SignalChain\",\n    )\n\n    # Indexes\n    __table_args__ = (\n        Index(\"ix_signal_chain_groups_user_id\", \"user_id\"),\n    )\n","numLines":234,"startLine":1,"totalLines":234}}}
