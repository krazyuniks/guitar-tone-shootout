{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Xg2UZ1DPt7LmyyxLE62aGx","type":"tool_result","content":"    80→            insert_default=_UTCNow(),\n    81→            nullable=False,\n    82→        )\n    83→\n    84→    @declared_attr\n    85→    def updated_at(cls) -> Mapped[datetime]:\n    86→        \"\"\"Timestamp when record was last updated.\"\"\"\n    87→        return mapped_column(\n    88→            DateTime(timezone=True),\n    89→            insert_default=_UTCNow(),\n    90→            onupdate=_UTCNow(),\n    91→            nullable=False,\n    92→        )\n    93→\n    94→\n    95→E = TypeVar(\"E\", bound=Enum)\n    96→\n    97→\n    98→class EnumByValue(TypeDecorator[E]):\n    99→    \"\"\"SQLAlchemy type for storing Enum by value instead of name.\n   100→\n   101→    This ensures enums are stored as their string/int values in the database,\n   102→    making them more readable and resilient to enum name changes.\n   103→    \"\"\"\n   104→\n   105→    from sqlalchemy import String\n   106→\n   107→    # impl must be set at class level for TypeDecorator - default to String\n   108→    impl: Any = String(50)\n   109→    cache_ok = True\n   110→\n   111→    def __init__(self, enum_type: type[E], impl_type: Any | None = None) -> None:\n   112→        \"\"\"Initialize with the enum type to use.\n   113→\n   114→        Args:\n   115→            enum_type: The Enum class to use for conversion\n   116→            impl_type: Optional SQLAlchemy type to use (defaults to String(50))\n   117→        \"\"\"\n   118→        self.enum_type = enum_type\n   119→\n   120→        if impl_type is not None:\n   121→            self.impl = impl_type\n   122→        else:\n   123→            # Determine the appropriate SQL type based on enum value type\n   124→            first_member = next(iter(enum_type))\n   125→            if isinstance(first_member.value, str):\n   126→                from sqlalchemy import String\n   127→\n   128→                self.impl = String(50)\n   129→            elif isinstance(first_member.value, int):\n   130→                from sqlalchemy import Integer\n   131→\n   132→                self.impl = Integer()\n   133→            else:\n   134→                from sqlalchemy import String\n   135→\n   136→                self.impl = String(50)\n   137→\n   138→        super().__init__()\n   139→\n   140→    def process_bind_param(self, value: E | None, _dialect: Any) -> Any:\n   141→        \"\"\"Convert enum to value for database storage.\"\"\"\n   142→        if value is None:\n   143→            return None\n   144→        return value.value\n   145→\n   146→    def process_result_value(self, value: Any, _dialect: Any) -> E | None:\n   147→        \"\"\"Convert value from database to enum.\"\"\"\n   148→        if value is None:\n   149→            return None\n   150→        return self.enum_type(value)\n   151→\n   152→\n   153→def get_async_session(database_url: str) -> async_sessionmaker[AsyncSession]:\n   154→    \"\"\"Create an async session factory for the database.\n   155→\n   156→    Args:\n   157→        database_url: PostgreSQL connection string (must use asyncpg driver)\n   158→\n   159→    Returns:\n   160→        Session factory that creates AsyncSession instances\n   161→    \"\"\"\n   162→    # SQLite doesn't support pool_size/max_overflow\n   163→    if \"sqlite\" in database_url:\n   164→        engine = create_async_engine(\n   165→            database_url,\n   166→            echo=False,\n   167→        )\n   168→    else:\n   169→        # PostgreSQL with connection pooling\n   170→        engine = create_async_engine(\n   171→            database_url,\n   172→            echo=False,\n   173→            pool_pre_ping=True,\n   174→            pool_size=10,\n   175→            max_overflow=20,\n   176→        )\n   177→\n   178→    return async_sessionmaker(\n   179→        engine,\n   180→        class_=AsyncSession,\n   181→        expire_on_commit=False,\n   182→    )\n   183→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"6044bc8c-bcbf-48e4-90f1-5ef30954a52d","uuid":"d3010ea2-95b1-4df8-8a49-24ae206f8594","tool_use_result":{"type":"text","file":{"filePath":"/home/ryan/Work/guitar-tone-worktrees/main/apps/webapp/src/webapp/adapters/persistence/models/base.py","content":"            insert_default=_UTCNow(),\n            nullable=False,\n        )\n\n    @declared_attr\n    def updated_at(cls) -> Mapped[datetime]:\n        \"\"\"Timestamp when record was last updated.\"\"\"\n        return mapped_column(\n            DateTime(timezone=True),\n            insert_default=_UTCNow(),\n            onupdate=_UTCNow(),\n            nullable=False,\n        )\n\n\nE = TypeVar(\"E\", bound=Enum)\n\n\nclass EnumByValue(TypeDecorator[E]):\n    \"\"\"SQLAlchemy type for storing Enum by value instead of name.\n\n    This ensures enums are stored as their string/int values in the database,\n    making them more readable and resilient to enum name changes.\n    \"\"\"\n\n    from sqlalchemy import String\n\n    # impl must be set at class level for TypeDecorator - default to String\n    impl: Any = String(50)\n    cache_ok = True\n\n    def __init__(self, enum_type: type[E], impl_type: Any | None = None) -> None:\n        \"\"\"Initialize with the enum type to use.\n\n        Args:\n            enum_type: The Enum class to use for conversion\n            impl_type: Optional SQLAlchemy type to use (defaults to String(50))\n        \"\"\"\n        self.enum_type = enum_type\n\n        if impl_type is not None:\n            self.impl = impl_type\n        else:\n            # Determine the appropriate SQL type based on enum value type\n            first_member = next(iter(enum_type))\n            if isinstance(first_member.value, str):\n                from sqlalchemy import String\n\n                self.impl = String(50)\n            elif isinstance(first_member.value, int):\n                from sqlalchemy import Integer\n\n                self.impl = Integer()\n            else:\n                from sqlalchemy import String\n\n                self.impl = String(50)\n\n        super().__init__()\n\n    def process_bind_param(self, value: E | None, _dialect: Any) -> Any:\n        \"\"\"Convert enum to value for database storage.\"\"\"\n        if value is None:\n            return None\n        return value.value\n\n    def process_result_value(self, value: Any, _dialect: Any) -> E | None:\n        \"\"\"Convert value from database to enum.\"\"\"\n        if value is None:\n            return None\n        return self.enum_type(value)\n\n\ndef get_async_session(database_url: str) -> async_sessionmaker[AsyncSession]:\n    \"\"\"Create an async session factory for the database.\n\n    Args:\n        database_url: PostgreSQL connection string (must use asyncpg driver)\n\n    Returns:\n        Session factory that creates AsyncSession instances\n    \"\"\"\n    # SQLite doesn't support pool_size/max_overflow\n    if \"sqlite\" in database_url:\n        engine = create_async_engine(\n            database_url,\n            echo=False,\n        )\n    else:\n        # PostgreSQL with connection pooling\n        engine = create_async_engine(\n            database_url,\n            echo=False,\n            pool_pre_ping=True,\n            pool_size=10,\n            max_overflow=20,\n        )\n\n    return async_sessionmaker(\n        engine,\n        class_=AsyncSession,\n        expire_on_commit=False,\n    )\n","numLines":104,"startLine":80,"totalLines":183}}}
