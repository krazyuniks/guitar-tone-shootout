{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BkMLSVhi98ok8dJ36X1AAF","type":"tool_result","content":"     1→from __future__ import annotations\n     2→\n     3→import uuid\n     4→from typing import TYPE_CHECKING\n     5→\n     6→from sqlalchemy import Boolean, ForeignKey, Index, String, Uuid\n     7→from sqlalchemy.orm import Mapped, mapped_column, relationship\n     8→\n     9→from .base import Base, TimestampMixin, UUIDMixin\n    10→\n    11→if TYPE_CHECKING:\n    12→    from .shootout import DITrack, Shootout\n    13→    from .signal_chain import SignalChain, SignalChainGroup\n    14→\n    15→\n    16→class OAuthProvider(UUIDMixin, Base):\n    17→    \"\"\"OAuth provider model.\n    18→\n    19→    Represents available OAuth providers (t3k, google, etc.) that users\n    20→    can authenticate with. Providers can be enabled or disabled.\n    21→\n    22→    Attributes:\n    23→        id: Primary key (UUIDv7)\n    24→        name: Provider name (e.g., 't3k', 'google')\n    25→        enabled: Whether this provider is currently active\n    26→    \"\"\"\n    27→\n    28→    __tablename__ = \"oauth_providers\"\n    29→\n    30→    name: Mapped[str] = mapped_column(String(50), unique=True, nullable=False)\n    31→    enabled: Mapped[bool] = mapped_column(Boolean, nullable=False, default=True)\n    32→\n    33→    # Relationship to identities\n    34→    identities: Mapped[list[UserIdentity]] = relationship(\n    35→        \"UserIdentity\",\n    36→        back_populates=\"provider\",\n    37→        cascade=\"all, delete-orphan\",\n    38→    )\n    39→\n    40→\n    41→class User(UUIDMixin, TimestampMixin, Base):\n    42→    \"\"\"User model for authenticated users.\n    43→\n    44→    Users are the core entity for authentication and authorization.\n    45→    They can be linked to multiple external identity providers.\n    46→\n    47→    Attributes:\n    48→        id: Primary key (UUIDv7)\n    49→        username: Display name\n    50→        email: Email address (optional, indexed)\n    51→        avatar_url: Profile image URL (optional)\n    52→        created_at: When the user was created\n    53→        updated_at: When the user was last updated\n    54→        identities: List of linked external identities\n    55→    \"\"\"\n    56→\n    57→    __tablename__ = \"users\"\n    58→\n    59→    username: Mapped[str] = mapped_column(String(255), nullable=False)\n    60→    email: Mapped[str | None] = mapped_column(String(255), nullable=True, index=True)\n    61→    avatar_url: Mapped[str | None] = mapped_column(String(500), nullable=True)\n    62→\n    63→    # Relationship to identities\n    64→    identities: Mapped[list[UserIdentity]] = relationship(\n    65→        \"UserIdentity\",\n    66→        back_populates=\"user\",\n    67→        cascade=\"all, delete-orphan\",\n    68→        lazy=\"selectin\",  # Eager load identities by default\n    69→    )\n    70→\n    71→    # Relationships to signal chains\n    72→    signal_chains: Mapped[list[SignalChain]] = relationship(\n    73→        \"SignalChain\",\n    74→        back_populates=\"user\",\n    75→        cascade=\"all, delete-orphan\",\n    76→    )\n    77→    signal_chain_groups: Mapped[list[SignalChainGroup]] = relationship(\n    78→        \"SignalChainGroup\",\n    79→        back_populates=\"user\",\n    80→        cascade=\"all, delete-orphan\",\n    81→    )\n    82→\n    83→    # Relationships to DI tracks and shootouts\n    84→    di_tracks: Mapped[list[DITrack]] = relationship(\n    85→        \"DITrack\",\n    86→        back_populates=\"user\",\n    87→        cascade=\"all, delete-orphan\",\n    88→    )\n    89→    shootouts: Mapped[list[Shootout]] = relationship(\n    90→        \"Shootout\",\n    91→        back_populates=\"user\",\n    92→        cascade=\"all, delete-orphan\",\n    93→    )\n    94→\n    95→    # TODO: Add relationships to Gear, Job once those models exist\n    96→\n    97→\n    98→class UserIdentity(UUIDMixin, TimestampMixin, Base):\n    99→    \"\"\"User identity model for linking external providers.\n   100→\n   101→    Each UserIdentity represents a link between a User and an external\n   102→    OAuth provider. Users can have multiple identities (one per provider).\n   103→\n   104→    Attributes:\n   105→        id: Primary key (UUIDv7)\n   106→        user_id: Foreign key to users table\n   107→        provider_id: Foreign key to oauth_providers table\n   108→        external_id: ID from the external provider\n   109→        username: Display name from the provider\n   110→        avatar_url: Profile image URL from provider (optional)\n   111→        created_at: When the identity link was created\n   112→        updated_at: When the identity was last updated\n   113→        user: Reference to the User\n   114→        provider: Reference to the OAuthProvider\n   115→    \"\"\"\n   116→\n   117→    __tablename__ = \"user_identities\"\n   118→\n   119→    user_id: Mapped[uuid.UUID] = mapped_column(\n   120→        Uuid,\n   121→        ForeignKey(\"users.id\", ondelete=\"CASCADE\"),\n   122→        nullable=False,\n   123→    )\n   124→    provider_id: Mapped[uuid.UUID] = mapped_column(\n   125→        Uuid,\n   126→        ForeignKey(\"oauth_providers.id\", ondelete=\"CASCADE\"),\n   127→        nullable=False,\n   128→    )\n   129→    external_id: Mapped[str] = mapped_column(String(255), nullable=False)\n   130→    username: Mapped[str] = mapped_column(String(255), nullable=False)\n   131→    avatar_url: Mapped[str | None] = mapped_column(String(500), nullable=True)\n   132→\n   133→    # Relationships\n   134→    user: Mapped[User] = relationship(\"User\", back_populates=\"identities\")\n   135→    provider: Mapped[OAuthProvider] = relationship(\n   136→        \"OAuthProvider\",\n   137→        back_populates=\"identities\",\n   138→        lazy=\"selectin\",  # Eager load provider by default\n   139→    )\n   140→\n   141→    # Indexes for common query patterns\n   142→    __table_args__ = (\n   143→        # Composite index for provider + external_id lookups\n   144→        Index(\"ix_user_identities_provider_external\", \"provider_id\", \"external_id\"),\n   145→        # Index for user_id lookups\n   146→        Index(\"ix_user_identities_user_id\", \"user_id\"),\n   147→    )\n   148→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"6044bc8c-bcbf-48e4-90f1-5ef30954a52d","uuid":"a5eadbeb-743b-446c-b610-13c6a4e5940f","tool_use_result":{"type":"text","file":{"filePath":"/home/ryan/Work/guitar-tone-worktrees/main/apps/webapp/src/webapp/adapters/persistence/models/user.py","content":"from __future__ import annotations\n\nimport uuid\nfrom typing import TYPE_CHECKING\n\nfrom sqlalchemy import Boolean, ForeignKey, Index, String, Uuid\nfrom sqlalchemy.orm import Mapped, mapped_column, relationship\n\nfrom .base import Base, TimestampMixin, UUIDMixin\n\nif TYPE_CHECKING:\n    from .shootout import DITrack, Shootout\n    from .signal_chain import SignalChain, SignalChainGroup\n\n\nclass OAuthProvider(UUIDMixin, Base):\n    \"\"\"OAuth provider model.\n\n    Represents available OAuth providers (t3k, google, etc.) that users\n    can authenticate with. Providers can be enabled or disabled.\n\n    Attributes:\n        id: Primary key (UUIDv7)\n        name: Provider name (e.g., 't3k', 'google')\n        enabled: Whether this provider is currently active\n    \"\"\"\n\n    __tablename__ = \"oauth_providers\"\n\n    name: Mapped[str] = mapped_column(String(50), unique=True, nullable=False)\n    enabled: Mapped[bool] = mapped_column(Boolean, nullable=False, default=True)\n\n    # Relationship to identities\n    identities: Mapped[list[UserIdentity]] = relationship(\n        \"UserIdentity\",\n        back_populates=\"provider\",\n        cascade=\"all, delete-orphan\",\n    )\n\n\nclass User(UUIDMixin, TimestampMixin, Base):\n    \"\"\"User model for authenticated users.\n\n    Users are the core entity for authentication and authorization.\n    They can be linked to multiple external identity providers.\n\n    Attributes:\n        id: Primary key (UUIDv7)\n        username: Display name\n        email: Email address (optional, indexed)\n        avatar_url: Profile image URL (optional)\n        created_at: When the user was created\n        updated_at: When the user was last updated\n        identities: List of linked external identities\n    \"\"\"\n\n    __tablename__ = \"users\"\n\n    username: Mapped[str] = mapped_column(String(255), nullable=False)\n    email: Mapped[str | None] = mapped_column(String(255), nullable=True, index=True)\n    avatar_url: Mapped[str | None] = mapped_column(String(500), nullable=True)\n\n    # Relationship to identities\n    identities: Mapped[list[UserIdentity]] = relationship(\n        \"UserIdentity\",\n        back_populates=\"user\",\n        cascade=\"all, delete-orphan\",\n        lazy=\"selectin\",  # Eager load identities by default\n    )\n\n    # Relationships to signal chains\n    signal_chains: Mapped[list[SignalChain]] = relationship(\n        \"SignalChain\",\n        back_populates=\"user\",\n        cascade=\"all, delete-orphan\",\n    )\n    signal_chain_groups: Mapped[list[SignalChainGroup]] = relationship(\n        \"SignalChainGroup\",\n        back_populates=\"user\",\n        cascade=\"all, delete-orphan\",\n    )\n\n    # Relationships to DI tracks and shootouts\n    di_tracks: Mapped[list[DITrack]] = relationship(\n        \"DITrack\",\n        back_populates=\"user\",\n        cascade=\"all, delete-orphan\",\n    )\n    shootouts: Mapped[list[Shootout]] = relationship(\n        \"Shootout\",\n        back_populates=\"user\",\n        cascade=\"all, delete-orphan\",\n    )\n\n    # TODO: Add relationships to Gear, Job once those models exist\n\n\nclass UserIdentity(UUIDMixin, TimestampMixin, Base):\n    \"\"\"User identity model for linking external providers.\n\n    Each UserIdentity represents a link between a User and an external\n    OAuth provider. Users can have multiple identities (one per provider).\n\n    Attributes:\n        id: Primary key (UUIDv7)\n        user_id: Foreign key to users table\n        provider_id: Foreign key to oauth_providers table\n        external_id: ID from the external provider\n        username: Display name from the provider\n        avatar_url: Profile image URL from provider (optional)\n        created_at: When the identity link was created\n        updated_at: When the identity was last updated\n        user: Reference to the User\n        provider: Reference to the OAuthProvider\n    \"\"\"\n\n    __tablename__ = \"user_identities\"\n\n    user_id: Mapped[uuid.UUID] = mapped_column(\n        Uuid,\n        ForeignKey(\"users.id\", ondelete=\"CASCADE\"),\n        nullable=False,\n    )\n    provider_id: Mapped[uuid.UUID] = mapped_column(\n        Uuid,\n        ForeignKey(\"oauth_providers.id\", ondelete=\"CASCADE\"),\n        nullable=False,\n    )\n    external_id: Mapped[str] = mapped_column(String(255), nullable=False)\n    username: Mapped[str] = mapped_column(String(255), nullable=False)\n    avatar_url: Mapped[str | None] = mapped_column(String(500), nullable=True)\n\n    # Relationships\n    user: Mapped[User] = relationship(\"User\", back_populates=\"identities\")\n    provider: Mapped[OAuthProvider] = relationship(\n        \"OAuthProvider\",\n        back_populates=\"identities\",\n        lazy=\"selectin\",  # Eager load provider by default\n    )\n\n    # Indexes for common query patterns\n    __table_args__ = (\n        # Composite index for provider + external_id lookups\n        Index(\"ix_user_identities_provider_external\", \"provider_id\", \"external_id\"),\n        # Index for user_id lookups\n        Index(\"ix_user_identities_user_id\", \"user_id\"),\n    )\n","numLines":148,"startLine":1,"totalLines":148}}}
