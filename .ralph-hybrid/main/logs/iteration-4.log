pattern\n    45→    for flexibility.\n    46→    \"\"\"\n    47→\n    48→    __tablename__ = \"jobs\"\n    49→    __table_args__ = (\n    50→        Index(\"ix_jobs_status\", \"status\"),\n    51→        Index(\"ix_jobs_reference\", \"reference_type\", \"reference_id\"),\n    52→        Index(\"ix_jobs_user_id\", \"user_id\"),\n    53→    )\n    54→\n    55→    # Job Type\n    56→    job_type: Mapped[JobType] = mapped_column(\n    57→        EnumByValue(JobType, name=\"job_type\"),\n    58→        index=True,\n    59→    )\n    60→\n    61→    # Reference to Related Entity\n    62→    reference_id: Mapped[UUID | None] = mapped_column(nullable=True)\n    63→    reference_type: Mapped[str | None] = mapped_column(String(50), nullable=True)\n    64→\n    65→    # User Who Initiated (if applicable)\n    66→    user_id: Mapped[UUID | None] = mapped_column(\n    67→        ForeignKey(\"users.id\", ondelete=\"SET NULL\"),\n    68→        nullable=True,\n    69→        index=True,\n    70→    )\n    71→\n    72→    # Job Status\n    73→    status: Mapped[JobStatus] = mapped_column(\n    74→        EnumByValue(JobStatus, name=\"job_status\"),\n    75→        default=JobStatus.PENDING,\n    76→        index=True,\n    77→    )\n    78→\n    79→    # Progress Tracking\n    80→    progress: Mapped[int] = mapped_column(Integer, default=0)\n    81→    message: Mapped[str | None] = mapped_column(Text)\n    82→\n    83→    # Error Handling\n    84→    error_message: Mapped[str | None] = mapped_column(Text)\n    85→    retry_count: Mapped[int] = mapped_column(Integer, default=0)\n    86→\n    87→    # Timing\n    88→    started_at: Mapped[datetime | None] = mapped_column(DateTime(timezone=True))\n    89→    completed_at: Mapped[datetime | None] = mapped_column(DateTime(timezone=True))\n    90→    last_heartbeat: Mapped[datetime | None] = mapped_column(DateTime(timezone=True))\n    91→    next_retry_at: Mapped[datetime | None] = mapped_column(DateTime(timezone=True))\n    92→\n    93→    # Task Tracking (for background workers)\n    94→    task_id: Mapped[str | None] = mapped_column(String(100), index=True)\n    95→\n    96→    # Job Configuration (JSON string for retry support)\n    97→    config: Mapped[str | None] = mapped_column(Text)\n    98→\n    99→    # Result Storage\n   100→    result_path: Mapped[str | None] = mapped_column(Text)\n   101→\n   102→    # Job Hierarchy (for parent/child jobs)\n   103→    parent_job_id: Mapped[UUID | None] = mapped_column(\n   104→        ForeignKey(\"jobs.id\", ondelete=\"CASCADE\"),\n   105→        nullable=True,\n   106→    )\n   107→\n   108→    # Relationships\n   109→    user: Mapped[\"User | None\"] = relationship(\n   110→        back_populates=\"jobs\",\n   111→        lazy=\"raise\",\n   112→    )\n   113→\n   114→    # Convenience property for shootout jobs\n   115→    @property\n   116→    def shootout_id(self) -> UUID | None:\n   117→        \"\"\"Get shootout ID if this is a shootout job.\"\"\"\n   118→        if self.reference_type == \"shootout\" and self.reference_id:\n   119→            return self.reference_id\n   120→        return None\n   121→\n   122→    def __repr__(self) -> str:\n   123→        \"\"\"Return string representation of the job.\"\"\"\n   124→        return (\n   125→            f\"<Job {self.id} type={self.job_type.value} \"\n   126→            f\"status={self.status.value} progress={self.progress}%>\"\n   127→        )\n   128→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"6044bc8c-bcbf-48e4-90f1-5ef30954a52d","uuid":"27a5352f-d8bb-4a8a-87f2-a34b330f9850","tool_use_result":{"type":"text","file":{"filePath":"/home/ryan/Work/guitar-tone-worktrees-archive-20260202/main/backend/app/models/job.py","content":"\"\"\"Job model for tracking background processing jobs.\"\"\"\n\nfrom datetime import datetime\nfrom enum import Enum\nfrom typing import TYPE_CHECKING\nfrom uuid import UUID\n\nfrom sqlalchemy import DateTime, ForeignKey, Index, Integer, String, Text\nfrom sqlalchemy.orm import Mapped, mapped_column, relationship\n\nfrom app.models.base import Base, TimestampMixin, UUIDMixin\nfrom app.models.types import EnumByValue\n\nif TYPE_CHECKING:\n    from app.models.user import User\n\n\nclass JobStatus(str, Enum):\n    \"\"\"Status of a background processing job.\"\"\"\n\n    PENDING = \"pending\"  # Job created, not yet queued\n    QUEUED = \"queued\"  # Job sent to worker queue\n    RUNNING = \"running\"  # Worker is processing\n    COMPLETED = \"completed\"  # Job finished successfully\n    FAILED = \"failed\"  # Job failed with error\n\n\nclass JobType(str, Enum):\n    \"\"\"Type of background processing job.\"\"\"\n\n    SHOOTOUT_PROCESS = \"shootout_process\"  # Process a shootout\n    MODEL_DOWNLOAD = \"model_download\"  # Download model file from T3K\n    T3K_SYNC = \"t3k_sync\"  # T3K catalog sync (backfill + newest)\n    T3K_SYNC_FULL = \"t3k_sync_full\"  # Full T3K catalog sync\n    T3K_SYNC_INCREMENTAL = \"t3k_sync_incremental\"  # Incremental T3K sync\n\n\nclass Job(Base, UUIDMixin, TimestampMixin):\n    \"\"\"Background processing job.\n\n    Tracks the lifecycle of a background job from creation through\n    completion, with progress updates and error handling.\n\n    Supports generic job types via reference_id/reference_type pattern\n    for flexibility.\n    \"\"\"\n\n    __tablename__ = \"jobs\"\n    __table_args__ = (\n        Index(\"ix_jobs_status\", \"status\"),\n        Index(\"ix_jobs_reference\", \"reference_type\", \"reference_id\"),\n        Index(\"ix_jobs_user_id\", \"user_id\"),\n    )\n\n    # Job Type\n    job_type: Mapped[JobType] = mapped_column(\n        EnumByValue(JobType, name=\"job_type\"),\n        index=True,\n    )\n\n    # Reference to Related Entity\n    reference_id: Mapped[UUID | None] = mapped_column(nullable=True)\n    reference_type: Mapped[str | None] = mapped_column(String(50), nullable=True)\n\n    # User Who Initiated (if applicable)\n    user_id: Mapped[UUID | None] = mapped_column(\n        ForeignKey(\"users.id\", ondelete=\"SET NULL\"),\n        nullable=True,\n        index=True,\n    )\n\n    # Job Status\n    status: Mapped[JobStatus] = mapped_column(\n        EnumByValue(JobStatus, name=\"job_status\"),\n        default=JobStatus.PENDING,\n        index=True,\n    )\n\n    # Progress Tracking\n    progress: Mapped[int] = mapped_column(Integer, default=0)\n    message: Mapped[str | None] = mapped_column(Text)\n\n    # Error Handling\n    error_message: Mapped[str | None] = mapped_column(Text)\n    retry_count: Mapped[int] = mapped_column(Integer, default=0)\n\n    # Timing\n    started_at: Mapped[datetime | None] = mapped_column(DateTime(timezone=True))\n    completed_at: Mapped[datetime | None] = mapped_column(DateTime(timezone=True))\n    last_heartbeat: Mapped[datetime | None] = mapped_column(DateTime(timezone=True))\n    next_retry_at: Mapped[datetime | None] = mapped_column(DateTime(timezone=True))\n\n    # Task Tracking (for background workers)\n    task_id: Mapped[str | None] = mapped_column(String(100), index=True)\n\n    # Job Configuration (JSON string for retry support)\n    config: Mapped[str | None] = mapped_column(Text)\n\n    # Result Storage\n    result_path: Mapped[str | None] = mapped_column(Text)\n\n    # Job Hierarchy (for parent/child jobs)\n    parent_job_id: Mapped[UUID | None] = mapped_column(\n        ForeignKey(\"jobs.id\", ondelete=\"CASCADE\"),\n        nullable=True,\n    )\n\n    # Relationships\n    user: Mapped[\"User | None\"] = relationship(\n        back_populates=\"jobs\",\n        lazy=\"raise\",\n    )\n\n    # Convenience property for shootout jobs\n    @property\n    def shootout_id(self) -> UUID | None:\n        \"\"\"Get shootout ID if this is a shootout job.\"\"\"\n        if self.reference_type == \"shootout\" and self.reference_id:\n            return self.reference_id\n        return None\n\n    def __repr__(self) -> str:\n        \"\"\"Return string representation of the job.\"\"\"\n        return (\n            f\"<Job {self.id} type={self.job_type.value} \"\n            f\"status={self.status.value} progress={self.progress}%>\"\n        )\n","numLines":128,"startLine":1,"totalLines":128}}}
