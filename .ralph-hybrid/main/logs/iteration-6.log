eturns:\n   113→            The Gear if found, None otherwise\n   114→        \"\"\"\n   115→        ...\n   116→\n   117→    async def search(\n   118→        self,\n   119→        *,\n   120→        query: str | None = None,\n   121→        gear_type: GearType | None = None,\n   122→        manufacturer: str | None = None,\n   123→        tags: list[str] | None = None,\n   124→        limit: int = 50,\n   125→        offset: int = 0,\n   126→    ) -> list[Gear]:\n   127→        \"\"\"Search for gear with filters.\n   128→\n   129→        Args:\n   130→            query: Optional text search on name/description\n   131→            gear_type: Optional filter by gear type\n   132→            manufacturer: Optional filter by manufacturer\n   133→            tags: Optional filter by tags (AND logic)\n   134→            limit: Maximum number of results\n   135→            offset: Number of results to skip\n   136→\n   137→        Returns:\n   138→            List of matching Gear ordered by name\n   139→        \"\"\"\n   140→        ...\n   141→\n   142→    async def count(\n   143→        self,\n   144→        *,\n   145→        query: str | None = None,\n   146→        gear_type: GearType | None = None,\n   147→        manufacturer: str | None = None,\n   148→        tags: list[str] | None = None,\n   149→    ) -> int:\n   150→        \"\"\"Count gear matching filters.\n   151→\n   152→        Args:\n   153→            query: Optional text search\n   154→            gear_type: Optional filter by gear type\n   155→            manufacturer: Optional filter by manufacturer\n   156→            tags: Optional filter by tags\n   157→\n   158→        Returns:\n   159→            Count of matching gear\n   160→        \"\"\"\n   161→        ...\n   162→\n   163→    async def save(self, gear: Gear) -> None:\n   164→        \"\"\"Save gear (create or update).\n   165→\n   166→        Args:\n   167→            gear: The gear to save\n   168→        \"\"\"\n   169→        ...\n 