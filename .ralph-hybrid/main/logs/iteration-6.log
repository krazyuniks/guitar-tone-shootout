{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NWfWYpDGUwi4E5ZBVAwmqT","type":"tool_result","content":"     1→\"\"\"Gear ORM models for persistence layer.\"\"\"\n     2→\n     3→import uuid\n     4→from datetime import datetime\n     5→\n     6→from sqlalchemy import Boolean, Column, DateTime, ForeignKey, Index, String, Table, Text, Uuid\n     7→from sqlalchemy.orm import Mapped, mapped_column, relationship\n     8→\n     9→from core.domain.value_objects.download_status import DownloadStatus  # type: ignore[import-untyped]\n    10→from core.domain.value_objects.signal_chain_enums import (  # type: ignore[import-untyped]\n    11→    GearType,\n    12→    ModelSize,\n    13→    Platform,\n    14→)\n    15→\n    16→from .base import Base, EnumByValue, TimestampMixin, UUIDMixin\n    17→\n    18→# Junction table for gear-tag many-to-many relationship\n    19→gear_tags_table = Table(\n    20→    \"gear_tags\",\n    21→    Base.metadata,\n    22→    Column(\"gear_id\", Uuid, ForeignKey(\"gear.id\", ondelete=\"CASCADE\"), primary_key=True),\n    23→    Column(\"tag_id\", Uuid, ForeignKey(\"tags.id\", ondelete=\"CASCADE\"), primary_key=True),\n    24→)\n    25→\n    26→\n    27→class GearTag(UUIDMixin, Base):\n    28→    \"\"\"Tag model for categorizing gear.\n    29→\n    30→    Tags are shared across all gear items for consistent categorization.\n    31→    Examples: \"metal\", \"high-gain\", \"blues\", \"clean\", etc.\n    32→\n    33→    Attributes:\n    34→        id: Primary key (UUIDv7)\n    35→        name: Tag name (unique, lowercase)\n    36→        gear_items: List of gear with this tag\n    37→    \"\"\"\n    38→\n    39→    __tablename__ = \"tags\"\n    40→\n    41→    name: Mapped[str] = mapped_column(String(50), unique=True, nullable=False)\n    42→\n    43→    # Relationship to gear (many-to-many)\n    44→    gear_items: Mapped[list[\"Gear\"]] = relationship(\n    45→        \"Gear\",\n    46→        secondary=gear_tags_table,\n    47→        back_populates=\"tags\",\n    48→    )\n    49→\n    50→\n    51→class GearMake(UUIDMixin, Base):\n    52→    \"\"\"Manufacturer/make model for gear.\n    53→\n    54→    Represents gear manufacturers (Fender, Marshall, etc.) for\n    55→    consistent manufacturer names across gear items.\n    56→\n    57→    Attributes:\n    58→        id: Primary key (UUIDv7)\n    59→        name: Manufacturer name (unique)\n    60→        gear_items: List of gear from this manufacturer\n    61→    \"\"\"\n    62→\n    63→    __tablename__ = \"gear_makes\"\n    64→\n    65→    name: Mapped[str] = mapped_column(String(100), unique=True, nullable=False)\n    66→\n    67→    # Relationship to gear\n    68→    gear_items: Mapped[list[\"Gear\"]] = relationship(\n    69→        \"Gear\",\n    70→        back_populates=\"make\",\n    71→    )\n    72→\n    73→\n    74→class GearSource(UUIDMixin, TimestampMixin, Base):\n    75→    \"\"\"Source tracking for gear data.\n    76→\n    77→    Tracks where gear came from (T3K, user upload, etc.) for sync\n    78→    and attribution purposes.\n    79→\n    80→    Attributes:\n    81→        id: Primary key (UUIDv7)\n    82→        source_name: Name of source (e.g., 't3k', 'user_upload')\n    83→        source_record_id: ID in the source system\n    84→        source_updated_at: Last update time in source system\n    85→        created_at: When source record was created\n    86→        updated_at: When source record was last updated\n    87→        gear: The gear item this source belongs to\n    88→    \"\"\"\n    89→\n    90→    __tablename__ = \"gear_sources\"\n    91→\n    92→    source_name: Mapped[str] = mapped_column(String(50), nullable=False)\n    93→    source_record_id: Mapped[str] = mapped_column(String(255), nullable=False)\n    94→    source_updated_at: Mapped[datetime] = mapped_column(\n    95→        DateTime(timezone=True),\n    96→        nullable=False,\n    97→    )\n    98→\n    99→    # Relationship to gear (one-to-one)\n   100→    gear: Mapped[\"Gear\"] = relationship(\"Gear\", back_populates=\"source\", uselist=False)\n   101→\n   102→    # Composite index for source lookups\n   103→    __table_args__ = (\n   104→        Index(\"ix_gear_sources_source_lookup\", \"source_name\", \"source_record_id\"),\n   105→    )\n   106→\n   107→\n   108→class GearModel(UUIDMixin, Base):\n   109→    \"\"\"Downloadable model file for gear.\n   110→\n   111→    Represents a specific model file variant (platform, size) for a\n   112→    piece of gear. A single gear item can have multiple model files.\n   113→\n   114→    Attributes:\n   115→        id: Primary key (UUIDv7)\n   116→        gear_id: Foreign key to gear table\n   117→        platform: Target platform (NAM, AIDA-X, etc.)\n   118→        size: Model size variant (standard, lite, etc.)\n   119→        file_path: Local path to model file (if downloaded)\n   120→        download_url: URL to download the model\n   121→        download_status: Current download status\n   122→        file_hash: SHA256 hash for integrity verification\n   123→        gear: The gear item this model belongs to\n   124→    \"\"\"\n   125→\n   126→    __tablename__ = \"gear_models\"\n   127→\n   128→    gear_id: Mapped[uuid.UUID] = mapped_column(\n   129→        Uuid,\n   130→        ForeignKey(\"gear.id\", ondelete=\"CASCADE\"),\n   131→        nullable=False,\n   132→    )\n   133→    platform: Mapped[Platform] = mapped_column(\n   134→        EnumByValue(Platform),\n   135→        nullable=False,\n   136→    )\n   137→    size: Mapped[ModelSize] = mapped_column(\n   138→        EnumByValue(ModelSize),\n   139→        nullable=False,\n   140→    )\n   141→    file_path: Mapped[str | None] = mapped_column(String(500), nullable=True)\n   142→    download_url: Mapped[str | None] = mapped_column(String(500), nullable=True)\n   143→    download_status: Mapped[DownloadStatus] = mapped_column(\n   144→        EnumByValue(DownloadStatus),\n   145→        nullable=False,\n   146→        default=DownloadStatus.PENDING,\n   147→    )\n   148→    file_hash: Mapped[str | None] = mapped_column(String(64), nullable=True)\n   149→\n   150→    # Relationship to gear\n   151→    gear: Mapped[\"Gear\"] = relationship(\"Gear\", back_populates=\"models\")\n   152→\n   153→    # Indexes for common query patterns\n   154→    __table_args__ = (\n   155→        Index(\"ix_gearmodel_gear_id\", \"gear_id\"),\n   156→        Index(\"ix_gearmodel_platform\", \"platform\"),\n   157→    )\n   158→\n   159→\n   160→class Gear(UUIDMixin, TimestampMixin, Base):\n   161→    \"\"\"Gear model representing amps, pedals, IRs, etc.\n   162→\n   163→    Domain aggregate root for gear. Unified representation from any source.\n   164→\n   165→    Attributes:\n   166→        id: Primary key (UUIDv7)\n   167→        name: Display name\n   168→        gear_type: Type of gear (amp, pedal, ir, etc.)\n   169→        description: Optional description\n   170→        manufacturer: Manufacturer name (legacy field, prefer make_id)\n   171→        make_id: Foreign key to gear_makes table\n   172→        thumbnail_url: Preview image URL\n   173→        is_public: Whether visible to all users\n   174→        source_id: Foreign key to gear_sources table (optional)\n   175→        created_at: When created in GTS\n   176→        updated_at: When last updated in GTS\n   177→        make: Manufacturer relationship\n   178→        source: Source tracking relationship\n   179→        models: List of downloadable model files\n   180→        tags: List of tags for categorization\n   181→    \"\"\"\n   182→\n   183→    __tablename__ = \"gear\"\n   184→\n   185→    name: Mapped[str] = mapped_column(String(255), nullable=False)\n   186→    gear_type: Mapped[GearType] = mapped_column(\n   187→        EnumByValue(GearType),\n   188→        nullable=False,\n   189→    )\n   190→    description: Mapped[str | None] = mapped_column(Text, nullable=True)\n   191→    manufacturer: Mapped[str | None] = mapped_column(String(100), nullable=True)\n   192→    make_id: Mapped[uuid.UUID | None] = mapped_column(\n   193→        Uuid,\n   194→        ForeignKey(\"gear_makes.id\", ondelete=\"SET NULL\"),\n   195→        nullable=True,\n   196→    )\n   197→    thumbnail_url: Mapped[str | None] = mapped_column(String(500), nullable=True)\n   198→    is_public: Mapped[bool] = mapped_column(Boolean, nullable=False, default=True)\n   199→    source_id: Mapped[uuid.UUID | None] = mapped_column(\n   200→        Uuid,\n   201→        ForeignKey(\"gear_sources.id\", ondelete=\"SET NULL\"),\n   202→        nullable=True,\n   203→    )\n   204→\n   205→    # Relationships\n   206→    make: Mapped[\"GearMake | None\"] = relationship(\n   207→        \"GearMake\",\n   208→        back_populates=\"gear_items\",\n   209→    )\n   210→    source: Mapped[\"GearSource | None\"] = relationship(\n   211→        \"GearSource\",\n   212→        back_populates=\"gear\",\n   213→    )\n   214→    models: Mapped[list[\"GearModel\"]] = relationship(\n   215→        \"GearModel\",\n   216→        back_populates=\"gear\",\n   217→        cascade=\"all, delete-orphan\",\n   218→        lazy=\"selectin\",  # Eager load models\n   219→    )\n   220→    tags: Mapped[list[\"GearTag\"]] = relationship(\n   221→        \"GearTag\",\n   222→        secondary=gear_tags_table,\n   223→        back_populates=\"gear_items\",\n   224→        lazy=\"selectin\",  # Eager load tags\n   225→    )\n   226→\n   227→    # Indexes for common query patterns\n   228→    __table_args__ = (\n   229→        Index(\"ix_gear_type\", \"gear_type\"),\n   230→        Index(\"ix_gear_is_public\", \"is_public\"),\n   231→        Index(\"ix_gear_make_id\", \"make_id\"),\n   232→        Index(\"ix_gear_source_id\", \"source_id\"),\n   233→    )\n   234→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"ebefa784-877a-482f-a56c-83cdfc115341","uuid":"31e50eea-22f9-45ec-adb6-af2f36ec679f","tool_use_result":{"type":"text","file":{"filePath":"apps/webapp/src/webapp/adapters/persistence/models/gear.py","content":"\"\"\"Gear ORM models for persistence layer.\"\"\"\n\nimport uuid\nfrom datetime import datetime\n\nfrom sqlalchemy import Boolean, Column, DateTime, ForeignKey, Index, String, Table, Text, Uuid\nfrom sqlalchemy.orm import Mapped, mapped_column, relationship\n\nfrom core.domain.value_objects.download_status import DownloadStatus  # type: ignore[import-untyped]\nfrom core.domain.value_objects.signal_chain_enums import (  # type: ignore[import-untyped]\n    GearType,\n    ModelSize,\n    Platform,\n)\n\nfrom .base import Base, EnumByValue, TimestampMixin, UUIDMixin\n\n# Junction table for gear-tag many-to-many relationship\ngear_tags_table = Table(\n    \"gear_tags\",\n    Base.metadata,\n    Column(\"gear_id\", Uuid, ForeignKey(\"gear.id\", ondelete=\"CASCADE\"), primary_key=True),\n    Column(\"tag_id\", Uuid, ForeignKey(\"tags.id\", ondelete=\"CASCADE\"), primary_key=True),\n)\n\n\nclass GearTag(UUIDMixin, Base):\n    \"\"\"Tag model for categorizing gear.\n\n    Tags are shared across all gear items for consistent categorization.\n    Examples: \"metal\", \"high-gain\", \"blues\", \"clean\", etc.\n\n    Attributes:\n        id: Primary key (UUIDv7)\n        name: Tag name (unique, lowercase)\n        gear_items: List of gear with this tag\n    \"\"\"\n\n    __tablename__ = \"tags\"\n\n    name: Mapped[str] = mapped_column(String(50), unique=True, nullable=False)\n\n    # Relationship to gear (many-to-many)\n    gear_items: Mapped[list[\"Gear\"]] = relationship(\n        \"Gear\",\n        secondary=gear_tags_table,\n        back_populates=\"tags\",\n    )\n\n\nclass GearMake(UUIDMixin, Base):\n    \"\"\"Manufacturer/make model for gear.\n\n    Represents gear manufacturers (Fender, Marshall, etc.) for\n    consistent manufacturer names across gear items.\n\n    Attributes:\n        id: Primary key (UUIDv7)\n        name: Manufacturer name (unique)\n        gear_items: List of gear from this manufacturer\n    \"\"\"\n\n    __tablename__ = \"gear_makes\"\n\n    name: Mapped[str] = mapped_column(String(100), unique=True, nullable=False)\n\n    # Relationship to gear\n    gear_items: Mapped[list[\"Gear\"]] = relationship(\n        \"Gear\",\n        back_populates=\"make\",\n    )\n\n\nclass GearSource(UUIDMixin, TimestampMixin, Base):\n    \"\"\"Source tracking for gear data.\n\n    Tracks where gear came from (T3K, user upload, etc.) for sync\n    and attribution purposes.\n\n    Attributes:\n        id: Primary key (UUIDv7)\n        source_name: Name of source (e.g., 't3k', 'user_upload')\n        source_record_id: ID in the source system\n        source_updated_at: Last update time in source system\n        created_at: When source record was created\n        updated_at: When source record was last updated\n        gear: The gear item this source belongs to\n    \"\"\"\n\n    __tablename__ = \"gear_sources\"\n\n    source_name: Mapped[str] = mapped_column(String(50), nullable=False)\n    source_record_id: Mapped[str] = mapped_column(String(255), nullable=False)\n    source_updated_at: Mapped[datetime] = mapped_column(\n        DateTime(timezone=True),\n        nullable=False,\n    )\n\n    # Relationship to gear (one-to-one)\n    gear: Mapped[\"Gear\"] = relationship(\"Gear\", back_populates=\"source\", uselist=False)\n\n    # Composite index for source lookups\n    __table_args__ = (\n        Index(\"ix_gear_sources_source_lookup\", \"source_name\", \"source_record_id\"),\n    )\n\n\nclass GearModel(UUIDMixin, Base):\n    \"\"\"Downloadable model file for gear.\n\n    Represents a specific model file variant (platform, size) for a\n    piece of gear. A single gear item can have multiple model files.\n\n    Attributes:\n        id: Primary key (UUIDv7)\n        gear_id: Foreign key to gear table\n        platform: Target platform (NAM, AIDA-X, etc.)\n        size: Model size variant (standard, lite, etc.)\n        file_path: Local path to model file (if downloaded)\n        download_url: URL to download the model\n        download_status: Current download status\n        file_hash: SHA256 hash for integrity verification\n        gear: The gear item this model belongs to\n    \"\"\"\n\n    __tablename__ = \"gear_models\"\n\n    gear_id: Mapped[uuid.UUID] = mapped_column(\n        Uuid,\n        ForeignKey(\"gear.id\", ondelete=\"CASCADE\"),\n        nullable=False,\n    )\n    platform: Mapped[Platform] = mapped_column(\n        EnumByValue(Platform),\n        nullable=False,\n    )\n    size: Mapped[ModelSize] = mapped_column(\n        EnumByValue(ModelSize),\n        nullable=False,\n    )\n    file_path: Mapped[str | None] = mapped_column(String(500), nullable=True)\n    download_url: Mapped[str | None] = mapped_column(String(500), nullable=True)\n    download_status: Mapped[DownloadStatus] = mapped_column(\n        EnumByValue(DownloadStatus),\n        nullable=False,\n        default=DownloadStatus.PENDING,\n    )\n    file_hash: Mapped[str | None] = mapped_column(String(64), nullable=True)\n\n    # Relationship to gear\n    gear: Mapped[\"Gear\"] = relationship(\"Gear\", back_populates=\"models\")\n\n    # Indexes for common query patterns\n    __table_args__ = (\n        Index(\"ix_gearmodel_gear_id\", \"gear_id\"),\n        Index(\"ix_gearmodel_platform\", \"platform\"),\n    )\n\n\nclass Gear(UUIDMixin, TimestampMixin, Base):\n    \"\"\"Gear model representing amps, pedals, IRs, etc.\n\n    Domain aggregate root for gear. Unified representation from any source.\n\n    Attributes:\n        id: Primary key (UUIDv7)\n        name: Display name\n        gear_type: Type of gear (amp, pedal, ir, etc.)\n        description: Optional description\n        manufacturer: Manufacturer name (legacy field, prefer make_id)\n        make_id: Foreign key to gear_makes table\n        thumbnail_url: Preview image URL\n        is_public: Whether visible to all users\n        source_id: Foreign key to gear_sources table (optional)\n        created_at: When created in GTS\n        updated_at: When last updated in GTS\n        make: Manufacturer relationship\n        source: Source tracking relationship\n        models: List of downloadable model files\n        tags: List of tags for categorization\n    \"\"\"\n\n    __tablename__ = \"gear\"\n\n    name: Mapped[str] = mapped_column(String(255), nullable=False)\n    gear_type: Mapped[GearType] = mapped_column(\n        EnumByValue(GearType),\n        nullable=False,\n    )\n    description: Mapped[str | None] = mapped_column(Text, nullable=True)\n    manufacturer: Mapped[str | None] = mapped_column(String(100), nullable=True)\n    make_id: Mapped[uuid.UUID | None] = mapped_column(\n        Uuid,\n        ForeignKey(\"gear_makes.id\", ondelete=\"SET NULL\"),\n        nullable=True,\n    )\n    thumbnail_url: Mapped[str | None] = mapped_column(String(500), nullable=True)\n    is_public: Mapped[bool] = mapped_column(Boolean, nullable=False, default=True)\n    source_id: Mapped[uuid.UUID | None] = mapped_column(\n        Uuid,\n        ForeignKey(\"gear_sources.id\", ondelete=\"SET NULL\"),\n        nullable=True,\n    )\n\n    # Relationships\n    make: Mapped[\"GearMake | None\"] = relationship(\n        \"GearMake\",\n        back_populates=\"gear_items\",\n    )\n    source: Mapped[\"GearSource | None\"] = relationship(\n        \"GearSource\",\n        back_populates=\"gear\",\n    )\n    models: Mapped[list[\"GearModel\"]] = relationship(\n        \"GearModel\",\n        back_populates=\"gear\",\n        cascade=\"all, delete-orphan\",\n        lazy=\"selectin\",  # Eager load models\n    )\n    tags: Mapped[list[\"GearTag\"]] = relationship(\n        \"GearTag\",\n        secondary=gear_tags_table,\n        back_populates=\"gear_items\",\n        lazy=\"selectin\",  # Eager load tags\n    )\n\n    # Indexes for common query patterns\n    __table_args__ = (\n        Index(\"ix_gear_type\", \"gear_type\"),\n        Index(\"ix_gear_is_public\", \"is_public\"),\n        Index(\"ix_gear_make_id\", \"make_id\"),\n        Index(\"ix_gear_source_id\", \"source_id\"),\n    )\n","numLines":234,"startLine":1,"totalLines":234}}}
