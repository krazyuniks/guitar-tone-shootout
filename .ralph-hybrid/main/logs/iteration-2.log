ont-semibold\">\n                  4\n                </span>\n                <div>\n                  <strong class=\"text-[var(--color-text-primary)]\">Listen & Compare</strong>\n                  <p class=\"text-[var(--color-text-secondary)] mt-1\">\n                    Listen to the results side by side and decide which tone works best for you.\n                  </p>\n                </div>\n              </li>\n            </ol>\n          </section>\n\n          <section class=\"mb-12\">\n            <h2 class=\"text-2xl font-semibold text-[var(--color-text-primary)] mb-4\">\n              Technology\n            </h2>\n            <p class=\"text-[var(--color-text-secondary)] mb-4 leading-relaxed\">\n              GTS is built with modern web technologies and audio processing libraries:\n            </p>\n            <ul class=\"list-disc list-inside text-[var(--color-text-secondary)] space-y-2 ml-4\">\n              <li><strong class=\"text-[var(--color-text-primary)]\">Neural Amp Modeler (NAM)</strong> - High-quality amp simulation</li>\n              <li><strong class=\"text-[var(--color-text-primary)]\">Pedalboard</strong> - Audio effects processing</li>\n              <li><strong class=\"text-[var(--color-text-primary)]\">FastAPI</strong> - High-performance Python backend</li>\n              <li><strong class=\"text-[var(--color-text-primary)]\">Astro + HTMX</strong> - Fast, modern frontend</li>\n              <li><strong class=\"text-[var(--color-text-primary)]\">FFmpeg</strong> - Video generation and encoding</li>\n            </ul>\n          </section>\n\n          <section>\n            <h2 class=\"text-2xl font-semibold text-[var(--color-text-primary)] mb-4\">\n              Get Started\n            </h2>\n            <p class=\"text-[var(--color-text-secondary)] mb-6 leading-relaxed\">\n              Ready to find your perfect guitar tone? Sign up with your Tone3000 account to get started.\n            </p>\n            <a\n              href=\"