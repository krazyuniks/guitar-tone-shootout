{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MbMDmGCt6t9vNBRG18h5TB","type":"tool_result","content":"     1→\"\"\"Audio processor port definition for domain layer.\n     2→\n     3→Defines the interface for audio processing operations.\n     4→\"\"\"\n     5→\n     6→from pathlib import Path\n     7→from typing import Protocol\n     8→\n     9→from core.domain.value_objects.audio_result import AudioResult\n    10→from core.domain.value_objects.tone_config import ToneConfig\n    11→from core.domain.value_objects.waveform_data import WaveformData\n    12→\n    13→\n    14→class AudioProcessor(Protocol):\n    15→    \"\"\"Protocol for audio processing operations.\n    16→\n    17→    This port defines the interface that the domain layer expects\n    18→    from audio processing implementations. The actual implementation\n    19→    lives in libs/audio.\n    20→    \"\"\"\n    21→\n    22→    async def process_di_track(\n    23→        self,\n    24→        input_path: Path,\n    25→        output_path: Path,\n    26→        config: ToneConfig,\n    27→    ) -> AudioResult:\n    28→        \"\"\"Process a DI track through a tone configuration.\n    29→\n    30→        Args:\n    31→            input_path: Path to the input DI audio file\n    32→            output_path: Path for the processed output file\n    33→            config: Tone processing configuration\n    34→\n    35→        Returns:\n    36→            AudioResult with processing metadata\n    37→\n    38→        Raises:\n    39→            ProcessingError: If processing fails\n    40→        \"\"\"\n    41→        ...\n    42→\n    43→    async def extract_waveform(\n    44→        self,\n    45→        audio_path: Path,\n    46→        *,\n    47→        num_peaks: int = 200,\n    48→    ) -> WaveformData:\n    49→        \"\"\"Extract waveform visualization data from audio.\n    50→\n    51→        Args:\n    52→            audio_path: Path to the audio file\n    53→            num_peaks: Number of peak values to extract\n    54→\n    55→        Returns:\n    56→            WaveformData for visualization\n    57→        \"\"\"\n    58→        ...\n    59→\n    60→    async def measure_loudness(\n    61→        self,\n    62→        audio_path: Path,\n    63→    ) -> tuple[float, float]:\n    64→        \"\"\"Measure audio loudness.\n    65→\n    66→        Args:\n    67→            audio_path: Path to the audio file\n    68→\n    69→        Returns:\n    70→            Tuple of (integrated_lufs, peak_dbfs)\n    71→        \"\"\"\n    72→        ...\n    73→\n    74→    async def normalize_loudness(\n    75→        self,\n    76→        input_path: Path,\n    77→        output_path: Path,\n    78→        target_lufs: float = -14.0,\n    79→    ) -> AudioResult:\n    80→        \"\"\"Normalize audio to target loudness.\n    81→\n    82→        Args:\n    83→            input_path: Path to input audio file\n    84→            output_path: Path for output file\n    85→            target_lufs: Target loudness in LUFS\n    86→\n    87→        Returns:\n    88→            AudioResult with processing metadata\n    89→        \"\"\"\n    90→        ...\n    91→\n    92→    def get_supported_formats(self) -> list[str]:\n    93→        \"\"\"Get list of supported audio formats.\n    94→\n    95→        Returns:\n    96→            List of format extensions (e.g., ['wav', 'flac', 'mp3'])\n    97→        \"\"\"\n    98→        ...\n    99→\n   100→    def is_format_supported(self, format_ext: str) -> bool:\n   101→        \"\"\"Check if a format is supported.\n   102→\n   103→        Args:\n   104→            format_ext: Format extension (without dot)\n   105→\n   106→        Returns:\n   107→            True if supported, False otherwise\n   108→        \"\"\"\n   109→        ...\n   110→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it