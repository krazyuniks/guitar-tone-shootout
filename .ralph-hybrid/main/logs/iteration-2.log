# Load the state dict\n        model.load_state_dict(state_dict, strict=False)\n\n        # Set to evaluation mode\n        model.eval()\n\n        return model\n\n    except Exception as e:\n        raise NAMLoadError(f\"Failed to create NAM model: {e}\") from e\n","structuredPatch":[],"originalFile":null}}
