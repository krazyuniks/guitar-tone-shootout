_name)\n\n# add your model's MetaData object here\n# for 'autogenerate' support\ntarget_metadata = Base.metadata"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"cache_creation_input_tokens":375,"cache_read_input_tokens":90403,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":375},"output_tokens":8,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"a6b3d9c8-0123-4e43-8750-d4c1aafae23a","uuid":"2c9f4772-7b91-48a8-a21c-4bb9e559c881"}
