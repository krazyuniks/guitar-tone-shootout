"worker\", \"scheduler\"]\ninclude_external_packages = true\n\n# Core has zero dependencies on other packages\n[[tool.importlinter.contracts]]\nname = \"core-isolation\"\ntype = \"forbidden\"\nsource_modules = [\"core\"]\nforbidden_modules = [\"audio\", \"source_t3k\", \"webapp\", \"worker\", \"scheduler\"]\n\n# Core must not import any framework libraries\n[[tool.importlinter.contracts]]\nname = \"core-no-frameworks\"\ntype = \"forbidden\"\nsource_modules = [\"core\"]\nforbidden_modules = [\n    \"sqlalchemy\",\n    \"fastapi\",\n    \"starlette\",\n    \"pydantic\",\n    \"redis\",\n    \"taskiq\",\n    \"httpx\",\n    \"pedalboard\",\n    \"torch\",\n]\n\n# Audio can only depend on core\n[[tool.importlinter.contracts]]\nname = \"audio-dependencies\"\ntype = \"forbidden\"\nsource_modules = [\"audio\"]\nforbidden_modules = [\"source_t3k\", \"webapp\", \"worker\", \"scheduler\"]\n\n# Source adapters can only depend on core\n[[tool.importlinter.contracts]]\nname = \"source-dependencies\"\ntype = \"forbidden\"\nsource_modules = [\"source_t3k\"]\nforbidden_modules = [\"audio\", \"webapp\", \"worker\", \"scheduler\"]\n\n# Webapp cannot depend on sources (worker is the bridge)\n[[tool.importlinter.contracts]]\nname = \"webapp-no-sources\"\ntype = \"forbidden\"\nsource_modules = [\"webapp\"]\nforbidden_modules = [\"source_t3k\"]\n\n# Worker cannot depend on sources directly (uses pgmq messages)\n[[tool.importlinter.contracts]]\nname = \"worker-no-sources\"\ntype = \"forbidden\"\nsource_modules = [\"worker\"]\nforbidden_modules = [\"source_t3k\"]\n\n# Scheduler can only depend on core\n[[tool.importlinter.contracts]]\nname = \"scheduler-dependencies\"\ntype = \"forbidden\"\nsource_modules = [\"scheduler\"]\nforbidden_modules = [\"audio\", \"source_t3k\", \"webapp\", \"worker\"]\n\n# =============================================================================\n# Ruff Configuration\n# =============================================================================\n\n[tool.ruff]\ntarget-version = \"py312\"\nline-length = 100\n\n[tool.ruff.lint]\nselect = [\n    \"E\",      # pycodestyle errors\n    \"W\",      # pycodestyle warnings\n    \"F\",      # Pyflakes\n    \"I\",      # isort\n    \"B\",      # flake8-bugbear\n    \"C4\",     # flake8-comprehensions\n    \"UP\",     # pyupgrade\n    \"ARG\",    # flake8-unused-arguments\n    \"SIM\",    # flake8-simplify\n    \"TCH\",    # flake8-type-checking\n    \"PTH\",    # flake8-use-pathlib\n    \"RUF\",    # Ruff-specific rules\n]\nignore = [\n    \"E501\",   # line too long (handled by formatter)\n    \"B008\",   # do not perform function calls in argument defaults (FastAPI Depends)\n    \"B904\",   # raise from err (too noisy)\n    \"ARG001\", # unused function argument (common in protocols/interfaces)\n]\n\n[tool.ruff.lint.isort]\nknown-first-party = [\"core\", \"audio\", \"source_t3k\", \"webapp\", \"worker\", \"scheduler\"]\n\n[tool.ruff.lint.per-file-ignores]\n\"tests/**/*.py\" = [\"ARG001\", \"ARG002\"]\n\"apps/webapp/src/webapp/adapters/persistence/models/job.py\" = [\"TC003\"]\n\"apps/webapp/src/webapp/adapters/persistence/models/shootout.py\" = [\"TC003\"]\n\"apps/webapp/src/webapp/adapters/persistence/models/signal_chain.py\" = [\"TC003\"]\n\"apps/webapp/src/webapp/adapters/persistence/models/user.py\" = [\"TC003\"]\n\"apps/webapp/src/webapp/adapters/persistence/unit_of_work.py\" = [\"TC002\"]\n\"tests/unit/webapp/test_job_model.py\" = [\"TC003\"]\n\"infrastructure/migrations/**/*.py\" = [\"E501\", \"F401\", \"E402\", \"F811\", \"F821\"]\n\n# =============================================================================\n# MyPy Configuration\n# =============================================================================\n\n[tool.mypy]\npython_version = \"3.12\"\nstrict = true\nwarn_return_any = true\nwarn_unused_configs = true\ndisallow_untyped_defs = true\ndisallow_incomplete_defs = true\ncheck_untyped_defs = true\ndisallow_untyped_decorators = true\nno_implicit_optional = true\nwarn_redundant_casts = true\nwarn_unused_ignores = true\n\n[[tool.mypy.overrides]]\nmodule = [\n    \"pedalboard.*\",\n    \"nam.*\",\n    \"pyloudnorm.*\",\n    \"torch.*\",\n    \"taskiq.*\",\n    \"pgmq.*\",\n    \"soundfile.*\",\n    \"scipy.*\",\n]\nignore_missing_imports = true\n\n# =============================================================================\n# Pytest Configuration\n# =============================================================================\n\n[tool.pytest.ini_options]\nasyncio_mode = \"auto\"\nasyncio_default_fixture_loop_scope = \"function\"\ntestpaths = [\"tests\"]\naddopts = [\n    \"-ra\",\n    \"-q\",\n    \"--strict-markers\",\n]\nmarkers = [\n    \"slow: marks tests as slow\",\n    \"integration: marks tests as integration tests\",\n    \"e2e: marks tests as end-to-end tests\",\n    \"smoke: marks tests as smoke tests\",\n]\nfilterwarnings = [\n    \"ignore::DeprecationWarning\",\n]\n\n[tool.coverage.run]\nsource = [\"libs\", \"sources\", \"apps\"]\nbranch = true\nomit = [\"*/tests/*\", \"*/__pycache__/*\"]\n\n[tool.coverage.report]\nexclude_lines = [\n    \"pragma: no cover\",\n    \"def __repr__\",\n    \"raise NotImplementedError\",\n    \"if TYPE_CHECKING:\",\n    \"if __name__ == .__main__.:\",\n    \"@abstractmethod\",\n    \"@abc.abstractmethod\",\n]\n","structuredPatch":[{"oldStart":152,"oldLines":6,"newStart":152,"newLines":9,"lines":[" no_implicit_optional = true"," warn_redundant_casts = true"," warn_unused_ignores = true","+exclude = [","+    \"infrastructure/migrations/\",","+]"," "," [[tool.mypy.overrides]]"," module = ["]}],"userModified":false,"replaceAll":false}}
