{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WCcUKLTx96ayVUpocBLnnX","type":"tool_result","content":"     1→\"\"\"Signal chain domain enums for value objects.\n     2→\n     3→These enums define the valid values for signal chain composition:\n     4→- Platform: Target platform (NAM, AIDA-X, IR, AA_SNAPSHOT, PROTEUS)\n     5→- GearType: Type of gear in the signal chain\n     6→- EffectCategory: Category of effect for placement rules\n     7→- ModelSize: NAM model size variants\n     8→- BlockPosition: Position in signal chain (pre/post amp)\n     9→\"\"\"\n    10→\n    11→from enum import Enum\n    12→\n    13→\n    14→class Platform(str, Enum):\n    15→    \"\"\"Target platform for signal chain processing.\n    16→\n    17→    Supports multiple modelling platforms with different characteristics.\n    18→    \"\"\"\n    19→\n    20→    NAM = \"nam\"  # Neural Amp Modeler\n    21→    AIDA_X = \"aida_x\"  # AIDA-X neural models\n    22→    IR = \"ir\"  # Impulse Response only (cab sim)\n    23→    AA_SNAPSHOT = \"aa_snapshot\"  # Axe-FX/Helix snapshots\n    24→    PROTEUS = \"proteus\"  # Proteus Tone Capture\n    25→\n    26→\n    27→class GearType(str, Enum):\n    28→    \"\"\"Type of gear represented by a signal chain block.\n    29→\n    30→    Signal chain grammar rules depend on gear type:\n    31→    - PEDAL: Pre-amp effect (overdrive, distortion, fuzz, wah, etc.)\n    32→    - AMP: Amp head capture, requires IR after\n    33→    - FULL_RIG: Full rig capture with baked-in IR, no IR allowed after\n    34→    - IR: Impulse response, required after AMP only\n    35→    - POST_EFFECT: Post-amp effect (delay, reverb, chorus, etc.)\n    36→    - OUTBOARD: External rack gear (studio outboard, preamps, EQs, etc.)\n    37→    \"\"\"\n    38→\n    39→    PEDAL = \"pedal\"\n    40→    AMP = \"amp\"\n    41→    FULL_RIG = \"full_rig\"\n    42→    IR = \"ir\"\n    43→    POST_EFFECT = \"post_effect\"\n    44→    OUTBOARD = \"outboard\"\n    45→\n    46→\n    47→class EffectCategory(str, Enum):\n    48→    \"\"\"Category of effect for determining valid placement positions.\n    49→\n    50→    Effect placement rules:\n    51→    - PRE_ONLY: Before amp only (overdrive, distortion, fuzz, wah, compressor)\n    52→    - POST_ONLY: After amp/cab only (delay, reverb)\n    53→    - PRE_OR_POST: Either before or after amp (EQ, modulation, noise gate)\n    54→    \"\"\"\n    55→\n    56→    PRE_ONLY = \"pre_only\"\n    57→    POST_ONLY = \"post_only\"\n    58→    PRE_OR_POST = \"pre_or_post\"\n    59→\n    60→\n    61→# Mapping of effect tags/types to their category\n    62→# Used by guidance to determine valid positions for effects\n    63→EFFECT_PLACEMENT_RULES: dict[str, EffectCategory] = {\n    64→    # Pre-amp only effects (gain-based)\n    65→    \"overdrive\": EffectCategory.PRE_ONLY,\n    66→    \"distortion\": EffectCategory.PRE_ONLY,\n    67→    \"fuzz\": EffectCategory.PRE_ONLY,\n    68→    \"wah\": EffectCategory.PRE_ONLY,\n    69→    \"compressor\": EffectCategory.PRE_ONLY,\n    70→    \"boost\": EffectCategory.PRE_ONLY,\n    71→    \"preamp\": EffectCategory.PRE_ONLY,\n    72→    # Post-amp only effects (time/ambient-based)\n    73→    \"delay\": EffectCategory.POST_ONLY,\n    74→    \"reverb\": EffectCategory.POST_ONLY,\n    75→    # Effects that can go either place\n    76→    \"eq\": EffectCategory.PRE_OR_POST,\n    77→    \"equalizer\": EffectCategory.PRE_OR_POST,\n    78→    \"chorus\": EffectCategory.PRE_OR_POST,\n    79→    \"flanger\": EffectCategory.PRE_OR_POST,\n    80→    \"phaser\": EffectCategory.PRE_OR_POST,\n    81→    \"tremolo\": EffectCategory.PRE_OR_POST,\n    82→    \"vibrato\": EffectCategory.PRE_OR_POST,\n    83→    \"noise gate\": EffectCategory.PRE_OR_POST,\n    84→    \"noise_gate\": EffectCategory.PRE_OR_POST,\n    85→    \"noisegate\": EffectCategory.PRE_OR_POST,\n    86→    \"gate\": EffectCategory.PRE_OR_POST,\n    87→    \"modulation\": EffectCategory.PRE_OR_POST,\n    88→}\n    89→\n    90→\n    91→def get_effect_category(effect_tags: list[str]) -> EffectCategory:\n    92→    \"\"\"Determine the effect category from tags.\n    93→\n    94→    Args:\n    95→        effect_tags: List of tag names from the effect/pedal\n    96→\n    97→    Returns:\n    98→        The effect category for placement rules.\n    99→        Defaults to PRE_OR_POST if no matching tags found.\n   100→    \"\"\"\n   101→    for tag in effect_tags:\n   102→        tag_lower = tag.lower()\n   103→        if tag_lower in EFFECT_PLACEMENT_RULES:\n   104→            return EFFECT_PLACEMENT_RULES[tag_lower]\n   105→    # Default to pre_or_post if no specific rule matches\n   106→    return EffectCategory.PRE_OR_POST\n   107→\n   108→\n   109→class ModelSize(str, Enum):\n   110→    \"\"\"NAM model size variants.\n   111→\n   112→    Different sizes trade off between accuracy and CPU usage:\n   113→    - STANDARD: Full accuracy, highest CPU\n   114→    - LITE: Good accuracy, moderate CPU\n   115→    - FEATHER: Reduced accuracy, lower CPU\n   116→    - NANO: Minimal accuracy, lowest CPU\n   117→    \"\"\"\n   118→\n   119→    STANDARD = \"standard\"\n   120→    LITE = \"lite\"\n   121→    FEATHER = \"feather\"\n   122→    NANO = \"nano\"\n   123→\n   124→\n   125→class BlockPosition(str, Enum):\n   126→    \"\"\"Position of a block in the signal chain.\n   127→\n   128→    Used to track whether a block is in the pre-amp or post-amp section.\n   129→    \"\"\"\n   130→\n   131→    PRE_AMP = \"pre_amp\"\n   132→    AMP = \"amp\"\n   133→    POST_AMP = \"post_amp\"\n   134→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"6a122b68-c4ec-42c9-816a-34349f480631","uuid":"f877ef7a-c757-419d-b82d-097b55918635","tool_use_result":{"type":"text","file":{"filePath":"libs/core/src/core/domain/value_objects/signal_chain_enums.py","content":"\"\"\"Signal chain domain enums for value objects.\n\nThese enums define the valid values for signal chain composition:\n- Platform: Target platform (NAM, AIDA-X, IR, AA_SNAPSHOT, PROTEUS)\n- GearType: Type of gear in the signal chain\n- EffectCategory: Category of effect for placement rules\n- ModelSize: NAM model size variants\n- BlockPosition: Position in signal chain (pre/post amp)\n\"\"\"\n\nfrom enum import Enum\n\n\nclass Platform(str, Enum):\n    \"\"\"Target platform for signal chain processing.\n\n    Supports multiple modelling platforms with different characteristics.\n    \"\"\"\n\n    NAM = \"nam\"  # Neural Amp Modeler\n    AIDA_X = \"aida_x\"  # AIDA-X neural models\n    IR = \"ir\"  # Impulse Response only (cab sim)\n    AA_SNAPSHOT = \"aa_snapshot\"  # Axe-FX/Helix snapshots\n    PROTEUS = \"proteus\"  # Proteus Tone Capture\n\n\nclass GearType(str, Enum):\n    \"\"\"Type of gear represented by a signal chain block.\n\n    Signal chain grammar rules depend on gear type:\n    - PEDAL: Pre-amp effect (overdrive, distortion, fuzz, wah, etc.)\n    - AMP: Amp head capture, requires IR after\n    - FULL_RIG: Full rig capture with baked-in IR, no IR allowed after\n    - IR: Impulse response, required after AMP only\n    - POST_EFFECT: Post-amp effect (delay, reverb, chorus, etc.)\n    - OUTBOARD: External rack gear (studio outboard, preamps, EQs, etc.)\n    \"\"\"\n\n    PEDAL = \"pedal\"\n    AMP = \"amp\"\n    FULL_RIG = \"full_rig\"\n    IR = \"ir\"\n    POST_EFFECT = \"post_effect\"\n    OUTBOARD = \"outboard\"\n\n\nclass EffectCategory(str, Enum):\n    \"\"\"Category of effect for determining valid placement positions.\n\n    Effect placement rules:\n    - PRE_ONLY: Before amp only (overdrive, distortion, fuzz, wah, compressor)\n    - POST_ONLY: After amp/cab only (delay, reverb)\n    - PRE_OR_POST: Either before or after amp (EQ, modulation, noise gate)\n    \"\"\"\n\n    PRE_ONLY = \"pre_only\"\n    POST_ONLY = \"post_only\"\n    PRE_OR_POST = \"pre_or_post\"\n\n\n# Mapping of effect tags/types to their category\n# Used by guidance to determine valid positions for effects\nEFFECT_PLACEMENT_RULES: dict[str, EffectCategory] = {\n    # Pre-amp only effects (gain-based)\n    \"overdrive\": EffectCategory.PRE_ONLY,\n    \"distortion\": EffectCategory.PRE_ONLY,\n    \"fuzz\": EffectCategory.PRE_ONLY,\n    \"wah\": EffectCategory.PRE_ONLY,\n    \"compressor\": EffectCategory.PRE_ONLY,\n    \"boost\": EffectCategory.PRE_ONLY,\n    \"preamp\": EffectCategory.PRE_ONLY,\n    # Post-amp only effects (time/ambient-based)\n    \"delay\": EffectCategory.POST_ONLY,\n    \"reverb\": EffectCategory.POST_ONLY,\n    # Effects that can go either place\n    \"eq\": EffectCategory.PRE_OR_POST,\n    \"equalizer\": EffectCategory.PRE_OR_POST,\n    \"chorus\": EffectCategory.PRE_OR_POST,\n    \"flanger\": EffectCategory.PRE_OR_POST,\n    \"phaser\": EffectCategory.PRE_OR_POST,\n    \"tremolo\": EffectCategory.PRE_OR_POST,\n    \"vibrato\": EffectCategory.PRE_OR_POST,\n    \"noise gate\": EffectCategory.PRE_OR_POST,\n    \"noise_gate\": EffectCategory.PRE_OR_POST,\n    \"noisegate\": EffectCategory.PRE_OR_POST,\n    \"gate\": EffectCategory.PRE_OR_POST,\n    \"modulation\": EffectCategory.PRE_OR_POST,\n}\n\n\ndef get_effect_category(effect_tags: list[str]) -> EffectCategory:\n    \"\"\"Determine the effect category from tags.\n\n    Args:\n        effect_tags: List of tag names from the effect/pedal\n\n    Returns:\n        The effect category for placement rules.\n        Defaults to PRE_OR_POST if no matching tags found.\n    \"\"\"\n    for tag in effect_tags:\n        tag_lower = tag.lower()\n        if tag_lower in EFFECT_PLACEMENT_RULES:\n            return EFFECT_PLACEMENT_RULES[tag_lower]\n    # Default to pre_or_post if no specific rule matches\n    return EffectCategory.PRE_OR_POST\n\n\nclass ModelSize(str, Enum):\n    \"\"\"NAM model size variants.\n\n    Different sizes trade off between accuracy and CPU usage:\n    - STANDARD: Full accuracy, highest CPU\n    - LITE: Good accuracy, moderate CPU\n    - FEATHER: Reduced accuracy, lower CPU\n    - NANO: Minimal accuracy, lowest CPU\n    \"\"\"\n\n    STANDARD = \"standard\"\n    LITE = \"lite\"\n    FEATHER = \"feather\"\n    NANO = \"nano\"\n\n\nclass BlockPosition(str, Enum):\n    \"\"\"Position of a block in the signal chain.\n\n    Used to track whether a block is in the pre-amp or post-amp section.\n    \"\"\"\n\n    PRE_AMP = \"pre_amp\"\n    AMP = \"amp\"\n    POST_AMP = \"post_amp\"\n","numLines":134,"startLine":1,"totalLines":134}}}
