{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019faKAkrTtn26Uin3KxdBq3","type":"tool_result","content":"     1→\"\"\"Repository port definitions for domain layer.\n     2→\n     3→These protocols define the interface that the domain layer expects\n     4→from persistence implementations. Infrastructure adapters implement\n     5→these protocols to provide actual storage.\n     6→\n     7→Note: T3K-specific repositories are NOT in core. They belong in\n     8→sources/t3k. Core only has unified Gear repository.\n     9→\"\"\"\n    10→\n    11→from typing import Protocol\n    12→from uuid import UUID\n    13→\n    14→from core.domain.entities.di_track import DITrack\n    15→from core.domain.entities.gear import Gear\n    16→from core.domain.entities.job import Job\n    17→from core.domain.entities.shootout import Shootout\n    18→from core.domain.entities.signal_chain import SignalChain\n    19→from core.domain.entities.signal_chain_group import SignalChainGroup\n    20→from core.domain.entities.user import User\n    21→from core.domain.value_objects.job_status import JobStatus, JobType\n    22→from core.domain.value_objects.signal_chain_enums import GearType\n    23→\n    24→\n    25→class UserRepository(Protocol):\n    26→    \"\"\"Protocol for user persistence operations.\"\"\"\n    27→\n    28→    async def get_by_id(self, user_id: UUID) -> User | None:\n    29→        \"\"\"Get a user by their ID.\n    30→\n    31→        Args:\n    32→            user_id: The user's UUID\n    33→\n    34→        Returns:\n    35→            The User if found, None otherwise\n    36→        \"\"\"\n    37→        ...\n    38→\n    39→    async def get_by_identity(\n    40→        self,\n    41→        provider: str,\n    42→        external_id: str,\n    43→    ) -> User | None:\n    44→        \"\"\"Get a user by an external identity.\n    45→\n    46→        Args:\n    47→            provider: The identity provider name\n    48→            external_id: The ID from the external provider\n    49→\n    50→        Returns:\n    51→            The User if found, None otherwise\n    52→        \"\"\"\n    53→        ...\n    54→\n    55→    async def get_by_email(self, email: str) -> User | None:\n    56→        \"\"\"Get a user by email address.\n    57→\n    58→        Args:\n    59→            email: The email address\n    60→\n    61→        Returns:\n    62→            The User if found, None otherwise\n    63→        \"\"\"\n    64→        ...\n    65→\n    66→    async def save(self, user: User) -> None:\n    67→        \"\"\"Save a user (create or update).\n    68→\n    69→        Args:\n    70→            user: The user to save\n    71→        \"\"\"\n    72→        ...\n    73→\n    74→    async def delete(self, user_id: UUID) -> None:\n    75→        \"\"\"Delete a user by ID.\n    76→\n    77→        Args:\n    78→            user_id: The user's UUID\n    79→        \"\"\"\n    80→        ...\n    81→\n    82→\n    83→class GearRepository(Protocol):\n    84→    \"\"\"Protocol for unified gear persistence operations.\n    85→\n    86→    This is the core domain's view of gear, abstracting away\n    87→    source-specific details (T3K, user uploads, etc.)\n    88→    \"\"\"\n    89→\n    90→    async def get_by_id(self, gear_id: UUID) -> Gear | None:\n    91→        \"\"\"Get gear by its internal ID.\n    92→\n    93→        Args:\n    94→            gear_id: The gear's UUID\n    95→\n    96→        Returns:\n    97→            The Gear if found, None otherwise\n    98→        \"\"\"\n    99→        ...\n   100→\n   101→    async def get_by_source(\n   102→        self,\n   103→        source_name: str,\n   104→        source_record_id: str,\n   105→    ) -> Gear | None:\n   106→        \"\"\"Get gear by its source identifier.\n   107→\n   108→        Args:\n   109→            source_name: Name of the source (e.g., 't3k')\n   110→            source_record_id: ID in the source system\n   111→\n   112→        Returns:\n   113→            The Gear if found, None otherwise\n   114→        \"\"\"\n   115→        ...\n   116→\n   117→    async def search(\n   118→        self,\n   119→        *,\n   120→        query: str | None = None,\n   121→        gear_type: GearType | None = None,\n   122→        manufacturer: str | None = None,\n   123→        tags: list[str] | None = None,\n   124→        limit: int = 50,\n   125→        offset: int = 0,\n   126→    ) -> list[Gear]:\n   127→        \"\"\"Search for gear with filters.\n   128→\n   129→        Args:\n   130→            query: Optional text search on name/description\n   131→            gear_type: Optional filter by gear type\n   132→            manufacturer: Optional filter by manufacturer\n   133→            tags: Optional filter by tags (AND logic)\n   134→            limit: Maximum number of results\n   135→            offset: Number of results to skip\n   136→\n   137→        Returns:\n   138→            List of matching Gear ordered by name\n   139→        \"\"\"\n   140→        ...\n   141→\n   142→    async def count(\n   143→        self,\n   144→        *,\n   145→        query: str | None = None,\n   146→        gear_type: GearType | None = None,\n   147→        manufacturer: str | None = None,\n   148→        tags: list[str] | None = None,\n   149→    ) -> int:\n   150→        \"\"\"Count gear matching filters.\n   151→\n   152→        Args:\n   153→            query: Optional text search\n   154→            gear_type: Optional filter by gear type\n   155→            manufacturer: Optional filter by manufacturer\n   156→            tags: Optional filter by tags\n   157→\n   158→        Returns:\n   159→            Count of matching gear\n   160→        \"\"\"\n   161→        ...\n   162→\n   163→    async def save(self, gear: Gear) -> None:\n   164→        \"\"\"Save gear (create or update).\n   165→\n   166→        Args:\n   167→            gear: The gear to save\n   168→        \"\"\"\n   169→        ...\n   170→\n   171→    async def delete(self, gear_id: UUID) -> None:\n   172→        \"\"\"Delete gear by ID.\n   173→\n   174→        Args:\n   175→            gear_id: The gear's UUID\n   176→        \"\"\"\n   177→        ...\n   178→\n   179→\n   180→class DITrackRepository(Protocol):\n   181→    \"\"\"Protocol for DI track persistence operations.\"\"\"\n   182→\n   183→    async def get_by_id(self, track_id: UUID) -> DITrack | None:\n   184→        \"\"\"Get a DI track by its ID.\n   185→\n   186→        Args:\n   187→            track_id: The track's UUID\n   188→\n   189→        Returns:\n   190→            The DITrack if found, None otherwise\n   191→        \"\"\"\n   192→        ...\n   193→\n   194→    async def get_by_user_id(\n   195→        self,\n   196→        user_id: UUID,\n   197→        *,\n   198→        limit: int = 50,\n   199→        offset: int = 0,\n   200→    ) -> list[DITrack]:\n   201→        \"\"\"Get DI tracks for a user.\n   202→\n   203→        Args:\n   204→            user_id: The owner's UUID\n   205→            limit: Maximum number of results\n   206→            offset: Number of results to skip\n   207→\n   208→        Returns:\n   209→            List of DITracks ordered by created_at desc\n   210→        \"\"\"\n   211→        ...\n   212→\n   213→    async def count_by_user_id(self, user_id: UUID) -> int:\n   214→        \"\"\"Count DI tracks for a user.\n   215→\n   216→        Args:\n   217→            user_id: The owner's UUID\n   218→\n   219→        Returns:\n   220→            Count of tracks\n   221→        \"\"\"\n   222→        ...\n   223→\n   224→    async def save(self, track: DITrack) -> None:\n   225→        \"\"\"Save a DI track (create or update).\n   226→\n   227→        Args:\n   228→            track: The track to save\n   229→        \"\"\"\n   230→        ...\n   231→\n   232→    async def delete(self, track_id: UUID) -> None:\n   233→        \"\"\"Delete a DI track by ID.\n   234→\n   235→        Args:\n  