      select(Gear)\n    55→            .where(Gear.id == gear_id)\n    56→            .options(\n    57→                selectinload(Gear.models),\n    58→                selectinload(Gear.tags),\n    59→                selectinload(Gear.source),\n    60→                selectinload(Gear.make),\n    61→            )\n    62→        )\n    63→        result = await self.session.execute(stmt)\n    64→        gear = result.scalar_one_or_none()\n    65→        return self._to_entity(gear) if gear else None\n    66→\n    67→    async def get_by_source(\n    68→        self,\n    69→        source_name: str,\n    70→        source_record_id: str,\n    71→    ) -> GearEntity | None:\n    72→        \"\"\"Get gear by its source identifier.\n    73→\n    74→        Args:\n    75→            source_name: Name of the source (e.g., 't3k')\n    76→            source_record_id: ID in the source system\n    77→\n    78→        Returns:\n    79→            The Gear entity if found, None otherwise\n    80→        \"\"\"\n    81→        stmt = (\n    82→            select(Gear)\n    83→            .join(GearSource, Gear.source_id == GearSource.id)\n    84→            .where(\n    85→                GearSource.source_name == source_name,\n    86→                GearSource.source_record_id == source_record_id,\n    87→            )\n    88→            .options(\n    89→                selectinload(Gear.models),\n    90→                selectinload(Gear.tags),\n    91→                selectinload(Gear.source),\n    92→                selectinload(Gear.make),\n    93→            )\n    94→        )\n    95→        result = await self.session.execute(stmt)\n    96→        gear = result.scalar_one_or_none()\n    97→        return self._to_entity(gear) if gear else None\n    98→\n    99→    async def search(\n   100→        self,\n   101→        *,\n   102→        query: str | None = None,\n   103→        gear_type: GearType | None = None,\n   104→        manufacturer: str | None = None,\n   105→        tags: list[str] | None = None,\n   106→        limit: int = 50,\n   107→        offset: int = 0,\n   108→    ) -> list[GearEntity]:\n   109→        \"\"\"Search for gear with filters.\n   110→\n   111→        Args:\n   112→            query: Optional text search on name/description\n   113→            gear_type: Optional filter by gear type\n   114→            manufacturer: Optional filter by manufacturer\n   115→            tags: Optional filter by tags (AND logic)\n   116→            limit: Maximum number of results\n   117→            offset: Number of results to skip\n   118→\n   119→        Returns:\n   120→            List of matching Gear ordered by name\n   121→        \"\"\"\n   122→        stmt = select(Gear).options(\n   123→            selectinload(Gear.models),\n   124→            selectinload(Gear.tags),\n   125→            selectinload(Gear.source),\n   126→            selectinload(Gear.make),\n   127→        )\n   128→\n   129→        # Apply filters\n   130→        conditions = []\n   131→\n   132→        if query:\n   133→            search_pattern = f\"%{query}%\"\n   134→            conditions.append(\n   135→                or_(\n   136→                    Gear.name.ilike(search_pattern),\n   137→                    Gear.description.ilike(search_pattern),\n   138→                )\n   139→            )\n   140→\n   141→        if gear_type:\n   142→            conditions.append(Gear.gear_type == gear_type)\n   143→\n   144→        if manufacturer:\n   145→            conditions.append(Gear.manufacturer == manufacturer)\n   146→\n   147→        if tags:\n   148→            # AND logic for tags - gear must have all specified tags\n   149→            # Subquery approach: count how many of the requested tags each gear has\n   150→            tag_count = (\n   151→                select(gear_tags_table.c.gear_id)\n   152→                .join(GearTag, gear_tags_table.c.tag_id == GearTag.id)\n   153→                .where(GearTag.name.in_(tags))\n   154→                .group_by(gear_tags_table.c.gear_id)\n   155→                .having(func.count(gear_tags_table.c.tag_id) == len(tags))\n   156→            )\n   157→            conditions.append(Gear.id.in_(tag_count))\n   158→\n   159→        if conditions:\n   160→            stmt = stmt.where(and_(*conditions))\n   161→\n   162→        # Order by name and apply pagination\n   163→        stmt = stmt.order_by(Gear.name).limit(limit).offset(offset)\n   164→\n   165→        result = await self.session.execute(stmt)\n   166→        gear_items = result.scalars().unique().all()\n   167→\n   168→        return [self._to_entity(gear) for gear in gear_items]\n   169→\n   170→    async def count(\n   171→        self,\n   172→        *,\n   173→        query: str | None = None,\n   174→        gear_type: GearType | None = None,\n   175→        manufacturer: str | None = None,\n   176→        tags: list[str] | None = None,\n   177→    ) -> int:\n   178→        \"\"\"Count gear matching filters.\n   179→\n   180→        Args:\n   181→            query: Optional text search\n   182→            gear_type: Optional filter by gear type\n   183→            manufacturer: Optional filter by manufacturer\n   184→            tags: Optional filter by tags\n   185→\n   186→        Returns:\n   187→            Count of matching gear\n   188→        \"\"\"\n   189→        stmt = select(func.count(Gear.id))\n   190→\n   191→        # Apply filters\n   192→        conditions = []\n   193→\n   194→        if query:\n   195→            search_pattern = f\"%{query}%\"\n   196→            conditions.append(\n   197→                or_(\n   198→                    Gear.name.ilike(search_pattern),\n   199→                    Gear.description.ilike(search_pattern),\n   200→                )\n   201→            )\n   202→\n   203→        if gear_type:\n   204→            conditions.append(Gear.gear_type == gear_type)\n   205→\n   206→        if manufacturer:\n   207→            conditions.append(Gear.manufacturer == manufacturer)\n   208→\n   209→        if tags:\n   210→            # AND logic for tags - same subquery approach as search\n   211→            tag_count = (\n   212→                select(gear_tags_table.c.gear_id)\n   213→                .join(GearTag, gear_tags_table.c.tag_id == GearTag.id)\n   214→                .where(GearTag.name.in_(tags))\n   215→                .group_by(gear_tags_table.c.gear_id)\n   216→                .having(func.count(gear_tags_table.c.tag_id) == len(tags))\n   217→            )\n   218→            conditions.append(Gear.id.in_(tag_count))\n   219→\n   220→        if conditions:\n   221→            stmt = stmt.where(and_(*conditions))\n   222→\n   223→        result = await self.session.execute(stmt)\n   224→        return result.scalar_one()\n   225→\n   226→    async def save(self, gear: GearEntity) -> None:\n   227→        \"\"\"Save gear (create or update).\n   228→\n   229→        Args:\n   230→            gear: The gear entity to save\n   231→        \"\"\"\n   232→        # Check if gear exists\n   233→        existing = await self.session.get(Gear, gear.id)\n   234→\n   235→        if existing:\n   236→            # Update existing gear\n   237→            existing.name = gear.name\n   238→            existing.gear_type = gear.gear_type\n   239→            existing.description = gear.description\n   240→            existing.manufacturer = gear.manufacturer\n   241→            existing.thumbnail_url = gear.thumbnail_url\n   242→            existing.is_public = gear.is_public\n   243→            existing.updated_at = gear.updated_at\n   244→\n   245→            # Update source if present\n   246→            if gear.source:\n   247→                if existing.source:\n   248→                    existing.source.source_name = gear.source.source_name\n   249→                    existing.source.source_record_id = gear.source.source_record_id\n   250→                    existing.source.source_updated_at = gear.source.source_updated_at\n   251→                else:\n   252→                    new_source = GearSource(\n   253→                        source_name=gear.source.source_name,\n   254→                        source_record_id=gear.source.source_record_id,\n   255→                        source_updated_at=gear.source.source_updated_at,\n   256→                    )\n   257→                    self.session.add(new_source)\n   258→                    await self.session.flush()\n   259→                    existing.source_id = new_source.id\n   260→\n   261→            # Update tags\n   262→            await self._update_tags(existing, gear.tags)\n   263→\n   264→            # Update models\n   265→            await self._update_models(existing, gear.models)\n   266→        else:\n   267→            # Create new gear\n   268→            new_gear = Gear(\n   269→                id=gear.id,\n   270→                name=gear.name,\n   271→                gear_type=gear.gear_type,\n   272→                description=gear.description,\n   273→                manufacturer=gear.manufacturer,\n   274→                thumbnail_url=gear.thumbnail_url,\n   275→                is_public=gear.is_public,\n   276→                created_at=gear.created_at,\n   277→                updated_at=gear.updated_at,\n   278→            )\n   279→            self.session.add(new_gear)\n   280→            await self.session.flush()\n   281→\n   282→            # Add source if present\n   283→            if gear.source:\n   284→                new_source = GearSource(\n   285→                    source_name=gear.source.source_name,\n   286→                    source_record_id=gear.source.source_record_id,\n   287→                    source_updated_at=gear.source.source_updated_at,\n   288→                )\n   289→                self.session.add(new_source)\n   290→                await self.session.flush()\n   291→                new_gear.source_id = new_source.id\n   292→\n   293→            # Add tags\n   294→            await self._update_tags(new_gear, gear.tags)\n   295→\n   296→            # Add models\n   297→            for model_vo in gear.models:\n   298→                new_model = GearModel(\n   299→                    id=model_vo.id,\n   300→                    gear_id=new_gear.id,\n   301→                    platform=model_vo.platform,\n   302→                    size=model_vo.size,\n   303→                    file_path=model_vo.file_path,\n   304→                    download_url=model_vo.download_url,\n   305→                    download_status=model_vo.download_status,\n   306→                    file_hash=model_vo.file_hash,\n   307→                )\n   308→                self.session.add(new_model)\n   309→\n   310→        await self.session.flush()\n   311→\n   312→    async def delete(self, gear_id: UUID) -> None:\n   313→        \"\"\"Delete gear by ID.\n   314→\n   315→        Args:\n   316→            gear_id: The gear's UUID\n   317→        \"\"\"\n   318→        gear = await self.session.get(Gear, gear_id)\n   319→        if gear:\n   320→            await self.session.delete(gear)\n   321→            await self.session.flush()\n   322→\n   323→    async def _update_tags(self, gear: Gear, tag_names: list[str]) -> None:\n   324→        \"\"\"Update tags for a gear item.\n   325→\n   326→        Args:\n   327→            gear: The ORM Gear model\n   328→            tag_names: List of tag names\n   329→        \"\"\"\n   330→        # Delete existing tag associations\n   331→        delete_stmt = delete(gear_tags_table).where(\n   332→            gear_tags_table.c.gear_id == gear.id\n   333→        )\n   334→        await self.session.execute(delete_stmt)\n   335→\n   336→        # Get or create tags and add associations\n   337→        for tag_name in tag_names:\n   338→            stmt = select(GearTag).where(GearTag.name == tag_name.lower())\n   339→            result = await self.session.execute(stmt)\n   340→            tag = result.scalar_one_or_none()\n   341→\n   342→            if not tag:\n   343→                tag = GearTag(name=tag_name.lower())\n   344→                self.session.add(tag)\n   345→                await self.session.flush()\n   346→\n   347→            # Insert into junction table\n   348→            insert_stmt = gear_tags_table.insert().values(\n   349→                gear_id=gear.id,\n   350→                tag_id=tag.id,\n   351→            )\n   352→            await self.session.execute(insert_stmt)\n   353→\n   354→    async def _update_models(\n   355→        self,\n   356→        gear: Gear,\n   357→        model_vos: list[GearModelVO],\n   358→    ) -> None:\n   359→        \"\"\"Update models for a gear item.\n   360→\n   361→        Args:\n   362→            gear: The ORM Gear model\n   363→            model_vos: List of model value objects\n   364→        \"\"\"\n   365→        # Get existing model IDs\n   366→        existing_ids = {model.id for model in gear.models}\n   367→        new_ids = {model.id for model in model_vos}\n   368→\n   369→        # Delete removed models\n   370→        models_to_delete = [\n   371→            model for model in gear.models if model.id not in new_ids\n   372→        ]\n   373→        for model in models_to_delete:\n   374→            await self.session.delete(model)\n   375→\n   376→        # Update or create models\n   377→        for model_vo in model_vos:\n   378→            if model_vo.id in existing_ids:\n   379→                # Update existing model\n   380→                existing_model = next(\n   381→                    m for m in gear.models if m.id == model_vo.id\n   382→                )\n   383→                existing_model.platform = model_vo.platform\n   384→                existing_model.size = model_vo.size\n   385→                existing_model.file_path = model_vo.file_path\n   386→                existing_model.download_url = model_vo.download_url\n   387→                existing_model.download_status = model_vo.download_status\n   388→                existing_model.file_hash = model_vo.file_hash\n   389→            else:\n   390→                # Create new model\n   391→                new_model = GearModel(\n   392→                    id=model_vo.id,\n   393→                    gear_id=gear.id,\n   394→                    platform=model_vo.platform,\n   395→                    size=model_vo.size,\n   396→                    file_path=model_vo.file_path,\n   397→                    download_url=model_vo.download_url,\n   398→                    download_status=model_vo.download_status,\n   399→                    file_hash=model_vo.file_hash,\n   400→                )\n   401→                self.session.add(new_model)\n   402→\n   403→    def _to_entity(self, gear: Gear) -> GearEntity:\n   404→        \"\"\"Convert ORM Gear to domain GearEntity.\n   405→\n   406→        Args:\n   407→            gear: The ORM Gear model\n   408→\n   409→        Returns:\n   410→            The domain GearEntity\n   411→        \"\"\"\n   412→        # Convert source\n   413→        source = None\n   414→        if gear.source:\n   415→            source = GearSourceVO(\n   416→                source_name=gear.source.source_name,\n   417→                source_record_id=gear.source.source_record_id,\n   418→                source_updated_at=gear.source.source_updated_at,\n   419→            )\n   420→\n   421→        # Convert models\n   422→        models = [\n   423→            GearModelVO(\n   424→                id=model.id,\n   425→                platform=model.platform,\n   426→                size=model.size,\n   427→                file_path=model.file_path,\n   428→                download_url=model.download_url,\n   429→                download_status=model.download_status,\n   430→                file_hash=model.file_hash,\n   431→            )\n   432→            for model in gear.models\n   433→        ]\n   434→\n   435→        # Convert tags\n   436→        tags = [tag.name for tag in gear.tags]\n   437→\n   438→        return GearEntity(\n   439→            id=gear.id,\n   440→            name=gear.name,\n   441→            gear_type=gear.gear_type,\n   442→            description=gear.description,\n   443→            manufacturer=gear.manufacturer,\n   444→            tags=tags,\n   445→            source=source,\n   446→            models=models,\n   447→            thumbnail_url=gear.thumbnail_url,\n   448→            is_public=gear.is_public,\n   449→            created_at=gear.created_at,\n   450→            updated_at=gear.updated_at,\n   451→        )\n   452→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"50b63515-2767-4b73-ade9-cf678352b806","uuid":"fd2013b8-d2ec-4ac6-8f57-0fe02ae5c4fc","tool_use_result":{"type":"text","file":{"filePath":"apps/webapp/src/webapp/adapters/persistence/repositories/gear_repository.py","content":"\"\"\"SQLAlchemy implementation of GearRepository protocol.\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import TYPE_CHECKING\n\nfrom sqlalchemy import and_, delete, func, or_, select\nfrom sqlalchemy.orm import selectinload\n\nfrom core.domain.entities.gear import Gear as GearEntity\nfrom core.domain.entities.gear import GearModel as GearModelVO\nfrom core.domain.entities.gear import GearSource as GearSourceVO\nfrom webapp.adapters.persistence.models.gear import (\n    Gear,\n    GearModel,\n    GearSource,\n    GearTag,\n    gear_tags_table,\n)\n\nif TYPE_CHECKING:\n    from uuid import UUID\n\n    from sqlalchemy.ext.asyncio import AsyncSession\n\n    from core.domain.value_objects.signal_chain_enums import GearType\n\n\nclass SQLAlchemyGearRepository:\n    \"\"\"SQLAlchemy implementation of GearRepository protocol.\n\n    Maps between domain Gear entities and ORM Gear models, handling\n    models, tags, and source relationships.\n    \"\"\"\n\n    def __init__(self, session: AsyncSession) -> None:\n        \"\"\"Initialize the repository with an async session.\n\n        Args:\n            session: SQLAlchemy async session\n        \"\"\"\n        self.session = session\n\n    async def get_by_id(self, gear_id: UUID) -> GearEntity | None:\n        \"\"\"Get gear by its internal ID.\n\n        Args:\n            gear_id: The gear's UUID\n\n        Returns:\n            The Gear entity if found, None otherwise\n        \"\"\"\n        stmt = (\n            select(Gear)\n            .where(Gear.id == gear_id)\n            .options(\n                selectinload(Gear.models),\n                selectinload(Gear.tags),\n                selectinload(Gear.source),\n                selectinload(Gear.make),\n            )\n        )\n        result = await self.session.execute(stmt)\n        gear = result.scalar_one_or_none()\n        return self._to_entity(gear) if gear else None\n\n    async def get_by_source(\n        self,\n        source_name: str,\n        source_record_id: str,\n    ) -> GearEntity | None:\n        \"\"\"Get gear by its source identifier.\n\n        Args:\n            source_name: Name of the source (e.g., 't3k')\n            source_record_id: ID in the source system\n\n        Returns:\n            The Gear entity if found, None otherwise\n        \"\"\"\n        stmt = (\n            select(Gear)\n            .join(GearSource, Gear.source_id == GearSource.id)\n            .where(\n                GearSource.source_name == source_name,\n                GearSource.source_record_id == source_record_id,\n            )\n            .options(\n                selectinload(Gear.models),\n                selectinload(Gear.tags),\n                selectinload(Gear.source),\n                selectinload(Gear.make),\n            )\n        )\n        result = await self.session.execute(stmt)\n        gear = result.scalar_one_or_none()\n        return self._to_entity(gear) if gear else None\n\n    async def search(\n        self,\n        *,\n        query: str | None = None,\n        gear_type: GearType | None = None,\n        manufacturer: str | None = None,\n        tags: list[str] | None = None,\n        limit: int = 50,\n        offset: int = 0,\n    ) -> list[GearEntity]:\n        \"\"\"Search for gear with filters.\n\n        Args:\n            query: Optional text search on name/description\n            gear_type: Optional filter by gear type\n            manufacturer: Optional filter by manufacturer\n            tags: Optional filter by tags (AND logic)\n            limit: Maximum number of results\n            offset: Number of results to skip\n\n        Returns:\n            List of matching Gear ordered by name\n        \"\"\"\n        stmt = select(Gear).options(\n            selectinload(Gear.models),\n            selectinload(Gear.tags),\n            selectinload(Gear.source),\n            selectinload(Gear.make),\n        )\n\n        # Apply filters\n        conditions = []\n\n        if query:\n            search_pattern = f\"%{query}%\"\n            conditions.append(\n                or_(\n                    Gear.name.ilike(search_pattern),\n                    Gear.description.ilike(search_pattern),\n                )\n            )\n\n        if gear_type:\n            conditions.append(Gear.gear_type == gear_type)\n\n        if manufacturer:\n            conditions.append(Gear.manufacturer == manufacturer)\n\n        if tags:\n            # AND logic for tags - gear must have all specified tags\n            # Subquery approach: count how many of the requested tags each gear has\n            tag_count = (\n                select(gear_tags_table.c.gear_id)\n                .join(GearTag, gear_tags_table.c.tag_id == GearTag.id)\n                .where(GearTag.name.in_(tags))\n                .group_by(gear_tags_table.c.gear_id)\n                .having(func.count(gear_tags_table.c.tag_id) == len(tags))\n            )\n            conditions.append(Gear.id.in_(tag_count))\n\n        if conditions:\n            stmt = stmt.where(and_(*conditions))\n\n        # Order by name and apply pagination\n        stmt = stmt.order_by(Gear.name).limit(limit).offset(offset)\n\n        result = await self.session.execute(stmt)\n        gear_items = result.scalars().unique().all()\n\n        return [self._to_entity(gear) for gear in gear_items]\n\n    async def count(\n        self,\n        *,\n        query: str | None = None,\n        gear_type: GearType | None = None,\n        manufacturer: str | None = None,\n        tags: list[str] | None = None,\n    ) -> int:\n        \"\"\"Count gear matching filters.\n\n        Args:\n            query: Optional text search\n            gear_type: Optional filter by gear type\n            manufacturer: Optional filter by manufacturer\n            tags: Optional filter by tags\n\n        Returns:\n            Count of matching gear\n        \"\"\"\n        stmt = select(func.count(Gear.id))\n\n        # Apply filters\n        conditions = []\n\n        if query:\n            search_pattern = f\"%{query}%\"\n            conditions.append(\n                or_(\n                    Gear.name.ilike(search_pattern),\n                    Gear.description.ilike(search_pattern),\n                )\n            )\n\n        if gear_type:\n            conditions.append(Gear.gear_type == gear_type)\n\n        if manufacturer:\n            conditions.append(Gear.manufacturer == manufacturer)\n\n        if tags:\n            # AND logic for tags - same subquery approach as search\n            tag_count = (\n                select(gear_tags_table.c.gear_id)\n                .join(GearTag, gear_tags_table.c.tag_id == GearTag.id)\n                .where(GearTag.name.in_(tags))\n                .group_by(gear_tags_table.c.gear_id)\n                .having(func.count(gear_tags_table.c.tag_id) == len(tags))\n            )\n            conditions.append(Gear.id.in_(tag_count))\n\n        if conditions:\n            stmt = stmt.where(and_(*conditions))\n\n        result = await self.session.execute(stmt)\n        return result.scalar_one()\n\n    async def save(self, gear: GearEntity) -> None:\n        \"\"\"Save gear (create or update).\n\n        Args:\n            gear: The gear entity to save\n        \"\"\"\n        # Check if gear exists\n        existing = await self.session.get(Gear, gear.id)\n\n        if existing:\n            # Update existing gear\n            existing.name = gear.name\n            existing.gear_type = gear.gear_type\n            existing.description = gear.description\n            existing.manufacturer = gear.manufacturer\n            existing.thumbnail_url = gear.thumbnail_url\n            existing.is_public = gear.is_public\n            existing.updated_at = gear.updated_at\n\n            # Update source if present\n            if gear.source:\n                if existing.source:\n                    existing.source.source_name = gear.source.source_name\n                    existing.source.source_record_id = gear.source.source_record_id\n                    existing.source.source_updated_at = gear.source.source_updated_at\n                else:\n                    new_source = GearSource(\n                        source_name=gear.source.source_name,\n                        source_record_id=gear.source.source_record_id,\n                        source_updated_at=gear.source.source_updated_at,\n                    )\n                    self.session.add(new_source)\n                    await self.session.flush()\n                    existing.source_id = new_source.id\n\n            # Update tags\n            await self._update_tags(existing, gear.tags)\n\n            # Update models\n            await self._update_models(existing, gear.models)\n        else:\n            # Create new gear\n            new_gear = Gear(\n                id=gear.id,\n                name=gear.name,\n                gear_type=gear.gear_type,\n                description=gear.description,\n                manufacturer=gear.manufacturer,\n                thumbnail_url=gear.thumbnail_url,\n                is_public=gear.is_public,\n                created_at=gear.created_at,\n                updated_at=gear.updated_at,\n            )\n            self.session.add(new_gear)\n            await self.session.flush()\n\n            # Add source if present\n            if gear.source:\n                new_source = GearSource(\n                    source_name=gear.source.source_name,\n                    source_record_id=gear.source.source_record_id,\n                    source_updated_at=gear.source.source_updated_at,\n                )\n                self.session.add(new_source)\n                await self.session.flush()\n                new_gear.source_id = new_source.id\n\n            # Add tags\n            await self._update_tags(new_gear, gear.tags)\n\n            # Add models\n            for model_vo in gear.models:\n                new_model = GearModel(\n                    id=model_vo.id,\n                    gear_id=new_gear.id,\n                    platform=model_vo.platform,\n                    size=model_vo.size,\n                    file_path=model_vo.file_path,\n                    download_url=model_vo.download_url,\n                    download_status=model_vo.download_status,\n                    file_hash=model_vo.file_hash,\n                )\n                self.session.add(new_model)\n\n        await self.session.flush()\n\n    async def delete(self, gear_id: UUID) -> None:\n        \"\"\"Delete gear by ID.\n\n        Args:\n            gear_id: The gear's UUID\n        \"\"\"\n        gear = await self.session.get(Gear, gear_id)\n        if gear:\n            await self.session.delete(gear)\n            await self.session.flush()\n\n    async def _update_tags(self, gear: Gear, tag_names: list[str]) -> None:\n        \"\"\"Update tags for a gear item.\n\n        Args:\n            gear: The ORM Gear model\n            tag_names: List of tag names\n        \"\"\"\n        # Delete existing tag associations\n        delete_stmt = delete(gear_tags_table).where(\n            gear_tags_table.c.gear_id == gear.id\n        )\n        await self.session.execute(delete_stmt)\n\n        # Get or create tags and add associations\n        for tag_name in tag_names:\n            stmt = select(GearTag).where(GearTag.name == tag_name.lower())\n            result = await self.session.execute(stmt)\n            tag = result.scalar_one_or_none()\n\n            if not tag:\n                tag = GearTag(name=tag_name.lower())\n                self.session.add(tag)\n                await self.session.flush()\n\n            # Insert into junction table\n            insert_stmt = gear_tags_table.insert().values(\n                gear_id=gear.id,\n                tag_id=tag.id,\n            )\n            await self.session.execute(insert_stmt)\n\n    async def _update_models(\n        self,\n        gear: Gear,\n        model_vos: list[GearModelVO],\n    ) -> None:\n        \"\"\"Update models for a gear item.\n\n        Args:\n            gear: The ORM Gear model\n            model_vos: List of model value objects\n        \"\"\"\n        # Get existing model IDs\n        existing_ids = {model.id for model in gear.models}\n        new_ids = {model.id for model in model_vos}\n\n        # Delete removed models\n        models_to_delete = [\n            model for model in gear.models if model.id not in new_ids\n        ]\n        for model in models_to_delete:\n            await self.session.delete(model)\n\n        # Update or create models\n        for model_vo in model_vos:\n            if model_vo.id in existing_ids:\n                # Update existing model\n                existing_model = next(\n                    m for m in gear.models if m.id == model_vo.id\n                )\n                existing_model.platform = model_vo.platform\n                existing_model.size = model_vo.size\n                existing_model.file_path = model_vo.file_path\n                existing_model.download_url = model_vo.download_url\n                existing_model.download_status = model_vo.download_status\n                existing_model.file_hash = model_vo.file_hash\n            else:\n                # Create new model\n                new_model = GearModel(\n                    id=model_vo.id,\n                    gear_id=gear.id,\n                    platform=model_vo.platform,\n                    size=model_vo.size,\n                    file_path=model_vo.file_path,\n                    download_url=model_vo.download_url,\n                    download_status=model_vo.download_status,\n                    file_hash=model_vo.file_hash,\n                )\n                self.session.add(new_model)\n\n    def _to_entity(self, gear: Gear) -> GearEntity:\n        \"\"\"Convert ORM Gear to domain GearEntity.\n\n        Args:\n            gear: The ORM Gear model\n\n        Returns:\n            The domain GearEntity\n        \"\"\"\n        # Convert source\n        source = None\n        if gear.source:\n            source = GearSourceVO(\n                source_name=gear.source.source_name,\n                source_record_id=gear.source.source_record_id,\n                source_updated_at=gear.source.source_updated_at,\n            )\n\n        # Convert models\n        models = [\n            GearModelVO(\n                id=model.id,\n                platform=model.platform,\n                size=model.size,\n                file_path=model.file_path,\n                download_url=model.download_url,\n                download_status=model.download_status,\n                file_hash=model.file_hash,\n            )\n            for model in gear.models\n        ]\n\n        # Convert tags\n        tags = [tag.name for tag in gear.tags]\n\n        return GearEntity(\n            id=gear.id,\n            name=gear.name,\n            gear_type=gear.gear_type,\n            description=gear.description,\n            manufacturer=gear.manufacturer,\n            tags=tags,\n            source=source,\n            models=models,\n            thumbnail_url=gear.thumbnail_url,\n            is_public=gear.is_public,\n            created_at=gear.created_at,\n            updated_at=gear.updated_at,\n        )\n","numLines":452,"startLine":1,"totalLines":452}}}
