{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012eqpiQXYdbNrgxzaNYJMm3","type":"tool_result","content":"     1→\"\"\"SignalChain aggregate and related entities for domain layer.\n     2→\n     3→A SignalChain represents a composition of gear that can be\n     4→processed together. It follows specific grammar rules for valid compositions.\n     5→\n     6→Signal Chain Grammar:\n     7→    [PrePedals*] -> AmpBlock -> [IRBlock?] -> [PostEffects*]\n     8→\n     9→    - PrePedals: 0 or more pre-amp pedal captures (overdrive, fuzz, etc.)\n    10→    - AmpBlock: Exactly ONE of:\n    11→        - HeadCapture (AMP) -> REQUIRES IRBlock after\n    12→        - FullRigCapture (FULL_RIG) -> IR baked in, NO IRBlock allowed\n    13→    - IRBlock: Exactly ONE IR file (required after HeadCapture only)\n    14→    - PostEffects: 0 or more post-amp effect captures (delay, reverb, etc.)\n    15→\"\"\"\n    16→\n    17→from dataclasses import dataclass, field\n    18→from datetime import datetime\n    19→from uuid import UUID\n    20→\n    21→from core.domain.entities.base import Entity, new_id, utcnow\n    22→from core.domain.value_objects.signal_chain_enums import GearType, Platform\n    23→\n    24→\n    25→@dataclass(frozen=True, slots=True)\n    26→class SignalChainBlock:\n    27→    \"\"\"A single block in a signal chain.\n    28→\n    29→    Represents one component (pedal, amp, full-rig, IR, or post-effect) in\n    30→    the signal chain. Blocks are ordered by position and reference gear\n    31→    from the user's library via user_gear_id.\n    32→\n    33→    Attributes:\n    34→        id: Unique identifier for this block\n    35→        signal_chain_id: Parent signal chain ID\n    36→        position: Order in the chain (0-indexed)\n    37→        user_gear_id: Reference to UserGear item from user's library\n    38→        gear_type: Type of gear (pedal, amp, full_rig, ir, post_effect)\n    39→    \"\"\"\n    40→\n    41→    id: UUID\n    42→    signal_chain_id: UUID\n    43→    position: int\n    44→    user_gear_id: UUID\n    45→    gear_type: GearType\n    46→\n    47→    def with_position(self, position: int) -> \"SignalChainBlock\":\n    48→        \"\"\"Return a new block with updated position.\n    49→\n    50→        Args:\n    51→            position: The new position\n    52→\n    53→        Returns:\n    54→            A new SignalChainBlock with the updated position\n    55→        \"\"\"\n    56→        return SignalChainBlock(\n    57→            id=self.id,\n    58→            signal_chain_id=self.signal_chain_id,\n    59→            position=position,\n    60→            user_gear_id=self.user_gear_id,\n    61→            gear_type=self.gear_type,\n    62→        )\n    63→\n    64→\n    65→@dataclass(eq=False, slots=True)\n    66→class SignalChain(Entity):\n    67→    \"\"\"Aggregate root for signal chain composition.\n    68→\n    69→    A SignalChain represents a user-created composition of gear\n    70→    that can be processed together. It enforces grammar rules for valid\n    71→    signal chain compositions.\n    72→\n    73→    Valid chain grammar:\n    74→        [PrePedals*] -> AmpBlock -> [IRBlock?] -> [PostEffects*]\n    75→\n    76→    Validation is delegated to SignalChainValidator service.\n    77→\n    78→    Attributes:\n    79→        id: Unique identifier\n    80→        user_id: Owner's user ID\n    81→        name: Display name for the signal chain\n    82→        description: Optional description\n    83→        platform: Target platform (nam, aida_x, etc.)\n    84→        created_at: When the chain was created\n    85→        updated_at: When the chain was last updated\n    86→        blocks: Ordered list of blocks in this chain\n    87→    \"\"\"\n    88→\n    89→    user_id: UUID = field(default_factory=new_id)\n    90→    name: str = \"\"\n    91→    platform: Platform = Platform.NAM\n    92→    description: str | None = None\n    93→    blocks: list[SignalChainBlock] = field(default_factory=list)\n    94→    id: UUID = field(default_factory=new_id)\n    95→    created_at: datetime = field(default_factory=utcnow)\n    96→    updated_at: datetime = field(default_factory=utcnow)\n    97→\n    98→    @property\n    99→    def block_count(self) -> int:\n   100→        \"\"\"Return the number of blocks in this signal chain.\"\"\"\n   101→        return len(self.blocks)\n   102→\n   103→    def add_block(self, block: SignalChainBlock) -> None:\n   104→        \"\"\"Add a block to the signal chain.\n   105→\n   106→        The block will be added at the end of the chain.\n   107→\n   108→        Args:\n   109→            block: The block to add\n   110→        \"\"\"\n   111→        # Update position to be at the end\n   112→        new_block = block.with_position(len(self.blocks))\n   113→        self.blocks.append(new_block)\n   114→        self.updated_at = utcnow()\n   115→\n   116→    def remove_block(self, block_id: UUID) -> bool:\n   117→        \"\"\"Remove a block from the signal chain.\n   118→\n   119→        Args:\n   120→            block_id: The ID of the block to remove\n   121→\n   122→        Returns:\n   123→            True if removed, False if not found\n   124→        \"\"\"\n   125→        for i, block in enumerate(self.blocks):\n   126→            if block.id == block_id:\n   127→                self.blocks.pop(i)\n   128→                self._reorder_positions()\n   129→                self.updated_at = utcnow()\n   130→                return True\n   131→        return False\n   132→\n   133→    def reorder_block(self, block_id: UUID, new_position: int) -> bool:\n   134→        \"\"\"Move a block to a new position.\n   135→\n   136→        Args:\n   137→            block_id: The ID of the block to move\n   138→            new_position: The new position (0-indexed)\n   139→\n   140→        Returns:\n   141→            True if moved, False if not found or invalid position\n   142→        \"\"\"\n   143→        if new_position < 0 or new_position >= self.block_count:\n   144→            return False\n   145→\n   146→        # Find the block\n   147→        block_index = None\n   148→        for i, block in enumerate(self.blocks):\n   149→            if block.id == block_id:\n   150→                block_index = i\n   151→                break\n   152→\n   153→        if block_index is None:\n   154→            return False\n   155→\n   156→        # Move the block\n   157→        block = self.blocks.pop(block_index)\n   158→        self.blocks.insert(new_position, block)\n   159→        self._reorder_positions()\n   160→        self.updated_at = utcnow()\n   161→        return True\n   162→\n   163→    def _reorder_positions(self) -> None:\n   164→        \"\"\"Reorder positions to be sequential starting from 0.\"\"\"\n   165→        self.blocks = [block.with_position(i) for i, block in enumerate(self.blocks)]\n   166→\n   167→    def get_block(self, block_id: UUID) -> SignalChainBlock | None:\n   168→        \"\"\"Get a block by ID.\n   169→\n   170→        Args:\n   171→            block_id: The block ID\n   172→\n   173→        Returns:\n   174→            The block if found, None otherwise\n   175→        \"\"\"\n   176→        for block in self.blocks:\n   177→            if block.id == block_id:\n   178→                return block\n   179→        return None\n   180→\n   181→    def get_blocks_by_type(self, gear_type: GearType) -> list[SignalChainBlock]:\n   182→        \"\"\"Get all blocks of a specific type.\n   183→\n   184→        Args:\n   185→            gear_type: The gear type to filter by\n   186→\n   187→        Returns:\n   188→            List of matching blocks\n   189→        \"\"\"\n   190→        return [b for b in self.blocks if b.gear_type == gear_type]\n   191→\n   192→    def has_amp(self) -> bool:\n   193→        \"\"\"Check if chain has an amp (AMP or FULL_RIG).\"\"\"\n   194→        return any(\n   195→            b.gear_type in (GearType.AMP, GearType.FULL_RIG)\n   196→            for b in self.blocks\n   197→        )\n   198→\n   199→    def has_ir(self) -> bool:\n   200→        \"\"\"Check if chain has an IR.\"\"\"\n   201→        return any(b.gear_type == GearType.IR for b in self.blocks)\n   202→\n   203→    def is_complete(self) -> bool:\n   204→        \"\"\"Check if the signal chain is complete and ready for use.\n   205→\n   206→        A chain is complete when:\n   207→        - It has a FULL_RIG amp, OR\n   208→        - It has an AMP + IR combination\n   209→\n   210→        Returns:\n   211→            True if the chain is complete, False otherwise\n   212→        \"\"\"\n   213→        has_amp = any(b.gear_type == GearType.AMP for b in self.blocks)\n   214→        has_full_rig = any(b.gear_type == GearType.FULL_RIG for b in self.blocks)\n   215→        has_ir = self.has_ir()\n   216→\n   217→        return has_full_rig or (has_amp and has_ir)\n   218→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"57c48ba8-7f07-4096-8a0a-3ab4fb2ff266","uuid":"f4fbcc1b-fdf6-46db-8837-29baf3ddfe95","tool_use_result":{"type":"text","file":{"filePath":"libs/core/src/core/domain/entities/signal_chain.py","content":"\"\"\"SignalChain aggregate and related entities for domain layer.\n\nA SignalChain represents a composition of gear that can be\nprocessed together. It follows specific grammar rules for valid compositions.\n\nSignal Chain Grammar:\n    [PrePedals*] -> AmpBlock -> [IRBlock?] -> [PostEffects*]\n\n    - PrePedals: 0 or more pre-amp pedal captures (overdrive, fuzz, etc.)\n    - AmpBlock: Exactly ONE of:\n        - HeadCapture (AMP) -> REQUIRES IRBlock after\n        - FullRigCapture (FULL_RIG) -> IR baked in, NO IRBlock allowed\n    - IRBlock: Exactly ONE IR file (required after HeadCapture only)\n    - PostEffects: 0 or more post-amp effect captures (delay, reverb, etc.)\n\"\"\"\n\nfrom dataclasses import dataclass, field\nfrom datetime import datetime\nfrom uuid import UUID\n\nfrom core.domain.entities.base import Entity, new_id, utcnow\nfrom core.domain.value_objects.signal_chain_enums import GearType, Platform\n\n\n@dataclass(frozen=True, slots=True)\nclass SignalChainBlock:\n    \"\"\"A single block in a signal chain.\n\n    Represents one component (pedal, amp, full-rig, IR, or post-effect) in\n    the signal chain. Blocks are ordered by position and reference gear\n    from the user's library via user_gear_id.\n\n    Attributes:\n        id: Unique identifier for this block\n        signal_chain_id: Parent signal chain ID\n        position: Order in the chain (0-indexed)\n        user_gear_id: Reference to UserGear item from user's library\n        gear_type: Type of gear (pedal, amp, full_rig, ir, post_effect)\n    \"\"\"\n\n    id: UUID\n    signal_chain_id: UUID\n    position: int\n    user_gear_id: UUID\n    gear_type: GearType\n\n    def with_position(self, position: int) -> \"SignalChainBlock\":\n        \"\"\"Return a new block with updated position.\n\n        Args:\n            position: The new position\n\n        Returns:\n            A new SignalChainBlock with the updated position\n        \"\"\"\n        return SignalChainBlock(\n            id=self.id,\n            signal_chain_id=self.signal_chain_id,\n            position=position,\n            user_gear_id=self.user_gear_id,\n            gear_type=self.gear_type,\n        )\n\n\n@dataclass(eq=False, slots=True)\nclass SignalChain(Entity):\n    \"\"\"Aggregate root for signal chain composition.\n\n    A SignalChain represents a user-created composition of gear\n    that can be processed together. It enforces grammar rules for valid\n    signal chain compositions.\n\n    Valid chain grammar:\n        [PrePedals*] -> AmpBlock -> [IRBlock?] -> [PostEffects*]\n\n    Validation is delegated to SignalChainValidator service.\n\n    Attributes:\n        id: Unique identifier\n        user_id: Owner's user ID\n        name: Display name for the signal chain\n        description: Optional description\n        platform: Target platform (nam, aida_x, etc.)\n        created_at: When the chain was created\n        updated_at: When the chain was last updated\n        blocks: Ordered list of blocks in this chain\n    \"\"\"\n\n    user_id: UUID = field(default_factory=new_id)\n    name: str = \"\"\n    platform: Platform = Platform.NAM\n    description: str | None = None\n    blocks: list[SignalChainBlock] = field(default_factory=list)\n    id: UUID = field(default_factory=new_id)\n    created_at: datetime = field(default_factory=utcnow)\n    updated_at: datetime = field(default_factory=utcnow)\n\n    @property\n    def block_count(self) -> int:\n        \"\"\"Return the number of blocks in this signal chain.\"\"\"\n        return len(self.blocks)\n\n    def add_block(self, block: SignalChainBlock) -> None:\n        \"\"\"Add a block to the signal chain.\n\n        The block will be added at the end of the chain.\n\n        Args:\n            block: The block to add\n        \"\"\"\n        # Update position to be at the end\n        new_block = block.with_position(len(self.blocks))\n        self.blocks.append(new_block)\n        self.updated_at = utcnow()\n\n    def remove_block(self, block_id: UUID) -> bool:\n        \"\"\"Remove a block from the signal chain.\n\n        Args:\n            block_id: The ID of the block to remove\n\n        Returns:\n            True if removed, False if not found\n        \"\"\"\n        for i, block in enumerate(self.blocks):\n            if block.id == block_id:\n                self.blocks.pop(i)\n                self._reorder_positions()\n                self.updated_at = utcnow()\n                return True\n        return False\n\n    def reorder_block(self, block_id: UUID, new_position: int) -> bool:\n        \"\"\"Move a block to a new position.\n\n        Args:\n            block_id: The ID of the block to move\n            new_position: The new position (0-indexed)\n\n        Returns:\n            True if moved, False if not found or invalid position\n        \"\"\"\n        if new_position < 0 or new_position >= self.block_count:\n            return False\n\n        # Find the block\n        block_index = None\n        for i, block in enumerate(self.blocks):\n            if block.id == block_id:\n                block_index = i\n                break\n\n        if block_index is None:\n            return False\n\n        # Move the block\n        block = self.blocks.pop(block_index)\n        self.blocks.insert(new_position, block)\n        self._reorder_positions()\n        self.updated_at = utcnow()\n        return True\n\n    def _reorder_positions(self) -> None:\n        \"\"\"Reorder positions to be sequential starting from 0.\"\"\"\n        self.blocks = [block.with_position(i) for i, block in enumerate(self.blocks)]\n\n    def get_block(self, block_id: UUID) -> SignalChainBlock | None:\n        \"\"\"Get a block by ID.\n\n        Args:\n            block_id: The block ID\n\n        Returns:\n            The block if found, None otherwise\n        \"\"\"\n        for block in self.blocks:\n            if block.id == block_id:\n                return block\n        return None\n\n    def get_blocks_by_type(self, gear_type: GearType) -> list[SignalChainBlock]:\n        \"\"\"Get all blocks of a specific type.\n\n        Args:\n            gear_type: The gear type to filter by\n\n        Returns:\n            List of matching blocks\n        \"\"\"\n        return [b for b in self.blocks if b.gear_type == gear_type]\n\n    def has_amp(self) -> bool:\n        \"\"\"Check if chain has an amp (AMP or FULL_RIG).\"\"\"\n        return any(\n            b.gear_type in (GearType.AMP, GearType.FULL_RIG)\n            for b in self.blocks\n        )\n\n    def has_ir(self) -> bool:\n        \"\"\"Check if chain has an IR.\"\"\"\n        return any(b.gear_type == GearType.IR for b in self.blocks)\n\n    def is_complete(self) -> bool:\n        \"\"\"Check if the signal chain is complete and ready for use.\n\n        A chain is complete when:\n        - It has a FULL_RIG amp, OR\n        - It has an AMP + IR combination\n\n        Returns:\n            True if the chain is complete, False otherwise\n        \"\"\"\n        has_amp = any(b.gear_type == GearType.AMP for b in self.blocks)\n        has_full_rig = any(b.gear_type == GearType.FULL_RIG for b in self.blocks)\n        has_ir = self.has_ir()\n\n        return has_full_rig or (has_amp and has_ir)\n","numLines":218,"startLine":1,"totalLines":218}}}
