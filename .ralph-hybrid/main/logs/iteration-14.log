{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PoJ9CYV84Mg1S3E7XXEikB","type":"tool_result","content":"     1→\"\"\"NAM (Neural Amp Modeler) model loader with LRU caching.\n     2→\n     3→This module provides functionality to load NAM models using PyTorch directly,\n     4→without requiring the neural-amp-modeler library (which has Python 3.12 compatibility issues).\n     5→\"\"\"\n     6→\n     7→from functools import lru_cache\n     8→from pathlib import Path\n     9→\n    10→import torch\n    11→\n    12→\n    13→class NAMLoadError(Exception):\n    14→    \"\"\"Exception raised when NAM model loading fails.\"\"\"\n    15→\n    16→    pass\n    17→\n    18→\n    19→@lru_cache(maxsize=10)\n    20→def load_nam_model(\n    21→    model_path: Path,\n    22→) -> tuple[torch.nn.Module, int]:\n    23→    \"\"\"Load a NAM model from file with LRU caching.\n    24→\n    25→    Args:\n    26→        model_path: Path to the .nam model file\n    27→\n    28→    Returns:\n    29→        Tuple of (model, sample_rate) where model is the loaded PyTorch model\n    30→        and sample_rate is the expected audio sample rate (default 48000 Hz)\n    31→\n    32→    Raises:\n    33→        NAMLoadError: If the model file doesn't exist or cannot be loaded\n    34→\n    35→    Note:\n    36→        Models are cached using LRU (Least Recently Used) cache with a default\n    37→        size of 10 models. The cache key is based on the file path.\n    38→    \"\"\"\n    39→    # Validate file exists\n    40→    if not model_path.exists():\n    41→        raise NAMLoadError(f\"Model file not found: {model_path}\")\n    42→\n    43→    if not model_path.is_file():\n    44→        raise NAMLoadError(f\"Path is not a file: {model_path}\")\n    45→\n    46→    try:\n    47→        # Load the model checkpoint\n    48→        # NAM models are PyTorch checkpoints with 'model' and optionally 'sample_rate' keys\n    49→        checkpoint = torch.load(model_path, map_location=\"cpu\", weights_only=False)\n    50→\n    51→        # Extract model state dict\n    52→        if isinstance(checkpoint, dict):\n    53→            if \"model\" in checkpoint:\n    54→                model_state = checkpoint[\"model\"]\n    55→                sample_rate = checkpoint.get(\"sample_rate\", 48000)\n    56→            else:\n    57→                # Checkpoint is already the state dict\n    58→                model_state = checkpoint\n    59→                sample_rate = 48000\n    60→        else:\n    61→            raise NAMLoadError(\n    62→                f\"Unexpected checkpoint format: expected dict, got {type(checkpoint)}\"\n    63→            )\n    64→\n    65→        # Create a simple model wrapper\n    66→        # NAM models are typically feed-forward networks with specific architectures\n    67→        # For now, we'll load the state dict into a generic Sequential model\n    68→        # This is a simplified approach - production code would need to reconstruct\n    69→        # the exact NAM architecture\n    70→        model = _create_nam_model(model_state)\n    71→\n    72→        return model, sample_rate\n    73→\n    74→    except Exception as e:\n    75→        if isinstance(e, NAMLoadError):\n    76→            raise\n    77→        raise NAMLoadError(f\"Failed to load NAM model from {model_path}: {e}\") from e\n    78→\n    79→\n    80→def _create_nam_model(state_dict: dict[str, torch.Tensor]) -> torch.nn.Module:\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"57c48ba8-7f07-4096-8a0a-3ab4fb2ff266","uuid":"9adcc8a8-8e27-40c7-8135-0415d205b8c8","tool_use_result":{"type":"text","file":{"filePath":"libs/audio/src/audio/processing/nam_loader.py","content":"\"\"\"NAM (Neural Amp Modeler) model loader with LRU caching.\n\nThis module provides functionality to load NAM models using PyTorch directly,\nwithout requiring the neural-amp-modeler library (which has Python 3.12 compatibility issues).\n\"\"\"\n\nfrom functools import lru_cache\nfrom pathlib import Path\n\nimport torch\n\n\nclass NAMLoadError(Exception):\n    \"\"\"Exception raised when NAM model loading fails.\"\"\"\n\n    pass\n\n\n@lru_cache(maxsize=10)\ndef load_nam_model(\n    model_path: Path,\n) -> tuple[torch.nn.Module, int]:\n    \"\"\"Load a NAM model from file with LRU caching.\n\n    Args:\n        model_path: Path to the .nam model file\n\n    Returns:\n        Tuple of (model, sample_rate) where model is the loaded PyTorch model\n        and sample_rate is the expected audio sample rate (default 48000 Hz)\n\n    Raises:\n        NAMLoadError: If the model file doesn't exist or cannot be loaded\n\n    Note:\n        Models are cached using LRU (Least Recently Used) cache with a default\n        size of 10 models. The cache key is based on the file path.\n    \"\"\"\n    # Validate file exists\n    if not model_path.exists():\n        raise NAMLoadError(f\"Model file not found: {model_path}\")\n\n    if not model_path.is_file():\n        raise NAMLoadError(f\"Path is not a file: {model_path}\")\n\n    try:\n        # Load the model checkpoint\n        # NAM models are PyTorch checkpoints with 'model' and optionally 'sample_rate' keys\n        checkpoint = torch.load(model_path, map_location=\"cpu\", weights_only=False)\n\n        # Extract model state dict\n        if isinstance(checkpoint, dict):\n            if \"model\" in checkpoint:\n                model_state = checkpoint[\"model\"]\n                sample_rate = checkpoint.get(\"sample_rate\", 48000)\n            else:\n                # Checkpoint is already the state dict\n                model_state = checkpoint\n                sample_rate = 48000\n        else:\n            raise NAMLoadError(\n                f\"Unexpected checkpoint format: expected dict, got {type(checkpoint)}\"\n            )\n\n        # Create a simple model wrapper\n        # NAM models are typically feed-forward networks with specific architectures\n        # For now, we'll load the state dict into a generic Sequential model\n        # This is a simplified approach - production code would need to reconstruct\n        # the exact NAM architecture\n        model = _create_nam_model(model_state)\n\n        return model, sample_rate\n\n    except Exception as e:\n        if isinstance(e, NAMLoadError):\n            raise\n        raise NAMLoadError(f\"Failed to load NAM model from {model_path}: {e}\") from e\n\n\ndef _create_nam_model(state_dict: dict[str, torch.Tensor]) -> torch.nn.Module:","numLines":80,"startLine":1,"totalLines":114}}}
