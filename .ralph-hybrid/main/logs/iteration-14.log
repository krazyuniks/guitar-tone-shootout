level in dBFS\\n   146→        peak = np.max(np.abs(audio))\\n   147→        peak_dbfs = 20 * np.log10(peak) if peak > 0 else -np.inf\\n   148→\\n   149→        return (float(lufs), float(peak_dbfs))\\n   150→\\n   151→    async def normalize_loudness(\\n   152→        self,\\n   153→        input_path: Path,\\n   154→        output_path: Path,\\n   155→        target_lufs: float = -14.0,\\n   156→    ) -> AudioResult:\\n   157→        \\\"\\\"\\\"Normalize audio to target loudness.\\n   158→\\n   159→        Args:\\n   160→            input_path: Path to input audio file\\n   161→            output_path: Path for output file\\n   162→            target_lufs: Target loudness in LUFS\\n   163→\\n   164→        Returns:\\n   165→            AudioResult with processing metadata\\n   166→        \\\"\\\"\\\"\\n   167→        start_time = time.time()\\n   168→\\n   169→        # Load audio file\\n   170→        audio, sample_rate = sf.read(input_path)\\n   171→\\n   172→        # Convert stereo to mono if needed\\n   173→        if audio.ndim == 2:\\n   174→            audio = np.mean(audio, axis=1)\\n   175→\\n   176→        # Measure current loudness\\n   177→        meter = pyln.Meter(sample_rate)\\n   178→        current_lufs = meter.integrated_loudness(audio)\\n   179→\\n   180→        # Normalize to target LUFS\\n   181→        normalized_audio = pyln.normalize.loudness(audio, current_lufs, target_lufs)\\n   182→\\n   183→        # Write output file\\n   184→        sf.write(output_path, normalized_audio, sample_rate)\\n   185→\\n   186→        # Calculate output metrics\\n   187→        duration = float(len(normalized_audio)) / sample_rate\\n   188→        peak = np.max(np.abs(normalized_audio))\\n   189→        peak_dbfs = 20 * np.log10(peak) if peak > 0 else -np.inf\\n   190→\\n   191→        processing_time = time.time() - start_time\\n   192→\\n   193→        return AudioResult.create(\\n   194→            output_path=output_path,\\n   195→            duration