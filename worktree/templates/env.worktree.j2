# .env.worktree - Worktree-specific non-secret environment
# Auto-generated by worktree.py - DO NOT EDIT MANUALLY
# Worktree: {{ worktree.worktree_name }}
# Branch: {{ worktree.branch }}
# Generated: {{ generated_at }}
#
# Secrets live in env.local.sh. Static defaults live in compose.env.

GTS_WORKTREE={{ worktree.worktree_name }}
COMPOSE_PROJECT_NAME={{ worktree.compose_project }}
COMPOSE_FILE={{ compose_file }}

# Port overrides (external ports)
NGINX_PORT={{ worktree.ports.nginx }}
ASTRO_PORT={{ worktree.ports.astro }}
WEBAPP_PORT={{ worktree.ports.webapp }}
DB_PORT={{ worktree.ports.db }}
REDIS_PORT={{ worktree.ports.redis }}
CLOUDBEAVER_PORT={{ worktree.ports.cloudbeaver }}

# Public URL (Traefik HTTPS on server, localhost otherwise)
PUBLIC_URL={{ public_url }}

# Traefik routing (for public internet deployment)
GTS_SUBDOMAIN={{ subdomain }}
GTS_ROUTER_NAME={{ router_name }}

# Volume names (isolated per worktree)
POSTGRES_VOLUME={{ worktree.volumes.postgres }}
REDIS_VOLUME={{ worktree.volumes.redis }}
CLOUDBEAVER_VOLUME={{ worktree.volumes.cloudbeaver }}

# Observability (--profile observability)
GRAFANA_PORT={{ worktree.ports.grafana }}
PROMETHEUS_PORT={{ worktree.ports.prometheus }}
LOKI_PORT={{ worktree.ports.loki }}
TEMPO_PORT={{ worktree.ports.tempo }}
OTLP_GRPC_PORT={{ worktree.ports.otlp_grpc }}
OTLP_HTTP_PORT={{ worktree.ports.otlp_http }}
ALLOY_PORT={{ worktree.ports.alloy }}

GRAFANA_VOLUME={{ worktree.volumes.grafana }}
LOKI_VOLUME={{ worktree.volumes.loki }}
TEMPO_VOLUME={{ worktree.volumes.tempo }}
PROMETHEUS_VOLUME={{ worktree.volumes.prometheus }}
