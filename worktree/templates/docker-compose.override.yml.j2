# docker-compose.override.yml
# Auto-generated by worktree.py - DO NOT EDIT MANUALLY
# Worktree: {{ worktree.worktree_name }}
# Branch: {{ worktree.branch }}
# Generated: {{ generated_at }}

services:
  nginx:
    container_name: {{ worktree.compose_project }}-nginx
    ports:
      - "127.0.0.1:{{ worktree.ports.nginx }}:80"

  webapp:
    container_name: {{ worktree.compose_project }}-webapp
    ports:
      - "127.0.0.1:{{ worktree.ports.webapp }}:8000"
    environment:
      - PUBLIC_URL={{ public_url }}
      - CORS_ORIGINS={{ public_url }}
      - GTS_AUTH_FILE=/worktrees/.gts-auth.json
      - GTS_STORAGE_ROOT=/app/storage
    volumes:
      - ../:/worktrees

  astro:
    container_name: {{ worktree.compose_project }}-astro
    ports:
      - "127.0.0.1:{{ worktree.ports.astro }}:4321"
    environment:
      - PUBLIC_URL={{ public_url }}

  t3k-sync:
    container_name: {{ worktree.compose_project }}-t3k-sync
    environment:
      - GTS_AUTH_FILE=/worktrees/.gts-auth.json
    volumes:
      - ../:/worktrees

  audio-worker:
    container_name: {{ worktree.compose_project }}-audio-worker

  video-worker:
    container_name: {{ worktree.compose_project }}-video-worker
    ports:
      - "127.0.0.1:{{ worktree.ports.video }}:8002"

  db:
    container_name: {{ worktree.compose_project }}-db
    ports:
      - "127.0.0.1:{{ worktree.ports.db }}:5432"
    volumes:
      - {{ worktree.volumes.postgres }}:/var/lib/postgresql

  cloudbeaver:
    container_name: {{ worktree.compose_project }}-cloudbeaver
    ports:
      - "127.0.0.1:{{ worktree.ports.cloudbeaver }}:8978"
    volumes:
      - {{ worktree.volumes.cloudbeaver }}:/opt/cloudbeaver/workspace
    environment:
      CB_SERVER_NAME: "GTS {{ worktree.worktree_name }}"

volumes:
  {{ worktree.volumes.postgres }}:
  {{ worktree.volumes.cloudbeaver }}:

networks:
  default:
    driver: bridge
    ipam:
      config:
        - subnet: 10.10.{{ worktree.offset }}.0/24
