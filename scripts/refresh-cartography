#!/usr/bin/env bash
# refresh-cartography — regenerate woof's on-disk codebase map.
#
# Outputs (all gitignored, all under .woof/codebase/):
#   tree.txt        Hierarchical file listing (git-tracked files only)
#   tags            ctags index (if [indexing.ctags] is declared)
#   freshness.json  {path: {mtime, sha256}} for every git-tracked file
#
# summary.md is human-authored and never touched by this script.
#
# Wired up by `just wf-install-hooks` as a post-commit hook fenced block.
# Idempotent; ~1s for typical repos.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
OUT_DIR="$REPO_ROOT/.woof/codebase"
PREREQ="$REPO_ROOT/.woof/prerequisites.toml"

[[ -f "$PREREQ" ]] || { echo "refresh-cartography: $PREREQ not found; skipping" >&2; exit 0; }

mkdir -p "$OUT_DIR"

# ---------------------------------------------------------------------------
# tree.txt — every git-tracked file, sorted (deterministic across hosts)
# ---------------------------------------------------------------------------

git -C "$REPO_ROOT" ls-files | sort > "$OUT_DIR/tree.txt"

# ---------------------------------------------------------------------------
# tags — ctags index (only if declared in prerequisites)
# ---------------------------------------------------------------------------

if grep -qE '^\s*\[indexing\.ctags\]|^\s*ctags\s*=' "$PREREQ" \
   || grep -qE '^\s*\[indexing\]' "$PREREQ" && grep -qE '^\s*ctags\s*=' "$PREREQ"; then
    if ! command -v ctags >/dev/null; then
        echo "refresh-cartography: ctags declared in prerequisites but binary not on PATH" >&2
        exit 1
    fi
    ctags --recurse=yes \
        --exclude=node_modules --exclude=.venv --exclude=.git \
        --exclude=__pycache__ --exclude=astro/dist \
        --exclude=.woof --exclude=tests/e2e/python/.venv \
        -f "$OUT_DIR/tags" \
        "$REPO_ROOT"
fi

# ---------------------------------------------------------------------------
# freshness.json — {path: {mtime: epoch, sha256: hex}} per git-tracked file
# ---------------------------------------------------------------------------

python3 - "$REPO_ROOT" "$OUT_DIR/freshness.json" <<'PY'
import hashlib
import json
import os
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

repo, out = Path(sys.argv[1]), Path(sys.argv[2])
files = subprocess.run(
    ["git", "-C", str(repo), "ls-files"],
    capture_output=True, text=True, check=True,
).stdout.splitlines()

records: dict[str, dict[str, object]] = {}
for rel in files:
    p = repo / rel
    try:
        st = p.stat()
        with p.open("rb") as fh:
            digest = hashlib.sha256(fh.read()).hexdigest()
        records[rel] = {"mtime": int(st.st_mtime), "sha256": digest}
    except (OSError, FileNotFoundError):
        # File removed or unreadable since git ls-files emitted it; skip.
        continue

payload = {
    "generated_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    "files": records,
}
tmp = out.with_suffix(".json.tmp")
tmp.write_text(json.dumps(payload, separators=(",", ":")))
tmp.replace(out)
PY
