#!/usr/bin/env bash
# scripts/dc - docker compose wrapper for the current GTS checkout.
#
# Targets the stack for this checkout: main's gts-main stack or a feature
# worktree's gts-<slot> stack. The compose project and ports come from the engine
# registry via scripts/worktree/current-env; secrets come from env.local.sh, host
# identity from the host, and static defaults from compose.env. Provision's
# per-worktree override is layered in when present. No .env.worktree.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$REPO_ROOT"

if [ -f env.local.sh ]; then
    # shellcheck disable=SC1091
    source env.local.sh
fi
export USER_UID="$(id -u)" USER_GID="$(id -g)"

# Compose project + worktree key for this checkout. Main defaults to gts-main; a
# feature worktree reads its leased slot from the engine registry.
ENV_OUT="$("$SCRIPT_DIR/worktree/current-env" 2>/dev/null || true)"
if [ -n "$ENV_OUT" ]; then
    eval "$ENV_OUT"
else
    export COMPOSE_PROJECT_NAME="gts-main"
    export GTS_WORKTREE="main"
fi

# Base always; provision's per-worktree override when present.
COMPOSE_FILES=(-f docker-compose.yml)
if [ -f "$REPO_ROOT/.worktree-run/docker-compose.override.yml" ]; then
    COMPOSE_FILES+=(-f "$REPO_ROOT/.worktree-run/docker-compose.override.yml")
fi

ENV_FILE_ARGS=()
[ -f "$REPO_ROOT/compose.env" ] && ENV_FILE_ARGS+=(--env-file "$REPO_ROOT/compose.env")

exec docker compose "${COMPOSE_FILES[@]}" "${ENV_FILE_ARGS[@]}" "$@"
