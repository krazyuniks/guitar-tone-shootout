#!/usr/bin/env bash
# wf-run — woof Stage-5 driver loop.
#
# Spawns one /wf:execute-story subprocess per pending story (via
# `woof dispatch claude --role story-executor`) until either a gate.md
# appears or every story is `status: done`.
#
# Exit codes:
#   0   epic complete (all stories done; no gate)
#   1   gate.md exists; halt for /wf Stage 6
#   2   driver / preflight error (lockfile, malformed plan.json, missing tool)
#   130 SIGINT propagated to subprocess

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
WOOF_BIN="$REPO_ROOT/woof/bin/woof"

usage() {
    cat <<'EOF'
Usage: scripts/wf-run --epic <N>

Drives Stage 5 for epic E<N> by dispatching /wf:execute-story per pending story.
Reads .woof/agents.toml for the story-executor role; honours the lockfile at
.woof/epics/E<N>/.wf.lock.
EOF
}

EPIC=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --epic) EPIC="$2"; shift 2;;
        -h|--help) usage; exit 0;;
        *) echo "wf-run: unknown arg '$1'" >&2; usage >&2; exit 2;;
    esac
done

[[ -n "$EPIC" ]] || { echo "wf-run: --epic required" >&2; exit 2; }
[[ "$EPIC" =~ ^[1-9][0-9]*$ ]] || { echo "wf-run: --epic must be a positive integer" >&2; exit 2; }

EPIC_DIR="$REPO_ROOT/.woof/epics/E${EPIC}"
PLAN="$EPIC_DIR/plan.json"
GATE="$EPIC_DIR/gate.md"
LOCK="$EPIC_DIR/.wf.lock"
JSONL="$EPIC_DIR/dispatch.jsonl"
EPIC_LOG="$EPIC_DIR/epic.jsonl"

[[ -f "$PLAN" ]] || { echo "wf-run: $PLAN not found" >&2; exit 2; }
[[ -f "$REPO_ROOT/.woof/agents.toml" ]] || { echo "wf-run: .woof/agents.toml not found" >&2; exit 2; }

command -v jq >/dev/null || { echo "wf-run: jq required" >&2; exit 2; }
[[ -x "$WOOF_BIN" ]] || { echo "wf-run: $WOOF_BIN not executable" >&2; exit 2; }

# ---------------------------------------------------------------------------
# Lockfile
# ---------------------------------------------------------------------------

acquire_lock() {
    if [[ -f "$LOCK" ]]; then
        local pid
        pid="$(jq -r '.pid' "$LOCK" 2>/dev/null || echo "")"
        if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
            local started host invoker
            started="$(jq -r '.started_at' "$LOCK")"
            host="$(jq -r '.host' "$LOCK")"
            invoker="$(jq -r '.invoker' "$LOCK")"
            echo "wf-run: another woof process holds the lock" >&2
            echo "  pid=$pid invoker=$invoker host=$host started=$started" >&2
            echo "  wait or 'kill $pid', then retry." >&2
            exit 2
        fi
        echo "wf-run: stale lockfile (pid $pid not alive); reclaiming." >&2
    fi
    jq -n --arg pid "$$" --arg invoker "wf-run" \
        --arg started "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        --arg host "$(hostname)" \
        '{pid: ($pid|tonumber), invoker: $invoker, started_at: $started, host: $host}' \
        > "$LOCK"
}

release_lock() {
    rm -f "$LOCK"
}

# ---------------------------------------------------------------------------
# JSONL append
# ---------------------------------------------------------------------------

append_jsonl() {
    local path="$1"; shift
    mkdir -p "$(dirname "$path")"
    printf '%s\n' "$1" >> "$path"
}

now_iso() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# ---------------------------------------------------------------------------
# Plan helpers
# ---------------------------------------------------------------------------

next_story_id() {
    # First pending story whose depends_on are all done.
    jq -r '
        . as $root
        | .stories
        | map(select(.status == "pending"))
        | map(select(
            (.depends_on // [])
            | all(. as $dep | ($root.stories[] | select(.id == $dep) | .status) == "done")
        ))
        | sort_by(.id)
        | (first // empty).id // empty
    ' "$PLAN"
}

all_done() {
    local n
    n="$(jq '[.stories[] | select(.status != "done")] | length' "$PLAN")"
    [[ "$n" == "0" ]]
}

set_in_progress() {
    local sid="$1" tmp
    tmp="$(mktemp)"
    jq --arg sid "$sid" \
        '(.stories[] | select(.id == $sid) | .status) = "in_progress"' \
        "$PLAN" > "$tmp"
    mv "$tmp" "$PLAN"
}

revert_to_pending() {
    local sid="$1" tmp
    tmp="$(mktemp)"
    jq --arg sid "$sid" \
        '(.stories[] | select(.id == $sid) | .status) = "pending"' \
        "$PLAN" > "$tmp"
    mv "$tmp" "$PLAN"
}

# ---------------------------------------------------------------------------
# Dispatch one story
# ---------------------------------------------------------------------------

bootstrap_prompt() {
    local sid="$1"
    cat <<EOF
You are executing story ${sid} in epic E${EPIC}.

Read in order:
  1. .woof/.current-epic (verify E${EPIC})
  2. .woof/epics/E${EPIC}/plan.json (find ${sid})
  3. .woof/epics/E${EPIC}/EPIC.md (front-matter for outcomes / contract decisions)
  4. CLAUDE.md / AGENTS.md (project conventions)

Then invoke /wf:execute-story with arguments "E${EPIC} ${sid}".

Exit 0 only after the story commit transaction lands. Exit non-zero only after
writing .woof/epics/E${EPIC}/gate.md.
EOF
}

dispatch_story() {
    local sid="$1" prompt_file
    prompt_file="$(mktemp)"
    bootstrap_prompt "$sid" > "$prompt_file"

    append_jsonl "$EPIC_LOG" "$(jq -nc \
        --arg at "$(now_iso)" --argjson eid "$EPIC" --arg sid "$sid" \
        '{event:"story_started", at:$at, epic_id:$eid, story_id:$sid}')"

    set +e
    "$WOOF_BIN" dispatch claude \
        --role story-executor --epic "$EPIC" --story "$sid" \
        --prompt-file "$prompt_file"
    local rc=$?
    set -e
    rm -f "$prompt_file"
    return "$rc"
}

# ---------------------------------------------------------------------------
# SIGINT propagation
# ---------------------------------------------------------------------------

CHILD_PID=""
on_sigint() {
    if [[ -n "$CHILD_PID" ]]; then
        kill -INT "$CHILD_PID" 2>/dev/null || true
        wait "$CHILD_PID" 2>/dev/null || true
    fi
    append_jsonl "$JSONL" "$(jq -nc --arg at "$(now_iso)" \
        --argjson eid "$EPIC" \
        '{event:"subprocess_killed", at:$at, epic_id:$eid, signal:"SIGINT", reason:"manual_cancel"}')"
    release_lock
    exit 130
}
trap on_sigint INT TERM

# ---------------------------------------------------------------------------
# Main loop
# ---------------------------------------------------------------------------

acquire_lock
trap 'release_lock' EXIT

# Driver streaming UX (one structured line per event for /wf to surface)
emit() { printf '%s\n' "$1"; }

if [[ -f "$GATE" ]]; then
    emit "wf-run: gate.md already present at $GATE — halting (Stage 6)"
    exit 1
fi

while :; do
    if [[ -f "$GATE" ]]; then
        emit "wf-run: gate.md detected — halting"
        exit 1
    fi

    if all_done; then
        append_jsonl "$EPIC_LOG" "$(jq -nc --arg at "$(now_iso)" --argjson eid "$EPIC" \
            '{event:"epic_completed", at:$at, epic_id:$eid}')"
        emit "wf-run: epic E${EPIC} complete — every story status=done"
        exit 0
    fi

    sid="$(next_story_id)"
    if [[ -z "$sid" ]]; then
        emit "wf-run: no eligible pending story (all blocked on unsatisfied depends_on)"
        exit 1
    fi

    emit "wf-run: dispatching ${sid}"
    set_in_progress "$sid"

    if dispatch_story "$sid"; then
        # Subprocess succeeded — /wf:execute-story committed (status now done in plan.json
        # via the story commit transaction).
        emit "wf-run: ${sid} committed"
        continue
    fi

    rc=$?
    # Subprocess failed. Possibilities:
    #   - gate.md was written by the executor → Stage 6
    #   - subprocess crashed (no gate written) → revert + synthesise gate
    if [[ -f "$GATE" ]]; then
        emit "wf-run: ${sid} opened gate.md — halting"
        exit 1
    fi

    revert_to_pending "$sid"
    cat > "$GATE" <<EOF
---
epic_id: ${EPIC}
gate_type: story_gate
triggered_by: ["subprocess_crash"]
opened_at: $(now_iso)
---

# Story ${sid} — subprocess crash

The /wf:execute-story subprocess for ${sid} exited with code ${rc} without
writing gate.md. plan.json reverted to status=pending.

## Position

Investigate the dispatch.jsonl audit and the harness output before re-dispatching.
EOF
    emit "wf-run: ${sid} crashed (rc=${rc}) — synthetic gate.md written"
    exit 1
done
