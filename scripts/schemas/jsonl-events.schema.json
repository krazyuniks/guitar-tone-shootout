{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gts.local/schemas/jsonl-events.schema.json",
  "title": "GTS JSONL Event Log",
  "description": "Schema governing all JSONL event types in the V2 behavioural-validation workflow. Every line in epic.jsonl and story.jsonl conforms to one of the event types defined here.",
  "type": "object",
  "properties": {
    "schema_v": {
      "type": "integer",
      "const": 1,
      "description": "Schema version for future evolution."
    },
    "run_id": {
      "type": "string",
      "format": "uuid",
      "description": "UUID generated once when the orchestrator starts. Groups all events from one execution."
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp with timezone. Monotonically increasing within a run."
    },
    "event": {
      "type": "string",
      "enum": [
        "epic_started",
        "story_started",
        "agent_dispatched",
        "preflight_pass",
        "preflight_fail",
        "agent_complete",
        "agent_failed",
        "validation_pass",
        "validation_fail",
        "story_complete",
        "story_failed",
        "exit_to_human",
        "github_comment",
        "epic_complete"
      ],
      "description": "Event type identifier."
    }
  },
  "required": ["schema_v", "run_id", "ts", "event"],
  "allOf": [
    {
      "if": {
        "properties": {
          "event": {
            "enum": [
              "story_started",
              "agent_dispatched",
              "preflight_pass",
              "preflight_fail",
              "agent_complete",
              "agent_failed",
              "validation_pass",
              "validation_fail",
              "story_complete",
              "story_failed",
              "exit_to_human"
            ]
          }
        }
      },
      "then": {
        "required": ["story_id", "attempt"],
        "properties": {
          "story_id": {
            "type": "string",
            "minLength": 1,
            "description": "Story identifier from plan.json."
          },
          "attempt": {
            "type": "integer",
            "minimum": 1,
            "description": "Attempt number for this story (1-based). Increments on retry."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": { "const": "epic_started" }
        }
      },
      "then": {
        "required": ["epic", "stories"],
        "properties": {
          "epic": {
            "type": "integer",
            "minimum": 1,
            "description": "Epic (GitHub issue) number."
          },
          "stories": {
            "type": "integer",
            "minimum": 1,
            "description": "Total number of stories in the plan."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": { "const": "story_started" }
        }
      },
      "then": {
        "required": ["index"],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 1,
            "description": "Position in story execution order (1-based)."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": { "const": "agent_dispatched" }
        }
      },
      "then": {
        "required": ["model", "prompt_hash", "prompt_tokens", "skill_tokens"],
        "properties": {
          "model": {
            "type": "string",
            "description": "Claude model tier used for this dispatch."
          },
          "prompt_hash": {
            "type": "string",
            "description": "Hash of the prompt text for deduplication and debugging."
          },
          "prompt_tokens": {
            "type": "integer",
            "minimum": 0,
            "description": "Approximate token count of the prompt body (sections 1-7)."
          },
          "skill_tokens": {
            "type": "integer",
            "minimum": 0,
            "description": "Approximate token count of injected skill content."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": { "const": "agent_complete" }
        }
      },
      "then": {
        "required": ["commit", "turns", "cost_usd"],
        "properties": {
          "commit": {
            "type": "string",
            "description": "Git commit hash produced by the agent."
          },
          "turns": {
            "type": "integer",
            "minimum": 1,
            "description": "Number of conversation turns used."
          },
          "cost_usd": {
            "type": "number",
            "minimum": 0,
            "description": "Total cost in USD for this agent invocation."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": { "const": "agent_failed" }
        }
      },
      "then": {
        "required": ["error", "turns", "cost_usd"],
        "properties": {
          "error": {
            "type": "string",
            "description": "Error message or summary of the failure."
          },
          "turns": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of conversation turns used before failure."
          },
          "cost_usd": {
            "type": "number",
            "minimum": 0,
            "description": "Total cost in USD for this agent invocation."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": { "const": "validation_pass" }
        }
      },
      "then": {
        "required": ["check_type", "results"],
        "properties": {
          "check_type": {
            "type": "string",
            "enum": [
              "http",
              "http+dom",
              "browser+db",
              "api+response",
              "process",
              "screenshot",
              "regression",
              "quality"
            ],
            "description": "Type of validation check that was performed."
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/validation_result_item"
            },
            "description": "Per-criterion pass/fail results with evidence."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": { "const": "validation_fail" }
        }
      },
      "then": {
        "required": ["check_type", "results", "failure_category"],
        "properties": {
          "check_type": {
            "type": "string",
            "enum": [
              "http",
              "http+dom",
              "browser+db",
              "api+response",
              "process",
              "screenshot",
              "regression",
              "quality"
            ],
            "description": "Type of validation check that was performed."
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/validation_result_item"
            },
            "description": "Per-criterion pass/fail results with evidence."
          },
          "failure_category": {
            "$ref": "#/$defs/failure_category",
            "description": "Classification of the failure for retry policy."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": { "const": "preflight_fail" }
        }
      },
      "then": {
        "required": ["failure_category", "description"],
        "properties": {
          "failure_category": {
            "$ref": "#/$defs/failure_category",
            "description": "Classification of the pre-flight failure."
          },
          "description": {
            "type": "string",
            "description": "Human-readable description of what failed in pre-flight."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": { "const": "exit_to_human" }
        }
      },
      "then": {
        "required": ["reason", "failure_category", "context"],
        "properties": {
          "reason": {
            "type": "string",
            "description": "Short description of why the orchestrator is exiting to human."
          },
          "failure_category": {
            "$ref": "#/$defs/failure_category",
            "description": "Classification of the failure that triggered the exit."
          },
          "context": {
            "$ref": "#/$defs/exit_context",
            "description": "Rich diagnostic context for the human to diagnose without reading the full JSONL log."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": { "const": "github_comment" }
        }
      },
      "then": {
        "required": ["epic", "comment_url"],
        "properties": {
          "epic": {
            "type": "integer",
            "minimum": 1,
            "description": "Epic (GitHub issue) number."
          },
          "comment_url": {
            "type": "string",
            "format": "uri",
            "description": "URL of the posted GitHub comment."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": { "const": "epic_complete" }
        }
      },
      "then": {
        "required": ["epic", "stories_completed", "total_cost_usd"],
        "properties": {
          "epic": {
            "type": "integer",
            "minimum": 1,
            "description": "Epic (GitHub issue) number."
          },
          "stories_completed": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of stories that completed successfully."
          },
          "total_cost_usd": {
            "type": "number",
            "minimum": 0,
            "description": "Total cost in USD across all agent invocations."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": { "const": "story_complete" }
        }
      },
      "then": {
        "required": ["commit"],
        "properties": {
          "commit": {
            "type": "string",
            "description": "Git commit hash for the completed story."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": { "const": "story_failed" }
        }
      },
      "then": {
        "required": ["reason"],
        "properties": {
          "reason": {
            "type": "string",
            "description": "Summary of why the story failed."
          }
        }
      }
    }
  ],
  "$defs": {
    "failure_category": {
      "type": "string",
      "enum": ["env", "scope", "implementation", "unknown", "upstream"],
      "description": "Failure classification. 'env': infrastructure problem (0 retries). 'scope': plan references something wrong (2 retries). 'implementation': agent wrote incorrect code (2 retries). 'unknown': cannot classify (2 retries). 'upstream': failure traced to file owned by earlier story (0 retries, exit to human)."
    },
    "validation_result_item": {
      "type": "object",
      "properties": {
        "criterion": {
          "type": "string",
          "description": "The behaviour statement being verified."
        },
        "status": {
          "type": "string",
          "enum": ["pass", "fail"],
          "description": "Whether this criterion passed or failed."
        },
        "evidence": {
          "type": "object",
          "description": "Concrete evidence supporting the status. Required fields depend on check_type."
        }
      },
      "required": ["criterion", "status", "evidence"]
    },
    "exit_context": {
      "type": "object",
      "properties": {
        "story_id": {
          "type": "string",
          "description": "The story where the failure occurred."
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "description": "Which attempt failed."
        },
        "last_error": {
          "type": "string",
          "description": "The most recent error message."
        },
        "files_affected": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Files involved in the failure."
        },
        "jsonl_excerpt": {
          "type": "string",
          "description": "Relevant JSONL log lines for quick diagnosis."
        }
      },
      "required": ["story_id", "attempt", "last_error", "files_affected", "jsonl_excerpt"],
      "description": "Rich diagnostic context sufficient for a human to diagnose the failure without reading the full JSONL log."
    }
  }
}
