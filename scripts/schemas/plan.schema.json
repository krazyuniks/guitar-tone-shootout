{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gts.local/schemas/plan.schema.json",
  "title": "GTS Epic Plan",
  "description": "Machine-readable plan specification for the V2 behavioural-validation epic workflow. Governs the structure of plan.json files produced by the planner and consumed by the orchestrator.",
  "type": "object",
  "properties": {
    "schema_v": {
      "type": "integer",
      "const": 1,
      "description": "Schema version for future evolution."
    },
    "epic_number": {
      "type": "integer",
      "minimum": 1,
      "description": "GitHub issue number for the epic."
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "description": "Outcome-shaped goal statement from goal-backward analysis."
    },
    "observable_truths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/observable_truth"
      },
      "description": "User-perspective, verifiable-by-a-human truths that define 'done'."
    },
    "user_journeys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/user_journey"
      },
      "description": "Connected end-to-end narratives linking observable truths into coherent flows."
    },
    "stories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/story"
      },
      "description": "Ordered sequence of stories to execute. Each story is a coherent chunk an agent completes in one invocation."
    },
    "validation_checkpoints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/validation_checkpoint"
      },
      "description": "Strategic validation checkpoints placed after key stories. Not every story needs one."
    }
  },
  "required": [
    "schema_v",
    "epic_number",
    "goal",
    "observable_truths",
    "user_journeys",
    "stories",
    "validation_checkpoints"
  ],
  "additionalProperties": false,
  "$defs": {
    "observable_truth": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "description": "Unique identifier for this truth, referenced by stories and journeys."
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "description": "User-perspective, verifiable-by-a-human assertion. Not a technical requirement."
        }
      },
      "required": ["id", "statement"],
      "additionalProperties": false
    },
    "user_journey": {
      "type": "object",
      "properties": {
        "journey_id": {
          "type": "string",
          "pattern": "^J[0-9]+$",
          "description": "Journey identifier, e.g. 'J1', 'J2'."
        },
        "persona": {
          "type": "string",
          "minLength": 1,
          "description": "Who is performing this journey, e.g. 'authenticated user', 'guest'."
        },
        "narrative": {
          "type": "string",
          "minLength": 1,
          "description": "Connected end-to-end walkthrough in plain English, present tense, covering the happy path from entry point through all critical transitions."
        },
        "truths_covered": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "description": "IDs of observable truths exercised by this journey."
        },
        "entry_point": {
          "type": "string",
          "minLength": 1,
          "description": "URL path where this journey begins, e.g. '/'."
        },
        "critical_transitions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/critical_transition"
          },
          "description": "Key navigation or state transitions that must work for this journey to succeed."
        }
      },
      "required": [
        "journey_id",
        "persona",
        "narrative",
        "truths_covered",
        "entry_point",
        "critical_transitions"
      ],
      "additionalProperties": false
    },
    "critical_transition": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1,
          "description": "Source page or state, e.g. '/gear' or 'homepage'."
        },
        "to": {
          "type": "string",
          "minLength": 1,
          "description": "Target page or state, e.g. '/gear/{id}'."
        },
        "mechanism": {
          "type": "string",
          "minLength": 1,
          "description": "How the user transitions, e.g. 'nav link click', 'form submit', 'list item click'."
        }
      },
      "required": ["from", "to", "mechanism"],
      "additionalProperties": false
    },
    "story": {
      "type": "object",
      "properties": {
        "story_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "Unique story identifier, e.g. '01-architecture'. Used as directory name."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable story name."
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "description": "What this story delivers, 1-2 sentences."
        },
        "agent": {
          "$ref": "#/$defs/agent_config",
          "description": "Full agent dispatch specification."
        },
        "scope": {
          "$ref": "#/$defs/scope",
          "description": "Files to create and modify."
        },
        "state_assumption": {
          "type": "string",
          "enum": ["cumulative", "clean"],
          "default": "cumulative",
          "description": "'cumulative' means story expects data from all previous stories. 'clean' means orchestrator runs db-reset before dispatch."
        },
        "implementation_notes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Domain-specific hints from the planner to prevent common mistakes."
        },
        "truths_addressed": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "description": "IDs of observable truths this story contributes to."
        }
      },
      "required": [
        "story_id",
        "name",
        "purpose",
        "agent",
        "scope",
        "implementation_notes",
        "truths_addressed"
      ],
      "additionalProperties": false
    },
    "agent_config": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "enum": ["opus", "sonnet", "haiku"],
          "description": "Claude model tier for this agent."
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Skill names to inject into the agent's system prompt."
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Tools available to the agent, e.g. ['Read', 'Edit', 'Write', 'Bash', 'Glob', 'Grep']."
        },
        "mcp": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "MCP server names required, e.g. ['chrome-devtools', 'playwright']."
        },
        "max_turns": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum conversation turns for the agent."
        },
        "max_budget_usd": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Maximum spend in USD for this agent invocation."
        }
      },
      "required": ["model", "skills", "tools", "mcp", "max_turns", "max_budget_usd"],
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "properties": {
        "create": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "File paths to create (relative to project root)."
        },
        "modify": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "File paths to modify (relative to project root). Must exist on disk."
        }
      },
      "required": ["create", "modify"],
      "additionalProperties": false
    },
    "validation_checkpoint": {
      "type": "object",
      "properties": {
        "after_story": {
          "type": "string",
          "minLength": 1,
          "description": "References a story_id. This checkpoint runs after that story completes."
        },
        "check_type": {
          "type": "string",
          "enum": [
            "http",
            "http+dom",
            "browser+db",
            "api+response",
            "process",
            "screenshot",
            "regression",
            "quality"
          ],
          "description": "Type of validation check. Determines the model, MCP, and evidence fields required."
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/check_criterion"
          },
          "description": "Individual criteria to verify at this checkpoint."
        }
      },
      "required": ["after_story", "check_type", "checks"],
      "additionalProperties": false
    },
    "check_criterion": {
      "type": "object",
      "properties": {
        "criterion": {
          "type": "string",
          "minLength": 1,
          "description": "Natural-language behaviour statement to verify."
        },
        "evidence_fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "Required evidence fields for this criterion. Depends on the parent checkpoint's check_type."
        }
      },
      "required": ["criterion", "evidence_fields"],
      "additionalProperties": false
    }
  }
}
