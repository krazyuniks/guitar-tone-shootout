# syntax=docker/dockerfile:1
# GTS Audio Worker - dedicated process_audio consumer container

FROM python:3.14.3-slim

ARG UID=1000
ARG GID=1000

RUN apt-get update && apt-get install -y --no-install-recommends curl gnupg \
    && echo "deb http://apt.postgresql.org/pub/repos/apt trixie-pgdg main" \
       > /etc/apt/sources.list.d/pgdg.list \
    && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
       | gpg --dearmor -o /etc/apt/trusted.gpg.d/pgdg.gpg \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
    build-essential \
    ffmpeg \
    libsndfile1 \
    postgresql-client-18 \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -g $GID appgroup || true \
    && useradd -u $UID -g $GID -m -s /bin/bash appuser || true

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

RUN mkdir -p /app && chown appuser:appgroup /app
WORKDIR /app
USER appuser

COPY --chown=appuser:appgroup pyproject.toml uv.lock README.md ./
COPY --chown=appuser:appgroup libs/core/pyproject.toml libs/core/README.md libs/core/
COPY --chown=appuser:appgroup libs/audio/pyproject.toml libs/audio/README.md libs/audio/
COPY --chown=appuser:appgroup libs/video/pyproject.toml libs/video/README.md libs/video/
COPY --chown=appuser:appgroup sources/t3k/pyproject.toml sources/t3k/README.md sources/t3k/
COPY --chown=appuser:appgroup apps/webapp/pyproject.toml apps/webapp/README.md apps/webapp/
COPY --chown=appuser:appgroup apps/worker/pyproject.toml apps/worker/README.md apps/worker/
COPY --chown=appuser:appgroup apps/t3k_sync/pyproject.toml apps/t3k_sync/README.md apps/t3k_sync/
COPY --chown=appuser:appgroup apps/audio_worker/pyproject.toml apps/audio_worker/README.md apps/audio_worker/
COPY --chown=appuser:appgroup apps/video_worker/pyproject.toml apps/video_worker/README.md apps/video_worker/

RUN mkdir -p libs/core/src/core libs/audio/src/audio libs/video/src/video \
    sources/t3k/src/source_t3k \
    apps/webapp/src/webapp apps/worker/src/worker \
    apps/t3k_sync/src/t3k_sync apps/audio_worker/src/audio_worker apps/video_worker/src/video_worker \
    src/gts \
    && touch libs/core/src/core/__init__.py \
    && touch libs/audio/src/audio/__init__.py \
    && touch libs/video/src/video/__init__.py \
    && touch sources/t3k/src/source_t3k/__init__.py \
    && touch apps/webapp/src/webapp/__init__.py \
    && touch apps/worker/src/worker/__init__.py \
    && touch apps/t3k_sync/src/t3k_sync/__init__.py \
    && touch apps/audio_worker/src/audio_worker/__init__.py \
    && touch apps/video_worker/src/video_worker/__init__.py \
    && touch src/gts/__init__.py

RUN --mount=type=cache,target=/home/appuser/.cache/uv,uid=1000,gid=1000 \
    uv sync --frozen --all-packages

COPY --chown=appuser:appgroup src/gts src/gts/

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/app/.venv/bin:$PATH"

EXPOSE 8004

CMD ["uvicorn", "audio_worker.main:app", "--host", "0.0.0.0", "--port", "8004"]
