# syntax=docker/dockerfile:1
# GTS Backend - FastAPI web application with uv workspaces

# =============================================================================
# Build stage - Install dependencies
# =============================================================================
FROM python:3.14.3-slim AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install uv (pinned version for reproducibility)
COPY --from=ghcr.io/astral-sh/uv:0.10 /uv /uvx /bin/

# Set up environment for production builds
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_NO_DEV=1

WORKDIR /app

# Copy workspace configuration first for layer caching
# Dependencies change less frequently than source code
COPY pyproject.toml uv.lock ./
COPY libs/core/pyproject.toml libs/core/
COPY libs/audio/pyproject.toml libs/audio/
COPY apps/webapp/pyproject.toml apps/webapp/

# Create empty src directories for workspace resolution
RUN mkdir -p libs/core/src/core libs/audio/src/audio apps/webapp/src/webapp src/gts && \
    touch libs/core/src/core/__init__.py libs/audio/src/audio/__init__.py \
          apps/webapp/src/webapp/__init__.py src/gts/__init__.py

# Install dependencies only (no project yet for better caching)
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --package gts-webapp

# Copy source code
COPY libs/core/src libs/core/src/
COPY libs/audio/src libs/audio/src/
COPY apps/webapp/src apps/webapp/src/
COPY src/gts src/gts/

# Install project (non-editable for production)
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-editable --package gts-webapp

# Install gunicorn for production
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install gunicorn>=23.0.0

# =============================================================================
# Runtime stage - Minimal production image
# =============================================================================
FROM python:3.14.3-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libsndfile1 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --shell /bin/bash gts

WORKDIR /app

# Copy virtual environment from builder
COPY --from=builder /app/.venv /app/.venv

# Add venv to PATH
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Switch to non-root user
USER gts

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run with gunicorn + uvicorn workers for production
CMD ["gunicorn", "webapp.main:app", \
    "--bind", "0.0.0.0:8000", \
    "--workers", "4", \
    "--worker-class", "uvicorn.workers.UvicornWorker", \
    "--access-logfile", "-", \
    "--error-logfile", "-"]
