# syntax=docker/dockerfile:1
# GTS Video BC - Node.js 20 + Chromium + Python/uv for Remotion rendering
#
# This is a Bounded Context (BC) service that provides video rendering via Remotion.
# It runs independently from the worker, exposing an HTTP API for render requests.
# Worker calls this service via HTTP - no shared database or direct dependencies.

FROM python:3.14.3-slim

# Build args for user mapping (avoids root-owned files on bind mounts)
ARG UID=1000
ARG GID=1000

# Install Node.js 20 and system dependencies: Chromium for Remotion, build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    nodejs \
    # Chromium and dependencies for headless rendering
    chromium \
    chromium-sandbox \
    # Fonts for text rendering
    fonts-liberation \
    fonts-noto-color-emoji \
    # Build tools for native dependencies
    build-essential \
    curl \
    git \
    # Audio processing libraries (ffmpeg, libsndfile)
    ffmpeg \
    libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user with host UID/GID
RUN groupadd -g $GID appgroup || true \
    && useradd -u $UID -g $GID -m -s /bin/bash appuser || true

# Install uv (latest for development)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

# Copy workspace configuration
COPY pyproject.toml uv.lock README.md ./
COPY model/gts/pyproject.toml model/gts/README.md model/gts/
COPY model/audio/pyproject.toml model/audio/README.md model/audio/
COPY model/video/pyproject.toml model/video/README.md model/video/
COPY infra/messaging/pyproject.toml infra/messaging/README.md infra/messaging/
COPY sources/t3k/pyproject.toml sources/t3k/README.md sources/t3k/
COPY apps/webapp/pyproject.toml apps/webapp/README.md apps/webapp/
COPY apps/t3k_sync/pyproject.toml apps/t3k_sync/README.md apps/t3k_sync/
COPY apps/audio_worker/pyproject.toml apps/audio_worker/README.md apps/audio_worker/
COPY apps/video_worker/pyproject.toml apps/video_worker/README.md apps/video_worker/

# Create src directory structure for workspace resolution
RUN mkdir -p model/gts/src/gts model/audio/src/audio model/video/src/video \
    infra/messaging/src/messaging \
    sources/t3k/src/source_t3k \
    apps/webapp/src/webapp \
    apps/t3k_sync/src/t3k_sync apps/audio_worker/src/audio_worker apps/video_worker/src/video_worker \
    && touch model/gts/src/gts/__init__.py \
    && touch model/audio/src/audio/__init__.py \
    && touch model/video/src/video/__init__.py \
    && touch infra/messaging/src/messaging/__init__.py \
    && touch sources/t3k/src/source_t3k/__init__.py \
    && touch apps/webapp/src/webapp/__init__.py \
    && touch apps/t3k_sync/src/t3k_sync/__init__.py \
    && touch apps/audio_worker/src/audio_worker/__init__.py \
    && touch apps/video_worker/src/video_worker/__init__.py

# Install Python dependencies via uv (workspace members included)
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --all-packages

# Source code will be volume mounted at runtime for hot reload
# Copy placeholder __init__.py files for initial resolution
COPY model/video/src/video model/video/src/video/

# Set ownership of app directory to non-root user
RUN chown -R appuser:appgroup /app

# Environment
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/app/.venv/bin:$PATH" \
    # Chromium configuration for Remotion
    PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Switch to non-root user
USER appuser

# Expose internal port for HTTP API
EXPOSE 8002

# Default command: run video render service
# This will be overridden by docker-compose.yml to specify the actual service entrypoint
CMD ["uvicorn", "video.api:create_app", "--factory", "--host", "0.0.0.0", "--port", "8002"]
