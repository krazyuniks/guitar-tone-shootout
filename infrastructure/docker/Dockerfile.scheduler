# syntax=docker/dockerfile:1
# GTS Scheduler - TaskIQ cron job scheduler with uv workspaces

# =============================================================================
# Build stage - Install dependencies
# =============================================================================
FROM python:3.14.3-slim AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install uv (pinned version for reproducibility)
COPY --from=ghcr.io/astral-sh/uv:0.10 /uv /uvx /bin/

# Set up environment for production builds
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_NO_DEV=1

WORKDIR /app

# Copy workspace configuration first for layer caching
COPY pyproject.toml uv.lock ./
COPY model/gts/pyproject.toml model/gts/
COPY apps/scheduler/pyproject.toml apps/scheduler/

# Create empty src directories for workspace resolution
RUN mkdir -p model/gts/src/gts apps/scheduler/src/scheduler && \
    touch model/gts/src/gts/__init__.py apps/scheduler/src/scheduler/__init__.py

# Install dependencies only (no project yet for better caching)
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --package gts-scheduler

# Copy source code
COPY model/gts/src model/gts/src/
COPY apps/scheduler/src apps/scheduler/src/

# Install project (non-editable for production)
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-editable --package gts-scheduler

# =============================================================================
# Runtime stage - Minimal production image
# =============================================================================
FROM python:3.14.3-slim

# Create non-root user
RUN useradd --create-home --shell /bin/bash gts

WORKDIR /app

# Copy virtual environment from builder
COPY --from=builder /app/.venv /app/.venv

# Add venv to PATH
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Switch to non-root user
USER gts

# Run TaskIQ scheduler
CMD ["taskiq", "scheduler", "scheduler.main:scheduler"]
