# GTS Environment Configuration
# Copy to .env and fill in values

# =============================================================================
# Worktree Configuration
# =============================================================================

# Worktree name (main, 42-feature-name, etc.)
GTS_WORKTREE=main

# =============================================================================
# Docker User Mapping
# =============================================================================
# Run containers as your host user to avoid root-owned files on bind mounts.
# Set these to your host UID/GID (run `id -u` and `id -g` to find them).
# Defaults to 1000:1000 if not set.

UID=1000
GID=1000

# =============================================================================
# Database Configuration
# =============================================================================
#
# ARCHITECTURE: Dual database with worker as bridge
#   - gts_core: Main app database (webapp, worker, scheduler)
#   - gts_t3k_source: T3K source data (worker ONLY - not webapp!)
#
# The worker bridges databases via pgmq message queue.
# Webapp has NO direct access to gts_t3k_source.

# PostgreSQL password (shared between gts_core and gts_t3k_source)
DB_PASSWORD=gts_dev_password

# Database port (5432 for main, 5433+ for feature worktrees)
DB_PORT=5432

# Database URLs (constructed from components)
# DATABASE_URL=postgresql+asyncpg://gts:${DB_PASSWORD}@localhost:${DB_PORT}/gts_core
# T3K_DATABASE_URL=postgresql+asyncpg://gts:${DB_PASSWORD}@localhost:${DB_PORT}/gts_t3k_source  # Worker only!

# =============================================================================
# Redis Configuration
# =============================================================================

# Redis port (6379 for main, 6380+ for feature worktrees)
REDIS_PORT=6379

# Redis URL
# REDIS_URL=redis://localhost:${REDIS_PORT}

# =============================================================================
# Service Ports
# =============================================================================

# Backend port (8000 for main, 8010+ for feature worktrees)
BACKEND_PORT=8000

# nginx port (9000 for main, 9010+ for feature worktrees)
NGINX_PORT=9000

# =============================================================================
# Security
# =============================================================================

# Secret key for session signing (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=dev_secret_key_change_in_production

# OAuth token encryption key (must be exactly 32 bytes for Fernet)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_ENCRYPTION_KEY=dev_oauth_key_32_bytes_exactly!!

# =============================================================================
# Environment
# =============================================================================

# Environment name (development, staging, production)
ENV=development

# =============================================================================
# Storage Paths
# =============================================================================

# Upload storage (DI tracks, user uploads)
UPLOAD_PATH=/app/uploads

# Processed output storage (rendered audio, videos)
PROCESSED_PATH=/app/processed

# NAM models storage
NAM_MODELS_PATH=/app/models/nam

# IR files storage
IR_FILES_PATH=/app/models/ir

# =============================================================================
# T3K OAuth (for source adapter)
# =============================================================================

# T3K OAuth client ID (obtain from Tone3000)
# T3K_CLIENT_ID=

# T3K OAuth client secret (obtain from Tone3000)
# T3K_CLIENT_SECRET=

# T3K API base URL
# T3K_API_URL=https://api.tone3000.com
