{
  "permissions": {
    "allow": [
      "Bash(python3:*)",
      "Bash(source .venv/bin/activate)",
      "Bash(pip install:*)",
      "Bash(bd:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(GTS_ALLOW_MAIN_COMMIT=1 git commit:*)",
      "Bash(git push)",
      "Bash(git pull:*)",
      "Bash(git stash:*)",
      "WebFetch(domain:github.com)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bd prime 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": ".claude/hooks/sync-start.sh 2>/dev/null || true"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bd prime 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
