# compose.env — committed static defaults for docker compose
#
# Loaded by every docker compose invocation via `--env-file compose.env`.
# Contains only NON-secret, NON-worktree-specific values.
#   - Secrets live in env.local.sh (shell-sourced, gitignored).
#   - Worktree-specific values live in .env.worktree (auto-generated, gitignored).

ENV=development
GTS_STORAGE_ROOT=/app/storage

# Traefik fallbacks (overridden per-worktree in .env.worktree)
GTS_SUBDOMAIN=dev
GTS_ROUTER_NAME=gts-dev
