{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/usr/bin/zsh -lc \"sed -n '1,260p' woof/bin/woof\"","aggregated_output":"#!/usr/bin/env -S uv run --script\n# /// script\n# requires-python = \">=3.11\"\n# dependencies = [\"pyyaml>=6\", \"pydantic>=2\"]\n# ///\n\"\"\"woof — workflow orchestrator CLI.\n\nSubcommands:\n    validate     Validate artefacts against woof JSON Schemas via ajv-cli.\n    dispatch     Spawn a cld/cod subprocess for a role declared in agents.toml.\n    render-epic  Render EPIC.md front-matter into the gh issue body; optionally\n                 sync to GitHub with conflict detection (.last-sync).\n    check-cd     Verify each contract_decision's referenced artefact actually\n                 exists and parses (Stage 5 Check 4 / E146 regression).\n\nSchemas live at ``woof/schemas/*.schema.json`` (JSON Schema 2020-12).\nAuto-detection maps filename to schema; ``--schema`` overrides.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport hashlib\nimport json\nimport os\nimport re\nimport shutil\nimport subprocess\nimport sys\nimport tempfile\nimport tomllib\nfrom datetime import datetime, timezone\nfrom pathlib import Path\n\nimport yaml\n\nREPO_ROOT = Path(__file__).resolve().parents[2]\nSCHEMA_DIR = REPO_ROOT / \"woof\" / \"schemas\"\n\nSCHEMAS: dict[str, str] = {\n    \"epic\": \"epic.schema.json\",\n    \"plan\": \"plan.schema.json\",\n    \"gate\": \"gate.schema.json\",\n    \"critique\": \"critique.schema.json\",\n    \"jsonl-events\": \"jsonl-events.schema.json\",\n    \"prerequisites\": \"prerequisites.schema.json\",\n    \"agents\": \"agents.schema.json\",\n    \"test-markers\": \"test-markers.schema.json\",\n    \"language-registry\": \"language-registry.schema.json\",\n    \"quality-gates\": \"quality-gates.schema.json\",\n    \"docs-paths\": \"docs-paths.schema.json\",\n}\n\n# Filename → schema (basename match)\nFILENAME_RULES: list[tuple[re.Pattern[str], str]] = [\n    (re.compile(r\"^EPIC\\.md$\"), \"epic\"),\n    (re.compile(r\"^plan\\.json$\"), \"plan\"),\n    (re.compile(r\"^gate\\.md$\"), \"gate\"),\n    (re.compile(r\"^.+\\.jsonl$\"), \"jsonl-events\"),\n    (re.compile(r\"^prerequisites\\.toml$\"), \"prerequisites\"),\n    (re.compile(r\"^agents\\.toml$\"), \"agents\"),\n    (re.compile(r\"^test-markers\\.toml$\"), \"test-markers\"),\n    (re.compile(r\"^quality-gates\\.toml$\"), \"quality-gates\"),\n    (re.compile(r\"^docs-paths\\.toml$\"), \"docs-paths\"),\n]\n\n# Path-suffix → schema (for files distinguished by parent dir)\nPATH_RULES: list[tuple[re.Pattern[str], str]] = [\n    (re.compile(r\"(^|/)critique/[^/]+\\.md$\"), \"critique\"),\n    (re.compile(r\"(^|/)languages/[^/]+\\.toml$\"), \"language-registry\"),\n]\n\n\ndef detect_schema(path: Path) -> str | None:\n    \"\"\"Return schema name for ``path`` or None if no rule matches.\"\"\"\n    name = path.name\n    for pattern, schema in FILENAME_RULES:\n        if pattern.match(name):\n            return schema\n    posix = path.as_posix()\n    for pattern, schema in PATH_RULES:\n        if pattern.search(posix):\n            return schema\n    return None\n\n\ndef extract_front_matter(path: Path) -> object:\n    \"\"\"Parse YAML front-matter (delimited by ``---`` on its own line).\"\"\"\n    text = path.read_text()\n    if not text.startswith(\"---\\n\"):\n        raise ValueError(f\"{path}: no YAML front-matter (file must start with '---\\\\n')\")\n    end = text.find(\"\\n---\\n\", 4)\n    if end < 0:\n        end_alt = text.find(\"\\n---\", 4)\n        if end_alt < 0 or text[end_alt:].rstrip() != \"---\":\n            raise ValueError(f\"{path}: unterminated YAML front-matter\")\n        end = end_alt\n    block = text[4:end]\n    return yaml.safe_load(block) or {}\n\n\ndef load_payload(path: Path, schema: str) -> object:\n    \"\"\"Extract the structured payload appropriate for ``schema``.\"\"\"\n    if schema in {\"epic\", \"gate\", \"critique\"}:\n        return extract_front_matter(path)\n    if schema == \"plan\":\n        return json.loads(path.read_text())\n    if schema in {\n        \"prerequisites\",\n        \"agents\",\n        \"test-markers\",\n        \"language-registry\",\n        \"quality-gates\",\n        \"docs-paths\",\n    }:\n        with path.open(\"rb\") as fh:\n            return tomllib.load(fh)\n    raise ValueError(f\"load_payload: unhandled schema '{schema}'\")\n\n\ndef run_ajv(schema_path: Path, data_json: bytes) -> tuple[bool, str]:\n    \"\"\"Run ajv-cli; return (ok, combined-output).\"\"\"\n    with tempfile.NamedTemporaryFile(\"wb\", suffix=\".json\", delete=False) as fh:\n        fh.write(data_json)\n        data_path = fh.name\n    try:\n        proc = subprocess.run(\n            [\n                \"ajv\",\n                \"validate\",\n                \"--spec=draft2020\",\n                \"-c\",\n                \"ajv-formats\",\n                \"-s\",\n                str(schema_path),\n                \"-d\",\n                data_path,\n            ],\n            capture_output=True,\n            text=True,\n        )\n    finally:\n        Path(data_path).unlink(missing_ok=True)\n    output = (proc.stdout + proc.stderr).strip()\n    return proc.returncode == 0, output\n\n\ndef ensure_ajv() -> None:\n    \"\"\"Exit non-zero if ajv-cli is not on PATH.\"\"\"\n    if shutil.which(\"ajv\") is None:\n        sys.stderr.write(\n            \"woof: ajv-cli not found on PATH.\\n\"\n            \"Install: volta install ajv-cli ajv-formats\\n\"\n        )\n        sys.exit(2)\n\n\ndef validate_jsonl(path: Path, schema_path: Path) -> tuple[bool, list[str]]:\n    \"\"\"Validate every non-blank line of a JSONL file.\"\"\"\n    messages: list[str] = []\n    all_ok = True\n    line_count = 0\n    for lineno, raw in enumerate(path.read_text().splitlines(), 1):\n        line = raw.strip()\n        if not line:\n            continue\n        line_count += 1\n        try:\n            payload = json.loads(line)\n        except json.JSONDecodeError as exc:\n            all_ok = False\n            messages.append(f\"{path}:{lineno}: invalid JSON: {exc}\")\n            continue\n        ok, output = run_ajv(schema_path, json.dumps(payload, default=str).encode())\n        if not ok:\n            all_ok = False\n            messages.append(f\"{path}:{lineno}: INVALID\\n{output}\")\n    if all_ok:\n        messages.append(f\"{path}: valid (jsonl-events, {line_count} line(s))\")\n    return all_ok, messages\n\n\ndef validate_path(path: Path, schema_override: str | None) -> tuple[bool, list[str]]:\n    \"\"\"Validate one file. Returns ``(ok, messages)``.\"\"\"\n    schema = schema_override or detect_schema(path)\n    if schema is None:\n        return False, [f\"{path}: no schema rule matches; pass --schema explicitly\"]\n    if schema not in SCHEMAS:\n        return False, [f\"{path}: unknown schema '{schema}'\"]\n    schema_path = SCHEMA_DIR / SCHEMAS[schema]\n\n    if schema == \"jsonl-events\":\n        return validate_jsonl(path, schema_path)\n\n    try:\n        payload = load_payload(path, schema)\n    except (ValueError, json.JSONDecodeError, yaml.YAMLError, tomllib.TOMLDecodeError) as exc:\n        return False, [f\"{path}: parse error: {exc}\"]\n\n    ok, output = run_ajv(schema_path, json.dumps(payload, default=str).encode())\n    msg = f\"{path}: {'valid' if ok else 'INVALID'} ({schema})\"\n    if not ok:\n        msg += \"\\n\" + output\n    return ok, [msg]\n\n\ndef cmd_validate(args: argparse.Namespace) -> int:\n    ensure_ajv()\n    overall_ok = True\n    for raw in args.paths:\n        path = Path(raw)\n        if not path.is_file():\n            sys.stderr.write(f\"woof: {raw}: not a file\\n\")\n            overall_ok = False\n            continue\n        ok, messages = validate_path(path, args.schema)\n        for line in messages:\n            print(line)\n        if not ok:\n            overall_ok = False\n    return 0 if overall_ok else 1\n\n\n# ---------------------------------------------------------------------------\n# dispatch\n# ---------------------------------------------------------------------------\n\nHARNESS_BY_TARGET = {\"claude\": \"cld\", \"codex\": \"cod\"}\nSTORY_ID_RE = re.compile(r\"^S[1-9]\\d*$\")\n\n\ndef find_woof_root(start: Path) -> Path:\n    \"\"\"Walk up from ``start`` to the first directory containing ``.woof/``.\"\"\"\n    for candidate in (start, *start.parents):\n        if (candidate / \".woof\").is_dir():\n            return candidate\n    sys.stderr.write(\n        f\"woof: no .woof/ directory found at or above {start}; not a woof project\\n\"\n    )\n    sys.exit(2)\n\n\ndef iso_utc(dt: datetime) -> str:\n    return dt.astimezone(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n\n\ndef append_jsonl(path: Path, event: dict) -> None:\n    path.parent.mkdir(parents=True, exist_ok=True)\n    with path.open(\"a\", encoding=\"utf-8\") as fh:\n        fh.write(json.dumps(event, separators=(\",\", \":\")) + \"\\n\")\n\n\ndef parse_claude_output(stdout: str) -> tuple[dict, str | None]:\n    \"\"\"Extract token usage and session_id from ``claude -p --output-format json``.\"\"\"\n    lines = [ln for ln in stdout.strip().splitlines() if ln.strip()]\n    if not lines:\n        return {}, None\n    try:\n        data = json.loads(lines[-1])\n    except json.JSONDecodeError:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/usr/bin/zsh -lc \"sed -n '1,260p' scripts/wf-run\"","aggregated_output":"#!/usr/bin/env bash\n# wf-run — woof Stage-5 driver loop.\n#\n# Spawns one /wf:execute-story subprocess per pending story (via\n# `woof dispatch claude --role story-executor`) until either a gate.md\n# appears or every story is `status: done`.\n#\n# Exit codes:\n#   0   epic complete (all stories done; no gate)\n#   1   gate.md exists; halt for /wf Stage 6\n#   2   driver / preflight error (lockfile, malformed plan.json, missing tool)\n#   130 SIGINT propagated to subprocess\n\nset -euo pipefail\n\nREPO_ROOT=\"$(git rev-parse --show-toplevel)\"\nWOOF_BIN=\"$REPO_ROOT/woof/bin/woof\"\n\nusage() {\n    cat <<'EOF'\nUsage: scripts/wf-run --epic <N>\n\nDrives Stage 5 for epic E<N> by dispatching /wf:execute-story per pending story.\nReads .woof/agents.toml for the story-executor role; honours the lockfile at\n.woof/epics/E<N>/.wf.lock.\nEOF\n}\n\nEPIC=\"\"\nwhile [[ $# -gt 0 ]]; do\n    case \"$1\" in\n        --epic) EPIC=\"$2\"; shift 2;;\n        -h|--help) usage; exit 0;;\n        *) echo \"wf-run: unknown arg '$1'\" >&2; usage >&2; exit 2;;\n    esac\ndone\n\n[[ -n \"$EPIC\" ]] || { echo \"wf-run: --epic required\" >&2; exit 2; }\n[[ \"$EPIC\" =~ ^[1-9][0-9]*$ ]] || { echo \"wf-run: --epic must be a positive integer\" >&2; exit 2; }\n\nEPIC_DIR=\"$REPO_ROOT/.woof/epics/E${EPIC}\"\nPLAN=\"$EPIC_DIR/plan.json\"\nGATE=\"$EPIC_DIR/gate.md\"\nLOCK=\"$EPIC_DIR/.wf.lock\"\nJSONL=\"$EPIC_DIR/dispatch.jsonl\"\nEPIC_LOG=\"$EPIC_DIR/epic.jsonl\"\n\n[[ -f \"$PLAN\" ]] || { echo \"wf-run: $PLAN not found\" >&2; exit 2; }\n[[ -f \"$REPO_ROOT/.woof/agents.toml\" ]] || { echo \"wf-run: .woof/agents.toml not found\" >&2; exit 2; }\n\ncommand -v jq >/dev/null || { echo \"wf-run: jq required\" >&2; exit 2; }\n[[ -x \"$WOOF_BIN\" ]] || { echo \"wf-run: $WOOF_BIN not executable\" >&2; exit 2; }\n\n# ---------------------------------------------------------------------------\n# Lockfile\n# ---------------------------------------------------------------------------\n\nacquire_lock() {\n    if [[ -f \"$LOCK\" ]]; then\n        local pid\n        pid=\"$(jq -r '.pid' \"$LOCK\" 2>/dev/null || echo \"\")\"\n        if [[ -n \"$pid\" ]] && kill -0 \"$pid\" 2>/dev/null; then\n            local started host invoker\n            started=\"$(jq -r '.started_at' \"$LOCK\")\"\n            host=\"$(jq -r '.host' \"$LOCK\")\"\n            invoker=\"$(jq -r '.invoker' \"$LOCK\")\"\n            echo \"wf-run: another woof process holds the lock\" >&2\n            echo \"  pid=$pid invoker=$invoker host=$host started=$started\" >&2\n            echo \"  wait or 'kill $pid', then retry.\" >&2\n            exit 2\n        fi\n        echo \"wf-run: stale lockfile (pid $pid not alive); reclaiming.\" >&2\n    fi\n    jq -n --arg pid \"$$\" --arg invoker \"wf-run\" \\\n        --arg started \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\" \\\n        --arg host \"$(hostname)\" \\\n        '{pid: ($pid|tonumber), invoker: $invoker, started_at: $started, host: $host}' \\\n        > \"$LOCK\"\n}\n\nrelease_lock() {\n    rm -f \"$LOCK\"\n}\n\n# ---------------------------------------------------------------------------\n# JSONL append\n# ---------------------------------------------------------------------------\n\nappend_jsonl() {\n    local path=\"$1\"; shift\n    mkdir -p \"$(dirname \"$path\")\"\n    printf '%s\\n' \"$1\" >> \"$path\"\n}\n\nnow_iso() { date -u +%Y-%m-%dT%H:%M:%SZ; }\n\n# ---------------------------------------------------------------------------\n# Plan helpers\n# ---------------------------------------------------------------------------\n\nnext_story_id() {\n    # First pending story whose depends_on are all done.\n    jq -r '\n        . as $root\n        | .stories\n        | map(select(.status == \"pending\"))\n        | map(select(\n            (.depends_on // [])\n            | all(. as $dep | ($root.stories[] | select(.id == $dep) | .status) == \"done\")\n        ))\n        | sort_by(.id)\n        | (first // empty).id // empty\n    ' \"$PLAN\"\n}\n\nall_done() {\n    local n\n    n=\"$(jq '[.stories[] | select(.status != \"done\")] | length' \"$PLAN\")\"\n    [[ \"$n\" == \"0\" ]]\n}\n\nset_in_progress() {\n    local sid=\"$1\" tmp\n    tmp=\"$(mktemp)\"\n    jq --arg sid \"$sid\" \\\n        '(.stories[] | select(.id == $sid) | .status) = \"in_progress\"' \\\n        \"$PLAN\" > \"$tmp\"\n    mv \"$tmp\" \"$PLAN\"\n}\n\nrevert_to_pending() {\n    local sid=\"$1\" tmp\n    tmp=\"$(mktemp)\"\n    jq --arg sid \"$sid\" \\\n        '(.stories[] | select(.id == $sid) | .status) = \"pending\"' \\\n        \"$PLAN\" > \"$tmp\"\n    mv \"$tmp\" \"$PLAN\"\n}\n\n# ---------------------------------------------------------------------------\n# Dispatch one story\n# ---------------------------------------------------------------------------\n\nbootstrap_prompt() {\n    local sid=\"$1\"\n    cat <<EOF\nYou are executing story ${sid} in epic E${EPIC}.\n\nRead in order:\n  1. .woof/.current-epic (verify E${EPIC})\n  2. .woof/epics/E${EPIC}/plan.json (find ${sid})\n  3. .woof/epics/E${EPIC}/EPIC.md (front-matter for outcomes / contract decisions)\n  4. CLAUDE.md / AGENTS.md (project conventions)\n\nThen invoke /wf:execute-story with arguments \"E${EPIC} ${sid}\".\n\nExit 0 only after the story commit transaction lands. Exit non-zero only after\nwriting .woof/epics/E${EPIC}/gate.md.\nEOF\n}\n\ndispatch_story() {\n    local sid=\"$1\" prompt_file\n    prompt_file=\"$(mktemp)\"\n    bootstrap_prompt \"$sid\" > \"$prompt_file\"\n\n    append_jsonl \"$EPIC_LOG\" \"$(jq -nc \\\n        --arg at \"$(now_iso)\" --argjson eid \"$EPIC\" --arg sid \"$sid\" \\\n        '{event:\"story_started\", at:$at, epic_id:$eid, story_id:$sid}')\"\n\n    set +e\n    \"$WOOF_BIN\" dispatch claude \\\n        --role story-executor --epic \"$EPIC\" --story \"$sid\" \\\n        --prompt-file \"$prompt_file\"\n    local rc=$?\n    set -e\n    rm -f \"$prompt_file\"\n    return \"$rc\"\n}\n\n# ---------------------------------------------------------------------------\n# SIGINT propagation\n# ---------------------------------------------------------------------------\n\nCHILD_PID=\"\"\non_sigint() {\n    if [[ -n \"$CHILD_PID\" ]]; then\n        kill -INT \"$CHILD_PID\" 2>/dev/null || true\n        wait \"$CHILD_PID\" 2>/dev/null || true\n    fi\n    append_jsonl \"$JSONL\" \"$(jq -nc --arg at \"$(now_iso)\" \\\n        --argjson eid \"$EPIC\" \\\n        '{event:\"subprocess_killed\", at:$at, epic_id:$eid, signal:\"SIGINT\", reason:\"manual_cancel\"}')\"\n    release_lock\n    exit 130\n}\ntrap on_sigint INT TERM\n\n# ---------------------------------------------------------------------------\n# Main loop\n# ---------------------------------------------------------------------------\n\nacquire_lock\ntrap 'release_lock' EXIT\n\n# Driver streaming UX (one structured line per event for /wf to surface)\nemit() { printf '%s\\n' \"$1\"; }\n\nif [[ -f \"$GATE\" ]]; then\n    emit \"wf-run: gate.md already present at $GATE — halting (Stage 6)\"\n    exit 1\nfi\n\nwhile :; do\n    if [[ -f \"$GATE\" ]]; then\n        emit \"wf-run: gate.md detected — halting\"\n        exit 1\n    fi\n\n    if all_done; then\n        append_jsonl \"$EPIC_LOG\" \"$(jq -nc --arg at \"$(now_iso)\" --argjson eid \"$EPIC\" \\\n            '{event:\"epic_completed\", at:$at, epic_id:$eid}')\"\n        emit \"wf-run: epic E${EPIC} complete — every story status=done\"\n        exit 0\n    fi\n\n    sid=\"$(next_story_id)\"\n    if [[ -z \"$sid\" ]]; then\n        emit \"wf-run: no eligible pending story (all blocked on unsatisfied depends_on)\"\n        exit 1\n    fi\n\n    emit \"wf-run: dispatching ${sid}\"\n    set_in_progress \"$sid\"\n\n    if dispatch_story \"$sid\"; then\n        # Subprocess succeeded — /wf:execute-story committed (status now done in plan.json\n        # via the story commit transaction).\n        emit \"wf-run: ${sid} committed\"\n        continue\n    fi\n\n    rc=$?\n    # Subprocess failed. Possibilities:\n    #   - gate.md was written by the executor → Stage 6\n    #   - subprocess crashed (no gate written) → revert + synthesise gate\n    if [[ -f \"$GATE\" ]]; then\n        emit \"wf-run: ${sid} opened gate.md — halting\"\n        exit 1\n    fi\n\n    revert_to_pending \"$sid\"\n    cat > \"$GATE\" <<EOF\n---\ntype: story_gate\nstage: 6\nstory_id: ${sid}\ntriggered_by:\n  - subprocess_crash\ntimestamp: \"$(now_iso)\"\n","exit_code":0,"status":"completed"}}
