  registry = BlockTypeRegistry(session)\ntests/unit/backend/services/test_block_type_registry.py:160:        block_types = await registry.get_all_builtin_types()\ntests/unit/backend/services/test_block_type_registry.py:173:    async def test_registry_returns_same_instances_on_multiple_calls(\ntests/unit/backend/services/test_block_type_registry.py:177:        \"\"\"Test registry returns consistent data on multiple calls.\"\"\"\ntests/unit/backend/services/test_block_type_registry.py:178:        from webapp.services.block_type_registry import BlockTypeRegistry\ntests/unit/backend/services/test_block_type_registry.py:180:        registry = BlockTypeRegistry(session)\ntests/unit/backend/services/test_block_type_registry.py:183:        first_call = await registry.get_all_builtin_types()\ntests/unit/backend/services/test_block_type_registry.py:184:        second_call = await registry.get_all_builtin_types()\ntests/unit/backend/services/test_block_type_registry.py:194:    async def test_registry_builtin_types_have_default_params(\ntests/unit/backend/services/test_block_type_registry.py:199:        from webapp.services.block_type_registry import BlockTypeRegistry\ntests/unit/backend/services/test_block_type_registry.py:201:        registry = BlockTypeRegistry(session)\ntests/unit/backend/services/test_block_type_registry.py:202:        block_types = await registry.get_all_builtin_types()\n","exit_code":0,"status":"completed"}}
