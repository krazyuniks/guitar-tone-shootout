{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/usr/bin/zsh -lc \"sed -n '1,260p' woof/schemas/gate.schema.json\"","aggregated_output":"{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"https://woof.dev/schemas/gate.schema.json\",\n  \"title\": \"woof gate front-matter\",\n  \"description\": \"YAML front-matter of .woof/epics/E<N>/gate.md. Validates the structured header only; the prose sections (## Context, ## Findings, ## Claude's position) are unconstrained markdown. The gate.md represents an OPEN gate; resolution is recorded as a jsonl event with a decision drawn from the taxonomy in jsonl-events.schema.json (gate_resolved.decision).\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\"type\", \"stage\", \"story_id\", \"triggered_by\", \"timestamp\"],\n  \"properties\": {\n    \"type\": {\n      \"type\": \"string\",\n      \"enum\": [\"plan_gate\", \"story_gate\", \"review_gate\"],\n      \"description\": \"plan_gate (Stage 4, always opens). story_gate (Stage 6, conditional on Stage 5 check failure or critique blocker). review_gate (periodic; opens every-N stories or before epic close to surface accumulated minor critique findings).\"\n    },\n    \"stage\": {\n      \"type\": \"integer\",\n      \"enum\": [4, 5, 6],\n      \"description\": \"Stage that wrote the gate. plan_gate=4, story_gate=6, review_gate=5 (post-story rollup) or 6 (end-of-epic).\"\n    },\n    \"story_id\": {\n      \"oneOf\": [\n        { \"type\": \"string\", \"pattern\": \"^S[1-9]\\\\d*$\" },\n        { \"type\": \"null\" }\n      ],\n      \"description\": \"Story this gate is for. Required (non-null) when type=story_gate; null for plan_gate. For review_gate, may be null (end-of-epic) or the boundary story (every-N rollup).\"\n    },\n    \"triggered_by\": {\n      \"type\": \"array\",\n      \"minItems\": 1,\n      \"uniqueItems\": true,\n      \"items\": {\n        \"type\": \"string\",\n        \"enum\": [\n          \"plan_review\",\n          \"check_1_quality_gate\",\n          \"check_2_spec_coverage\",\n          \"check_3_scope\",\n          \"check_4_contract\",\n          \"check_5_plan_integrity\",\n          \"check_6_critique_blocker\",\n          \"check_7_completion\",\n          \"check_8_docs_drift\",\n          \"check_9_periodic_review\",\n          \"empty_diff_review\",\n          \"timeout\",\n          \"subprocess_crash\",\n          \"codex_unreachable\",\n          \"incomplete_subprocess\",\n          \"schema_validation_failed\",\n          \"github_sync_conflict\",\n          \"manual\"\n        ]\n      },\n      \"description\": \"Reasons the gate opened. plan_review fires automatically at Stage 4 (gate always opens). check_1..check_9 map to Stage 5 deterministic failure classes (1-8 are A-H from the failure-class taxonomy; 9 is the periodic-review valve). empty_diff_review opens when a story finishes with no diff. Driver-level: timeout, subprocess_crash (with exit_code), codex_unreachable, incomplete_subprocess. schema_validation_failed when Stage 3 self-validation exhausts the 2-attempt cap. github_sync_conflict when push detects remote-issue changes. manual for human-opened gates.\"\n    },\n    \"timestamp\": {\n      \"type\": \"string\",\n      \"format\": \"date-time\"\n    },\n    \"exit_code\": {\n      \"type\": \"integer\",\n      \"description\": \"Subprocess exit code. Required when triggered_by contains subprocess_crash.\"\n    },\n    \"harness_session_id\": {\n      \"type\": \"string\",\n      \"minLength\": 1,\n      \"description\": \"CC session UUID or Codex audit-file path of the subprocess that caused the gate.\"\n    }\n  },\n  \"allOf\": [\n    {\n      \"if\": {\n        \"properties\": { \"type\": { \"const\": \"plan_gate\" } },\n        \"required\": [\"type\"]\n      },\n      \"then\": {\n        \"properties\": {\n          \"stage\": { \"const\": 4 },\n          \"story_id\": { \"type\": \"null\" }\n        }\n      }\n    },\n    {\n      \"if\": {\n        \"properties\": { \"type\": { \"const\": \"story_gate\" } },\n        \"required\": [\"type\"]\n      },\n      \"then\": {\n        \"properties\": {\n          \"stage\": { \"const\": 6 },\n          \"story_id\": { \"type\": \"string\", \"pattern\": \"^S[1-9]\\\\d*$\" }\n        }\n      }\n    },\n    {\n      \"if\": {\n        \"properties\": {\n          \"triggered_by\": {\n            \"type\": \"array\",\n            \"contains\": { \"const\": \"subprocess_crash\" }\n          }\n        },\n        \"required\": [\"triggered_by\"]\n      },\n      \"then\": {\n        \"required\": [\"exit_code\"]\n      }\n    }\n  ]\n}\n","exit_code":0,"status":"completed"}}
