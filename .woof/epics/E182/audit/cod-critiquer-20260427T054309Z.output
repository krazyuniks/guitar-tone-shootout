{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/usr/bin/zsh -lc \"sed -n '1,260p' woof/schemas/jsonl-events.schema.json\"","aggregated_output":"{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"https://woof.dev/schemas/jsonl-events.schema.json\",\n  \"title\": \"woof JSONL event\",\n  \"description\": \"One line of .woof/epics/E<N>/epic.jsonl (stage-level narrative) or .woof/epics/E<N>/dispatch.jsonl (subprocess events). Both streams share this schema; the event field discriminates. Per-event payload fields validate via the conditional rules in allOf. Cross-line invariants (subprocess_returned matches a prior subprocess_spawned by pid; gate_resolved follows gate_opened; status transitions are monotonic) are helper-enforced, not schema-enforced.\",\n  \"type\": \"object\",\n  \"additionalProperties\": true,\n  \"required\": [\"event\", \"at\"],\n  \"properties\": {\n    \"event\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"spark_created\",\n        \"discovery_started\",\n        \"discovery_synthesised\",\n        \"definition_started\",\n        \"definition_closed\",\n        \"plan_generated\",\n        \"plan_critiqued\",\n        \"plan_gate_opened\",\n        \"plan_gate_resolved\",\n        \"story_started\",\n        \"story_completed\",\n        \"story_gate_opened\",\n        \"story_gate_resolved\",\n        \"review_gate_opened\",\n        \"review_gate_resolved\",\n        \"epic_completed\",\n        \"subprocess_spawned\",\n        \"subprocess_returned\",\n        \"subprocess_killed\",\n        \"preflight_run\",\n        \"github_synced\",\n        \"github_sync_conflict\",\n        \"cartography_refreshed\",\n        \"token_usage\"\n      ],\n      \"description\": \"Event kind. Stage events (epic.jsonl): spark_created, discovery_*, definition_*, plan_*, story_*, *_gate_*, epic_completed. Dispatch events (dispatch.jsonl): subprocess_*. Operational events (either): preflight_run, github_synced, github_sync_conflict, cartography_refreshed, token_usage.\"\n    },\n    \"at\": {\n      \"type\": \"string\",\n      \"format\": \"date-time\",\n      \"description\": \"ISO 8601 timestamp the event occurred.\"\n    },\n    \"epic_id\": {\n      \"type\": \"integer\",\n      \"minimum\": 1,\n      \"description\": \"Epic this event belongs to (gh issue number).\"\n    },\n    \"story_id\": {\n      \"type\": \"string\",\n      \"pattern\": \"^S[1-9]\\\\d*$\"\n    },\n    \"role\": {\n      \"type\": \"string\",\n      \"enum\": [\"orchestrator\", \"planner\", \"story-executor\", \"critiquer\", \"gate-resolver\"],\n      \"description\": \"Role from .woof/agents.toml under which a subprocess was dispatched.\"\n    },\n    \"harness\": {\n      \"type\": \"string\",\n      \"enum\": [\"cld\", \"cod\", \"in-session\"],\n      \"description\": \"Wrapper that spawned the subprocess (or in-session for orchestrator/gate-resolver).\"\n    },\n    \"model\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"pid\": {\n      \"type\": \"integer\",\n      \"minimum\": 1\n    },\n    \"exit_code\": {\n      \"type\": \"integer\"\n    },\n    \"duration_ms\": {\n      \"type\": \"integer\",\n      \"minimum\": 0\n    },\n    \"signal\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"reason\": {\n      \"type\": \"string\",\n      \"minLength\": 1,\n      \"description\": \"Free-form reason. Used by subprocess_killed (timeout, manual_cancel, ...). Gate resolution events use the structured 'decision' field instead.\"\n    },\n    \"decision\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"approve\",\n        \"revise_epic_contract\",\n        \"revise_plan\",\n        \"revise_story_scope\",\n        \"split_story\",\n        \"abandon_story\",\n        \"abandon_epic\"\n      ],\n      \"description\": \"Gate resolution decision. approve = proceed. revise_epic_contract = re-enter Stage 2. revise_plan = re-enter Stage 3. revise_story_scope = edit current story's paths or satisfies. split_story = replace one story with multiple. abandon_story = skip and continue. abandon_epic = mark incomplete + close gh issue with note.\"\n    },\n    \"cc_session_id\": {\n      \"type\": \"string\",\n      \"pattern\": \"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$\",\n      \"description\": \"CC session UUID. Cross-link into ~/.claude/projects/<slug>/<uuid>.jsonl.\"\n    },\n    \"codex_audit_path\": {\n      \"type\": \"string\",\n      \"minLength\": 1,\n      \"description\": \"Path under .woof/epics/E<N>/audit/ where Codex prompt+output+meta were tee'd.\"\n    },\n    \"empty_diff\": {\n      \"type\": \"boolean\"\n    },\n    \"commit_sha\": {\n      \"type\": \"string\",\n      \"pattern\": \"^[0-9a-f]{7,40}$\"\n    },\n    \"gate_type\": {\n      \"type\": \"string\",\n      \"enum\": [\"plan_gate\", \"story_gate\", \"review_gate\"]\n    },\n    \"triggered_by\": {\n      \"type\": \"array\",\n      \"items\": { \"type\": \"string\" },\n      \"minItems\": 1,\n      \"uniqueItems\": true,\n      \"description\": \"Mirrors gate.md.triggered_by[] when emitting *_gate_opened.\"\n    },\n    \"tokens_in\": {\n      \"type\": \"integer\",\n      \"minimum\": 0,\n      \"description\": \"Prompt tokens. Used by token_usage events and post-subprocess summaries.\"\n    },\n    \"tokens_out\": {\n      \"type\": \"integer\",\n      \"minimum\": 0,\n      \"description\": \"Completion tokens.\"\n    },\n    \"cache_read_tokens\": {\n      \"type\": \"integer\",\n      \"minimum\": 0\n    },\n    \"cache_write_tokens\": {\n      \"type\": \"integer\",\n      \"minimum\": 0\n    },\n    \"artefacts_loaded\": {\n      \"type\": \"array\",\n      \"items\": { \"type\": \"string\", \"minLength\": 1 },\n      \"description\": \"Paths of artefacts read into the prompt. Useful for token-budget post-mortems.\"\n    }\n  },\n  \"allOf\": [\n    {\n      \"if\": {\n        \"properties\": { \"event\": { \"const\": \"subprocess_spawned\" } },\n        \"required\": [\"event\"]\n      },\n      \"then\": { \"required\": [\"role\", \"harness\", \"pid\"] }\n    },\n    {\n      \"if\": {\n        \"properties\": { \"event\": { \"const\": \"subprocess_returned\" } },\n        \"required\": [\"event\"]\n      },\n      \"then\": { \"required\": [\"pid\", \"exit_code\", \"duration_ms\"] }\n    },\n    {\n      \"if\": {\n        \"properties\": { \"event\": { \"const\": \"subprocess_killed\" } },\n        \"required\": [\"event\"]\n      },\n      \"then\": { \"required\": [\"pid\", \"signal\", \"reason\"] }\n    },\n    {\n      \"if\": {\n        \"properties\": { \"event\": { \"const\": \"story_started\" } },\n        \"required\": [\"event\"]\n      },\n      \"then\": { \"required\": [\"story_id\"] }\n    },\n    {\n      \"if\": {\n        \"properties\": { \"event\": { \"const\": \"story_completed\" } },\n        \"required\": [\"event\"]\n      },\n      \"then\": { \"required\": [\"story_id\"] }\n    },\n    {\n      \"if\": {\n        \"properties\": { \"event\": { \"const\": \"story_gate_opened\" } },\n        \"required\": [\"event\"]\n      },\n      \"then\": { \"required\": [\"story_id\", \"triggered_by\"] }\n    },\n    {\n      \"if\": {\n        \"properties\": { \"event\": { \"const\": \"story_gate_resolved\" } },\n        \"required\": [\"event\"]\n      },\n      \"then\": { \"required\": [\"story_id\", \"decision\"] }\n    },\n    {\n      \"if\": {\n        \"properties\": { \"event\": { \"const\": \"plan_gate_opened\" } },\n        \"required\": [\"event\"]\n      },\n      \"then\": { \"required\": [\"triggered_by\"] }\n    },\n    {\n      \"if\": {\n        \"properties\": { \"event\": { \"const\": \"plan_gate_resolved\" } },\n        \"required\": [\"event\"]\n      },\n      \"then\": { \"required\": [\"decision\"] }\n    },\n    {\n      \"if\": {\n        \"properties\": { \"event\": { \"const\": \"review_gate_opened\" } },\n        \"required\": [\"event\"]\n      },\n      \"then\": { \"required\": [\"triggered_by\"] }\n    },\n    {\n      \"if\": {\n        \"properties\": { \"event\": { \"const\": \"review_gate_resolved\" } },\n        \"required\": [\"event\"]\n      },\n      \"then\": { \"required\": [\"decision\"] }\n    }\n  ]\n}\n","exit_code":0,"status":"completed"}}
