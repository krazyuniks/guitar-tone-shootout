{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/usr/bin/zsh -lc \"nl -ba tests/unit/woof/test_check_stage_5_subcommand.py | sed -n '1,360p'\"","aggregated_output":"     1\t\"\"\"Tests for 'woof check stage-5' subcommand — O2, O4.\n     2\t\n     3\tO2: registry exports exactly 9 check entries with the canonical IDs;\n     4\t    --self-test exits 0 when all runners are implemented;\n     5\t    stubbing any runner to raise NotImplementedError causes non-zero exit.\n     6\t\n     7\tO4: check-result output conforms to check-result.schema.json;\n     8\t    exit code is 0 iff result.ok is true.\n     9\t\"\"\"\n    10\t\n    11\tfrom __future__ import annotations\n    12\t\n    13\timport json\n    14\timport shutil\n    15\timport subprocess\n    16\tfrom pathlib import Path\n    17\t\n    18\timport pytest\n    19\t\n    20\tREPO_ROOT = Path(__file__).resolve().parents[3]\n    21\tWOOF_BIN = REPO_ROOT / \"woof\" / \"bin\" / \"woof\"\n    22\t\n    23\tEXPECTED_STAGE_5_IDS = [\n    24\t    \"check_1_quality_gates\",\n    25\t    \"check_2_outcome_markers\",\n    26\t    \"check_3_scope\",\n    27\t    \"check_4_contract_refs\",\n    28\t    \"check_5_plan_crossrefs\",\n    29\t    \"check_6_critique_blocker\",\n    30\t    \"check_7_commit_transaction\",\n    31\t    \"check_8_docs_drift\",\n    32\t    \"check_9_review_valve\",\n    33\t]\n    34\t\n    35\tpytestmark = pytest.mark.host_only\n    36\t\n    37\t\n    38\tdef _run(*args: str, cwd: Path | None = None) -> subprocess.CompletedProcess[str]:\n    39\t    return subprocess.run(\n    40\t        [str(WOOF_BIN), *args],\n    41\t        capture_output=True,\n    42\t        text=True,\n    43\t        cwd=str(cwd or REPO_ROOT),\n    44\t    )\n    45\t\n    46\t\n    47\t# ---------------------------------------------------------------------------\n    48\t# O2 — registry completeness\n    49\t# ---------------------------------------------------------------------------\n    50\t\n    51\t\n    52\tdef test_registry_exports_nine_canonical_ids_O2() -> None:\n    53\t    \"\"\"O2: STAGE_5_CHECK_IDS contains exactly the 9 canonical IDs.\"\"\"\n    54\t    import sys\n    55\t\n    56\t    sys.path.insert(0, str(REPO_ROOT))\n    57\t    from woof.checks.registry import REGISTRY, STAGE_5_CHECK_IDS\n    58\t\n    59\t    assert set(STAGE_5_CHECK_IDS) == set(EXPECTED_STAGE_5_IDS), (\n    60\t        f\"Registry IDs mismatch.\\nExpected: {sorted(EXPECTED_STAGE_5_IDS)}\\nGot: {sorted(STAGE_5_CHECK_IDS)}\"\n    61\t    )\n    62\t    assert len(STAGE_5_CHECK_IDS) == 9\n    63\t    for check_id in STAGE_5_CHECK_IDS:\n    64\t        assert check_id in REGISTRY, f\"{check_id} in STAGE_5_CHECK_IDS but missing from REGISTRY\"\n    65\t\n    66\t\n    67\tdef test_self_test_exits_nonzero_when_runner_unimplemented_O2() -> None:\n    68\t    \"\"\"O2: --self-test exits non-zero because checks 1-5,7-9 raise NotImplementedError.\"\"\"\n    69\t    proc = _run(\"check\", \"stage-5\", \"--self-test\")\n    70\t    assert proc.returncode != 0, (\n    71\t        f\"Expected non-zero exit (unimplemented runners) but got 0.\\n{proc.stdout}{proc.stderr}\"\n    72\t    )\n    73\t    # stderr should name at least one failing check\n    74\t    combined = proc.stderr + proc.stdout\n    75\t    assert \"NotImplementedError\" in combined or \"not implemented\" in combined.lower(), combined\n    76\t\n    77\t\n    78\tdef test_self_test_distinguishes_implemented_from_placeholder_O2() -> None:\n    79\t    \"\"\"O2: check_6 (implemented) is not reported as failing by --self-test.\"\"\"\n    80\t    import sys\n    81\t\n    82\t    sys.path.insert(0, str(REPO_ROOT))\n    83\t    from woof.checks.registry import REGISTRY\n    84\t\n    85\t    # Run only check_6 in isolation — should not appear in failures\n    86\t    failures: list[str] = []\n    87\t    check = REGISTRY[\"check_6_critique_blocker\"]\n    88\t    try:\n    89\t        check.runner(None)  # type: ignore[arg-type]\n    90\t    except NotImplementedError:\n    91\t        failures.append(\"check_6_critique_blocker\")\n    92\t    except Exception:\n    93\t        pass  # implemented runner raised for a real reason (None context)\n    94\t\n    95\t    assert \"check_6_critique_blocker\" not in failures, (\n    96\t        \"check_6_critique_blocker incorrectly identified as unimplemented\"\n    97\t    )\n    98\t\n    99\t\n   100\t# ---------------------------------------------------------------------------\n   101\t# O4 — check-result schema conformance\n   102\t# ---------------------------------------------------------------------------\n   103\t\n   104\t\n   105\tdef test_check_stage_5_json_output_conforms_to_schema_O4(tmp_path: Path) -> None:\n   106\t    \"\"\"O4: check stage-5 --format json emits check-result conforming to check-result.schema.json.\"\"\"\n   107\t    if not shutil.which(\"ajv\"):\n   108\t        pytest.skip(\"ajv not on PATH\")\n   109\t\n   110\t    # Create a minimal epic dir with a blocker critique so check_6 fires\n   111\t    epic_dir = tmp_path / \".woof\" / \"epics\" / \"E999\"\n   112\t    critique_dir = epic_dir / \"critique\"\n   113\t    critique_dir.mkdir(parents=True)\n   114\t    plan_path = epic_dir / \"plan.json\"\n   115\t    plan_path.write_text(json.dumps({\"epic_id\": 999, \"goal\": \"test\", \"stories\": []}))\n   116\t    (critique_dir / \"story-S1.md\").write_text(\n   117\t        \"---\\ntarget: story\\ntarget_id: S1\\nseverity: blocker\\n\"\n   118\t        \"timestamp: '2026-01-01T00:00:00Z'\\nharness: test\\n\"\n   119\t        \"findings:\\n  - id: F1\\n    severity: blocker\\n    summary: test\\n---\\n\"\n   120\t    )\n   121\t\n   122\t    woof_root = tmp_path\n   123\t    (woof_root / \".woof\").mkdir(exist_ok=True)\n   124\t    # Write a minimal .woof/quality-gates.toml so the woof find_repo_root works\n   125\t    # woof check stage-5 walks up to find .woof; tmp_path has one\n   126\t    # We need plan.json at the right path relative to .woof\n   127\t\n   128\t    proc = subprocess.run(\n   129\t        [str(WOOF_BIN), \"check\", \"stage-5\", \"--epic\", \"999\", \"--story\", \"S1\", \"--format\", \"json\"],\n   130\t        capture_output=True,\n   131\t        text=True,\n   132\t        cwd=str(tmp_path),\n   133\t    )\n   134\t\n   135\t    # Exit code non-zero expected (check_6 or unimplemented checks fail)\n   136\t    assert proc.returncode != 0 or proc.returncode == 0  # just check it ran\n   137\t\n   138\t    output = proc.stdout.strip()\n   139\t    if not output:\n   140\t        pytest.skip(\"no JSON output from check stage-5 (missing plan or epic dir setup)\")\n   141\t\n   142\t    result = json.loads(output)\n   143\t    assert \"ok\" in result\n   144\t    assert \"stage\" in result\n   145\t    assert result[\"stage\"] == 5\n   146\t    assert \"triggered_by\" in result\n   147\t    assert \"checks\" in result\n   148\t    assert isinstance(result[\"checks\"], list)\n   149\t\n   150\t    # Validate against the schema\n   151\t    schema_path = REPO_ROOT / \"woof\" / \"schemas\" / \"check-result.schema.json\"\n   152\t    result_file = tmp_path / \"check-result.json\"\n   153\t    result_file.write_text(json.dumps(result))\n   154\t    validate_proc = subprocess.run(\n   155\t        [\n   156\t            \"ajv\",\n   157\t            \"validate\",\n   158\t            \"--spec=draft2020\",\n   159\t            \"-c\",\n   160\t            \"ajv-formats\",\n   161\t            \"-s\",\n   162\t            str(schema_path),\n   163\t            \"-d\",\n   164\t            str(result_file),\n   165\t        ],\n   166\t        capture_output=True,\n   167\t        text=True,\n   168\t    )\n   169\t    assert validate_proc.returncode == 0, (\n   170\t        f\"check-result.json does not conform to schema:\\n\"\n   171\t        f\"{validate_proc.stdout}{validate_proc.stderr}\"\n   172\t    )\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/usr/bin/zsh -lc \"nl -ba tests/unit/woof/test_driver_protocol.py | sed -n '1,420p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/usr/bin/zsh -lc \"nl -ba tests/unit/woof/test_driver_protocol.py | sed -n '1,420p'\"","aggregated_output":"     1\t\"\"\"Tests for the wf-run driver protocol — O1, O8.\n     2\t\n     3\tO1: When check-result.ok is false, the driver writes gate.md and does NOT\n     4\t    invoke git commit; the staged diff remains uncommitted.\n     5\t\n     6\tO8: executor exits non-zero → gate with subprocess_crash\n     7\t    executor_result.outcome=aborted_with_position → gate with executor_aborted\n     8\t    executor_result.outcome=empty_diff → gate with empty_diff_review\n     9\t    executor_result.outcome=staged_for_verification → proceeds to woof check stage-5\n    10\t\"\"\"\n    11\t\n    12\tfrom __future__ import annotations\n    13\t\n    14\timport json\n    15\timport subprocess\n    16\tfrom pathlib import Path\n    17\t\n    18\timport pytest\n    19\timport yaml\n    20\t\n    21\tREPO_ROOT = Path(__file__).resolve().parents[3]\n    22\tWOOF_BIN = REPO_ROOT / \"woof\" / \"bin\" / \"woof\"\n    23\tFIXTURE_DIR = REPO_ROOT / \"tests\" / \"fixtures\" / \"woof\" / \"e181_s2\"\n    24\t\n    25\tpytestmark = pytest.mark.host_only\n    26\t\n    27\t\n    28\tdef _setup_epic(tmp_path: Path, epic_id: int = 181, story_id: str = \"S2\") -> tuple[Path, Path]:\n    29\t    \"\"\"Create a minimal epic directory. Returns (tmp_path, epic_dir).\"\"\"\n    30\t    epic_dir = tmp_path / \".woof\" / \"epics\" / f\"E{epic_id}\"\n    31\t    epic_dir.mkdir(parents=True)\n    32\t    (epic_dir / \"epic.jsonl\").touch()\n    33\t    plan = {\n    34\t        \"epic_id\": epic_id,\n    35\t        \"goal\": \"test\",\n    36\t        \"stories\": [\n    37\t            {\n    38\t                \"id\": story_id,\n    39\t                \"title\": \"test story\",\n    40\t                \"status\": \"in_progress\",\n    41\t                \"paths\": [],\n    42\t                \"satisfies\": [],\n    43\t                \"implements_contract_decisions\": [],\n    44\t                \"uses_contract_decisions\": [],\n    45\t                \"depends_on\": [],\n    46\t                \"tests\": {},\n    47\t            }\n    48\t        ],\n    49\t    }\n    50\t    (epic_dir / \"plan.json\").write_text(json.dumps(plan))\n    51\t    return tmp_path, epic_dir\n    52\t\n    53\t\n    54\tdef _run_gate(*args: str, cwd: Path) -> subprocess.CompletedProcess[str]:\n    55\t    return subprocess.run(\n    56\t        [str(WOOF_BIN), \"gate\", \"write\", *args],\n    57\t        capture_output=True,\n    58\t        text=True,\n    59\t        cwd=str(cwd),\n    60\t    )\n    61\t\n    62\t\n    63\tdef _read_gate_fm(gate_path: Path) -> dict:\n    64\t    text = gate_path.read_text()\n    65\t    end = text.find(\"\\n---\\n\", 4)\n    66\t    return yaml.safe_load(text[4:end])\n    67\t\n    68\t\n    69\t# ---------------------------------------------------------------------------\n    70\t# O8 — driver branches on executor outcome\n    71\t# ---------------------------------------------------------------------------\n    72\t\n    73\t\n    74\tdef test_subprocess_crash_writes_gate_O8(tmp_path: Path) -> None:\n    75\t    \"\"\"O8: driver invokes gate write with subprocess_crash when executor exits non-zero.\"\"\"\n    76\t    cwd, epic_dir = _setup_epic(tmp_path, 181, \"S2\")\n    77\t\n    78\t    proc = _run_gate(\n    79\t        \"--epic\",\n    80\t        \"181\",\n    81\t        \"--story\",\n    82\t        \"S2\",\n    83\t        \"--triggered-by\",\n    84\t        \"subprocess_crash\",\n    85\t        \"--exit-code\",\n    86\t        \"1\",\n    87\t        cwd=cwd,\n    88\t    )\n    89\t    assert proc.returncode == 0, proc.stderr\n    90\t\n    91\t    gate = epic_dir / \"gate.md\"\n    92\t    assert gate.exists()\n    93\t    fm = _read_gate_fm(gate)\n    94\t    assert \"subprocess_crash\" in fm[\"triggered_by\"]\n    95\t    assert fm[\"exit_code\"] == 1\n    96\t    assert fm[\"type\"] == \"story_gate\"\n    97\t\n    98\t\n    99\tdef test_executor_aborted_writes_gate_O8(tmp_path: Path) -> None:\n   100\t    \"\"\"O8: driver invokes gate write with executor_aborted when outcome=aborted_with_position.\"\"\"\n   101\t    cwd, epic_dir = _setup_epic(tmp_path, 181, \"S2\")\n   102\t    position = tmp_path / \"position.md\"\n   103\t    position.write_text(\"Critique returned blocker; aborting.\")\n   104\t\n   105\t    proc = _run_gate(\n   106\t        \"--epic\",\n   107\t        \"181\",\n   108\t        \"--story\",\n   109\t        \"S2\",\n   110\t        \"--triggered-by\",\n   111\t        \"executor_aborted\",\n   112\t        \"--from-position\",\n   113\t        str(position),\n   114\t        cwd=cwd,\n   115\t    )\n   116\t    assert proc.returncode == 0, proc.stderr\n   117\t\n   118\t    gate = epic_dir / \"gate.md\"\n   119\t    assert gate.exists()\n   120\t    fm = _read_gate_fm(gate)\n   121\t    assert \"executor_aborted\" in fm[\"triggered_by\"]\n   122\t    text = gate.read_text()\n   123\t    assert \"Critique returned blocker\" in text\n   124\t\n   125\t\n   126\tdef test_empty_diff_writes_gate_O8(tmp_path: Path) -> None:\n   127\t    \"\"\"O8: driver invokes gate write with empty_diff_review when outcome=empty_diff.\"\"\"\n   128\t    cwd, epic_dir = _setup_epic(tmp_path, 181, \"S2\")\n   129\t\n   130\t    proc = _run_gate(\n   131\t        \"--epic\",\n   132\t        \"181\",\n   133\t        \"--story\",\n   134\t        \"S2\",\n   135\t        \"--triggered-by\",\n   136\t        \"empty_diff_review\",\n   137\t        cwd=cwd,\n   138\t    )\n   139\t    assert proc.returncode == 0, proc.stderr\n   140\t\n   141\t    gate = epic_dir / \"gate.md\"\n   142\t    assert gate.exists()\n   143\t    fm = _read_gate_fm(gate)\n   144\t    assert \"empty_diff_review\" in fm[\"triggered_by\"]\n   145\t\n   146\t\n   147\t# ---------------------------------------------------------------------------\n   148\t# O1, O7 — check_6 failure → gate, no commit\n   149\t# ---------------------------------------------------------------------------\n   150\t\n   151\t\n   152\tdef test_check_6_failure_writes_gate_not_commit_O1_O7(tmp_path: Path) -> None:\n   153\t    \"\"\"O1+O7: When check_6 fails (E181 S2 fixture), gate write is called; commit does not occur.\n   154\t\n   155\t    This tests the Python-level gate write logic, not the bash driver directly.\n   156\t    The invariant: woof gate write succeeds and gate.md is written; no git commit\n   157\t    operation is triggered by the Python code path.\n   158\t    \"\"\"\n   159\t    import sys\n   160\t\n   161\t    sys.path.insert(0, str(REPO_ROOT))\n   162\t\n   163\t    _, epic_dir = _setup_epic(tmp_path, 181, \"S2\")\n   164\t\n   165\t    # Simulate the check-result that would be produced when check_6 fires on E181 S2\n   166\t    check_result = {\n   167\t        \"ok\": False,\n   168\t        \"stage\": 5,\n   169\t        \"epic_id\": 181,\n   170\t        \"story_id\": \"S2\",\n   171\t        \"triggered_by\": [\"check_6_critique_blocker\"],\n   172\t        \"checks\": [\n   173\t            {\n   174\t                \"id\": \"check_6_critique_blocker\",\n   175\t                \"ok\": False,\n   176\t                \"severity\": \"blocker\",\n   177\t                \"summary\": \"critique severity is blocker (2 finding(s))\",\n   178\t                \"evidence\": \"F1: apply_size_cap corrupts UTF-8; F2: lax tests\",\n   179\t                \"paths\": [],\n   180\t                \"command\": None,\n   181\t                \"exit_code\": None,\n   182\t            }\n   183\t        ],\n   184\t    }\n   185\t    cr_file = tmp_path / \"check-result.json\"\n   186\t    cr_file.write_text(json.dumps(check_result))\n   187\t    pos_file = tmp_path / \"position.md\"\n   188\t    pos_file.write_text(\"check_6_critique_blocker fired on E181 S2 critique.\")\n   189\t\n   190\t    from woof.gate.write import write_gate_from_check_result\n   191\t\n   192\t    gate_path = write_gate_from_check_result(\n   193\t        check_result_path=cr_file,\n   194\t        position_path=pos_file,\n   195\t        epic_dir=epic_dir,\n   196\t        story_id=\"S2\",\n   197\t        schema_path=None,  # skip ajv validation in unit test\n   198\t    )\n   199\t\n   200\t    assert gate_path.exists()\n   201\t    fm = _read_gate_fm(gate_path)\n   202\t    assert \"check_6_critique_blocker\" in fm[\"triggered_by\"], (\n   203\t        f\"check_6_critique_blocker not in triggered_by: {fm['triggered_by']}\"\n   204\t    )\n   205\t    assert fm[\"story_id\"] == \"S2\"\n   206\t\n   207\t    # The gate write function does NOT call git commit — verified by absence\n   208\t    # of any commit in the test's git history (we're in a tmpdir, no git repo).\n   209\t    # The important invariant: write_gate_from_check_result returns a path, not a commit SHA.\n   210\t    assert isinstance(gate_path, Path)\n","exit_code":0,"status":"completed"}}
