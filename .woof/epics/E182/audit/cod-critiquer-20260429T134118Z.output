{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/usr/bin/zsh -lc \"nl -ba tests/unit/woof/test_validate.py | sed -n '1,260p'\"","aggregated_output":"     1\t\"\"\"Black-box tests for ``woof validate``.\n     2\t\n     3\tTests run on host (woof requires uv and ajv-cli). Each test invokes the CLI as\n     4\ta subprocess and asserts against exit code + output.\n     5\t\"\"\"\n     6\t\n     7\tfrom __future__ import annotations\n     8\t\n     9\timport json\n    10\timport os\n    11\timport subprocess\n    12\tfrom pathlib import Path\n    13\t\n    14\timport pytest\n    15\t\n    16\tREPO_ROOT = Path(__file__).resolve().parents[3]\n    17\tWOOF_BIN = REPO_ROOT / \"woof\" / \"bin\" / \"woof\"\n    18\tSCHEMA_DIR = REPO_ROOT / \"woof\" / \"schemas\"\n    19\tSCHEMA_FILES = sorted(SCHEMA_DIR.glob(\"*.schema.json\"))\n    20\t\n    21\t\n    22\tpytestmark = pytest.mark.host_only\n    23\t\n    24\t\n    25\t# ---------------------------------------------------------------------------\n    26\t# Meta\n    27\t# ---------------------------------------------------------------------------\n    28\t\n    29\t\n    30\t@pytest.mark.parametrize(\"schema_path\", SCHEMA_FILES, ids=lambda p: p.name)\n    31\tdef test_shipped_schema_compiles(schema_path: Path) -> None:\n    32\t    \"\"\"Every schema in woof/schemas/ must itself be valid JSON Schema 2020-12.\"\"\"\n    33\t    proc = subprocess.run(\n    34\t        [\"ajv\", \"compile\", \"--spec=draft2020\", \"-c\", \"ajv-formats\", \"-s\", str(schema_path)],\n    35\t        capture_output=True,\n    36\t        text=True,\n    37\t    )\n    38\t    assert proc.returncode == 0, f\"{schema_path.name}: {proc.stdout}{proc.stderr}\"\n    39\t\n    40\t\n    41\tdef test_shipped_schema_count() -> None:\n    42\t    \"\"\"Schema directory holds the 13 designed artefact schemas.\"\"\"\n    43\t    expected = {\n    44\t        \"epic.schema.json\",\n    45\t        \"plan.schema.json\",\n    46\t        \"gate.schema.json\",\n    47\t        \"critique.schema.json\",\n    48\t        \"jsonl-events.schema.json\",\n    49\t        \"prerequisites.schema.json\",\n    50\t        \"agents.schema.json\",\n    51\t        \"test-markers.schema.json\",\n    52\t        \"language-registry.schema.json\",\n    53\t        \"quality-gates.schema.json\",\n    54\t        \"docs-paths.schema.json\",\n    55\t        \"check-result.schema.json\",\n    56\t        \"executor-result.schema.json\",\n    57\t    }\n    58\t    assert {p.name for p in SCHEMA_FILES} == expected\n    59\t\n    60\t\n    61\t# ---------------------------------------------------------------------------\n    62\t# Real-file validation (the bootstrapped GTS prerequisites)\n    63\t# ---------------------------------------------------------------------------\n    64\t\n    65\t\n    66\tdef test_validate_real_prerequisites(run_woof) -> None:\n    67\t    proc = run_woof(\"validate\", str(REPO_ROOT / \".woof\" / \"prerequisites.toml\"))\n    68\t    assert proc.returncode == 0, proc.stdout + proc.stderr\n    69\t    assert \"valid (prerequisites)\" in proc.stdout\n    70\t\n    71\t\n    72\t# ---------------------------------------------------------------------------\n    73\t# Plan (JSON)\n    74\t# ---------------------------------------------------------------------------\n    75\t\n    76\t\n    77\tdef _minimal_plan() -> dict:\n    78\t    return {\n    79\t        \"epic_id\": 1,\n    80\t        \"goal\": \"demo plan for tests\",\n    81\t        \"stories\": [\n    82\t            {\n    83\t                \"id\": \"S1\",\n    84\t                \"title\": \"first story\",\n    85\t                \"intent\": \"do the thing\",\n    86\t                \"paths\": [\"src/**/*.py\"],\n    87\t                \"satisfies\": [\"O1\"],\n    88\t                \"implements_contract_decisions\": [],\n    89\t                \"uses_contract_decisions\": [],\n    90\t                \"depends_on\": [],\n    91\t                \"tests\": {\"count\": 1, \"types\": [\"unit\"]},\n    92\t                \"status\": \"pending\",\n    93\t            }\n    94\t        ],\n    95\t    }\n    96\t\n    97\t\n    98\tdef test_validate_plan_valid(tmp_path: Path, run_woof) -> None:\n    99\t    path = tmp_path / \"plan.json\"\n   100\t    path.write_text(json.dumps(_minimal_plan()))\n   101\t    proc = run_woof(\"validate\", str(path))\n   102\t    assert proc.returncode == 0, proc.stdout + proc.stderr\n   103\t    assert \"valid (plan)\" in proc.stdout\n   104\t\n   105\t\n   106\tdef test_validate_plan_missing_goal_fails(tmp_path: Path, run_woof) -> None:\n   107\t    payload = _minimal_plan()\n   108\t    del payload[\"goal\"]\n   109\t    path = tmp_path / \"plan.json\"\n   110\t    path.write_text(json.dumps(payload))\n   111\t    proc = run_woof(\"validate\", str(path))\n   112\t    assert proc.returncode == 1\n   113\t    assert \"INVALID\" in proc.stdout\n   114\t\n   115\t\n   116\t# ---------------------------------------------------------------------------\n   117\t# Epic (YAML front-matter)\n   118\t# ---------------------------------------------------------------------------\n   119\t\n   120\t\n   121\tVALID_EPIC = \"\"\"\\\n   122\t---\n   123\tepic_id: 1\n   124\ttitle: demo epic\n   125\tobservable_outcomes:\n   126\t  - id: O1\n   127\t    statement: user can do the thing\n   128\t    verification: automated\n   129\tcontract_decisions: []\n   130\tacceptance_criteria:\n   131\t  - all outcomes verified by tests\n   132\t---\n   133\t\n   134\tFree-form prose below the front-matter is ignored by validate.\n   135\t\"\"\"\n   136\t\n   137\t\n   138\tdef test_validate_epic_valid(tmp_path: Path, run_woof) -> None:\n   139\t    path = tmp_path / \"EPIC.md\"\n   140\t    path.write_text(VALID_EPIC)\n   141\t    proc = run_woof(\"validate\", str(path))\n   142\t    assert proc.returncode == 0, proc.stdout + proc.stderr\n   143\t    assert \"valid (epic)\" in proc.stdout\n   144\t\n   145\t\n   146\tdef test_validate_epic_no_front_matter_fails(tmp_path: Path, run_woof) -> None:\n   147\t    path = tmp_path / \"EPIC.md\"\n   148\t    path.write_text(\"# Just markdown, no front-matter\\n\")\n   149\t    proc = run_woof(\"validate\", str(path))\n   150\t    assert proc.returncode == 1\n   151\t    assert \"no YAML front-matter\" in proc.stdout + proc.stderr\n   152\t\n   153\t\n   154\t# ---------------------------------------------------------------------------\n   155\t# Gate (YAML front-matter)\n   156\t# ---------------------------------------------------------------------------\n   157\t\n   158\t\n   159\tVALID_GATE = \"\"\"\\\n   160\t---\n   161\ttype: plan_gate\n   162\tstage: 4\n   163\tstory_id: null\n   164\ttriggered_by:\n   165\t  - plan_review\n   166\ttimestamp: \"2026-04-26T10:00:00Z\"\n   167\t---\n   168\t\n   169\t## Context\n   170\t\n   171\tPlan generated; awaiting operator review.\n   172\t\"\"\"\n   173\t\n   174\t\n   175\tdef test_validate_gate_valid(tmp_path: Path, run_woof) -> None:\n   176\t    path = tmp_path / \"gate.md\"\n   177\t    path.write_text(VALID_GATE)\n   178\t    proc = run_woof(\"validate\", str(path))\n   179\t    assert proc.returncode == 0, proc.stdout + proc.stderr\n   180\t    assert \"valid (gate)\" in proc.stdout\n   181\t\n   182\t\n   183\t# ---------------------------------------------------------------------------\n   184\t# Critique (path-based detection)\n   185\t# ---------------------------------------------------------------------------\n   186\t\n   187\t\n   188\tVALID_CRITIQUE = \"\"\"\\\n   189\t---\n   190\ttarget: plan\n   191\ttarget_id: null\n   192\tseverity: info\n   193\ttimestamp: \"2026-04-26T10:05:00Z\"\n   194\tharness: claude-opus-4-7\n   195\t---\n   196\t\n   197\tLooks fine.\n   198\t\"\"\"\n   199\t\n   200\t\n   201\tdef test_validate_critique_via_path(tmp_path: Path, run_woof) -> None:\n   202\t    crit_dir = tmp_path / \"critique\"\n   203\t    crit_dir.mkdir()\n   204\t    path = crit_dir / \"plan.md\"\n   205\t    path.write_text(VALID_CRITIQUE)\n   206\t    proc = run_woof(\"validate\", str(path))\n   207\t    assert proc.returncode == 0, proc.stdout + proc.stderr\n   208\t    assert \"valid (critique)\" in proc.stdout\n   209\t\n   210\t\n   211\tGATE_WITH_UNQUOTED_TIMESTAMP = \"\"\"\\\n   212\t---\n   213\ttype: plan_gate\n   214\tstage: 4\n   215\tstory_id: null\n   216\ttriggered_by:\n   217\t  - plan_review\n   218\ttimestamp: 2026-04-26T10:00:00Z\n   219\t---\n   220\t\n   221\t## Context\n   222\t\n   223\tPyYAML parses bare ISO-8601 strings as datetime objects; the validator\n   224\tmust coerce them back to a JSON-serialisable string before piping to ajv.\n   225\t\"\"\"\n   226\t\n   227\t\n   228\tdef test_validate_gate_unquoted_timestamp(tmp_path: Path, run_woof) -> None:\n   229\t    \"\"\"Regression: bare ISO-8601 timestamps in YAML front-matter are parsed\n   230\t    as datetime objects by PyYAML. The validator must serialise them via\n   231\t    json.dumps(..., default=str) — otherwise it crashes with TypeError.\"\"\"\n   232\t    path = tmp_path / \"gate.md\"\n   233\t    path.write_text(GATE_WITH_UNQUOTED_TIMESTAMP)\n   234\t    proc = run_woof(\"validate\", str(path))\n   235\t    assert proc.returncode == 0, proc.stdout + proc.stderr\n   236\t    assert \"valid (gate)\" in proc.stdout\n   237\t\n   238\t\n   239\t# ---------------------------------------------------------------------------\n   240\t# JSONL events (per-line)\n   241\t# ---------------------------------------------------------------------------\n   242\t\n   243\t\n   244\tdef test_validate_jsonl_per_line(tmp_path: Path, run_woof) -> None:\n   245\t    path = tmp_path / \"epic.jsonl\"\n   246\t    lines = [\n   247\t        {\"event\": \"spark_created\", \"at\": \"2026-04-26T10:00:00Z\", \"epic_id\": 1},\n   248\t        {\"event\": \"definition_closed\", \"at\": \"2026-04-26T10:30:00Z\", \"epic_id\": 1},\n   249\t    ]\n   250\t    path.write_text(\"\\n\".join(json.dumps(line) for line in lines) + \"\\n\")\n   251\t    proc = run_woof(\"validate\", str(path))\n   252\t    assert proc.returncode == 0, proc.stdout + proc.stderr\n   253\t    assert \"valid (jsonl-events, 2 line(s))\" in proc.stdout\n   254\t\n   255\t\n   256\tdef test_validate_jsonl_bad_line_fails(tmp_path: Path, run_woof) -> None:\n   257\t    path = tmp_path / \"epic.jsonl\"\n   258\t    path.write_text(\n   259\t        json.dumps({\"event\": \"not_a_valid_event_kind\", \"at\": \"2026-04-26T10:00:00Z\"}) + \"\\n\"\n   260\t    )\n","exit_code":0,"status":"completed"}}
