{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/usr/bin/zsh -lc \"nl -ba tests/unit/woof/test_gate_write.py | sed -n '1,420p'\"","aggregated_output":"     1\t\"\"\"Tests for 'woof gate write' subcommand and gate/write.py — O5.\n     2\t\n     3\tO5: woof gate write produces gate.md whose YAML front-matter validates\n     4\t    against gate.schema.json; gate_type, triggered_by[], opened_at fields\n     5\t    are mechanically derived from the check-result; prose body is verbatim\n     6\t    from the position file.\n     7\t\"\"\"\n     8\t\n     9\tfrom __future__ import annotations\n    10\t\n    11\timport json\n    12\timport shutil\n    13\timport subprocess\n    14\tfrom pathlib import Path\n    15\t\n    16\timport pytest\n    17\timport yaml\n    18\t\n    19\tREPO_ROOT = Path(__file__).resolve().parents[3]\n    20\tWOOF_BIN = REPO_ROOT / \"woof\" / \"bin\" / \"woof\"\n    21\tGATE_SCHEMA = REPO_ROOT / \"woof\" / \"schemas\" / \"gate.schema.json\"\n    22\t\n    23\tpytestmark = pytest.mark.host_only\n    24\t\n    25\t\n    26\tdef _run(*args: str, cwd: Path | None = None) -> subprocess.CompletedProcess[str]:\n    27\t    return subprocess.run(\n    28\t        [str(WOOF_BIN), *args],\n    29\t        capture_output=True,\n    30\t        text=True,\n    31\t        cwd=str(cwd or REPO_ROOT),\n    32\t    )\n    33\t\n    34\t\n    35\tdef _validate_gate_fm(gate_path: Path) -> tuple[bool, str]:\n    36\t    \"\"\"Validate gate.md front-matter against gate.schema.json via ajv.\"\"\"\n    37\t    text = gate_path.read_text()\n    38\t    assert text.startswith(\"---\\n\"), \"gate.md must start with '---'\"\n    39\t    end = text.find(\"\\n---\\n\", 4)\n    40\t    assert end >= 0, \"gate.md front-matter is unterminated\"\n    41\t    fm = yaml.safe_load(text[4:end])\n    42\t\n    43\t    if not shutil.which(\"ajv\"):\n    44\t        pytest.skip(\"ajv not on PATH\")\n    45\t\n    46\t    data_file = gate_path.with_suffix(\".fm.json\")\n    47\t    data_file.write_text(json.dumps(fm))\n    48\t    proc = subprocess.run(\n    49\t        [\n    50\t            \"ajv\",\n    51\t            \"validate\",\n    52\t            \"--spec=draft2020\",\n    53\t            \"-c\",\n    54\t            \"ajv-formats\",\n    55\t            \"-s\",\n    56\t            str(GATE_SCHEMA),\n    57\t            \"-d\",\n    58\t            str(data_file),\n    59\t        ],\n    60\t        capture_output=True,\n    61\t        text=True,\n    62\t    )\n    63\t    data_file.unlink(missing_ok=True)\n    64\t    return proc.returncode == 0, (proc.stdout + proc.stderr).strip()\n    65\t\n    66\t\n    67\tdef _setup_epic_dir(tmp_path: Path, epic_id: int = 999) -> Path:\n    68\t    epic_dir = tmp_path / \".woof\" / \"epics\" / f\"E{epic_id}\"\n    69\t    epic_dir.mkdir(parents=True)\n    70\t    (epic_dir / \"epic.jsonl\").touch()\n    71\t    return epic_dir\n    72\t\n    73\t\n    74\tdef test_gate_write_from_check_result_validates_O5(tmp_path: Path) -> None:\n    75\t    \"\"\"O5: woof gate write --from-check-result produces schema-valid gate.md.\"\"\"\n    76\t    epic_dir = _setup_epic_dir(tmp_path, 181)\n    77\t\n    78\t    check_result = {\n    79\t        \"ok\": False,\n    80\t        \"stage\": 5,\n    81\t        \"epic_id\": 181,\n    82\t        \"story_id\": \"S2\",\n    83\t        \"triggered_by\": [\"check_6_critique_blocker\"],\n    84\t        \"checks\": [\n    85\t            {\n    86\t                \"id\": \"check_6_critique_blocker\",\n    87\t                \"ok\": False,\n    88\t                \"severity\": \"blocker\",\n    89\t                \"summary\": \"critique severity is blocker\",\n    90\t                \"evidence\": \"F1: UTF-8 truncation\",\n    91\t                \"paths\": [],\n    92\t                \"command\": None,\n    93\t                \"exit_code\": None,\n    94\t            }\n    95\t        ],\n    96\t    }\n    97\t    cr_file = tmp_path / \"check-result.json\"\n    98\t    cr_file.write_text(json.dumps(check_result))\n    99\t\n   100\t    position_file = tmp_path / \"position.md\"\n   101\t    position_file.write_text(\"Critique returned blocker; halting pending investigation.\")\n   102\t\n   103\t    proc = _run(\n   104\t        \"gate\",\n   105\t        \"write\",\n   106\t        \"--epic\",\n   107\t        \"181\",\n   108\t        \"--story\",\n   109\t        \"S2\",\n   110\t        \"--from-check-result\",\n   111\t        str(cr_file),\n   112\t        \"--position-file\",\n   113\t        str(position_file),\n   114\t        cwd=tmp_path,\n   115\t    )\n   116\t    assert proc.returncode == 0, proc.stderr\n   117\t\n   118\t    gate_path = epic_dir / \"gate.md\"\n   119\t    assert gate_path.exists(), \"gate.md not written\"\n   120\t\n   121\t    # Validate front-matter\n   122\t    ok, msg = _validate_gate_fm(gate_path)\n   123\t    assert ok, f\"gate.md front-matter invalid: {msg}\"\n   124\t\n   125\t    # Check triggered_by contains check_6_critique_blocker\n   126\t    text = gate_path.read_text()\n   127\t    fm = yaml.safe_load(text[4 : text.find(\"\\n---\\n\", 4)])\n   128\t    assert \"check_6_critique_blocker\" in fm[\"triggered_by\"]\n   129\t    assert fm[\"type\"] == \"story_gate\"\n   130\t    assert fm[\"story_id\"] == \"S2\"\n   131\t\n   132\t    # Position body is copied verbatim\n   133\t    assert \"Critique returned blocker\" in text\n   134\t\n   135\t\n   136\tdef test_gate_write_for_subprocess_crash_O5(tmp_path: Path) -> None:\n   137\t    \"\"\"O5: woof gate write --triggered-by subprocess_crash writes valid gate.md.\"\"\"\n   138\t    epic_dir = _setup_epic_dir(tmp_path, 182)\n   139\t\n   140\t    proc = _run(\n   141\t        \"gate\",\n   142\t        \"write\",\n   143\t        \"--epic\",\n   144\t        \"182\",\n   145\t        \"--story\",\n   146\t        \"S1\",\n   147\t        \"--triggered-by\",\n   148\t        \"subprocess_crash\",\n   149\t        \"--exit-code\",\n   150\t        \"1\",\n   151\t        cwd=tmp_path,\n   152\t    )\n   153\t    assert proc.returncode == 0, proc.stderr\n   154\t\n   155\t    gate_path = epic_dir / \"gate.md\"\n   156\t    assert gate_path.exists()\n   157\t\n   158\t    ok, msg = _validate_gate_fm(gate_path)\n   159\t    assert ok, f\"gate.md front-matter invalid: {msg}\"\n   160\t\n   161\t    text = gate_path.read_text()\n   162\t    fm = yaml.safe_load(text[4 : text.find(\"\\n---\\n\", 4)])\n   163\t    assert \"subprocess_crash\" in fm[\"triggered_by\"]\n   164\t    assert fm[\"exit_code\"] == 1\n   165\t\n   166\t\n   167\tdef test_gate_write_appends_epic_jsonl_O5(tmp_path: Path) -> None:\n   168\t    \"\"\"O5: gate write appends story_gate_opened event to epic.jsonl.\"\"\"\n   169\t    epic_dir = _setup_epic_dir(tmp_path, 183)\n   170\t\n   171\t    proc = _run(\n   172\t        \"gate\",\n   173\t        \"write\",\n   174\t        \"--epic\",\n   175\t        \"183\",\n   176\t        \"--story\",\n   177\t        \"S1\",\n   178\t        \"--triggered-by\",\n   179\t        \"executor_aborted\",\n   180\t        cwd=tmp_path,\n   181\t    )\n   182\t    assert proc.returncode == 0, proc.stderr\n   183\t\n   184\t    jsonl = epic_dir / \"epic.jsonl\"\n   185\t    lines = [json.loads(line) for line in jsonl.read_text().splitlines() if line.strip()]\n   186\t    assert any(e[\"event\"] == \"story_gate_opened\" for e in lines), (\n   187\t        f\"story_gate_opened not in epic.jsonl: {lines}\"\n   188\t    )\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/usr/bin/zsh -lc \"nl -ba tests/unit/woof/test_check_6_critique_blocker.py | sed -n '1,360p'\"","aggregated_output":"     1\t\"\"\"Tests for check_6_critique_blocker — Stage-5 Check 6.\n     2\t\n     3\tCovers O7 (E181 S2 regression: blocker critique halts pipeline) and the\n     4\tbasic pass/fail branches of the check logic.\n     5\t\"\"\"\n     6\t\n     7\tfrom __future__ import annotations\n     8\t\n     9\tfrom pathlib import Path\n    10\t\n    11\timport pytest\n    12\t\n    13\tREPO_ROOT = Path(__file__).resolve().parents[3]\n    14\tFIXTURE_DIR = REPO_ROOT / \"tests\" / \"fixtures\" / \"woof\" / \"e181_s2\"\n    15\t\n    16\tpytestmark = pytest.mark.host_only\n    17\t\n    18\t\n    19\tdef _make_ctx(epic_dir: Path, story_id: str = \"S2\") -> object:\n    20\t    from woof.checks import CheckContext\n    21\t\n    22\t    return CheckContext(\n    23\t        epic_id=181,\n    24\t        story_id=story_id,\n    25\t        repo_root=REPO_ROOT,\n    26\t        epic_dir=epic_dir,\n    27\t        plan={},\n    28\t        critique=None,\n    29\t    )\n    30\t\n    31\t\n    32\tdef _write_critique(critique_dir: Path, story_id: str, content: str) -> Path:\n    33\t    critique_dir.mkdir(parents=True, exist_ok=True)\n    34\t    p = critique_dir / f\"story-{story_id}.md\"\n    35\t    p.write_text(content)\n    36\t    return p\n    37\t\n    38\t\n    39\t_BLOCKER_CRITIQUE = \"\"\"\\\n    40\t---\n    41\ttarget: story\n    42\ttarget_id: S2\n    43\tseverity: blocker\n    44\ttimestamp: \"2026-04-27T05:46:49Z\"\n    45\tharness: codex-gpt-5\n    46\tfindings:\n    47\t  - id: F1\n    48\t    severity: blocker\n    49\t    summary: \"apply_size_cap corrupts UTF-8 at byte boundaries\"\n    50\t---\n    51\tFindings text here.\n    52\t\"\"\"\n    53\t\n    54\t_MINOR_CRITIQUE = \"\"\"\\\n    55\t---\n    56\ttarget: story\n    57\ttarget_id: S2\n    58\tseverity: minor\n    59\ttimestamp: \"2026-04-27T05:46:49Z\"\n    60\tharness: codex-gpt-5\n    61\tfindings:\n    62\t  - id: F1\n    63\t    severity: minor\n    64\t    summary: \"Minor style nit in variable name\"\n    65\t---\n    66\tMinor findings.\n    67\t\"\"\"\n    68\t\n    69\t_INFO_CRITIQUE = \"\"\"\\\n    70\t---\n    71\ttarget: story\n    72\ttarget_id: S1\n    73\tseverity: info\n    74\ttimestamp: \"2026-04-27T05:46:49Z\"\n    75\tharness: codex-gpt-5\n    76\tfindings: []\n    77\t---\n    78\tNo findings.\n    79\t\"\"\"\n    80\t\n    81\t\n    82\tdef test_blocker_critique_fails_O7(tmp_path: Path) -> None:\n    83\t    \"\"\"O7: E181 S2 blocker critique → check_6 returns ok=False, severity=blocker.\"\"\"\n    84\t    import sys\n    85\t\n    86\t    sys.path.insert(0, str(REPO_ROOT))\n    87\t\n    88\t    from woof.checks.runners.check_6_critique_blocker import check_6_critique_blocker_runner\n    89\t\n    90\t    epic_dir = tmp_path / \".woof\" / \"epics\" / \"E181\"\n    91\t    _write_critique(epic_dir / \"critique\", \"S2\", _BLOCKER_CRITIQUE)\n    92\t    ctx = _make_ctx(epic_dir, \"S2\")\n    93\t\n    94\t    outcome = check_6_critique_blocker_runner(ctx)\n    95\t\n    96\t    assert not outcome.ok\n    97\t    assert outcome.severity == \"blocker\"\n    98\t    assert \"blocker\" in outcome.summary.lower()\n    99\t    assert outcome.id == \"check_6_critique_blocker\"\n   100\t\n   101\t\n   102\tdef test_e181_s2_fixture_is_blocker_O7(tmp_path: Path) -> None:\n   103\t    \"\"\"O7: The canonical E181 S2 fixture triggers check_6 failure (regression guard).\"\"\"\n   104\t    import sys\n   105\t\n   106\t    sys.path.insert(0, str(REPO_ROOT))\n   107\t\n   108\t    from woof.checks.runners.check_6_critique_blocker import check_6_critique_blocker_runner\n   109\t\n   110\t    epic_dir = tmp_path / \".woof\" / \"epics\" / \"E181\"\n   111\t    critique_dir = epic_dir / \"critique\"\n   112\t    critique_dir.mkdir(parents=True)\n   113\t    import shutil\n   114\t\n   115\t    shutil.copy(FIXTURE_DIR / \"critique\" / \"story-S2.md\", critique_dir / \"story-S2.md\")\n   116\t\n   117\t    ctx = _make_ctx(epic_dir, \"S2\")\n   118\t    outcome = check_6_critique_blocker_runner(ctx)\n   119\t\n   120\t    assert not outcome.ok, f\"Expected failure but got: {outcome}\"\n   121\t    assert outcome.severity == \"blocker\"\n   122\t    assert outcome.id == \"check_6_critique_blocker\"\n   123\t\n   124\t\n   125\tdef test_minor_critique_passes(tmp_path: Path) -> None:\n   126\t    \"\"\"Minor severity critique → check_6 returns ok=True.\"\"\"\n   127\t    import sys\n   128\t\n   129\t    sys.path.insert(0, str(REPO_ROOT))\n   130\t\n   131\t    from woof.checks.runners.check_6_critique_blocker import check_6_critique_blocker_runner\n   132\t\n   133\t    epic_dir = tmp_path / \".woof\" / \"epics\" / \"E181\"\n   134\t    _write_critique(epic_dir / \"critique\", \"S2\", _MINOR_CRITIQUE)\n   135\t    ctx = _make_ctx(epic_dir, \"S2\")\n   136\t\n   137\t    outcome = check_6_critique_blocker_runner(ctx)\n   138\t\n   139\t    assert outcome.ok\n   140\t    assert outcome.severity == \"minor\"\n   141\t\n   142\t\n   143\tdef test_info_critique_passes(tmp_path: Path) -> None:\n   144\t    \"\"\"Info severity (no findings) critique → check_6 returns ok=True.\"\"\"\n   145\t    import sys\n   146\t\n   147\t    sys.path.insert(0, str(REPO_ROOT))\n   148\t\n   149\t    from woof.checks.runners.check_6_critique_blocker import check_6_critique_blocker_runner\n   150\t\n   151\t    epic_dir = tmp_path / \".woof\" / \"epics\" / \"E181\"\n   152\t    _write_critique(epic_dir / \"critique\", \"S1\", _INFO_CRITIQUE)\n   153\t    ctx = _make_ctx(epic_dir, \"S1\")\n   154\t\n   155\t    outcome = check_6_critique_blocker_runner(ctx)\n   156\t\n   157\t    assert outcome.ok\n   158\t    assert outcome.severity == \"info\"\n   159\t\n   160\t\n   161\tdef test_missing_critique_file_fails(tmp_path: Path) -> None:\n   162\t    \"\"\"Missing critique file → check_6 returns ok=False.\"\"\"\n   163\t    import sys\n   164\t\n   165\t    sys.path.insert(0, str(REPO_ROOT))\n   166\t\n   167\t    from woof.checks.runners.check_6_critique_blocker import check_6_critique_blocker_runner\n   168\t\n   169\t    epic_dir = tmp_path / \".woof\" / \"epics\" / \"E181\"\n   170\t    epic_dir.mkdir(parents=True)\n   171\t    ctx = _make_ctx(epic_dir, \"S2\")\n   172\t\n   173\t    outcome = check_6_critique_blocker_runner(ctx)\n   174\t\n   175\t    assert not outcome.ok\n   176\t    assert \"missing\" in outcome.summary.lower()\n","exit_code":0,"status":"completed"}}
