{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/usr/bin/zsh -lc \"nl -ba woof/gate/write.py | sed -n '1,320p'\"","aggregated_output":"     1\t\"\"\"woof gate write — mechanical gate.md authoring.\n     2\t\n     3\tAll YAML front-matter fields are derived deterministically from the\n     4\tcheck-result or trigger arguments. No LLM authors any YAML field.\n     5\t\"\"\"\n     6\t\n     7\tfrom __future__ import annotations\n     8\t\n     9\timport json\n    10\timport subprocess\n    11\timport tempfile\n    12\tfrom datetime import datetime, timezone\n    13\tfrom pathlib import Path\n    14\t\n    15\timport yaml\n    16\t\n    17\t\n    18\tdef iso_utc() -> str:\n    19\t    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n    20\t\n    21\t\n    22\tdef _append_jsonl(path: Path, event: dict) -> None:\n    23\t    path.parent.mkdir(parents=True, exist_ok=True)\n    24\t    with path.open(\"a\", encoding=\"utf-8\") as fh:\n    25\t        fh.write(json.dumps(event, separators=(\",\", \":\")) + \"\\n\")\n    26\t\n    27\t\n    28\tdef _validate_gate(gate_md: Path, schema_path: Path) -> tuple[bool, str]:\n    29\t    \"\"\"Validate gate.md front-matter via ajv. Returns (ok, message).\"\"\"\n    30\t    text = gate_md.read_text()\n    31\t    if not text.startswith(\"---\\n\"):\n    32\t        return False, \"gate.md has no YAML front-matter\"\n    33\t    end = text.find(\"\\n---\\n\", 4)\n    34\t    if end < 0:\n    35\t        return False, \"gate.md front-matter is unterminated\"\n    36\t    try:\n    37\t        fm = yaml.safe_load(text[4:end]) or {}\n    38\t    except yaml.YAMLError as exc:\n    39\t        return False, f\"gate.md YAML parse error: {exc}\"\n    40\t\n    41\t    payload = json.dumps(fm).encode()\n    42\t    with tempfile.NamedTemporaryFile(\"wb\", suffix=\".json\", delete=False) as fh:\n    43\t        fh.write(payload)\n    44\t        data_path = fh.name\n    45\t    try:\n    46\t        proc = subprocess.run(\n    47\t            [\n    48\t                \"ajv\", \"validate\",\n    49\t                \"--spec=draft2020\", \"-c\", \"ajv-formats\",\n    50\t                \"-s\", str(schema_path),\n    51\t                \"-d\", data_path,\n    52\t            ],\n    53\t            capture_output=True,\n    54\t            text=True,\n    55\t        )\n    56\t    finally:\n    57\t        Path(data_path).unlink(missing_ok=True)\n    58\t\n    59\t    output = (proc.stdout + proc.stderr).strip()\n    60\t    return proc.returncode == 0, output\n    61\t\n    62\t\n    63\tdef write_gate(\n    64\t    epic_dir: Path,\n    65\t    story_id: str | None,\n    66\t    triggered_by: list[str],\n    67\t    position_text: str,\n    68\t    exit_code: int | None = None,\n    69\t    *,\n    70\t    schema_path: Path | None = None,\n    71\t    validate: bool = True,\n    72\t) -> Path:\n    73\t    \"\"\"Write gate.md and append gate_opened to epic.jsonl.\n    74\t\n    75\t    Returns the path of the written gate.md.\n    76\t    Raises ValueError if the resulting front-matter fails schema validation.\n    77\t    \"\"\"\n    78\t    gate_path = epic_dir / \"gate.md\"\n    79\t    epic_jsonl = epic_dir / \"epic.jsonl\"\n    80\t    now = iso_utc()\n    81\t\n    82\t    front: dict = {\n    83\t        \"type\": \"story_gate\",\n    84\t        \"stage\": 6,\n    85\t        \"story_id\": story_id,\n    86\t        \"triggered_by\": triggered_by,\n    87\t        \"timestamp\": now,\n    88\t    }\n    89\t    if exit_code is not None:\n    90\t        front[\"exit_code\"] = exit_code\n    91\t\n    92\t    fm_yaml = yaml.dump(front, default_flow_style=False, allow_unicode=True)\n    93\t    body = position_text.strip()\n    94\t    content = f\"---\\n{fm_yaml}---\\n\\n{body}\\n\"\n    95\t    gate_path.write_text(content)\n    96\t\n    97\t    if validate and schema_path and schema_path.is_file():\n    98\t        ok, msg = _validate_gate(gate_path, schema_path)\n    99\t        if not ok:\n   100\t            gate_path.unlink(missing_ok=True)\n   101\t            raise ValueError(f\"gate.md front-matter failed schema validation: {msg}\")\n   102\t\n   103\t    epic_id_str = epic_dir.name  # e.g. \"E182\"\n   104\t    epic_id = int(epic_id_str.lstrip(\"E\")) if epic_id_str.startswith(\"E\") else 0\n   105\t    event: dict = {\n   106\t        \"event\": \"story_gate_opened\",\n   107\t        \"at\": now,\n   108\t        \"epic_id\": epic_id,\n   109\t        \"triggered_by\": triggered_by,\n   110\t    }\n   111\t    if story_id:\n   112\t        event[\"story_id\"] = story_id\n   113\t    _append_jsonl(epic_jsonl, event)\n   114\t\n   115\t    return gate_path\n   116\t\n   117\t\n   118\tdef write_gate_from_check_result(\n   119\t    check_result_path: Path,\n   120\t    position_path: Path | None,\n   121\t    epic_dir: Path,\n   122\t    story_id: str | None = None,\n   123\t    *,\n   124\t    schema_path: Path | None = None,\n   125\t) -> Path:\n   126\t    \"\"\"Build gate.md from a check-result JSON file.\"\"\"\n   127\t    check_result = json.loads(check_result_path.read_text())\n   128\t    triggered_by: list[str] = check_result.get(\"triggered_by\") or []\n   129\t    if not triggered_by:\n   130\t        triggered_by = [\"schema_validation_failed\"]\n   131\t\n   132\t    sid = story_id or check_result.get(\"story_id\")\n   133\t\n   134\t    if position_path and position_path.is_file():\n   135\t        position_text = position_path.read_text()\n   136\t    else:\n   137\t        position_text = _auto_position(triggered_by, check_result)\n   138\t\n   139\t    return write_gate(\n   140\t        epic_dir=epic_dir,\n   141\t        story_id=sid,\n   142\t        triggered_by=triggered_by,\n   143\t        position_text=position_text,\n   144\t        schema_path=schema_path,\n   145\t        validate=schema_path is not None,\n   146\t    )\n   147\t\n   148\t\n   149\tdef write_gate_for_trigger(\n   150\t    trigger: str,\n   151\t    epic_dir: Path,\n   152\t    story_id: str | None,\n   153\t    exit_code: int | None = None,\n   154\t    position_path: Path | None = None,\n   155\t    *,\n   156\t    schema_path: Path | None = None,\n   157\t) -> Path:\n   158\t    \"\"\"Build gate.md for a driver-level trigger (crash, aborted, empty diff).\"\"\"\n   159\t    if position_path and position_path.is_file():\n   160\t        position_text = position_path.read_text()\n   161\t    else:\n   162\t        position_text = _auto_position_for_trigger(trigger, exit_code)\n   163\t\n   164\t    return write_gate(\n   165\t        epic_dir=epic_dir,\n   166\t        story_id=story_id,\n   167\t        triggered_by=[trigger],\n   168\t        position_text=position_text,\n   169\t        exit_code=exit_code if trigger == \"subprocess_crash\" else None,\n   170\t        schema_path=schema_path,\n   171\t        validate=schema_path is not None,\n   172\t    )\n   173\t\n   174\t\n   175\tdef _auto_position(triggered_by: list[str], check_result: dict) -> str:\n   176\t    checks = check_result.get(\"checks\") or []\n   177\t    failed = [c for c in checks if not c.get(\"ok\")]\n   178\t    lines = [f\"Check stage-5 failed: {', '.join(triggered_by)}.\"]\n   179\t    for c in failed:\n   180\t        lines.append(f\"\\n- {c['id']}: {c.get('summary', '')}\")\n   181\t        if c.get(\"evidence\"):\n   182\t            lines.append(f\"  Evidence: {c['evidence']}\")\n   183\t    lines.append(\"\\n\\nInvestigate the findings above and retry or revise the story scope.\")\n   184\t    return \"\".join(lines)\n   185\t\n   186\t\n   187\tdef _auto_position_for_trigger(trigger: str, exit_code: int | None) -> str:\n   188\t    if trigger == \"subprocess_crash\":\n   189\t        return (\n   190\t            f\"Story executor subprocess crashed with exit code {exit_code}.\\n\\n\"\n   191\t            \"Investigate the dispatch.jsonl audit and harness output before re-dispatching.\"\n   192\t        )\n   193\t    if trigger == \"executor_aborted\":\n   194\t        return (\n   195\t            \"Story executor reported aborted_with_position. \"\n   196\t            \"No position prose was provided.\\n\\n\"\n   197\t            \"Review the executor audit output for the reason.\"\n   198\t        )\n   199\t    if trigger == \"empty_diff_review\":\n   200\t        return (\n   201\t            \"Story executor reported empty_diff. \"\n   202\t            \"Confirm whether earlier stories already realised this outcome.\\n\\n\"\n   203\t            \"Approve if confirmed; revise story scope otherwise.\"\n   204\t        )\n   205\t    return f\"Gate opened with trigger: {trigger}.\"\n","exit_code":0,"status":"completed"}}
