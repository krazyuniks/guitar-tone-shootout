{"type":"item.completed","item":{"id":"item_44","type":"command_execution","command":"/usr/bin/zsh -lc \"nl -ba woof/bin/woof | sed -n '760,980p'\"","aggregated_output":"   760\t    _write_last_sync(epic_dir, {\n   761\t        \"issue_number\": args.epic,\n   762\t        \"updated_at\": new_remote.get(\"updated_at\") or \"\",\n   763\t        \"body_sha256\": _sha256(body),\n   764\t        \"body\": body,\n   765\t    })\n   766\t    append_jsonl(epic_dir / \"epic.jsonl\", {\n   767\t        \"event\": \"github_synced\",\n   768\t        \"at\": iso_utc(datetime.now(timezone.utc)),\n   769\t        \"epic_id\": args.epic,\n   770\t    })\n   771\t\n   772\t    if args.output:\n   773\t        Path(args.output).write_text(body)\n   774\t    else:\n   775\t        sys.stdout.write(body)\n   776\t    return 0\n   777\t\n   778\t\n   779\t# ---------------------------------------------------------------------------\n   780\t# check-cd — Stage 5 Check 4 (contract-decision artefact verification)\n   781\t# ---------------------------------------------------------------------------\n   782\t\n   783\t\n   784\tdef _resolve_json_pointer(doc: object, pointer: str) -> object | None:\n   785\t    \"\"\"Resolve an RFC 6901 JSON Pointer against ``doc``. Returns None on miss.\"\"\"\n   786\t    if pointer in (\"\", \"/\"):\n   787\t        return doc\n   788\t    if not pointer.startswith(\"/\"):\n   789\t        return None\n   790\t    cur: object = doc\n   791\t    for raw in pointer.lstrip(\"/\").split(\"/\"):\n   792\t        token = raw.replace(\"~1\", \"/\").replace(\"~0\", \"~\")\n   793\t        if isinstance(cur, list):\n   794\t            try:\n   795\t                cur = cur[int(token)]\n   796\t            except (ValueError, IndexError):\n   797\t                return None\n   798\t        elif isinstance(cur, dict):\n   799\t            if token not in cur:\n   800\t                return None\n   801\t            cur = cur[token]\n   802\t        else:\n   803\t            return None\n   804\t    return cur\n   805\t\n   806\t\n   807\tdef _check_openapi_ref(repo_root: Path, ref: str) -> tuple[bool, str]:\n   808\t    if \"#\" not in ref:\n   809\t        return False, f\"openapi_ref missing '#<json-pointer>' fragment: {ref!r}\"\n   810\t    file_part, pointer = ref.split(\"#\", 1)\n   811\t    spec_path = (repo_root / file_part).resolve()\n   812\t    if not spec_path.is_file():\n   813\t        return False, f\"openapi document not found: {file_part}\"\n   814\t    try:\n   815\t        with spec_path.open(\"rb\") as fh:\n   816\t            doc = yaml.safe_load(fh)\n   817\t    except yaml.YAMLError as exc:\n   818\t        return False, f\"openapi document failed to parse: {exc}\"\n   819\t    target = _resolve_json_pointer(doc, pointer)\n   820\t    if target is None:\n   821\t        return False, f\"json pointer '{pointer}' did not resolve in {file_part}\"\n   822\t    if not isinstance(target, dict):\n   823\t        return False, f\"json pointer '{pointer}' resolved to non-object {type(target).__name__}\"\n   824\t    return True, f\"resolved to {type(target).__name__} with {len(target)} key(s)\"\n   825\t\n   826\t\n   827\tdef _check_pydantic_ref(repo_root: Path, ref: str) -> tuple[bool, str]:\n   828\t    if \":\" not in ref:\n   829\t        return False, f\"pydantic_ref must be '<file-or-module>:<ClassName>': {ref!r}\"\n   830\t    locator, class_name = ref.rsplit(\":\", 1)\n   831\t    try:\n   832\t        try:\n   833\t            import pydantic  # noqa: F401  (import for the issubclass check)\n   834\t        except ImportError:\n   835\t            return False, \"pydantic not installed in this environment\"\n   836\t        from pydantic import BaseModel\n   837\t    except Exception as exc:  # noqa: BLE001\n   838\t        return False, f\"failed to import pydantic: {exc}\"\n   839\t\n   840\t    import importlib\n   841\t    import importlib.util\n   842\t    from importlib.machinery import SourceFileLoader\n   843\t\n   844\t    module: object | None = None\n   845\t    if locator.endswith(\".py\") or \"/\" in locator:\n   846\t        path = (repo_root / locator).resolve()\n   847\t        if not path.is_file():\n   848\t            return False, f\"pydantic source file not found: {locator}\"\n   849\t        loader = SourceFileLoader(f\"_woof_check_cd_{path.stem}\", str(path))\n   850\t        spec = importlib.util.spec_from_loader(loader.name, loader)\n   851\t        if spec is None:\n   852\t            return False, f\"failed to build module spec for {locator}\"\n   853\t        module = importlib.util.module_from_spec(spec)\n   854\t        try:\n   855\t            loader.exec_module(module)\n   856\t        except Exception as exc:  # noqa: BLE001\n   857\t            return False, f\"failed to import {locator}: {exc}\"\n   858\t    else:\n   859\t        try:\n   860\t            module = importlib.import_module(locator)\n   861\t        except Exception as exc:  # noqa: BLE001\n   862\t            return False, f\"failed to import {locator}: {exc}\"\n   863\t\n   864\t    cls = getattr(module, class_name, None)\n   865\t    if cls is None:\n   866\t        return False, f\"class '{class_name}' not found in {locator}\"\n   867\t    try:\n   868\t        if not issubclass(cls, BaseModel):\n   869\t            return False, f\"'{class_name}' is not a pydantic.BaseModel subclass\"\n   870\t    except TypeError:\n   871\t        return False, f\"'{class_name}' is not a class\"\n   872\t    return True, f\"BaseModel subclass with {len(cls.model_fields)} field(s)\"\n   873\t\n   874\t\n   875\tdef _check_json_schema_ref(repo_root: Path, ref: str) -> tuple[bool, str]:\n   876\t    schema_path = (repo_root / ref).resolve()\n   877\t    if not schema_path.is_file():\n   878\t        return False, f\"json_schema file not found: {ref}\"\n   879\t    proc = subprocess.run(\n   880\t        [\n   881\t            \"ajv\", \"compile\",\n   882\t            \"--spec=draft2020\", \"-c\", \"ajv-formats\",\n   883\t            \"-s\", str(schema_path),\n   884\t        ],\n   885\t        capture_output=True, text=True,\n   886\t    )\n   887\t    if proc.returncode != 0:\n   888\t        msg = (proc.stdout + proc.stderr).strip().splitlines()\n   889\t        first = msg[0] if msg else \"(no output)\"\n   890\t        return False, f\"ajv compile rejected schema: {first}\"\n   891\t    return True, \"ajv compile passed\"\n   892\t\n   893\t\n   894\tdef cmd_check_cd(args: argparse.Namespace) -> int:\n   895\t    ensure_ajv()\n   896\t    epic_md = Path(args.epic_md).resolve()\n   897\t    if not epic_md.is_file():\n   898\t        sys.stderr.write(f\"woof: {epic_md} not found\\n\")\n   899\t        return 2\n   900\t\n   901\t    try:\n   902\t        front, _ = split_front_matter(epic_md)\n   903\t    except (ValueError, yaml.YAMLError) as exc:\n   904\t        sys.stderr.write(f\"woof: {epic_md}: {exc}\\n\")\n   905\t        return 2\n   906\t\n   907\t    schema_path = SCHEMA_DIR / SCHEMAS[\"epic\"]\n   908\t    ok, output = run_ajv(schema_path, json.dumps(front).encode())\n   909\t    if not ok:\n   910\t        sys.stderr.write(f\"woof: {epic_md}: front-matter invalid\\n{output}\\n\")\n   911\t        return 2\n   912\t\n   913\t    repo_root = epic_md.parent\n   914\t    while repo_root != repo_root.parent and not (repo_root / \".git\").exists():\n   915\t        repo_root = repo_root.parent\n   916\t    if not (repo_root / \".git\").exists():\n   917\t        repo_root = epic_md.parent  # fallback\n   918\t\n   919\t    cds = front.get(\"contract_decisions\") or []\n   920\t    findings: list[dict] = []\n   921\t    all_ok = True\n   922\t    for cd in cds:\n   923\t        cd_id = cd[\"id\"]\n   924\t        if cd.get(\"openapi_ref\"):\n   925\t            ref = cd[\"openapi_ref\"]\n   926\t            kind = \"openapi_ref\"\n   927\t            ok, msg = _check_openapi_ref(repo_root, ref)\n   928\t        elif cd.get(\"pydantic_ref\"):\n   929\t            ref = cd[\"pydantic_ref\"]\n   930\t            kind = \"pydantic_ref\"\n   931\t            ok, msg = _check_pydantic_ref(repo_root, ref)\n   932\t        elif cd.get(\"json_schema_ref\"):\n   933\t            ref = cd[\"json_schema_ref\"]\n   934\t            kind = \"json_schema_ref\"\n   935\t            ok, msg = _check_json_schema_ref(repo_root, ref)\n   936\t        else:\n   937\t            ok, kind, ref, msg = False, \"missing\", \"\", \"no contract reference declared\"\n   938\t        findings.append({\"id\": cd_id, \"kind\": kind, \"ref\": ref, \"ok\": ok, \"detail\": msg})\n   939\t        if not ok:\n   940\t            all_ok = False\n   941\t\n   942\t    if args.format == \"json\":\n   943\t        print(json.dumps({\n   944\t            \"epic_md\": str(epic_md),\n   945\t            \"total\": len(cds),\n   946\t            \"verified\": sum(1 for f in findings if f[\"ok\"]),\n   947\t            \"findings\": findings,\n   948\t        }))\n   949\t    else:\n   950\t        print(f\"{epic_md.relative_to(repo_root) if epic_md.is_relative_to(repo_root) else epic_md}: {len(cds)} contract decision(s)\")\n   951\t        for f in findings:\n   952\t            status = \"OK  \" if f[\"ok\"] else \"FAIL\"\n   953\t            print(f\"  {status} {f['id']:<6} ({f['kind']}) {f['ref']}\")\n   954\t            if not f[\"ok\"]:\n   955\t                print(f\"         → {f['detail']}\")\n   956\t            elif args.verbose:\n   957\t                print(f\"         → {f['detail']}\")\n   958\t        verified = sum(1 for f in findings if f[\"ok\"])\n   959\t        print(f\"{verified}/{len(cds)} verified\")\n   960\t\n   961\t    return 0 if all_ok else 1\n   962\t\n   963\t\n   964\t# ---------------------------------------------------------------------------\n   965\t# main\n   966\t# ---------------------------------------------------------------------------\n   967\t\n   968\t\n   969\tdef main() -> int:\n   970\t    parser = argparse.ArgumentParser(prog=\"woof\", description=\"workflow orchestrator CLI\")\n   971\t    sub = parser.add_subparsers(dest=\"cmd\", required=True)\n   972\t\n   973\t    validate = sub.add_parser(\"validate\", help=\"validate woof artefacts against schemas\")\n   974\t    validate.add_argument(\"paths\", nargs=\"+\", help=\"paths to validate\")\n   975\t    validate.add_argument(\n   976\t        \"--schema\",\n   977\t        choices=sorted(SCHEMAS),\n   978\t        help=\"override schema auto-detection\",\n   979\t    )\n   980\t    validate.set_defaults(func=cmd_validate)\n","exit_code":0,"status":"completed"}}
