{"type":"item.completed","item":{"id":"item_36","type":"command_execution","command":"/usr/bin/zsh -lc \"nl -ba woof/schemas/jsonl-events.schema.json | sed -n '1,340p'\"","aggregated_output":"     1\t{\n     2\t  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n     3\t  \"$id\": \"https://woof.dev/schemas/jsonl-events.schema.json\",\n     4\t  \"title\": \"woof JSONL event\",\n     5\t  \"description\": \"One line of .woof/epics/E<N>/epic.jsonl (stage-level narrative) or .woof/epics/E<N>/dispatch.jsonl (subprocess events). Both streams share this schema; the event field discriminates. Per-event payload fields validate via the conditional rules in allOf. Cross-line invariants (subprocess_returned matches a prior subprocess_spawned by pid; gate_resolved follows gate_opened; status transitions are monotonic) are helper-enforced, not schema-enforced.\",\n     6\t  \"type\": \"object\",\n     7\t  \"additionalProperties\": true,\n     8\t  \"required\": [\"event\", \"at\"],\n     9\t  \"properties\": {\n    10\t    \"event\": {\n    11\t      \"type\": \"string\",\n    12\t      \"enum\": [\n    13\t        \"spark_created\",\n    14\t        \"discovery_started\",\n    15\t        \"discovery_synthesised\",\n    16\t        \"definition_started\",\n    17\t        \"definition_closed\",\n    18\t        \"plan_generated\",\n    19\t        \"plan_critiqued\",\n    20\t        \"plan_gate_opened\",\n    21\t        \"plan_gate_resolved\",\n    22\t        \"story_started\",\n    23\t        \"story_completed\",\n    24\t        \"story_gate_opened\",\n    25\t        \"story_gate_resolved\",\n    26\t        \"review_gate_opened\",\n    27\t        \"review_gate_resolved\",\n    28\t        \"epic_completed\",\n    29\t        \"subprocess_spawned\",\n    30\t        \"subprocess_returned\",\n    31\t        \"subprocess_killed\",\n    32\t        \"executor_result_recorded\",\n    33\t        \"check_run\",\n    34\t        \"story_committed\",\n    35\t        \"preflight_run\",\n    36\t        \"github_synced\",\n    37\t        \"github_sync_conflict\",\n    38\t        \"cartography_refreshed\",\n    39\t        \"token_usage\"\n    40\t      ],\n    41\t      \"description\": \"Event kind. Stage events (epic.jsonl): spark_created, discovery_*, definition_*, plan_*, story_*, *_gate_*, epic_completed, executor_result_recorded, check_run, story_committed. Dispatch events (dispatch.jsonl): subprocess_*. Operational events (either): preflight_run, github_synced, github_sync_conflict, cartography_refreshed, token_usage.\"\n    42\t    },\n    43\t    \"at\": {\n    44\t      \"type\": \"string\",\n    45\t      \"format\": \"date-time\",\n    46\t      \"description\": \"ISO 8601 timestamp the event occurred.\"\n    47\t    },\n    48\t    \"epic_id\": {\n    49\t      \"type\": \"integer\",\n    50\t      \"minimum\": 1,\n    51\t      \"description\": \"Epic this event belongs to (gh issue number).\"\n    52\t    },\n    53\t    \"story_id\": {\n    54\t      \"type\": \"string\",\n    55\t      \"pattern\": \"^S[1-9]\\\\d*$\"\n    56\t    },\n    57\t    \"role\": {\n    58\t      \"type\": \"string\",\n    59\t      \"enum\": [\"orchestrator\", \"planner\", \"story-executor\", \"critiquer\", \"gate-resolver\"],\n    60\t      \"description\": \"Role from .woof/agents.toml under which a subprocess was dispatched.\"\n    61\t    },\n    62\t    \"harness\": {\n    63\t      \"type\": \"string\",\n    64\t      \"enum\": [\"cld\", \"cod\", \"in-session\"],\n    65\t      \"description\": \"Wrapper that spawned the subprocess (or in-session for orchestrator/gate-resolver).\"\n    66\t    },\n    67\t    \"model\": {\n    68\t      \"type\": \"string\",\n    69\t      \"minLength\": 1\n    70\t    },\n    71\t    \"pid\": {\n    72\t      \"type\": \"integer\",\n    73\t      \"minimum\": 1\n    74\t    },\n    75\t    \"exit_code\": {\n    76\t      \"type\": \"integer\"\n    77\t    },\n    78\t    \"duration_ms\": {\n    79\t      \"type\": \"integer\",\n    80\t      \"minimum\": 0\n    81\t    },\n    82\t    \"signal\": {\n    83\t      \"type\": \"string\",\n    84\t      \"minLength\": 1\n    85\t    },\n    86\t    \"reason\": {\n    87\t      \"type\": \"string\",\n    88\t      \"minLength\": 1,\n    89\t      \"description\": \"Free-form reason. Used by subprocess_killed (timeout, manual_cancel, ...). Gate resolution events use the structured 'decision' field instead.\"\n    90\t    },\n    91\t    \"decision\": {\n    92\t      \"type\": \"string\",\n    93\t      \"enum\": [\n    94\t        \"approve\",\n    95\t        \"revise_epic_contract\",\n    96\t        \"revise_plan\",\n    97\t        \"revise_story_scope\",\n    98\t        \"split_story\",\n    99\t        \"abandon_story\",\n   100\t        \"abandon_epic\"\n   101\t      ],\n   102\t      \"description\": \"Gate resolution decision. approve = proceed. revise_epic_contract = re-enter Stage 2. revise_plan = re-enter Stage 3. revise_story_scope = edit current story's paths or satisfies. split_story = replace one story with multiple. abandon_story = skip and continue. abandon_epic = mark incomplete + close gh issue with note.\"\n   103\t    },\n   104\t    \"cc_session_id\": {\n   105\t      \"type\": \"string\",\n   106\t      \"pattern\": \"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$\",\n   107\t      \"description\": \"CC session UUID. Cross-link into ~/.claude/projects/<slug>/<uuid>.jsonl.\"\n   108\t    },\n   109\t    \"codex_audit_path\": {\n   110\t      \"type\": \"string\",\n   111\t      \"minLength\": 1,\n   112\t      \"description\": \"Path under .woof/epics/E<N>/audit/ where Codex prompt+output+meta were tee'd.\"\n   113\t    },\n   114\t    \"empty_diff\": {\n   115\t      \"type\": \"boolean\"\n   116\t    },\n   117\t    \"commit_sha\": {\n   118\t      \"type\": \"string\",\n   119\t      \"pattern\": \"^[0-9a-f]{7,40}$\"\n   120\t    },\n   121\t    \"gate_type\": {\n   122\t      \"type\": \"string\",\n   123\t      \"enum\": [\"plan_gate\", \"story_gate\", \"review_gate\"]\n   124\t    },\n   125\t    \"triggered_by\": {\n   126\t      \"type\": \"array\",\n   127\t      \"items\": { \"type\": \"string\" },\n   128\t      \"minItems\": 1,\n   129\t      \"uniqueItems\": true,\n   130\t      \"description\": \"Mirrors gate.md.triggered_by[] when emitting *_gate_opened.\"\n   131\t    },\n   132\t    \"tokens_in\": {\n   133\t      \"type\": \"integer\",\n   134\t      \"minimum\": 0,\n   135\t      \"description\": \"Prompt tokens. Used by token_usage events and post-subprocess summaries.\"\n   136\t    },\n   137\t    \"tokens_out\": {\n   138\t      \"type\": \"integer\",\n   139\t      \"minimum\": 0,\n   140\t      \"description\": \"Completion tokens.\"\n   141\t    },\n   142\t    \"cache_read_tokens\": {\n   143\t      \"type\": \"integer\",\n   144\t      \"minimum\": 0\n   145\t    },\n   146\t    \"cache_write_tokens\": {\n   147\t      \"type\": \"integer\",\n   148\t      \"minimum\": 0\n   149\t    },\n   150\t    \"artefacts_loaded\": {\n   151\t      \"type\": \"array\",\n   152\t      \"items\": { \"type\": \"string\", \"minLength\": 1 },\n   153\t      \"description\": \"Paths of artefacts read into the prompt. Useful for token-budget post-mortems.\"\n   154\t    }\n   155\t  },\n   156\t  \"allOf\": [\n   157\t    {\n   158\t      \"if\": {\n   159\t        \"properties\": { \"event\": { \"const\": \"subprocess_spawned\" } },\n   160\t        \"required\": [\"event\"]\n   161\t      },\n   162\t      \"then\": { \"required\": [\"role\", \"harness\", \"pid\"] }\n   163\t    },\n   164\t    {\n   165\t      \"if\": {\n   166\t        \"properties\": { \"event\": { \"const\": \"subprocess_returned\" } },\n   167\t        \"required\": [\"event\"]\n   168\t      },\n   169\t      \"then\": { \"required\": [\"pid\", \"exit_code\", \"duration_ms\"] }\n   170\t    },\n   171\t    {\n   172\t      \"if\": {\n   173\t        \"properties\": { \"event\": { \"const\": \"subprocess_killed\" } },\n   174\t        \"required\": [\"event\"]\n   175\t      },\n   176\t      \"then\": { \"required\": [\"pid\", \"signal\", \"reason\"] }\n   177\t    },\n   178\t    {\n   179\t      \"if\": {\n   180\t        \"properties\": { \"event\": { \"const\": \"story_started\" } },\n   181\t        \"required\": [\"event\"]\n   182\t      },\n   183\t      \"then\": { \"required\": [\"story_id\"] }\n   184\t    },\n   185\t    {\n   186\t      \"if\": {\n   187\t        \"properties\": { \"event\": { \"const\": \"story_completed\" } },\n   188\t        \"required\": [\"event\"]\n   189\t      },\n   190\t      \"then\": { \"required\": [\"story_id\"] }\n   191\t    },\n   192\t    {\n   193\t      \"if\": {\n   194\t        \"properties\": { \"event\": { \"const\": \"story_gate_opened\" } },\n   195\t        \"required\": [\"event\"]\n   196\t      },\n   197\t      \"then\": { \"required\": [\"story_id\", \"triggered_by\"] }\n   198\t    },\n   199\t    {\n   200\t      \"if\": {\n   201\t        \"properties\": { \"event\": { \"const\": \"story_gate_resolved\" } },\n   202\t        \"required\": [\"event\"]\n   203\t      },\n   204\t      \"then\": { \"required\": [\"story_id\", \"decision\"] }\n   205\t    },\n   206\t    {\n   207\t      \"if\": {\n   208\t        \"properties\": { \"event\": { \"const\": \"plan_gate_opened\" } },\n   209\t        \"required\": [\"event\"]\n   210\t      },\n   211\t      \"then\": { \"required\": [\"triggered_by\"] }\n   212\t    },\n   213\t    {\n   214\t      \"if\": {\n   215\t        \"properties\": { \"event\": { \"const\": \"plan_gate_resolved\" } },\n   216\t        \"required\": [\"event\"]\n   217\t      },\n   218\t      \"then\": { \"required\": [\"decision\"] }\n   219\t    },\n   220\t    {\n   221\t      \"if\": {\n   222\t        \"properties\": { \"event\": { \"const\": \"review_gate_opened\" } },\n   223\t        \"required\": [\"event\"]\n   224\t      },\n   225\t      \"then\": { \"required\": [\"triggered_by\"] }\n   226\t    },\n   227\t    {\n   228\t      \"if\": {\n   229\t        \"properties\": { \"event\": { \"const\": \"review_gate_resolved\" } },\n   230\t        \"required\": [\"event\"]\n   231\t      },\n   232\t      \"then\": { \"required\": [\"decision\"] }\n   233\t    },\n   234\t    {\n   235\t      \"if\": {\n   236\t        \"properties\": { \"event\": { \"const\": \"executor_result_recorded\" } },\n   237\t        \"required\": [\"event\"]\n   238\t      },\n   239\t      \"then\": { \"required\": [\"story_id\", \"exit_code\"] }\n   240\t    },\n   241\t    {\n   242\t      \"if\": {\n   243\t        \"properties\": { \"event\": { \"const\": \"check_run\" } },\n   244\t        \"required\": [\"event\"]\n   245\t      },\n   246\t      \"then\": { \"required\": [\"story_id\", \"triggered_by\"] }\n   247\t    },\n   248\t    {\n   249\t      \"if\": {\n   250\t        \"properties\": { \"event\": { \"const\": \"story_committed\" } },\n   251\t        \"required\": [\"event\"]\n   252\t      },\n   253\t      \"then\": { \"required\": [\"story_id\", \"commit_sha\"] }\n   254\t    }\n   255\t  ]\n   256\t}\n","exit_code":0,"status":"completed"}}
