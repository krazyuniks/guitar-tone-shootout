{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/usr/bin/zsh -lc \"nl -ba woof/cli/commands/gate.py | sed -n '1,320p'\"","aggregated_output":"     1\t\"\"\"woof gate write — mechanical gate.md authoring from check-result or trigger.\n     2\t\n     3\tWrites .woof/epics/E<N>/gate.md and appends story_gate_opened to epic.jsonl.\n     4\tFront-matter is derived deterministically; no LLM authors any YAML field.\n     5\t\"\"\"\n     6\t\n     7\tfrom __future__ import annotations\n     8\t\n     9\timport argparse\n    10\timport sys\n    11\tfrom pathlib import Path\n    12\t\n    13\t\n    14\tdef _find_repo_root() -> Path:\n    15\t    for candidate in [Path.cwd(), *Path.cwd().parents]:\n    16\t        if (candidate / \".woof\").is_dir():\n    17\t            return candidate\n    18\t    return Path.cwd()\n    19\t\n    20\t\n    21\tdef _schema_path(repo_root: Path) -> Path:\n    22\t    return repo_root / \"woof\" / \"schemas\" / \"gate.schema.json\"\n    23\t\n    24\t\n    25\tdef cmd_gate_write(args: argparse.Namespace) -> int:\n    26\t    from woof.gate.write import write_gate_from_check_result, write_gate_for_trigger\n    27\t\n    28\t    repo_root = _find_repo_root()\n    29\t    epic_dir = repo_root / \".woof\" / \"epics\" / f\"E{args.epic}\"\n    30\t    schema = _schema_path(repo_root)\n    31\t\n    32\t    story_id: str | None = args.story\n    33\t\n    34\t    # Resolve story_id from plan.json if not given\n    35\t    if story_id is None and not args.from_check_result:\n    36\t        plan_path = epic_dir / \"plan.json\"\n    37\t        if plan_path.exists():\n    38\t            import json\n    39\t            plan = json.loads(plan_path.read_text())\n    40\t            for s in plan.get(\"stories\", []):\n    41\t                if s.get(\"status\") == \"in_progress\":\n    42\t                    story_id = s[\"id\"]\n    43\t                    break\n    44\t\n    45\t    if args.from_check_result:\n    46\t        cr_path = Path(args.from_check_result)\n    47\t        if not cr_path.exists():\n    48\t            sys.stderr.write(f\"woof gate write: {cr_path} not found\\n\")\n    49\t            return 2\n    50\t        pos_path = Path(args.position_file) if args.position_file else None\n    51\t        try:\n    52\t            gate_path = write_gate_from_check_result(\n    53\t                check_result_path=cr_path,\n    54\t                position_path=pos_path,\n    55\t                epic_dir=epic_dir,\n    56\t                story_id=story_id,\n    57\t                schema_path=schema if schema.exists() else None,\n    58\t            )\n    59\t        except ValueError as exc:\n    60\t            sys.stderr.write(f\"woof gate write: {exc}\\n\")\n    61\t            return 1\n    62\t    elif args.triggered_by:\n    63\t        pos_path = Path(args.from_position) if args.from_position else None\n    64\t        try:\n    65\t            gate_path = write_gate_for_trigger(\n    66\t                trigger=args.triggered_by,\n    67\t                epic_dir=epic_dir,\n    68\t                story_id=story_id,\n    69\t                exit_code=args.exit_code,\n    70\t                position_path=pos_path,\n    71\t                schema_path=schema if schema.exists() else None,\n    72\t            )\n    73\t        except ValueError as exc:\n    74\t            sys.stderr.write(f\"woof gate write: {exc}\\n\")\n    75\t            return 1\n    76\t    else:\n    77\t        sys.stderr.write(\n    78\t            \"woof gate write: provide --from-check-result or --triggered-by\\n\"\n    79\t        )\n    80\t        return 2\n    81\t\n    82\t    sys.stdout.write(f\"woof gate write: {gate_path}\\n\")\n    83\t    return 0\n    84\t\n    85\t\n    86\tdef setup_gate_parser(sub: argparse._SubParsersAction) -> None:  # type: ignore[type-arg]\n    87\t    gate_p = sub.add_parser(\"gate\", help=\"manage woof gates\")\n    88\t    gate_sub = gate_p.add_subparsers(dest=\"gate_cmd\", required=True)\n    89\t\n    90\t    write_p = gate_sub.add_parser(\"write\", help=\"write gate.md from check-result or trigger\")\n    91\t    write_p.add_argument(\"--epic\", type=int, required=True, help=\"epic id\")\n    92\t    write_p.add_argument(\"--story\", help=\"story id (e.g. S1); auto-detected if omitted\")\n    93\t    # Mode 1: from check-result JSON\n    94\t    write_p.add_argument(\n    95\t        \"--from-check-result\", dest=\"from_check_result\",\n    96\t        help=\"path to check-result.json\",\n    97\t    )\n    98\t    write_p.add_argument(\n    99\t        \"--position-file\", dest=\"position_file\",\n   100\t        help=\"path to prose position file (used with --from-check-result)\",\n   101\t    )\n   102\t    # Mode 2: direct trigger\n   103\t    write_p.add_argument(\n   104\t        \"--triggered-by\", dest=\"triggered_by\",\n   105\t        help=\"trigger ID (subprocess_crash | executor_aborted | empty_diff_review | ...)\",\n   106\t    )\n   107\t    write_p.add_argument(\n   108\t        \"--exit-code\", dest=\"exit_code\", type=int,\n   109\t        help=\"subprocess exit code (required with --triggered-by subprocess_crash)\",\n   110\t    )\n   111\t    write_p.add_argument(\n   112\t        \"--from-position\", dest=\"from_position\",\n   113\t        help=\"path to prose position file (used with --triggered-by)\",\n   114\t    )\n   115\t    write_p.set_defaults(func=cmd_gate_write)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/usr/bin/zsh -lc \"nl -ba woof/checks/runners/check_6_critique_blocker.py | sed -n '1,320p'\"","aggregated_output":"     1\t\"\"\"check_6_critique_blocker — Stage-5 Check 6.\n     2\t\n     3\tVerifies that the Codex critique artefact:\n     4\t  1. Exists at critique/story-S<k>.md\n     5\t  2. Has valid YAML front-matter with required fields\n     6\t  3. Top-level severity equals max(findings[].severity)\n     7\t  4. severity != \"blocker\"\n     8\t\"\"\"\n     9\t\n    10\tfrom __future__ import annotations\n    11\t\n    12\timport yaml\n    13\t\n    14\tfrom woof.checks import CheckContext, CheckOutcome\n    15\t\n    16\t_SEVERITY_ORDER = {\"info\": 0, \"minor\": 1, \"blocker\": 2}\n    17\t_VALID_SEVERITIES = set(_SEVERITY_ORDER)\n    18\t_REQUIRED_FIELDS = {\"target\", \"target_id\", \"severity\", \"timestamp\", \"harness\"}\n    19\t\n    20\tCHECK_ID = \"check_6_critique_blocker\"\n    21\t\n    22\t\n    23\tdef check_6_critique_blocker_runner(ctx: CheckContext) -> CheckOutcome:\n    24\t    critique_path = ctx.epic_dir / \"critique\" / f\"story-{ctx.story_id}.md\"\n    25\t\n    26\t    if not critique_path.exists():\n    27\t        return CheckOutcome(\n    28\t            id=CHECK_ID,\n    29\t            ok=False,\n    30\t            severity=\"blocker\",\n    31\t            summary=f\"critique file missing: critique/story-{ctx.story_id}.md\",\n    32\t        )\n    33\t\n    34\t    text = critique_path.read_text()\n    35\t    if not text.startswith(\"---\\n\"):\n    36\t        return CheckOutcome(\n    37\t            id=CHECK_ID,\n    38\t            ok=False,\n    39\t            severity=\"blocker\",\n    40\t            summary=\"critique file missing YAML front-matter (must start with '---')\",\n    41\t        )\n    42\t\n    43\t    end = text.find(\"\\n---\\n\", 4)\n    44\t    if end < 0:\n    45\t        return CheckOutcome(\n    46\t            id=CHECK_ID,\n    47\t            ok=False,\n    48\t            severity=\"blocker\",\n    49\t            summary=\"critique file has unterminated YAML front-matter\",\n    50\t        )\n    51\t\n    52\t    try:\n    53\t        fm = yaml.safe_load(text[4:end]) or {}\n    54\t    except yaml.YAMLError as exc:\n    55\t        return CheckOutcome(\n    56\t            id=CHECK_ID,\n    57\t            ok=False,\n    58\t            severity=\"blocker\",\n    59\t            summary=f\"critique front-matter YAML parse error: {exc}\",\n    60\t        )\n    61\t\n    62\t    missing = _REQUIRED_FIELDS - set(fm.keys())\n    63\t    if missing:\n    64\t        return CheckOutcome(\n    65\t            id=CHECK_ID,\n    66\t            ok=False,\n    67\t            severity=\"blocker\",\n    68\t            summary=f\"critique front-matter missing required fields: {sorted(missing)}\",\n    69\t        )\n    70\t\n    71\t    top_sev = fm[\"severity\"]\n    72\t    if top_sev not in _VALID_SEVERITIES:\n    73\t        return CheckOutcome(\n    74\t            id=CHECK_ID,\n    75\t            ok=False,\n    76\t            severity=\"blocker\",\n    77\t            summary=f\"critique severity invalid: {top_sev!r} (expected info|minor|blocker)\",\n    78\t        )\n    79\t\n    80\t    findings = fm.get(\"findings\") or []\n    81\t    if findings:\n    82\t        max_sev = max(\n    83\t            (f.get(\"severity\", \"info\") for f in findings if isinstance(f, dict)),\n    84\t            key=lambda s: _SEVERITY_ORDER.get(s, 0),\n    85\t        )\n    86\t        if _SEVERITY_ORDER.get(top_sev, 0) != _SEVERITY_ORDER.get(max_sev, 0):\n    87\t            return CheckOutcome(\n    88\t                id=CHECK_ID,\n    89\t                ok=False,\n    90\t                severity=\"blocker\",\n    91\t                summary=(\n    92\t                    f\"critique top-level severity {top_sev!r} != \"\n    93\t                    f\"max finding severity {max_sev!r}\"\n    94\t                ),\n    95\t                evidence=f\"findings severities: {[f.get('severity') for f in findings if isinstance(f, dict)]}\",\n    96\t            )\n    97\t\n    98\t    if top_sev == \"blocker\":\n    99\t        blocker_summaries = [\n   100\t            f.get(\"summary\", \"\")\n   101\t            for f in findings\n   102\t            if isinstance(f, dict) and f.get(\"severity\") == \"blocker\"\n   103\t        ]\n   104\t        return CheckOutcome(\n   105\t            id=CHECK_ID,\n   106\t            ok=False,\n   107\t            severity=\"blocker\",\n   108\t            summary=f\"critique severity is blocker ({len(blocker_summaries)} finding(s))\",\n   109\t            evidence=\"; \".join(blocker_summaries) if blocker_summaries else None,\n   110\t        )\n   111\t\n   112\t    return CheckOutcome(\n   113\t        id=CHECK_ID,\n   114\t        ok=True,\n   115\t        severity=top_sev,\n   116\t        summary=f\"critique severity={top_sev!r}; no blocker findings\",\n   117\t    )\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/usr/bin/zsh -lc \"nl -ba woof/checks/__init__.py | sed -n '1,260p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/usr/bin/zsh -lc \"nl -ba woof/checks/__init__.py | sed -n '1,260p'\"","aggregated_output":"     1\t\"\"\"woof checks package.\n     2\t\n     3\tCheckContext and CheckOutcome are the shared types for all check runners.\n     4\tThe registry (woof/checks/registry.py) maps check IDs to Check entries.\n     5\t\"\"\"\n     6\t\n     7\tfrom __future__ import annotations\n     8\t\n     9\tfrom dataclasses import dataclass, field\n    10\tfrom pathlib import Path\n    11\t\n    12\t\n    13\t@dataclass\n    14\tclass CheckContext:\n    15\t    \"\"\"Execution context passed to every check runner.\"\"\"\n    16\t\n    17\t    epic_id: int\n    18\t    story_id: str\n    19\t    repo_root: Path\n    20\t    epic_dir: Path\n    21\t    plan: dict\n    22\t    critique: dict | None = None\n    23\t\n    24\t\n    25\t@dataclass\n    26\tclass CheckOutcome:\n    27\t    \"\"\"Structured result produced by a single check runner.\"\"\"\n    28\t\n    29\t    id: str\n    30\t    ok: bool\n    31\t    severity: str | None  # null | \"info\" | \"minor\" | \"blocker\"\n    32\t    summary: str\n    33\t    evidence: str | None = None\n    34\t    paths: list[str] = field(default_factory=list)\n    35\t    command: str | None = None\n    36\t    exit_code: int | None = None\n","exit_code":0,"status":"completed"}}
