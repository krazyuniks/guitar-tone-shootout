{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/usr/bin/zsh -lc \"nl -ba scripts/wf-run | sed -n '1,420p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/usr/bin/zsh -lc \"nl -ba woof/cli/commands/check.py | sed -n '1,360p'\"","aggregated_output":"     1\t\"\"\"woof check stage-5 — deterministic Stage-5 boundary check runner.\n     2\t\n     3\tIterates the registry for stage=5, runs each runner against the current\n     4\tepic/story context, and emits a check-result conforming to\n     5\twoof/schemas/check-result.schema.json.\n     6\t\n     7\tExit codes:\n     8\t    0   all checks ok (check-result.ok == true)\n     9\t    1   one or more checks failed (check-result.ok == false)\n    10\t    2   usage / missing artefact error\n    11\t\"\"\"\n    12\t\n    13\tfrom __future__ import annotations\n    14\t\n    15\timport argparse\n    16\timport json\n    17\timport sys\n    18\tfrom dataclasses import asdict\n    19\tfrom pathlib import Path\n    20\t\n    21\t\n    22\tdef _load_plan(plan_path: Path) -> dict:\n    23\t    return json.loads(plan_path.read_text())\n    24\t\n    25\t\n    26\tdef _load_critique_fm(epic_dir: Path, story_id: str) -> dict | None:\n    27\t    p = epic_dir / \"critique\" / f\"story-{story_id}.md\"\n    28\t    if not p.exists():\n    29\t        return None\n    30\t    import yaml\n    31\t\n    32\t    text = p.read_text()\n    33\t    if not text.startswith(\"---\\n\"):\n    34\t        return None\n    35\t    end = text.find(\"\\n---\\n\", 4)\n    36\t    if end < 0:\n    37\t        return None\n    38\t    try:\n    39\t        return yaml.safe_load(text[4:end]) or {}\n    40\t    except Exception:  # noqa: BLE001\n    41\t        return None\n    42\t\n    43\t\n    44\tdef _outcome_to_dict(outcome: object) -> dict:\n    45\t    \"\"\"Convert a CheckOutcome dataclass to a JSON-serialisable dict.\"\"\"\n    46\t    d = asdict(outcome)  # type: ignore[arg-type]\n    47\t    return d\n    48\t\n    49\t\n    50\tdef _self_test(registry: dict, stage_ids: list[str]) -> int:\n    51\t    \"\"\"Check every stage-5 runner is implemented. Exit 0 if all ok, 1 if any missing.\"\"\"\n    52\t    failures: list[str] = []\n    53\t    for check_id in stage_ids:\n    54\t        check = registry.get(check_id)\n    55\t        if check is None:\n    56\t            failures.append(f\"{check_id}: not in registry\")\n    57\t            continue\n    58\t        try:\n    59\t            check.runner(None)  # type: ignore[arg-type]\n    60\t        except NotImplementedError:\n    61\t            failures.append(f\"{check_id}: runner raises NotImplementedError (not implemented)\")\n    62\t        except Exception:  # noqa: BLE001\n    63\t            pass  # raised for a real reason — runner IS implemented\n    64\t\n    65\t    if failures:\n    66\t        for msg in failures:\n    67\t            sys.stderr.write(f\"woof check stage-5 --self-test FAIL: {msg}\\n\")\n    68\t        return 1\n    69\t\n    70\t    sys.stdout.write(\n    71\t        f\"woof check stage-5 --self-test OK: all {len(stage_ids)} runners implemented\\n\"\n    72\t    )\n    73\t    return 0\n    74\t\n    75\t\n    76\tdef cmd_check_stage_5(args: argparse.Namespace) -> int:\n    77\t    from woof.checks.registry import REGISTRY, STAGE_5_CHECK_IDS\n    78\t\n    79\t    if args.self_test:\n    80\t        return _self_test(REGISTRY, STAGE_5_CHECK_IDS)\n    81\t\n    82\t    if not args.epic:\n    83\t        sys.stderr.write(\"woof check stage-5: --epic required (unless --self-test)\\n\")\n    84\t        return 2\n    85\t    if not args.story:\n    86\t        sys.stderr.write(\"woof check stage-5: --story required (unless --self-test)\\n\")\n    87\t        return 2\n    88\t\n    89\t    repo_root = _find_repo_root()\n    90\t    epic_dir = repo_root / \".woof\" / \"epics\" / f\"E{args.epic}\"\n    91\t    plan_path = epic_dir / \"plan.json\"\n    92\t\n    93\t    if not plan_path.exists():\n    94\t        sys.stderr.write(f\"woof check stage-5: {plan_path} not found\\n\")\n    95\t        return 2\n    96\t\n    97\t    from woof.checks import CheckContext\n    98\t\n    99\t    plan = _load_plan(plan_path)\n   100\t    critique = _load_critique_fm(epic_dir, args.story)\n   101\t    ctx = CheckContext(\n   102\t        epic_id=args.epic,\n   103\t        story_id=args.story,\n   104\t        repo_root=repo_root,\n   105\t        epic_dir=epic_dir,\n   106\t        plan=plan,\n   107\t        critique=critique,\n   108\t    )\n   109\t\n   110\t    outcomes = []\n   111\t    triggered_by: list[str] = []\n   112\t\n   113\t    for check_id in STAGE_5_CHECK_IDS:\n   114\t        check = REGISTRY[check_id]\n   115\t        try:\n   116\t            outcome = check.runner(ctx)\n   117\t        except NotImplementedError:\n   118\t            outcomes.append({\n   119\t                \"id\": check_id,\n   120\t                \"ok\": False,\n   121\t                \"severity\": \"blocker\",\n   122\t                \"summary\": f\"{check_id}: runner not implemented\",\n   123\t                \"evidence\": None,\n   124\t                \"paths\": [],\n   125\t                \"command\": None,\n   126\t                \"exit_code\": None,\n   127\t            })\n   128\t            triggered_by.append(check_id)\n   129\t            continue\n   130\t        d = _outcome_to_dict(outcome)\n   131\t        outcomes.append(d)\n   132\t        if not outcome.ok:\n   133\t            triggered_by.append(check_id)\n   134\t\n   135\t    result = {\n   136\t        \"ok\": len(triggered_by) == 0,\n   137\t        \"stage\": 5,\n   138\t        \"epic_id\": args.epic,\n   139\t        \"story_id\": args.story,\n   140\t        \"triggered_by\": triggered_by,\n   141\t        \"checks\": outcomes,\n   142\t    }\n   143\t\n   144\t    if args.format == \"json\":\n   145\t        sys.stdout.write(json.dumps(result) + \"\\n\")\n   146\t    else:\n   147\t        ok_str = \"OK\" if result[\"ok\"] else \"FAIL\"\n   148\t        sys.stdout.write(f\"woof check stage-5: {ok_str}\\n\")\n   149\t        for c in outcomes:\n   150\t            status = \"OK  \" if c[\"ok\"] else \"FAIL\"\n   151\t            sys.stdout.write(f\"  {status} {c['id']}: {c['summary']}\\n\")\n   152\t            if not c[\"ok\"] and c.get(\"evidence\"):\n   153\t                sys.stdout.write(f\"       evidence: {c['evidence']}\\n\")\n   154\t\n   155\t    return 0 if result[\"ok\"] else 1\n   156\t\n   157\t\n   158\tdef _find_repo_root() -> Path:\n   159\t    \"\"\"Walk up to the first directory containing a .woof/ directory.\"\"\"\n   160\t    for candidate in [Path.cwd(), *Path.cwd().parents]:\n   161\t        if (candidate / \".woof\").is_dir():\n   162\t            return candidate\n   163\t    # Fallback: assume cwd\n   164\t    return Path.cwd()\n   165\t\n   166\t\n   167\tdef setup_check_parser(sub: argparse._SubParsersAction) -> None:  # type: ignore[type-arg]\n   168\t    check_p = sub.add_parser(\"check\", help=\"run stage boundary checks\")\n   169\t    check_sub = check_p.add_subparsers(dest=\"check_stage\", required=True)\n   170\t\n   171\t    stage5 = check_sub.add_parser(\"stage-5\", help=\"run Stage-5 checks for a story\")\n   172\t    stage5.add_argument(\"--epic\", type=int, help=\"epic id (gh issue number)\")\n   173\t    stage5.add_argument(\"--story\", help=\"story id (e.g. S1)\")\n   174\t    stage5.add_argument(\n   175\t        \"--format\", choices=[\"text\", \"json\"], default=\"text\",\n   176\t        help=\"output format (default: text)\",\n   177\t    )\n   178\t    stage5.add_argument(\n   179\t        \"--self-test\", action=\"store_true\",\n   180\t        help=\"enumerate registry and exit non-zero if any runner is unimplemented\",\n   181\t    )\n   182\t    stage5.set_defaults(func=cmd_check_stage_5)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/usr/bin/zsh -lc \"nl -ba scripts/wf-run | sed -n '1,420p'\"","aggregated_output":"     1\t#!/usr/bin/env bash\n     2\t# wf-run — woof Stage-5 driver loop.\n     3\t#\n     4\t# Implements the producer/verifier/committer separation (E182):\n     5\t#   - Producer: cld story-executor subprocess (writes executor_result.json, exits 0)\n     6\t#   - Verifier: this script runs `woof check stage-5` against the staged state\n     7\t#   - Committer: this script invokes `git commit` only when check-result.ok == true\n     8\t#\n     9\t# Exit codes:\n    10\t#   0   epic complete (all stories done; no gate)\n    11\t#   1   gate.md exists; halt for /wf Stage 6\n    12\t#   2   driver / preflight error (lockfile, malformed plan.json, missing tool)\n    13\t#   130 SIGINT propagated to subprocess\n    14\t\n    15\tset -euo pipefail\n    16\t\n    17\tREPO_ROOT=\"$(git rev-parse --show-toplevel)\"\n    18\tWOOF_BIN=\"$REPO_ROOT/woof/bin/woof\"\n    19\t\n    20\tusage() {\n    21\t    cat <<'EOF'\n    22\tUsage: scripts/wf-run --epic <N>\n    23\t\n    24\tDrives Stage 5 for epic E<N> by dispatching /wf:execute-story per pending story.\n    25\tReads .woof/agents.toml for the story-executor role; honours the lockfile at\n    26\t.woof/epics/E<N>/.wf.lock.\n    27\tEOF\n    28\t}\n    29\t\n    30\tEPIC=\"\"\n    31\twhile [[ $# -gt 0 ]]; do\n    32\t    case \"$1\" in\n    33\t        --epic) EPIC=\"$2\"; shift 2;;\n    34\t        -h|--help) usage; exit 0;;\n    35\t        *) echo \"wf-run: unknown arg '$1'\" >&2; usage >&2; exit 2;;\n    36\t    esac\n    37\tdone\n    38\t\n    39\t[[ -n \"$EPIC\" ]] || { echo \"wf-run: --epic required\" >&2; exit 2; }\n    40\t[[ \"$EPIC\" =~ ^[1-9][0-9]*$ ]] || { echo \"wf-run: --epic must be a positive integer\" >&2; exit 2; }\n    41\t\n    42\tEPIC_DIR=\"$REPO_ROOT/.woof/epics/E${EPIC}\"\n    43\tPLAN=\"$EPIC_DIR/plan.json\"\n    44\tGATE=\"$EPIC_DIR/gate.md\"\n    45\tLOCK=\"$EPIC_DIR/.wf.lock\"\n    46\tJSONL=\"$EPIC_DIR/dispatch.jsonl\"\n    47\tEPIC_LOG=\"$EPIC_DIR/epic.jsonl\"\n    48\tEXECUTOR_RESULT=\"$EPIC_DIR/executor_result.json\"\n    49\t\n    50\t[[ -f \"$PLAN\" ]] || { echo \"wf-run: $PLAN not found\" >&2; exit 2; }\n    51\t[[ -f \"$REPO_ROOT/.woof/agents.toml\" ]] || { echo \"wf-run: .woof/agents.toml not found\" >&2; exit 2; }\n    52\t\n    53\tcommand -v jq >/dev/null || { echo \"wf-run: jq required\" >&2; exit 2; }\n    54\t[[ -x \"$WOOF_BIN\" ]] || { echo \"wf-run: $WOOF_BIN not executable\" >&2; exit 2; }\n    55\t\n    56\t# ---------------------------------------------------------------------------\n    57\t# Lockfile\n    58\t# ---------------------------------------------------------------------------\n    59\t\n    60\tacquire_lock() {\n    61\t    if [[ -f \"$LOCK\" ]]; then\n    62\t        local pid\n    63\t        pid=\"$(jq -r '.pid' \"$LOCK\" 2>/dev/null || echo \"\")\"\n    64\t        if [[ -n \"$pid\" ]] && kill -0 \"$pid\" 2>/dev/null; then\n    65\t            local started host invoker\n    66\t            started=\"$(jq -r '.started_at' \"$LOCK\")\"\n    67\t            host=\"$(jq -r '.host' \"$LOCK\")\"\n    68\t            invoker=\"$(jq -r '.invoker' \"$LOCK\")\"\n    69\t            echo \"wf-run: another woof process holds the lock\" >&2\n    70\t            echo \"  pid=$pid invoker=$invoker host=$host started=$started\" >&2\n    71\t            echo \"  wait or 'kill $pid', then retry.\" >&2\n    72\t            exit 2\n    73\t        fi\n    74\t        echo \"wf-run: stale lockfile (pid $pid not alive); reclaiming.\" >&2\n    75\t    fi\n    76\t    jq -n --arg pid \"$$\" --arg invoker \"wf-run\" \\\n    77\t        --arg started \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\" \\\n    78\t        --arg host \"$(hostname)\" \\\n    79\t        '{pid: ($pid|tonumber), invoker: $invoker, started_at: $started, host: $host}' \\\n    80\t        > \"$LOCK\"\n    81\t}\n    82\t\n    83\trelease_lock() {\n    84\t    rm -f \"$LOCK\"\n    85\t}\n    86\t\n    87\t# ---------------------------------------------------------------------------\n    88\t# JSONL append\n    89\t# ---------------------------------------------------------------------------\n    90\t\n    91\tappend_jsonl() {\n    92\t    local path=\"$1\"; shift\n    93\t    mkdir -p \"$(dirname \"$path\")\"\n    94\t    printf '%s\\n' \"$1\" >> \"$path\"\n    95\t}\n    96\t\n    97\tnow_iso() { date -u +%Y-%m-%dT%H:%M:%SZ; }\n    98\t\n    99\t# ---------------------------------------------------------------------------\n   100\t# Plan helpers\n   101\t# ---------------------------------------------------------------------------\n   102\t\n   103\tnext_story_id() {\n   104\t    # First pending story whose depends_on are all done.\n   105\t    jq -r '\n   106\t        . as $root\n   107\t        | .stories\n   108\t        | map(select(.status == \"pending\"))\n   109\t        | map(select(\n   110\t            (.depends_on // [])\n   111\t            | all(. as $dep | ($root.stories[] | select(.id == $dep) | .status) == \"done\")\n   112\t        ))\n   113\t        | sort_by(.id)\n   114\t        | (first // empty).id // empty\n   115\t    ' \"$PLAN\"\n   116\t}\n   117\t\n   118\tall_done() {\n   119\t    local n\n   120\t    n=\"$(jq '[.stories[] | select(.status != \"done\")] | length' \"$PLAN\")\"\n   121\t    [[ \"$n\" == \"0\" ]]\n   122\t}\n   123\t\n   124\tset_story_status() {\n   125\t    local sid=\"$1\" status=\"$2\" tmp\n   126\t    tmp=\"$(mktemp)\"\n   127\t    jq --arg sid \"$sid\" --arg st \"$status\" \\\n   128\t        '(.stories[] | select(.id == $sid) | .status) = $st' \\\n   129\t        \"$PLAN\" > \"$tmp\"\n   130\t    mv \"$tmp\" \"$PLAN\"\n   131\t}\n   132\t\n   133\t# ---------------------------------------------------------------------------\n   134\t# Dispatch one story — new executor protocol\n   135\t# ---------------------------------------------------------------------------\n   136\t\n   137\tbootstrap_prompt() {\n   138\t    local sid=\"$1\"\n   139\t    cat <<EOF\n   140\tYou are executing story ${sid} in epic E${EPIC}.\n   141\t\n   142\tRead in order:\n   143\t  1. .woof/.current-epic                                  — verify E${EPIC}\n   144\t  2. .woof/epics/E${EPIC}/plan.json                       — find ${sid}\n   145\t  3. .woof/epics/E${EPIC}/EPIC.md                         — front-matter for outcomes / contract decisions\n   146\t  4. CLAUDE.md / AGENTS.md                                — project conventions\n   147\t\n   148\tThen invoke /wf:execute-story with arguments \"E${EPIC} ${sid}\".\n   149\t\n   150\tExit 0 only after writing executor_result.json. Exit non-zero on crash/abort without writing it.\n   151\tEOF\n   152\t}\n   153\t\n   154\tdispatch_story() {\n   155\t    local sid=\"$1\" prompt_file\n   156\t    prompt_file=\"$(mktemp)\"\n   157\t    bootstrap_prompt \"$sid\" > \"$prompt_file\"\n   158\t\n   159\t    # Clean up any stale executor_result from a previous attempt\n   160\t    rm -f \"$EXECUTOR_RESULT\"\n   161\t\n   162\t    append_jsonl \"$EPIC_LOG\" \"$(jq -nc \\\n   163\t        --arg at \"$(now_iso)\" --argjson eid \"$EPIC\" --arg sid \"$sid\" \\\n   164\t        '{event:\"story_started\", at:$at, epic_id:$eid, story_id:$sid}')\"\n   165\t\n   166\t    set_story_status \"$sid\" \"in_progress\"\n   167\t\n   168\t    set +e\n   169\t    \"$WOOF_BIN\" dispatch claude \\\n   170\t        --role story-executor --epic \"$EPIC\" --story \"$sid\" \\\n   171\t        --prompt-file \"$prompt_file\"\n   172\t    local rc=$?\n   173\t    set -e\n   174\t    rm -f \"$prompt_file\"\n   175\t\n   176\t    # --- Executor exited ---\n   177\t\n   178\t    if [[ $rc -ne 0 ]] || [[ ! -f \"$EXECUTOR_RESULT\" ]]; then\n   179\t        # Subprocess crashed or exited without writing executor_result.json\n   180\t        emit \"wf-run: ${sid} subprocess crashed (rc=${rc}) — writing gate\"\n   181\t        set_story_status \"$sid\" \"pending\"\n   182\t        \"$WOOF_BIN\" gate write \\\n   183\t            --epic \"$EPIC\" --story \"$sid\" \\\n   184\t            --triggered-by subprocess_crash \\\n   185\t            --exit-code \"$rc\"\n   186\t        return 1\n   187\t    fi\n   188\t\n   189\t    # Record executor_result\n   190\t    local outcome\n   191\t    outcome=\"$(jq -r '.outcome' \"$EXECUTOR_RESULT\")\"\n   192\t    append_jsonl \"$EPIC_LOG\" \"$(jq -nc \\\n   193\t        --arg at \"$(now_iso)\" --argjson eid \"$EPIC\" --arg sid \"$sid\" \\\n   194\t        --arg outcome \"$outcome\" --argjson ec \"$rc\" \\\n   195\t        '{event:\"executor_result_recorded\", at:$at, epic_id:$eid, story_id:$sid, outcome:$outcome, exit_code:$ec}')\"\n   196\t\n   197\t    case \"$outcome\" in\n   198\t        aborted_with_position)\n   199\t            emit \"wf-run: ${sid} executor aborted — writing gate\"\n   200\t            local pos_file\n   201\t            pos_file=\"$(mktemp)\"\n   202\t            jq -r '.position // \"\"' \"$EXECUTOR_RESULT\" > \"$pos_file\"\n   203\t            set_story_status \"$sid\" \"pending\"\n   204\t            \"$WOOF_BIN\" gate write \\\n   205\t                --epic \"$EPIC\" --story \"$sid\" \\\n   206\t                --triggered-by executor_aborted \\\n   207\t                --from-position \"$pos_file\"\n   208\t            rm -f \"$pos_file\" \"$EXECUTOR_RESULT\"\n   209\t            return 1\n   210\t            ;;\n   211\t\n   212\t        empty_diff)\n   213\t            emit \"wf-run: ${sid} executor reports empty diff — writing gate\"\n   214\t            local pos_file\n   215\t            pos_file=\"$(mktemp)\"\n   216\t            jq -r '.position // \"\"' \"$EXECUTOR_RESULT\" > \"$pos_file\"\n   217\t            set_story_status \"$sid\" \"pending\"\n   218\t            \"$WOOF_BIN\" gate write \\\n   219\t                --epic \"$EPIC\" --story \"$sid\" \\\n   220\t                --triggered-by empty_diff_review \\\n   221\t                --from-position \"$pos_file\"\n   222\t            rm -f \"$pos_file\" \"$EXECUTOR_RESULT\"\n   223\t            return 1\n   224\t            ;;\n   225\t\n   226\t        staged_for_verification)\n   227\t            emit \"wf-run: ${sid} staged — running woof check stage-5\"\n   228\t            local check_result_file\n   229\t            check_result_file=\"$(mktemp)\"\n   230\t\n   231\t            set +e\n   232\t            \"$WOOF_BIN\" check stage-5 \\\n   233\t                --epic \"$EPIC\" --story \"$sid\" \\\n   234\t                --format json > \"$check_result_file\"\n   235\t            local check_rc=$?\n   236\t            set -e\n   237\t\n   238\t            # Record check_run event\n   239\t            local check_ok\n   240\t            check_ok=\"$(jq -r '.ok' \"$check_result_file\" 2>/dev/null || echo \"false\")\"\n   241\t            local triggered_by_json\n   242\t            triggered_by_json=\"$(jq -c '.triggered_by // []' \"$check_result_file\" 2>/dev/null || echo '[]')\"\n   243\t            append_jsonl \"$EPIC_LOG\" \"$(jq -nc \\\n   244\t                --arg at \"$(now_iso)\" --argjson eid \"$EPIC\" --arg sid \"$sid\" \\\n   245\t                --argjson ok \"$([ \"$check_ok\" = \"true\" ] && echo true || echo false)\" \\\n   246\t                --argjson tb \"$triggered_by_json\" \\\n   247\t                '{event:\"check_run\", at:$at, epic_id:$eid, story_id:$sid, stage:5, ok:$ok, triggered_by:$tb}')\"\n   248\t\n   249\t            if [[ $check_rc -ne 0 ]]; then\n   250\t                emit \"wf-run: ${sid} check stage-5 failed — writing gate\"\n   251\t                local pos_file\n   252\t                pos_file=\"$(mktemp)\"\n   253\t                printf 'Check stage-5 failed for story %s. See check-result for details.\\n' \"$sid\" > \"$pos_file\"\n   254\t                set_story_status \"$sid\" \"pending\"\n   255\t                \"$WOOF_BIN\" gate write \\\n   256\t                    --epic \"$EPIC\" --story \"$sid\" \\\n   257\t                    --from-check-result \"$check_result_file\" \\\n   258\t                    --position-file \"$pos_file\"\n   259\t                rm -f \"$pos_file\" \"$check_result_file\" \"$EXECUTOR_RESULT\"\n   260\t                return 1\n   261\t            fi\n   262\t\n   263\t            rm -f \"$check_result_file\"\n   264\t\n   265\t            # All checks passed — driver commits\n   266\t            local story_title\n   267\t            story_title=\"$(jq -r --arg sid \"$sid\" \\\n   268\t                '.stories[] | select(.id == $sid) | .title' \"$PLAN\")\"\n   269\t            local commit_subject=\"feat(woof): E${EPIC} ${sid} — ${story_title}\"\n   270\t            local commit_body\n   271\t            commit_body=\"$(jq -r '.commit_body // \"\"' \"$EXECUTOR_RESULT\")\"\n   272\t\n   273\t            if [[ -n \"$commit_body\" ]]; then\n   274\t                git commit -m \"$commit_subject\" -m \"$commit_body\"\n   275\t            else\n   276\t                git commit -m \"$commit_subject\"\n   277\t            fi\n   278\t\n   279\t            local commit_sha\n   280\t            commit_sha=\"$(git rev-parse HEAD)\"\n   281\t\n   282\t            append_jsonl \"$EPIC_LOG\" \"$(jq -nc \\\n   283\t                --arg at \"$(now_iso)\" --argjson eid \"$EPIC\" --arg sid \"$sid\" \\\n   284\t                --arg sha \"$commit_sha\" \\\n   285\t                '{event:\"story_committed\", at:$at, epic_id:$eid, story_id:$sid, commit_sha:$sha}')\"\n   286\t\n   287\t            rm -f \"$EXECUTOR_RESULT\"\n   288\t            emit \"wf-run: ${sid} committed (${commit_sha:0:7})\"\n   289\t            return 0\n   290\t            ;;\n   291\t\n   292\t        *)\n   293\t            emit \"wf-run: ${sid} unknown outcome '${outcome}' — writing crash gate\"\n   294\t            set_story_status \"$sid\" \"pending\"\n   295\t            \"$WOOF_BIN\" gate write \\\n   296\t                --epic \"$EPIC\" --story \"$sid\" \\\n   297\t                --triggered-by subprocess_crash \\\n   298\t                --exit-code 0\n   299\t            rm -f \"$EXECUTOR_RESULT\"\n   300\t            return 1\n   301\t            ;;\n   302\t    esac\n   303\t}\n   304\t\n   305\t# ---------------------------------------------------------------------------\n   306\t# SIGINT propagation\n   307\t# ---------------------------------------------------------------------------\n   308\t\n   309\tCHILD_PID=\"\"\n   310\ton_sigint() {\n   311\t    if [[ -n \"$CHILD_PID\" ]]; then\n   312\t        kill -INT \"$CHILD_PID\" 2>/dev/null || true\n   313\t        wait \"$CHILD_PID\" 2>/dev/null || true\n   314\t    fi\n   315\t    append_jsonl \"$JSONL\" \"$(jq -nc --arg at \"$(now_iso)\" \\\n   316\t        --argjson eid \"$EPIC\" \\\n   317\t        '{event:\"subprocess_killed\", at:$at, epic_id:$eid, signal:\"SIGINT\", reason:\"manual_cancel\"}')\"\n   318\t    release_lock\n   319\t    exit 130\n   320\t}\n   321\ttrap on_sigint INT TERM\n   322\t\n   323\t# ---------------------------------------------------------------------------\n   324\t# Main loop\n   325\t# ---------------------------------------------------------------------------\n   326\t\n   327\tacquire_lock\n   328\ttrap 'release_lock' EXIT\n   329\t\n   330\t# Driver streaming UX (one structured line per event for /wf to surface)\n   331\temit() { printf '%s\\n' \"$1\"; }\n   332\t\n   333\tif [[ -f \"$GATE\" ]]; then\n   334\t    emit \"wf-run: gate.md already present at $GATE — halting (Stage 6)\"\n   335\t    exit 1\n   336\tfi\n   337\t\n   338\twhile :; do\n   339\t    if [[ -f \"$GATE\" ]]; then\n   340\t        emit \"wf-run: gate.md detected — halting\"\n   341\t        exit 1\n   342\t    fi\n   343\t\n   344\t    if all_done; then\n   345\t        append_jsonl \"$EPIC_LOG\" \"$(jq -nc --arg at \"$(now_iso)\" --argjson eid \"$EPIC\" \\\n   346\t            '{event:\"epic_completed\", at:$at, epic_id:$eid}')\"\n   347\t        emit \"wf-run: epic E${EPIC} complete — every story status=done\"\n   348\t        exit 0\n   349\t    fi\n   350\t\n   351\t    sid=\"$(next_story_id)\"\n   352\t    if [[ -z \"$sid\" ]]; then\n   353\t        emit \"wf-run: no eligible pending story (all blocked on unsatisfied depends_on)\"\n   354\t        exit 1\n   355\t    fi\n   356\t\n   357\t    emit \"wf-run: dispatching ${sid}\"\n   358\t\n   359\t    if dispatch_story \"$sid\"; then\n   360\t        # Verifier confirmed ok, driver committed — loop to next story\n   361\t        continue\n   362\t    fi\n   363\t\n   364\t    # Gate was written (dispatch_story returned non-zero)\n   365\t    emit \"wf-run: gate.md written for ${sid} — halting\"\n   366\t    exit 1\n   367\tdone\n","exit_code":0,"status":"completed"}}
