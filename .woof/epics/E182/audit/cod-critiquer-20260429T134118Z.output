{"type":"item.completed","item":{"id":"item_37","type":"command_execution","command":"/usr/bin/zsh -lc \"nl -ba woof/cli/dispatcher.py | sed -n '1,280p'\"","aggregated_output":"     1\t\"\"\"Dispatch adapter for woof subprocesses.\n     2\t\n     3\tThe full dispatch implementation lives in woof/bin/woof (cmd_dispatch).\n     4\tThis module exposes a thin programmatic interface for testing and future\n     5\tmigration of the dispatch logic out of the monolithic script.\n     6\t\"\"\"\n     7\t\n     8\tfrom __future__ import annotations\n","exit_code":0,"status":"completed"}}
