{"type":"item.completed","item":{"id":"item_39","type":"command_execution","command":"/usr/bin/zsh -lc \"nl -ba woof/bin/woof | sed -n '1,460p'\"","aggregated_output":"     1\t#!/usr/bin/env -S uv run --script\n     2\t# /// script\n     3\t# requires-python = \">=3.11\"\n     4\t# dependencies = [\"pyyaml>=6\", \"pydantic>=2\"]\n     5\t# ///\n     6\t\"\"\"woof — workflow orchestrator CLI.\n     7\t\n     8\tSubcommands:\n     9\t    validate     Validate artefacts against woof JSON Schemas via ajv-cli.\n    10\t    dispatch     Spawn a cld/cod subprocess for a role declared in agents.toml.\n    11\t    render-epic  Render EPIC.md front-matter into the gh issue body; optionally\n    12\t                 sync to GitHub with conflict detection (.last-sync).\n    13\t    check-cd     Verify each contract_decision's referenced artefact actually\n    14\t                 exists and parses (Stage 5 Check 4 / E146 regression).\n    15\t\n    16\tSchemas live at ``woof/schemas/*.schema.json`` (JSON Schema 2020-12).\n    17\tAuto-detection maps filename to schema; ``--schema`` overrides.\n    18\t\"\"\"\n    19\t\n    20\tfrom __future__ import annotations\n    21\t\n    22\timport argparse\n    23\timport hashlib\n    24\timport json\n    25\timport os\n    26\timport re\n    27\timport shutil\n    28\timport subprocess\n    29\timport sys\n    30\timport tempfile\n    31\timport tomllib\n    32\tfrom datetime import datetime, timezone\n    33\tfrom pathlib import Path\n    34\t\n    35\timport yaml\n    36\t\n    37\tREPO_ROOT = Path(__file__).resolve().parents[2]\n    38\tSCHEMA_DIR = REPO_ROOT / \"woof\" / \"schemas\"\n    39\t\n    40\t# Make woof/ modules (checks, gate, cli) importable at runtime.\n    41\tsys.path.insert(0, str(REPO_ROOT))\n    42\t\n    43\tSCHEMAS: dict[str, str] = {\n    44\t    \"epic\": \"epic.schema.json\",\n    45\t    \"plan\": \"plan.schema.json\",\n    46\t    \"gate\": \"gate.schema.json\",\n    47\t    \"critique\": \"critique.schema.json\",\n    48\t    \"jsonl-events\": \"jsonl-events.schema.json\",\n    49\t    \"prerequisites\": \"prerequisites.schema.json\",\n    50\t    \"agents\": \"agents.schema.json\",\n    51\t    \"test-markers\": \"test-markers.schema.json\",\n    52\t    \"language-registry\": \"language-registry.schema.json\",\n    53\t    \"quality-gates\": \"quality-gates.schema.json\",\n    54\t    \"docs-paths\": \"docs-paths.schema.json\",\n    55\t    \"check-result\": \"check-result.schema.json\",\n    56\t    \"executor-result\": \"executor-result.schema.json\",\n    57\t}\n    58\t\n    59\t# Filename → schema (basename match)\n    60\tFILENAME_RULES: list[tuple[re.Pattern[str], str]] = [\n    61\t    (re.compile(r\"^EPIC\\.md$\"), \"epic\"),\n    62\t    (re.compile(r\"^plan\\.json$\"), \"plan\"),\n    63\t    (re.compile(r\"^gate\\.md$\"), \"gate\"),\n    64\t    (re.compile(r\"^.+\\.jsonl$\"), \"jsonl-events\"),\n    65\t    (re.compile(r\"^prerequisites\\.toml$\"), \"prerequisites\"),\n    66\t    (re.compile(r\"^agents\\.toml$\"), \"agents\"),\n    67\t    (re.compile(r\"^test-markers\\.toml$\"), \"test-markers\"),\n    68\t    (re.compile(r\"^quality-gates\\.toml$\"), \"quality-gates\"),\n    69\t    (re.compile(r\"^docs-paths\\.toml$\"), \"docs-paths\"),\n    70\t    (re.compile(r\"^check-result\\.json$\"), \"check-result\"),\n    71\t    (re.compile(r\"^executor-result\\.json$\"), \"executor-result\"),\n    72\t]\n    73\t\n    74\t# Path-suffix → schema (for files distinguished by parent dir)\n    75\tPATH_RULES: list[tuple[re.Pattern[str], str]] = [\n    76\t    (re.compile(r\"(^|/)critique/[^/]+\\.md$\"), \"critique\"),\n    77\t    (re.compile(r\"(^|/)languages/[^/]+\\.toml$\"), \"language-registry\"),\n    78\t]\n    79\t\n    80\t\n    81\tdef detect_schema(path: Path) -> str | None:\n    82\t    \"\"\"Return schema name for ``path`` or None if no rule matches.\"\"\"\n    83\t    name = path.name\n    84\t    for pattern, schema in FILENAME_RULES:\n    85\t        if pattern.match(name):\n    86\t            return schema\n    87\t    posix = path.as_posix()\n    88\t    for pattern, schema in PATH_RULES:\n    89\t        if pattern.search(posix):\n    90\t            return schema\n    91\t    return None\n    92\t\n    93\t\n    94\tdef extract_front_matter(path: Path) -> object:\n    95\t    \"\"\"Parse YAML front-matter (delimited by ``---`` on its own line).\"\"\"\n    96\t    text = path.read_text()\n    97\t    if not text.startswith(\"---\\n\"):\n    98\t        raise ValueError(f\"{path}: no YAML front-matter (file must start with '---\\\\n')\")\n    99\t    end = text.find(\"\\n---\\n\", 4)\n   100\t    if end < 0:\n   101\t        end_alt = text.find(\"\\n---\", 4)\n   102\t        if end_alt < 0 or text[end_alt:].rstrip() != \"---\":\n   103\t            raise ValueError(f\"{path}: unterminated YAML front-matter\")\n   104\t        end = end_alt\n   105\t    block = text[4:end]\n   106\t    return yaml.safe_load(block) or {}\n   107\t\n   108\t\n   109\tdef load_payload(path: Path, schema: str) -> object:\n   110\t    \"\"\"Extract the structured payload appropriate for ``schema``.\"\"\"\n   111\t    if schema in {\"epic\", \"gate\", \"critique\"}:\n   112\t        return extract_front_matter(path)\n   113\t    if schema in {\"plan\", \"check-result\", \"executor-result\"}:\n   114\t        return json.loads(path.read_text())\n   115\t    if schema in {\n   116\t        \"prerequisites\",\n   117\t        \"agents\",\n   118\t        \"test-markers\",\n   119\t        \"language-registry\",\n   120\t        \"quality-gates\",\n   121\t        \"docs-paths\",\n   122\t    }:\n   123\t        with path.open(\"rb\") as fh:\n   124\t            return tomllib.load(fh)\n   125\t    raise ValueError(f\"load_payload: unhandled schema '{schema}'\")\n   126\t\n   127\t\n   128\tdef run_ajv(schema_path: Path, data_json: bytes) -> tuple[bool, str]:\n   129\t    \"\"\"Run ajv-cli; return (ok, combined-output).\"\"\"\n   130\t    with tempfile.NamedTemporaryFile(\"wb\", suffix=\".json\", delete=False) as fh:\n   131\t        fh.write(data_json)\n   132\t        data_path = fh.name\n   133\t    try:\n   134\t        proc = subprocess.run(\n   135\t            [\n   136\t                \"ajv\",\n   137\t                \"validate\",\n   138\t                \"--spec=draft2020\",\n   139\t                \"-c\",\n   140\t                \"ajv-formats\",\n   141\t                \"-s\",\n   142\t                str(schema_path),\n   143\t                \"-d\",\n   144\t                data_path,\n   145\t            ],\n   146\t            capture_output=True,\n   147\t            text=True,\n   148\t        )\n   149\t    finally:\n   150\t        Path(data_path).unlink(missing_ok=True)\n   151\t    output = (proc.stdout + proc.stderr).strip()\n   152\t    return proc.returncode == 0, output\n   153\t\n   154\t\n   155\tdef ensure_ajv() -> None:\n   156\t    \"\"\"Exit non-zero if ajv-cli is not on PATH.\"\"\"\n   157\t    if shutil.which(\"ajv\") is None:\n   158\t        sys.stderr.write(\n   159\t            \"woof: ajv-cli not found on PATH.\\n\"\n   160\t            \"Install: volta install ajv-cli ajv-formats\\n\"\n   161\t        )\n   162\t        sys.exit(2)\n   163\t\n   164\t\n   165\tdef validate_jsonl(path: Path, schema_path: Path) -> tuple[bool, list[str]]:\n   166\t    \"\"\"Validate every non-blank line of a JSONL file.\"\"\"\n   167\t    messages: list[str] = []\n   168\t    all_ok = True\n   169\t    line_count = 0\n   170\t    for lineno, raw in enumerate(path.read_text().splitlines(), 1):\n   171\t        line = raw.strip()\n   172\t        if not line:\n   173\t            continue\n   174\t        line_count += 1\n   175\t        try:\n   176\t            payload = json.loads(line)\n   177\t        except json.JSONDecodeError as exc:\n   178\t            all_ok = False\n   179\t            messages.append(f\"{path}:{lineno}: invalid JSON: {exc}\")\n   180\t            continue\n   181\t        ok, output = run_ajv(schema_path, json.dumps(payload, default=str).encode())\n   182\t        if not ok:\n   183\t            all_ok = False\n   184\t            messages.append(f\"{path}:{lineno}: INVALID\\n{output}\")\n   185\t    if all_ok:\n   186\t        messages.append(f\"{path}: valid (jsonl-events, {line_count} line(s))\")\n   187\t    return all_ok, messages\n   188\t\n   189\t\n   190\tdef validate_path(path: Path, schema_override: str | None) -> tuple[bool, list[str]]:\n   191\t    \"\"\"Validate one file. Returns ``(ok, messages)``.\"\"\"\n   192\t    schema = schema_override or detect_schema(path)\n   193\t    if schema is None:\n   194\t        return False, [f\"{path}: no schema rule matches; pass --schema explicitly\"]\n   195\t    if schema not in SCHEMAS:\n   196\t        return False, [f\"{path}: unknown schema '{schema}'\"]\n   197\t    schema_path = SCHEMA_DIR / SCHEMAS[schema]\n   198\t\n   199\t    if schema == \"jsonl-events\":\n   200\t        return validate_jsonl(path, schema_path)\n   201\t\n   202\t    try:\n   203\t        payload = load_payload(path, schema)\n   204\t    except (ValueError, json.JSONDecodeError, yaml.YAMLError, tomllib.TOMLDecodeError) as exc:\n   205\t        return False, [f\"{path}: parse error: {exc}\"]\n   206\t\n   207\t    ok, output = run_ajv(schema_path, json.dumps(payload, default=str).encode())\n   208\t    msg = f\"{path}: {'valid' if ok else 'INVALID'} ({schema})\"\n   209\t    if not ok:\n   210\t        msg += \"\\n\" + output\n   211\t    return ok, [msg]\n   212\t\n   213\t\n   214\tdef cmd_validate(args: argparse.Namespace) -> int:\n   215\t    ensure_ajv()\n   216\t    overall_ok = True\n   217\t    for raw in args.paths:\n   218\t        path = Path(raw)\n   219\t        if not path.is_file():\n   220\t            sys.stderr.write(f\"woof: {raw}: not a file\\n\")\n   221\t            overall_ok = False\n   222\t            continue\n   223\t        ok, messages = validate_path(path, args.schema)\n   224\t        for line in messages:\n   225\t            print(line)\n   226\t        if not ok:\n   227\t            overall_ok = False\n   228\t    return 0 if overall_ok else 1\n   229\t\n   230\t\n   231\t# ---------------------------------------------------------------------------\n   232\t# dispatch\n   233\t# ---------------------------------------------------------------------------\n   234\t\n   235\tHARNESS_BY_TARGET = {\"claude\": \"cld\", \"codex\": \"cod\"}\n   236\tSTORY_ID_RE = re.compile(r\"^S[1-9]\\d*$\")\n   237\t\n   238\t\n   239\tdef find_woof_root(start: Path) -> Path:\n   240\t    \"\"\"Walk up from ``start`` to the first directory containing ``.woof/``.\"\"\"\n   241\t    for candidate in (start, *start.parents):\n   242\t        if (candidate / \".woof\").is_dir():\n   243\t            return candidate\n   244\t    sys.stderr.write(\n   245\t        f\"woof: no .woof/ directory found at or above {start}; not a woof project\\n\"\n   246\t    )\n   247\t    sys.exit(2)\n   248\t\n   249\t\n   250\tdef iso_utc(dt: datetime) -> str:\n   251\t    return dt.astimezone(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n   252\t\n   253\t\n   254\tdef append_jsonl(path: Path, event: dict) -> None:\n   255\t    path.parent.mkdir(parents=True, exist_ok=True)\n   256\t    with path.open(\"a\", encoding=\"utf-8\") as fh:\n   257\t        fh.write(json.dumps(event, separators=(\",\", \":\")) + \"\\n\")\n   258\t\n   259\t\n   260\tdef parse_claude_output(stdout: str) -> tuple[dict, str | None]:\n   261\t    \"\"\"Extract token usage and session_id from ``claude -p --output-format json``.\"\"\"\n   262\t    lines = [ln for ln in stdout.strip().splitlines() if ln.strip()]\n   263\t    if not lines:\n   264\t        return {}, None\n   265\t    try:\n   266\t        data = json.loads(lines[-1])\n   267\t    except json.JSONDecodeError:\n   268\t        return {}, None\n   269\t    usage = data.get(\"usage\") or {}\n   270\t    tokens = {\n   271\t        \"tokens_in\": int(usage.get(\"input_tokens\", 0) or 0),\n   272\t        \"tokens_out\": int(usage.get(\"output_tokens\", 0) or 0),\n   273\t        \"cache_read_tokens\": int(usage.get(\"cache_read_input_tokens\", 0) or 0),\n   274\t        \"cache_write_tokens\": int(usage.get(\"cache_creation_input_tokens\", 0) or 0),\n   275\t    }\n   276\t    return tokens, data.get(\"session_id\")\n   277\t\n   278\t\n   279\tdef parse_codex_output(stdout: str) -> tuple[dict, str | None]:\n   280\t    \"\"\"Sum token usage across ``turn.completed`` events from ``codex exec --json``.\"\"\"\n   281\t    tokens_in = tokens_out = cache_read = 0\n   282\t    saw_turn = False\n   283\t    thread_id: str | None = None\n   284\t    for raw in stdout.splitlines():\n   285\t        line = raw.strip()\n   286\t        if not line:\n   287\t            continue\n   288\t        try:\n   289\t            evt = json.loads(line)\n   290\t        except json.JSONDecodeError:\n   291\t            continue\n   292\t        kind = evt.get(\"type\")\n   293\t        if kind == \"thread.started\":\n   294\t            thread_id = evt.get(\"thread_id\")\n   295\t        elif kind == \"turn.completed\":\n   296\t            saw_turn = True\n   297\t            usage = evt.get(\"usage\") or {}\n   298\t            tokens_in += int(usage.get(\"input_tokens\", 0) or 0)\n   299\t            tokens_out += int(usage.get(\"output_tokens\", 0) or 0)\n   300\t            tokens_out += int(usage.get(\"reasoning_output_tokens\", 0) or 0)\n   301\t            cache_read += int(usage.get(\"cached_input_tokens\", 0) or 0)\n   302\t    if not saw_turn:\n   303\t        return {}, thread_id\n   304\t    return {\n   305\t        \"tokens_in\": tokens_in,\n   306\t        \"tokens_out\": tokens_out,\n   307\t        \"cache_read_tokens\": cache_read,\n   308\t    }, thread_id\n   309\t\n   310\t\n   311\tdef build_argv(harness: str, role: dict, prompt: str) -> list[str]:\n   312\t    \"\"\"Construct the cld/cod invocation argv from a role definition.\"\"\"\n   313\t    argv: list[str] = [harness]\n   314\t    mcp = role.get(\"mcp\") or []\n   315\t    flags = role.get(\"flags\") or []\n   316\t    model = role.get(\"model\")\n   317\t\n   318\t    if harness == \"cld\":\n   319\t        if role.get(\"think\"):\n   320\t            argv.append(\"-t\")\n   321\t        if mcp:\n   322\t            argv += [\"-m\", \",\".join(mcp)]\n   323\t        argv += [\"--\", \"-p\", \"--output-format\", \"json\"]\n   324\t        if model:\n   325\t            argv += [\"--model\", model]\n   326\t        argv += flags\n   327\t    else:  # cod\n   328\t        if mcp:\n   329\t            argv += [\"-m\", \",\".join(mcp)]\n   330\t        argv += [\"--\", \"exec\", \"--json\", \"--skip-git-repo-check\"]\n   331\t        if model:\n   332\t            argv += [\"--model\", model]\n   333\t        argv += flags\n   334\t    argv.append(prompt)\n   335\t    return argv\n   336\t\n   337\t\n   338\tdef cmd_dispatch(args: argparse.Namespace) -> int:\n   339\t    ensure_ajv()\n   340\t\n   341\t    expected_harness = HARNESS_BY_TARGET[args.target]\n   342\t    repo_root = find_woof_root(Path.cwd().resolve())\n   343\t    agents_path = repo_root / \".woof\" / \"agents.toml\"\n   344\t    if not agents_path.is_file():\n   345\t        sys.stderr.write(f\"woof: {agents_path} not found; cannot dispatch\\n\")\n   346\t        return 2\n   347\t\n   348\t    with agents_path.open(\"rb\") as fh:\n   349\t        agents = tomllib.load(fh)\n   350\t\n   351\t    schema_path = SCHEMA_DIR / SCHEMAS[\"agents\"]\n   352\t    ok, output = run_ajv(schema_path, json.dumps(agents).encode())\n   353\t    if not ok:\n   354\t        sys.stderr.write(f\"woof: {agents_path}: schema invalid\\n{output}\\n\")\n   355\t        return 2\n   356\t\n   357\t    role = (agents.get(\"roles\") or {}).get(args.role)\n   358\t    if role is None:\n   359\t        sys.stderr.write(\n   360\t            f\"woof: role '{args.role}' not declared in {agents_path}\\n\"\n   361\t        )\n   362\t        return 2\n   363\t\n   364\t    if role[\"harness\"] == \"in-session\":\n   365\t        sys.stderr.write(\n   366\t            f\"woof: role '{args.role}' is in-session; cannot be dispatched\\n\"\n   367\t        )\n   368\t        return 2\n   369\t    if role[\"harness\"] != expected_harness:\n   370\t        sys.stderr.write(\n   371\t            f\"woof: role '{args.role}' has harness={role['harness']!r}; \"\n   372\t            f\"expected {expected_harness!r} for 'woof dispatch {args.target}'\\n\"\n   373\t        )\n   374\t        return 2\n   375\t\n   376\t    if args.story is not None and not STORY_ID_RE.match(args.story):\n   377\t        sys.stderr.write(f\"woof: --story {args.story!r}: must match S<n> (n>=1)\\n\")\n   378\t        return 2\n   379\t\n   380\t    if args.prompt_file:\n   381\t        prompt = Path(args.prompt_file).read_text()\n   382\t    else:\n   383\t        prompt = sys.stdin.read()\n   384\t    if not prompt.strip():\n   385\t        sys.stderr.write(\"woof: empty prompt\\n\")\n   386\t        return 2\n   387\t\n   388\t    timeout_min = int(\n   389\t        (agents.get(\"timeouts\") or {}).get(\"default_minutes\", 30)\n   390\t    )\n   391\t    argv = build_argv(expected_harness, role, prompt)\n   392\t\n   393\t    if args.dry_run:\n   394\t        wrapped = [\"timeout\", f\"{timeout_min}m\", *argv]\n   395\t        print(json.dumps({\n   396\t            \"argv\": wrapped,\n   397\t            \"epic\": args.epic,\n   398\t            \"story\": args.story,\n   399\t            \"role\": args.role,\n   400\t            \"harness\": expected_harness,\n   401\t            \"model\": role.get(\"model\"),\n   402\t            \"mcp\": role.get(\"mcp\") or [],\n   403\t            \"flags\": role.get(\"flags\") or [],\n   404\t            \"timeout_min\": timeout_min,\n   405\t        }))\n   406\t        return 0\n   407\t\n   408\t    epic_dir = repo_root / \".woof\" / \"epics\" / f\"E{args.epic}\"\n   409\t    audit_dir = epic_dir / \"audit\"\n   410\t    audit_dir.mkdir(parents=True, exist_ok=True)\n   411\t    started_at = datetime.now(timezone.utc)\n   412\t    ts = started_at.strftime(\"%Y%m%dT%H%M%SZ\")\n   413\t    base = audit_dir / f\"{expected_harness}-{args.role}-{ts}\"\n   414\t    prompt_file = base.with_suffix(\".prompt\")\n   415\t    output_file = base.with_suffix(\".output\")\n   416\t    stderr_file = base.with_suffix(\".stderr\")\n   417\t    meta_file = base.with_suffix(\".meta\")\n   418\t    prompt_file.write_text(prompt)\n   419\t\n   420\t    dispatch_jsonl = epic_dir / \"dispatch.jsonl\"\n   421\t    wrapped_argv = [\"timeout\", f\"{timeout_min}m\", *argv]\n   422\t\n   423\t    proc = subprocess.Popen(\n   424\t        wrapped_argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True\n   425\t    )\n   426\t\n   427\t    spawned_event: dict = {\n   428\t        \"event\": \"subprocess_spawned\",\n   429\t        \"at\": iso_utc(started_at),\n   430\t        \"epic_id\": args.epic,\n   431\t        \"role\": args.role,\n   432\t        \"harness\": expected_harness,\n   433\t        \"pid\": proc.pid,\n   434\t    }\n   435\t    if args.story:\n   436\t        spawned_event[\"story_id\"] = args.story\n   437\t    if role.get(\"model\"):\n   438\t        spawned_event[\"model\"] = role[\"model\"]\n   439\t    append_jsonl(dispatch_jsonl, spawned_event)\n   440\t\n   441\t    try:\n   442\t        stdout, stderr = proc.communicate()\n   443\t    except KeyboardInterrupt:\n   444\t        proc.terminate()\n   445\t        stdout, stderr = proc.communicate()\n   446\t        ended_at = datetime.now(timezone.utc)\n   447\t        append_jsonl(dispatch_jsonl, {\n   448\t            \"event\": \"subprocess_killed\",\n   449\t            \"at\": iso_utc(ended_at),\n   450\t            \"epic_id\": args.epic,\n   451\t            \"pid\": proc.pid,\n   452\t            \"signal\": \"SIGINT\",\n   453\t            \"reason\": \"manual_cancel\",\n   454\t        })\n   455\t        output_file.write_text(stdout or \"\")\n   456\t        stderr_file.write_text(stderr or \"\")\n   457\t        return 130\n   458\t\n   459\t    ended_at = datetime.now(timezone.utc)\n   460\t    duration_ms = int((ended_at - started_at).total_seconds() * 1000)\n","exit_code":0,"status":"completed"}}
