{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/usr/bin/zsh -lc \"nl -ba woof/checks/registry.py | sed -n '1,260p'\"","aggregated_output":"     1\t\"\"\"woof checker registry — single source of truth for Stage-5 checks.\n     2\t\n     3\tREGISTRY maps check ID → Check. Skills, schemas, and documentation reference\n     4\tchecks by ID only; they never enumerate or describe the registry's contents.\n     5\t\n     6\tIn S1 only check_6_critique_blocker has a real runner. The other eight\n     7\tentries have placeholder runners that raise NotImplementedError; they will be\n     8\tpopulated in S2 and S3.\n     9\t\"\"\"\n    10\t\n    11\tfrom __future__ import annotations\n    12\t\n    13\tfrom typing import Callable, Literal\n    14\t\n    15\tfrom pydantic import BaseModel, ConfigDict\n    16\t\n    17\tfrom woof.checks import CheckContext, CheckOutcome\n    18\tfrom woof.checks.runners.check_6_critique_blocker import check_6_critique_blocker_runner\n    19\t\n    20\t\n    21\tclass Check(BaseModel):\n    22\t    \"\"\"Registry entry for one Stage-N boundary check.\"\"\"\n    23\t\n    24\t    model_config = ConfigDict(arbitrary_types_allowed=True)\n    25\t\n    26\t    id: str\n    27\t    stage: int\n    28\t    cost: Literal[\"cheap\", \"expensive\"]\n    29\t    summary: str\n    30\t    runner: Callable[[CheckContext], CheckOutcome]\n    31\t\n    32\t\n    33\tdef _placeholder(check_id: str) -> Callable[[CheckContext], CheckOutcome]:\n    34\t    \"\"\"Return a runner that raises NotImplementedError (populated in later stories).\"\"\"\n    35\t\n    36\t    def runner(ctx: CheckContext) -> CheckOutcome:\n    37\t        raise NotImplementedError(f\"{check_id}: runner not yet implemented\")\n    38\t\n    39\t    runner.__name__ = f\"{check_id}_runner\"\n    40\t    return runner\n    41\t\n    42\t\n    43\tREGISTRY: dict[str, Check] = {\n    44\t    \"check_1_quality_gates\": Check(\n    45\t        id=\"check_1_quality_gates\",\n    46\t        stage=5,\n    47\t        cost=\"expensive\",\n    48\t        summary=\"Run each command in .woof/quality-gates.toml; each must exit 0\",\n    49\t        runner=_placeholder(\"check_1_quality_gates\"),\n    50\t    ),\n    51\t    \"check_2_outcome_markers\": Check(\n    52\t        id=\"check_2_outcome_markers\",\n    53\t        stage=5,\n    54\t        cost=\"cheap\",\n    55\t        summary=\"For each O<n> in story.satisfies[], regex-grep the staged test diff; ≥1 hit each\",\n    56\t        runner=_placeholder(\"check_2_outcome_markers\"),\n    57\t    ),\n    58\t    \"check_3_scope\": Check(\n    59\t        id=\"check_3_scope\",\n    60\t        stage=5,\n    61\t        cost=\"cheap\",\n    62\t        summary=\"Staged file set ⊆ story.paths[] pathspec plus allowed .woof/ files\",\n    63\t        runner=_placeholder(\"check_3_scope\"),\n    64\t    ),\n    65\t    \"check_4_contract_refs\": Check(\n    66\t        id=\"check_4_contract_refs\",\n    67\t        stage=5,\n    68\t        cost=\"expensive\",\n    69\t        summary=\"woof check-cd verifies every CD's contract reference resolves\",\n    70\t        runner=_placeholder(\"check_4_contract_refs\"),\n    71\t    ),\n    72\t    \"check_5_plan_crossrefs\": Check(\n    73\t        id=\"check_5_plan_crossrefs\",\n    74\t        stage=5,\n    75\t        cost=\"cheap\",\n    76\t        summary=\"plan.json schema-valid; cross-refs intact; deps acyclic\",\n    77\t        runner=_placeholder(\"check_5_plan_crossrefs\"),\n    78\t    ),\n    79\t    \"check_6_critique_blocker\": Check(\n    80\t        id=\"check_6_critique_blocker\",\n    81\t        stage=5,\n    82\t        cost=\"cheap\",\n    83\t        summary=\"critique/story-S<k>.md exists; schema-valid; severity != blocker\",\n    84\t        runner=check_6_critique_blocker_runner,\n    85\t    ),\n    86\t    \"check_7_commit_transaction\": Check(\n    87\t        id=\"check_7_commit_transaction\",\n    88\t        stage=5,\n    89\t        cost=\"cheap\",\n    90\t        summary=\"Staged set contains the four .woof durable files; no foreign .woof/ paths\",\n    91\t        runner=_placeholder(\"check_7_commit_transaction\"),\n    92\t    ),\n    93\t    \"check_8_docs_drift\": Check(\n    94\t        id=\"check_8_docs_drift\",\n    95\t        stage=5,\n    96\t        cost=\"cheap\",\n    97\t        summary=\"Per .woof/docs-paths.toml mappings; no-op when file absent\",\n    98\t        runner=_placeholder(\"check_8_docs_drift\"),\n    99\t    ),\n   100\t    \"check_9_review_valve\": Check(\n   101\t        id=\"check_9_review_valve\",\n   102\t        stage=5,\n   103\t        cost=\"cheap\",\n   104\t        summary=\"Every-N stories and end-of-epic; surfaces accumulated minor critique findings\",\n   105\t        runner=_placeholder(\"check_9_review_valve\"),\n   106\t    ),\n   107\t}\n   108\t\n   109\tSTAGE_5_CHECK_IDS: list[str] = [\n   110\t    \"check_1_quality_gates\",\n   111\t    \"check_2_outcome_markers\",\n   112\t    \"check_3_scope\",\n   113\t    \"check_4_contract_refs\",\n   114\t    \"check_5_plan_crossrefs\",\n   115\t    \"check_6_critique_blocker\",\n   116\t    \"check_7_commit_transaction\",\n   117\t    \"check_8_docs_drift\",\n   118\t    \"check_9_review_valve\",\n   119\t]\n","exit_code":0,"status":"completed"}}
