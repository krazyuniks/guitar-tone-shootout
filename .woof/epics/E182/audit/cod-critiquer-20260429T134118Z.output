{"type":"item.completed","item":{"id":"item_45","type":"command_execution","command":"/usr/bin/zsh -lc \"nl -ba woof/bin/woof | sed -n '980,1080p'\"","aggregated_output":"   980\t    validate.set_defaults(func=cmd_validate)\n   981\t\n   982\t    dispatch = sub.add_parser(\n   983\t        \"dispatch\",\n   984\t        help=\"spawn a cld/cod subprocess for a role declared in agents.toml\",\n   985\t    )\n   986\t    dispatch.add_argument(\"target\", choices=sorted(HARNESS_BY_TARGET))\n   987\t    dispatch.add_argument(\"--role\", required=True, help=\"role name from .woof/agents.toml\")\n   988\t    dispatch.add_argument(\"--epic\", type=int, required=True, help=\"epic id (gh issue number)\")\n   989\t    dispatch.add_argument(\"--story\", help=\"story id (e.g. S1); optional\")\n   990\t    dispatch.add_argument(\n   991\t        \"--prompt-file\",\n   992\t        help=\"path to a file holding the prompt; if omitted, prompt is read from stdin\",\n   993\t    )\n   994\t    dispatch.add_argument(\n   995\t        \"--dry-run\",\n   996\t        action=\"store_true\",\n   997\t        help=\"print the resolved invocation as JSON and exit without spawning\",\n   998\t    )\n   999\t    dispatch.set_defaults(func=cmd_dispatch)\n  1000\t\n  1001\t    render = sub.add_parser(\n  1002\t        \"render-epic\",\n  1003\t        help=\"render EPIC.md front-matter into the gh issue body\",\n  1004\t    )\n  1005\t    render.add_argument(\"--epic\", type=int, required=True, help=\"epic id (gh issue number)\")\n  1006\t    render.add_argument(\"--output\", help=\"write rendered body to PATH instead of stdout\")\n  1007\t    render.add_argument(\n  1008\t        \"--sync\",\n  1009\t        action=\"store_true\",\n  1010\t        help=\"fetch remote, conflict-check against .last-sync, push if clean, update .last-sync\",\n  1011\t    )\n  1012\t    render.set_defaults(func=cmd_render_epic)\n  1013\t\n  1014\t    check_cd = sub.add_parser(\n  1015\t        \"check-cd\",\n  1016\t        help=\"verify each contract_decision's referenced artefact (Stage 5 Check 4)\",\n  1017\t    )\n  1018\t    check_cd.add_argument(\"epic_md\", help=\"path to EPIC.md\")\n  1019\t    check_cd.add_argument(\n  1020\t        \"--format\", choices=[\"text\", \"json\"], default=\"text\",\n  1021\t        help=\"output format (default: text)\",\n  1022\t    )\n  1023\t    check_cd.add_argument(\n  1024\t        \"--verbose\", action=\"store_true\",\n  1025\t        help=\"show OK detail lines\",\n  1026\t    )\n  1027\t    check_cd.set_defaults(func=cmd_check_cd)\n  1028\t\n  1029\t    from woof.cli.commands.check import setup_check_parser\n  1030\t    from woof.cli.commands.gate import setup_gate_parser\n  1031\t    setup_check_parser(sub)\n  1032\t    setup_gate_parser(sub)\n  1033\t\n  1034\t    args = parser.parse_args()\n  1035\t    return args.func(args)\n  1036\t\n  1037\t\n  1038\tif __name__ == \"__main__\":\n  1039\t    sys.exit(main())\n","exit_code":0,"status":"completed"}}
