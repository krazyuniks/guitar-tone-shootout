{"type":"item.completed","item":{"id":"item_43","type":"command_execution","command":"/usr/bin/zsh -lc \"nl -ba woof/bin/woof | sed -n '460,760p'\"","aggregated_output":"   460\t    duration_ms = int((ended_at - started_at).total_seconds() * 1000)\n   461\t    output_file.write_text(stdout)\n   462\t    stderr_file.write_text(stderr)\n   463\t\n   464\t    if expected_harness == \"cld\":\n   465\t        tokens, session_id = parse_claude_output(stdout)\n   466\t        thread_id = None\n   467\t    else:\n   468\t        tokens, thread_id = parse_codex_output(stdout)\n   469\t        session_id = None\n   470\t\n   471\t    timed_out = proc.returncode == 124  # GNU timeout(1) exit code\n   472\t    if timed_out:\n   473\t        append_jsonl(dispatch_jsonl, {\n   474\t            \"event\": \"subprocess_killed\",\n   475\t            \"at\": iso_utc(ended_at),\n   476\t            \"epic_id\": args.epic,\n   477\t            \"pid\": proc.pid,\n   478\t            \"signal\": \"SIGTERM\",\n   479\t            \"reason\": \"timeout\",\n   480\t        })\n   481\t\n   482\t    returned: dict = {\n   483\t        \"event\": \"subprocess_returned\",\n   484\t        \"at\": iso_utc(ended_at),\n   485\t        \"epic_id\": args.epic,\n   486\t        \"role\": args.role,\n   487\t        \"harness\": expected_harness,\n   488\t        \"pid\": proc.pid,\n   489\t        \"exit_code\": proc.returncode,\n   490\t        \"duration_ms\": duration_ms,\n   491\t    }\n   492\t    if args.story:\n   493\t        returned[\"story_id\"] = args.story\n   494\t    if role.get(\"model\"):\n   495\t        returned[\"model\"] = role[\"model\"]\n   496\t    if tokens:\n   497\t        returned.update(tokens)\n   498\t    if session_id:\n   499\t        returned[\"cc_session_id\"] = session_id\n   500\t    if expected_harness == \"cod\":\n   501\t        returned[\"codex_audit_path\"] = str(base.relative_to(repo_root))\n   502\t    append_jsonl(dispatch_jsonl, returned)\n   503\t\n   504\t    meta = {\n   505\t        \"harness\": expected_harness,\n   506\t        \"role\": args.role,\n   507\t        \"epic_id\": args.epic,\n   508\t        \"story_id\": args.story,\n   509\t        \"model\": role.get(\"model\"),\n   510\t        \"mcp\": role.get(\"mcp\") or [],\n   511\t        \"flags\": role.get(\"flags\") or [],\n   512\t        \"argv\": wrapped_argv,\n   513\t        \"pid\": proc.pid,\n   514\t        \"started_at\": iso_utc(started_at),\n   515\t        \"ended_at\": iso_utc(ended_at),\n   516\t        \"duration_ms\": duration_ms,\n   517\t        \"exit_code\": proc.returncode,\n   518\t        \"timed_out\": timed_out,\n   519\t        \"tokens\": tokens,\n   520\t    }\n   521\t    if session_id:\n   522\t        meta[\"cc_session_id\"] = session_id\n   523\t    if thread_id:\n   524\t        meta[\"codex_thread_id\"] = thread_id\n   525\t    meta_file.write_text(json.dumps(meta, indent=2) + \"\\n\")\n   526\t\n   527\t    return proc.returncode\n   528\t\n   529\t\n   530\t# ---------------------------------------------------------------------------\n   531\t# render-epic\n   532\t# ---------------------------------------------------------------------------\n   533\t\n   534\tWOOF_SENTINEL = (\n   535\t    \"<!-- woof — structured sections above are rewritten on Definition/plan \"\n   536\t    \"changes. Free-form prose above `## Observable Outcomes` is preserved on \"\n   537\t    \"overwrite. Do not edit structured sections directly in gh. -->\"\n   538\t)\n   539\tSTRUCTURED_HEADING = \"## Observable Outcomes\"\n   540\t\n   541\t\n   542\tdef split_front_matter(path: Path) -> tuple[dict, str]:\n   543\t    \"\"\"Return (front-matter dict, body prose) from a YAML-front-mattered file.\"\"\"\n   544\t    text = path.read_text()\n   545\t    if not text.startswith(\"---\\n\"):\n   546\t        raise ValueError(f\"{path}: no YAML front-matter (file must start with '---\\\\n')\")\n   547\t    end = text.find(\"\\n---\\n\", 4)\n   548\t    if end < 0:\n   549\t        raise ValueError(f\"{path}: unterminated YAML front-matter\")\n   550\t    front = yaml.safe_load(text[4:end]) or {}\n   551\t    prose = text[end + len(\"\\n---\\n\") :]\n   552\t    return front, prose\n   553\t\n   554\t\n   555\tdef first_paragraph(prose: str) -> str:\n   556\t    \"\"\"First non-empty paragraph of ``prose`` (delimited by a blank line).\"\"\"\n   557\t    paragraphs = re.split(r\"\\n\\s*\\n\", prose.strip())\n   558\t    for para in paragraphs:\n   559\t        stripped = para.strip()\n   560\t        if stripped:\n   561\t            return stripped\n   562\t    return \"\"\n   563\t\n   564\t\n   565\tdef _deprecation_suffix(item: dict) -> str:\n   566\t    if not item.get(\"deprecated\"):\n   567\t        return \"\"\n   568\t    rb = item.get(\"replaced_by\")\n   569\t    return f\" _(deprecated → {rb})_\" if rb else \" _(deprecated)_\"\n   570\t\n   571\t\n   572\tdef _contract_ref(cd: dict) -> str:\n   573\t    if cd.get(\"openapi_ref\"):\n   574\t        return f\"`openapi: {cd['openapi_ref']}`\"\n   575\t    if cd.get(\"pydantic_ref\"):\n   576\t        return f\"`pydantic: {cd['pydantic_ref']}`\"\n   577\t    if cd.get(\"json_schema_ref\"):\n   578\t        return f\"`json_schema: {cd['json_schema_ref']}`\"\n   579\t    return \"\"\n   580\t\n   581\t\n   582\tdef render_epic_body(front: dict, prose: str, remote_body: str | None = None) -> str:\n   583\t    \"\"\"Deterministic transform from EPIC front-matter to gh issue body markdown.\n   584\t\n   585\t    Preservation rule: if ``remote_body`` contains ``## Observable Outcomes``,\n   586\t    everything before that heading is preserved as the prefix; everything from\n   587\t    the heading onward is rewritten. On first push (no remote, or remote\n   588\t    without the marker), the prefix is the first paragraph of ``prose``.\n   589\t    \"\"\"\n   590\t    out: list[str] = []\n   591\t\n   592\t    if remote_body and STRUCTURED_HEADING in remote_body:\n   593\t        prefix, _ = remote_body.split(STRUCTURED_HEADING, 1)\n   594\t        out.append(prefix.rstrip() + \"\\n\\n\")\n   595\t    else:\n   596\t        intent = first_paragraph(prose)\n   597\t        out.append((intent or \"_(intent pending)_\") + \"\\n\\n\")\n   598\t\n   599\t    out.append(\"## Observable Outcomes\\n\\n\")\n   600\t    for o in front[\"observable_outcomes\"]:\n   601\t        suffix = _deprecation_suffix(o)\n   602\t        out.append(f\"- **{o['id']}** — {o['statement']}{suffix}\\n\")\n   603\t        out.append(f\"  - Verification: {o['verification']}\\n\")\n   604\t    out.append(\"\\n\")\n   605\t\n   606\t    cds = front.get(\"contract_decisions\") or []\n   607\t    if cds:\n   608\t        out.append(\"## Contract Decisions\\n\\n\")\n   609\t        out.append(\"| ID | Related Outcomes | Title | Contract Reference |\\n\")\n   610\t        out.append(\"|---|---|---|---|\\n\")\n   611\t        for cd in cds:\n   612\t            related = \", \".join(cd[\"related_outcomes\"])\n   613\t            title = cd[\"title\"] + _deprecation_suffix(cd)\n   614\t            out.append(\n   615\t                f\"| {cd['id']} | {related} | {title} | {_contract_ref(cd)} |\\n\"\n   616\t            )\n   617\t        out.append(\"\\n\")\n   618\t\n   619\t    out.append(\"## Acceptance Criteria\\n\\n\")\n   620\t    for c in front[\"acceptance_criteria\"]:\n   621\t        out.append(f\"- {c}\\n\")\n   622\t    out.append(\"\\n\")\n   623\t\n   624\t    open_qs = front.get(\"open_questions\") or []\n   625\t    if open_qs:\n   626\t        out.append(\"## Open Questions\\n\\n\")\n   627\t        for q in open_qs:\n   628\t            out.append(f\"- {q}\\n\")\n   629\t        out.append(\"\\n\")\n   630\t\n   631\t    out.append(\"---\\n\\n\")\n   632\t    out.append(WOOF_SENTINEL + \"\\n\")\n   633\t    return \"\".join(out)\n   634\t\n   635\t\n   636\tdef _gh_repo(repo_root: Path) -> str:\n   637\t    prereq = repo_root / \".woof\" / \"prerequisites.toml\"\n   638\t    if not prereq.is_file():\n   639\t        raise SystemExit(f\"woof: {prereq} not found; cannot resolve [github].repo\")\n   640\t    with prereq.open(\"rb\") as fh:\n   641\t        data = tomllib.load(fh)\n   642\t    repo = (data.get(\"github\") or {}).get(\"repo\")\n   643\t    if not repo:\n   644\t        raise SystemExit(f\"woof: {prereq} missing [github].repo\")\n   645\t    return repo\n   646\t\n   647\t\n   648\tdef _gh_fetch_issue(repo: str, number: int) -> dict:\n   649\t    proc = subprocess.run(\n   650\t        [\n   651\t            \"gh\", \"api\",\n   652\t            f\"/repos/{repo}/issues/{number}\",\n   653\t            \"-H\", \"Accept: application/vnd.github+json\",\n   654\t        ],\n   655\t        capture_output=True, text=True,\n   656\t    )\n   657\t    if proc.returncode != 0:\n   658\t        raise SystemExit(\n   659\t            f\"woof: gh api /repos/{repo}/issues/{number} failed:\\n{proc.stderr.strip()}\"\n   660\t        )\n   661\t    return json.loads(proc.stdout)\n   662\t\n   663\t\n   664\tdef _gh_edit_body(repo: str, number: int, body_path: Path) -> None:\n   665\t    proc = subprocess.run(\n   666\t        [\"gh\", \"issue\", \"edit\", str(number), \"--repo\", repo, \"--body-file\", str(body_path)],\n   667\t        capture_output=True, text=True,\n   668\t    )\n   669\t    if proc.returncode != 0:\n   670\t        raise SystemExit(\n   671\t            f\"woof: gh issue edit {number} failed:\\n{proc.stderr.strip()}\"\n   672\t        )\n   673\t\n   674\t\n   675\tdef _last_sync_path(epic_dir: Path) -> Path:\n   676\t    return epic_dir / \".last-sync\"\n   677\t\n   678\t\n   679\tdef _read_last_sync(epic_dir: Path) -> dict | None:\n   680\t    p = _last_sync_path(epic_dir)\n   681\t    if not p.is_file():\n   682\t        return None\n   683\t    return json.loads(p.read_text())\n   684\t\n   685\t\n   686\tdef _write_last_sync(epic_dir: Path, payload: dict) -> None:\n   687\t    p = _last_sync_path(epic_dir)\n   688\t    tmp = p.with_suffix(\".last-sync.tmp\")\n   689\t    tmp.write_text(json.dumps(payload, indent=2) + \"\\n\")\n   690\t    tmp.replace(p)\n   691\t\n   692\t\n   693\tdef _sha256(text: str) -> str:\n   694\t    return hashlib.sha256(text.encode(\"utf-8\")).hexdigest()\n   695\t\n   696\t\n   697\tdef cmd_render_epic(args: argparse.Namespace) -> int:\n   698\t    ensure_ajv()\n   699\t    repo_root = find_woof_root(Path.cwd().resolve())\n   700\t    epic_dir = repo_root / \".woof\" / \"epics\" / f\"E{args.epic}\"\n   701\t    epic_md = epic_dir / \"EPIC.md\"\n   702\t    if not epic_md.is_file():\n   703\t        sys.stderr.write(f\"woof: {epic_md} not found\\n\")\n   704\t        return 2\n   705\t\n   706\t    try:\n   707\t        front, prose = split_front_matter(epic_md)\n   708\t    except (ValueError, yaml.YAMLError) as exc:\n   709\t        sys.stderr.write(f\"woof: {epic_md}: {exc}\\n\")\n   710\t        return 2\n   711\t\n   712\t    schema_path = SCHEMA_DIR / SCHEMAS[\"epic\"]\n   713\t    ok, output = run_ajv(schema_path, json.dumps(front).encode())\n   714\t    if not ok:\n   715\t        sys.stderr.write(f\"woof: {epic_md}: front-matter invalid\\n{output}\\n\")\n   716\t        return 2\n   717\t\n   718\t    if not args.sync:\n   719\t        body = render_epic_body(front, prose, remote_body=None)\n   720\t        if args.output:\n   721\t            Path(args.output).write_text(body)\n   722\t        else:\n   723\t            sys.stdout.write(body)\n   724\t        return 0\n   725\t\n   726\t    # --sync: fetch remote, conflict-check, push, update .last-sync\n   727\t    repo = _gh_repo(repo_root)\n   728\t    remote = _gh_fetch_issue(repo, args.epic)\n   729\t    remote_updated_at = remote.get(\"updated_at\") or \"\"\n   730\t    remote_body = remote.get(\"body\") or \"\"\n   731\t\n   732\t    last_sync = _read_last_sync(epic_dir)\n   733\t    if last_sync and last_sync.get(\"updated_at\") != remote_updated_at:\n   734\t        ts = iso_utc(datetime.now(timezone.utc))\n   735\t        append_jsonl(epic_dir / \"epic.jsonl\", {\n   736\t            \"event\": \"github_sync_conflict\",\n   737\t            \"at\": ts,\n   738\t            \"epic_id\": args.epic,\n   739\t        })\n   740\t        sys.stderr.write(\n   741\t            f\"woof: github_sync_conflict for E{args.epic}\\n\"\n   742\t            f\"  last-sync updated_at: {last_sync.get('updated_at')}\\n\"\n   743\t            f\"  remote   updated_at: {remote_updated_at}\\n\"\n   744\t            \"  push aborted — resolve via /wf gate\\n\"\n   745\t        )\n   746\t        return 3\n   747\t\n   748\t    body = render_epic_body(front, prose, remote_body=remote_body)\n   749\t    with tempfile.NamedTemporaryFile(\n   750\t        \"w\", suffix=\".md\", delete=False, encoding=\"utf-8\"\n   751\t    ) as fh:\n   752\t        fh.write(body)\n   753\t        body_path = Path(fh.name)\n   754\t    try:\n   755\t        _gh_edit_body(repo, args.epic, body_path)\n   756\t    finally:\n   757\t        body_path.unlink(missing_ok=True)\n   758\t\n   759\t    new_remote = _gh_fetch_issue(repo, args.epic)\n   760\t    _write_last_sync(epic_dir, {\n","exit_code":0,"status":"completed"}}
