{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/usr/bin/zsh -lc \"nl -ba tests/unit/woof/test_executor_result_schema.py | sed -n '1,320p'\"","aggregated_output":"     1\t\"\"\"Tests for executor-result.schema.json — CD2.\n     2\t\n     3\tVerifies the schema compiles and that valid/invalid instances validate\n     4\tas expected.\n     5\t\"\"\"\n     6\t\n     7\tfrom __future__ import annotations\n     8\t\n     9\timport json\n    10\timport shutil\n    11\timport subprocess\n    12\tfrom pathlib import Path\n    13\t\n    14\timport pytest\n    15\t\n    16\tREPO_ROOT = Path(__file__).resolve().parents[3]\n    17\tSCHEMA_PATH = REPO_ROOT / \"woof\" / \"schemas\" / \"executor-result.schema.json\"\n    18\t\n    19\tpytestmark = pytest.mark.host_only\n    20\t\n    21\t\n    22\tdef _validate(payload: dict) -> tuple[bool, str]:\n    23\t    if not shutil.which(\"ajv\"):\n    24\t        pytest.skip(\"ajv not on PATH\")\n    25\t    data = json.dumps(payload).encode()\n    26\t    import tempfile\n    27\t\n    28\t    with tempfile.NamedTemporaryFile(\"wb\", suffix=\".json\", delete=False) as fh:\n    29\t        fh.write(data)\n    30\t        data_path = fh.name\n    31\t    try:\n    32\t        proc = subprocess.run(\n    33\t            [\n    34\t                \"ajv\",\n    35\t                \"validate\",\n    36\t                \"--spec=draft2020\",\n    37\t                \"-c\",\n    38\t                \"ajv-formats\",\n    39\t                \"-s\",\n    40\t                str(SCHEMA_PATH),\n    41\t                \"-d\",\n    42\t                data_path,\n    43\t            ],\n    44\t            capture_output=True,\n    45\t            text=True,\n    46\t        )\n    47\t    finally:\n    48\t        Path(data_path).unlink(missing_ok=True)\n    49\t    return proc.returncode == 0, (proc.stdout + proc.stderr).strip()\n    50\t\n    51\t\n    52\tdef test_staged_for_verification_valid() -> None:\n    53\t    \"\"\"staged_for_verification with commit_body validates OK.\"\"\"\n    54\t    ok, msg = _validate(\n    55\t        {\n    56\t            \"epic_id\": 182,\n    57\t            \"story_id\": \"S1\",\n    58\t            \"outcome\": \"staged_for_verification\",\n    59\t            \"commit_body\": \"Bootstrap: registry + check_6 + driver protocol\",\n    60\t            \"position\": None,\n    61\t        }\n    62\t    )\n    63\t    assert ok, msg\n    64\t\n    65\t\n    66\tdef test_aborted_with_position_valid() -> None:\n    67\t    \"\"\"aborted_with_position with position validates OK.\"\"\"\n    68\t    ok, msg = _validate(\n    69\t        {\n    70\t            \"epic_id\": 181,\n    71\t            \"story_id\": \"S2\",\n    72\t            \"outcome\": \"aborted_with_position\",\n    73\t            \"commit_body\": None,\n    74\t            \"position\": \"Critique returned blocker; halting.\",\n    75\t        }\n    76\t    )\n    77\t    assert ok, msg\n    78\t\n    79\t\n    80\tdef test_empty_diff_valid() -> None:\n    81\t    \"\"\"empty_diff with position validates OK.\"\"\"\n    82\t    ok, msg = _validate(\n    83\t        {\n    84\t            \"epic_id\": 182,\n    85\t            \"story_id\": \"S3\",\n    86\t            \"outcome\": \"empty_diff\",\n    87\t            \"commit_body\": None,\n    88\t            \"position\": \"No changes — outcome already realised by S1.\",\n    89\t        }\n    90\t    )\n    91\t    assert ok, msg\n    92\t\n    93\t\n    94\tdef test_staged_for_verification_missing_commit_body_invalid() -> None:\n    95\t    \"\"\"staged_for_verification without commit_body fails allOf rule.\"\"\"\n    96\t    ok, _ = _validate(\n    97\t        {\n    98\t            \"epic_id\": 182,\n    99\t            \"story_id\": \"S1\",\n   100\t            \"outcome\": \"staged_for_verification\",\n   101\t        }\n   102\t    )\n   103\t    assert not ok, \"Expected validation failure but got OK\"\n   104\t\n   105\t\n   106\tdef test_unknown_outcome_invalid() -> None:\n   107\t    \"\"\"An unrecognised outcome value fails the enum constraint.\"\"\"\n   108\t    ok, _ = _validate(\n   109\t        {\n   110\t            \"epic_id\": 182,\n   111\t            \"story_id\": \"S1\",\n   112\t            \"outcome\": \"committed\",\n   113\t            \"commit_body\": None,\n   114\t        }\n   115\t    )\n   116\t    assert not ok, \"Expected validation failure but got OK\"\n   117\t\n   118\t\n   119\tdef test_schema_compiles() -> None:\n   120\t    \"\"\"executor-result.schema.json itself is a valid JSON Schema.\"\"\"\n   121\t    if not shutil.which(\"ajv\"):\n   122\t        pytest.skip(\"ajv not on PATH\")\n   123\t    proc = subprocess.run(\n   124\t        [\n   125\t            \"ajv\",\n   126\t            \"compile\",\n   127\t            \"--spec=draft2020\",\n   128\t            \"-c\",\n   129\t            \"ajv-formats\",\n   130\t            \"-s\",\n   131\t            str(SCHEMA_PATH),\n   132\t        ],\n   133\t        capture_output=True,\n   134\t        text=True,\n   135\t    )\n   136\t    assert proc.returncode == 0, (proc.stdout + proc.stderr).strip()\n","exit_code":0,"status":"completed"}}
