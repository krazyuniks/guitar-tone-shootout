{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/usr/bin/zsh -lc \"sed -n '1,260p' woof/schemas/critique.schema.json\"","aggregated_output":"{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"https://woof.dev/schemas/critique.schema.json\",\n  \"title\": \"woof critique front-matter\",\n  \"description\": \"YAML front-matter of .woof/epics/E<N>/critique/<artefact>.md. Used at Stage 3 (critique/plan.md, critiques the breakdown) and Stage 5 (critique/story-S<k>.md, critiques a story diff). Top-level severity drives the gate-asymmetry rule: plan-gate always opens; story-gate opens when severity=blocker. Findings list is advisory and unconstrained in count.\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\"target\", \"target_id\", \"severity\", \"timestamp\", \"harness\"],\n  \"properties\": {\n    \"target\": {\n      \"type\": \"string\",\n      \"enum\": [\"plan\", \"story\"],\n      \"description\": \"What was critiqued. plan = critique/plan.md (Stage 3 output). story = critique/story-S<k>.md (Stage 5 output for a specific story).\"\n    },\n    \"target_id\": {\n      \"oneOf\": [\n        { \"type\": \"string\", \"pattern\": \"^S[1-9]\\\\d*$\" },\n        { \"type\": \"null\" }\n      ],\n      \"description\": \"Story ID when target=story; null when target=plan. Coupled to target via allOf below.\"\n    },\n    \"severity\": {\n      \"type\": \"string\",\n      \"enum\": [\"info\", \"minor\", \"blocker\"],\n      \"description\": \"Roll-up severity over all findings. info = no concerns; minor = improvements but proceed; blocker = halt and review. Stage 5 Check 6 fails when this equals blocker.\"\n    },\n    \"timestamp\": {\n      \"type\": \"string\",\n      \"format\": \"date-time\"\n    },\n    \"harness\": {\n      \"type\": \"string\",\n      \"minLength\": 1,\n      \"description\": \"Identifier of the agent that produced the critique, e.g. 'codex-gpt-5.4', 'claude-opus-4-7'. Used for audit linkage.\"\n    },\n    \"session_ref\": {\n      \"type\": \"string\",\n      \"minLength\": 1,\n      \"description\": \"Audit pointer to the agent's session: CC session UUID for claude harnesses, audit-file path under .woof/epics/E<N>/audit/ for codex. Optional but recommended.\"\n    },\n    \"findings\": {\n      \"type\": \"array\",\n      \"items\": { \"$ref\": \"#/$defs/finding\" },\n      \"description\": \"Individual findings the critique surfaced. Empty array allowed when severity=info.\"\n    }\n  },\n  \"$defs\": {\n    \"finding\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"id\", \"severity\", \"summary\"],\n      \"properties\": {\n        \"id\": {\n          \"type\": \"string\",\n          \"pattern\": \"^F[1-9]\\\\d*$\",\n          \"description\": \"Finding ID for cross-reference (F1, F2, ...). Sequential within the critique document.\"\n        },\n        \"severity\": {\n          \"type\": \"string\",\n          \"enum\": [\"info\", \"minor\", \"blocker\"]\n        },\n        \"category\": {\n          \"type\": \"string\",\n          \"enum\": [\n            \"outcome_coverage\",\n            \"decomposition\",\n            \"scope_hygiene\",\n            \"dependency_correctness\",\n            \"contract_implementation\",\n            \"class_2_architectural\",\n            \"marker_semantic_mismatch\",\n            \"test_quality\",\n            \"other\"\n          ],\n          \"description\": \"Critique category. Stage 3 focus areas (outcome_coverage, decomposition, scope_hygiene, dependency_correctness, contract_implementation, class_2_architectural) plus Stage 5 areas (marker_semantic_mismatch, test_quality). Optional; absent => other.\"\n        },\n        \"summary\": {\n          \"type\": \"string\",\n          \"minLength\": 1,\n          \"description\": \"One-sentence prose statement of the finding.\"\n        },\n        \"evidence\": {\n          \"type\": \"string\",\n          \"description\": \"Prose evidence for the finding. Optional.\"\n        },\n        \"suggestion\": {\n          \"type\": \"string\",\n          \"description\": \"Prose suggested resolution. Optional; advisory only.\"\n        }\n      }\n    }\n  },\n  \"allOf\": [\n    {\n      \"if\": {\n        \"properties\": { \"target\": { \"const\": \"plan\" } },\n        \"required\": [\"target\"]\n      },\n      \"then\": {\n        \"properties\": { \"target_id\": { \"type\": \"null\" } }\n      }\n    },\n    {\n      \"if\": {\n        \"properties\": { \"target\": { \"const\": \"story\" } },\n        \"required\": [\"target\"]\n      },\n      \"then\": {\n        \"properties\": { \"target_id\": { \"type\": \"string\", \"pattern\": \"^S[1-9]\\\\d*$\" } }\n      }\n    }\n  ]\n}\n","exit_code":0,"status":"completed"}}
