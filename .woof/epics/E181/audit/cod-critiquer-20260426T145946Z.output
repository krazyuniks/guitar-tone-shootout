{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/usr/bin/zsh -lc 'git show :woof/lib/audit_config.py | nl -ba'","aggregated_output":"     1\t\"\"\"Typed config loader for the [audit] block in .woof/agents.toml.\n     2\t\n     3\tConsumed by woof dispatch (S2) to drive redaction and per-file size cap\n     4\ton committed audit artefacts. S1 lands the contract surface only; no\n     5\tbehavioural change until S2 wires this into dispatch.\n     6\t\"\"\"\n     7\t\n     8\tfrom __future__ import annotations\n     9\t\n    10\tfrom dataclasses import dataclass, field\n    11\t\n    12\tDEFAULT_MAX_BYTES = 262_144  # 256 KB\n    13\t\n    14\t\n    15\t@dataclass(frozen=True)\n    16\tclass AuditConfig:\n    17\t    \"\"\"Resolved audit policy. All fields have safe defaults.\"\"\"\n    18\t\n    19\t    enabled: bool = True\n    20\t    max_bytes: int = DEFAULT_MAX_BYTES\n    21\t    redact_patterns: tuple[str, ...] = field(default_factory=tuple)\n    22\t\n    23\t\n    24\tdef load_audit_config(agents: dict) -> AuditConfig:\n    25\t    \"\"\"Extract audit policy from a parsed agents.toml dict.\n    26\t\n    27\t    Missing [audit] block or individual keys fall back to AuditConfig defaults.\n    28\t    \"\"\"\n    29\t    block = agents.get(\"audit\") or {}\n    30\t    return AuditConfig(\n    31\t        enabled=bool(block.get(\"enabled\", True)),\n    32\t        max_bytes=int(block.get(\"max_bytes\", DEFAULT_MAX_BYTES)),\n    33\t        redact_patterns=tuple(block.get(\"redact_patterns\") or []),\n    34\t    )\n","exit_code":0,"status":"completed"}}
