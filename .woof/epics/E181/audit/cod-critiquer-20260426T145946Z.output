{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/usr/bin/zsh -lc 'git diff --staged -- .woof/agents.toml woof/schemas/agents.schema.json woof/lib/audit_config.py tests/unit/woof/test_audit_config.py'","aggregated_output":"diff --git a/.woof/agents.toml b/.woof/agents.toml\nindex 8d7e2b32..b2613d64 100644\n--- a/.woof/agents.toml\n+++ b/.woof/agents.toml\n@@ -34,3 +34,8 @@ default_minutes = 30\n [review_valve]\n every_n_stories = 5\n end_of_epic = true\n+\n+[audit]\n+enabled = true\n+max_bytes = 262144\n+redact_patterns = []\ndiff --git a/tests/unit/woof/test_audit_config.py b/tests/unit/woof/test_audit_config.py\nnew file mode 100644\nindex 00000000..074322cd\n--- /dev/null\n+++ b/tests/unit/woof/test_audit_config.py\n@@ -0,0 +1,66 @@\n+\"\"\"Unit tests for woof/lib/audit_config.py.\n+\n+Outcome coverage: O3 — operator can configure audit policy via .woof/agents.toml\n+without re-deploying the woof CLI.\n+\"\"\"\n+\n+from __future__ import annotations\n+\n+import importlib.util\n+from importlib.machinery import SourceFileLoader\n+from pathlib import Path\n+\n+import pytest\n+\n+REPO_ROOT = Path(__file__).resolve().parents[3]\n+AUDIT_CONFIG_PATH = REPO_ROOT / \"woof\" / \"lib\" / \"audit_config.py\"\n+\n+pytestmark = pytest.mark.host_only\n+\n+\n+def _load_module():\n+    \"\"\"Load woof/lib/audit_config.py as a module without package import machinery.\n+\n+    Registers the module in sys.modules before exec_module so that Python 3.14's\n+    dataclasses annotation resolver can find it (it calls sys.modules[cls.__module__]).\n+    \"\"\"\n+    import sys\n+\n+    loader = SourceFileLoader(\"audit_config\", str(AUDIT_CONFIG_PATH))\n+    spec = importlib.util.spec_from_loader(\"audit_config\", loader)\n+    assert spec is not None\n+    mod = importlib.util.module_from_spec(spec)\n+    sys.modules[\"audit_config\"] = mod\n+    loader.exec_module(mod)\n+    return mod\n+\n+\n+def test_defaults_when_no_audit_block() -> None:\n+    \"\"\"O3: absent [audit] block yields defaults — enabled, 256 KB cap, no patterns.\"\"\"\n+    mod = _load_module()\n+    cfg = mod.load_audit_config({})\n+    assert cfg.enabled is True\n+    assert cfg.max_bytes == mod.DEFAULT_MAX_BYTES\n+    assert cfg.redact_patterns == ()\n+\n+\n+def test_custom_max_bytes() -> None:\n+    \"\"\"O3: operator can raise the per-file cap via [audit].max_bytes.\"\"\"\n+    mod = _load_module()\n+    cfg = mod.load_audit_config({\"audit\": {\"max_bytes\": 1_048_576}})\n+    assert cfg.max_bytes == 1_048_576\n+\n+\n+def test_disable_redaction() -> None:\n+    \"\"\"O3: operator can disable redaction + size cap via [audit].enabled = false.\"\"\"\n+    mod = _load_module()\n+    cfg = mod.load_audit_config({\"audit\": {\"enabled\": False}})\n+    assert cfg.enabled is False\n+\n+\n+def test_custom_redact_patterns() -> None:\n+    \"\"\"O3: operator can add project-specific redact patterns via [audit].redact_patterns.\"\"\"\n+    mod = _load_module()\n+    patterns = [\"SECRET_[A-Z]+\", r\"api_key=\\S+\"]\n+    cfg = mod.load_audit_config({\"audit\": {\"redact_patterns\": patterns}})\n+    assert cfg.redact_patterns == tuple(patterns)\ndiff --git a/woof/lib/audit_config.py b/woof/lib/audit_config.py\nnew file mode 100644\nindex 00000000..5f885587\n--- /dev/null\n+++ b/woof/lib/audit_config.py\n@@ -0,0 +1,34 @@\n+\"\"\"Typed config loader for the [audit] block in .woof/agents.toml.\n+\n+Consumed by woof dispatch (S2) to drive redaction and per-file size cap\n+on committed audit artefacts. S1 lands the contract surface only; no\n+behavioural change until S2 wires this into dispatch.\n+\"\"\"\n+\n+from __future__ import annotations\n+\n+from dataclasses import dataclass, field\n+\n+DEFAULT_MAX_BYTES = 262_144  # 256 KB\n+\n+\n+@dataclass(frozen=True)\n+class AuditConfig:\n+    \"\"\"Resolved audit policy. All fields have safe defaults.\"\"\"\n+\n+    enabled: bool = True\n+    max_bytes: int = DEFAULT_MAX_BYTES\n+    redact_patterns: tuple[str, ...] = field(default_factory=tuple)\n+\n+\n+def load_audit_config(agents: dict) -> AuditConfig:\n+    \"\"\"Extract audit policy from a parsed agents.toml dict.\n+\n+    Missing [audit] block or individual keys fall back to AuditConfig defaults.\n+    \"\"\"\n+    block = agents.get(\"audit\") or {}\n+    return AuditConfig(\n+        enabled=bool(block.get(\"enabled\", True)),\n+        max_bytes=int(block.get(\"max_bytes\", DEFAULT_MAX_BYTES)),\n+        redact_patterns=tuple(block.get(\"redact_patterns\") or []),\n+    )\ndiff --git a/woof/schemas/agents.schema.json b/woof/schemas/agents.schema.json\nindex 4d363e82..16820d8d 100644\n--- a/woof/schemas/agents.schema.json\n+++ b/woof/schemas/agents.schema.json\n@@ -48,6 +48,31 @@\n           \"description\": \"Open a review_gate after the last story completes, before epic close. Recommended on.\"\n         }\n       }\n+    },\n+    \"audit\": {\n+      \"type\": \"object\",\n+      \"additionalProperties\": false,\n+      \"description\": \"Audit policy for committed artefacts written by woof dispatch. Controls conservative redaction and per-file size cap (Stage 5 Check 8, realised in S2).\",\n+      \"properties\": {\n+        \"enabled\": {\n+          \"type\": \"boolean\",\n+          \"default\": true,\n+          \"description\": \"Apply redaction and size cap before writing audit artefacts. Set to false to disable both filters (not recommended for production use).\"\n+        },\n+        \"max_bytes\": {\n+          \"type\": \"integer\",\n+          \"minimum\": 1,\n+          \"default\": 262144,\n+          \"description\": \"Per-file size cap in bytes. Audit artefacts exceeding this are truncated at commit time; the full output overflows to the gitignored audit/raw/ path. Default 262144 (256 KB).\"\n+        },\n+        \"redact_patterns\": {\n+          \"type\": \"array\",\n+          \"items\": { \"type\": \"string\", \"minLength\": 1 },\n+          \"uniqueItems\": true,\n+          \"default\": [],\n+          \"description\": \"Additional project-specific regex patterns to redact. Each pattern is matched against each output line; matching text is replaced with a [REDACTED:<reason>] marker. Built-in patterns (JWT, AWS keys, bearer tokens) are always applied when enabled=true.\"\n+        }\n+      }\n     }\n   },\n   \"$defs\": {\n","exit_code":0,"status":"completed"}}
