{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/usr/bin/zsh -lc \"rg -n \\\"ajv not on PATH|host_only|skip\\\" tests/unit/woof -g'*.py' && echo '---' && sed -n '1,220p' tests/unit/woof/conftest.py\"","aggregated_output":"tests/unit/woof/conftest.py:22:pytestmark = pytest.mark.host_only\ntests/unit/woof/conftest.py:29:            pytest.skip(f\"{tool} not on PATH; woof tests require host tooling\")\ntests/unit/woof/test_validate.py:22:pytestmark = pytest.mark.host_only\ntests/unit/woof/test_dispatch.py:19:pytestmark = pytest.mark.host_only\ntests/unit/woof/test_dispatch.py:130:        \"--skip-git-repo-check\",\ntests/unit/woof/test_dispatch.py:391:    assert argv == [\"cod\", \"--\", \"exec\", \"--json\", \"--skip-git-repo-check\", \"hi\"]\ntests/unit/woof/test_audit_config.py:18:pytestmark = pytest.mark.host_only\ntests/unit/woof/test_check_cd.py:25:pytestmark = pytest.mark.host_only\ntests/unit/woof/test_render_epic.py:21:pytestmark = pytest.mark.host_only\n---\n\"\"\"Shared fixtures for woof CLI tests.\n\nThese tests run on host (not Docker) — woof requires uv and ajv-cli on PATH.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport shutil\nimport subprocess\nfrom pathlib import Path\nfrom typing import TYPE_CHECKING\n\nimport pytest\n\nif TYPE_CHECKING:\n    from collections.abc import Callable\n\nREPO_ROOT = Path(__file__).resolve().parents[3]\nWOOF_BIN = REPO_ROOT / \"woof\" / \"bin\" / \"woof\"\n\n\npytestmark = pytest.mark.host_only\n\n\n@pytest.fixture(scope=\"session\", autouse=True)\ndef _require_host_tools() -> None:\n    for tool in (\"uv\", \"ajv\"):\n        if shutil.which(tool) is None:\n            pytest.skip(f\"{tool} not on PATH; woof tests require host tooling\")\n\n\n@pytest.fixture\ndef run_woof() -> Callable[..., subprocess.CompletedProcess[str]]:\n    \"\"\"Invoke ``woof <args>`` and return the CompletedProcess.\"\"\"\n\n    def _run(*args: str, env: dict[str, str] | None = None) -> subprocess.CompletedProcess[str]:\n        return subprocess.run(\n            [str(WOOF_BIN), *args],\n            capture_output=True,\n            text=True,\n            env=env,\n        )\n\n    return _run\n","exit_code":0,"status":"completed"}}
