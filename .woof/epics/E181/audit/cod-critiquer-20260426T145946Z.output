{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/usr/bin/zsh -lc 'git show :tests/unit/woof/test_audit_config.py | nl -ba'","aggregated_output":"     1\t\"\"\"Unit tests for woof/lib/audit_config.py.\n     2\t\n     3\tOutcome coverage: O3 — operator can configure audit policy via .woof/agents.toml\n     4\twithout re-deploying the woof CLI.\n     5\t\"\"\"\n     6\t\n     7\tfrom __future__ import annotations\n     8\t\n     9\timport importlib.util\n    10\tfrom importlib.machinery import SourceFileLoader\n    11\tfrom pathlib import Path\n    12\t\n    13\timport pytest\n    14\t\n    15\tREPO_ROOT = Path(__file__).resolve().parents[3]\n    16\tAUDIT_CONFIG_PATH = REPO_ROOT / \"woof\" / \"lib\" / \"audit_config.py\"\n    17\t\n    18\tpytestmark = pytest.mark.host_only\n    19\t\n    20\t\n    21\tdef _load_module():\n    22\t    \"\"\"Load woof/lib/audit_config.py as a module without package import machinery.\n    23\t\n    24\t    Registers the module in sys.modules before exec_module so that Python 3.14's\n    25\t    dataclasses annotation resolver can find it (it calls sys.modules[cls.__module__]).\n    26\t    \"\"\"\n    27\t    import sys\n    28\t\n    29\t    loader = SourceFileLoader(\"audit_config\", str(AUDIT_CONFIG_PATH))\n    30\t    spec = importlib.util.spec_from_loader(\"audit_config\", loader)\n    31\t    assert spec is not None\n    32\t    mod = importlib.util.module_from_spec(spec)\n    33\t    sys.modules[\"audit_config\"] = mod\n    34\t    loader.exec_module(mod)\n    35\t    return mod\n    36\t\n    37\t\n    38\tdef test_defaults_when_no_audit_block() -> None:\n    39\t    \"\"\"O3: absent [audit] block yields defaults — enabled, 256 KB cap, no patterns.\"\"\"\n    40\t    mod = _load_module()\n    41\t    cfg = mod.load_audit_config({})\n    42\t    assert cfg.enabled is True\n    43\t    assert cfg.max_bytes == mod.DEFAULT_MAX_BYTES\n    44\t    assert cfg.redact_patterns == ()\n    45\t\n    46\t\n    47\tdef test_custom_max_bytes() -> None:\n    48\t    \"\"\"O3: operator can raise the per-file cap via [audit].max_bytes.\"\"\"\n    49\t    mod = _load_module()\n    50\t    cfg = mod.load_audit_config({\"audit\": {\"max_bytes\": 1_048_576}})\n    51\t    assert cfg.max_bytes == 1_048_576\n    52\t\n    53\t\n    54\tdef test_disable_redaction() -> None:\n    55\t    \"\"\"O3: operator can disable redaction + size cap via [audit].enabled = false.\"\"\"\n    56\t    mod = _load_module()\n    57\t    cfg = mod.load_audit_config({\"audit\": {\"enabled\": False}})\n    58\t    assert cfg.enabled is False\n    59\t\n    60\t\n    61\tdef test_custom_redact_patterns() -> None:\n    62\t    \"\"\"O3: operator can add project-specific redact patterns via [audit].redact_patterns.\"\"\"\n    63\t    mod = _load_module()\n    64\t    patterns = [\"SECRET_[A-Z]+\", r\"api_key=\\S+\"]\n    65\t    cfg = mod.load_audit_config({\"audit\": {\"redact_patterns\": patterns}})\n    66\t    assert cfg.redact_patterns == tuple(patterns)\n","exit_code":0,"status":"completed"}}
