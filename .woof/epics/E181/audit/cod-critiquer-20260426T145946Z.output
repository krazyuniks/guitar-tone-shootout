/unit/woof/test_dispatch.py:273:harness = \"wrong-harness\"\ntests/unit/woof/test_dispatch.py:387:    argv = mod.build_argv(\"cld\", {\"harness\": \"cld\"}, \"hi\")\ntests/unit/woof/test_dispatch.py:390:    argv = mod.build_argv(\"cod\", {\"harness\": \"cod\"}, \"hi\")\ntests/unit/woof/test_dispatch.py:395:# end-to-end with a stub harness on PATH\ntests/unit/woof/test_dispatch.py:460:    assert meta[\"harness\"] == \"cld\"\ntests/unit/woof/test_dispatch.py:463:    assert meta[\"story_id\"] == \"S2\"\ntests/e2e/python/tests/test_authenticated.py:127:        target_idx = None\ntests/e2e/python/tests/test_authenticated.py:132:                target_idx = i\ntests/e2e/python/tests/test_authenticated.py:135:        if target_idx is None:\ntests/e2e/python/tests/test_authenticated.py:137:            target_idx = 0\ntests/e2e/python/tests/test_authenticated.py:139:        checkbox = checkboxes.nth(target_idx)\ntests/e2e/python/tests/test_authenticated.py:150:        new_checkbox = new_checkboxes.nth(target_idx)\ntests/e2e/python/tests/test_authenticated.py:164:            final_checkbox = final_checkboxes.nth(target_idx)\ntests/e2e/python/tests/test_authenticated.py:175:            final_checkbox = final_checkboxes.nth(target_idx)\ntests/unit/woof/test_validate.py:47:        \"critique.schema.json\",\ntests/unit/woof/test_validate.py:161:story_id: null\ntests/unit/woof/test_validate.py:189:target_id: null\ntests/unit/woof/test_validate.py:190:severity: info\ntests/unit/woof/test_validate.py:192:harness: claude-opus-4-7\ntests/unit/woof/test_validate.py:213:story_id: null\nwoof/playbooks/critique/README.md:16:Both templates output a critique document conforming to `woof/schemas/critique.schema.json` with structured findings (`severity: blocker | minor | info`).\nwoof/playbooks/discovery/research/feasibility.md:83:- Technical risks: [List with severity]\nwoof/playbooks/critique/story.md:9:- `.woof/epics/E<N>/plan.json` — find the story by `story_id` (passed in the dispatch envelope)\nwoof/playbooks/critique/story.md:15:Write `.woof/epics/E<N>/critique/story-S<k>.md` with YAML front-matter conforming to `woof/schemas/critique.schema.json` plus prose.\nwoof/playbooks/critique/story.md:23:target_path: .woof/epics/E<N>/plan.json\nwoof/playbooks/critique/story.md:24:story_id: S<k>\nwoof/playbooks/critique/story.md:28:    severity: blocker | minor | info\n.woof/epics/E181/HANDOFF.md:91:The critique lands at `.woof/epics/E181/critique/plan.md` with severity-tagged findings. Validate:\n.woof/epics/E181/HANDOFF.md:152:- `.woof/epics/E181/audit/<cld|cod>-<role>-<ts>.meta` — JSON sidecar: `harness`, `role`, `model`, `mcp[]`, `flags[]`, `argv[]`, `pid`, `started_at`, `ended_at`, `duration_ms`, `exit_code`, `timed_out`, `tokens.{tokens_in,tokens_out,cache_read_tokens,cache_write_tokens}`, `cc_session_id` or `codex_thread_id`\n.woof/epics/E181/HANDOFF.md:219:- **Any blocker-severity Codex finding** — surface verbatim with your position.\nwoof/playbooks/critique/plan.md:14:Write `.woof/epics/E<N>/critique/plan.md` with YAML front-matter conforming to `woof/schemas/critique.schema.json` plus a prose body.\nwoof/playbooks/critique/plan.md:22:target_path: .woof/epics/E<N>/plan.json\nwoof/playbooks/critique/plan.md:26:    severity: blocker | minor | info\nwoof/playbooks/critique/plan.md:62:The orchestrator opens a `plan_gate` regardless of severity. Your job is to give the human the most informative critique you can in one shot. There is no auto-revision loop.\n.woof/epics/E181/EPIC.md:29:  - \"A unit test dispatches a stub harness whose stdout exceeds the cap and asserts truncation + raw-file landing.\"\n.woof/epics/E181/critique/plan.md:3:target_id: null\n.woof/epics/E181/critique/plan.md:4:severity: info\n.woof/epics/E181/critique/plan.md:6:harness: codex-gpt-5\n","exit_code":0,"status":"completed"}}
