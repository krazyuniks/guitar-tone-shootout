{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/usr/bin/zsh -lc \"git show :woof/schemas/agents.schema.json | nl -ba | sed -n '1,260p'\"","aggregated_output":"     1\t{\n     2\t  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n     3\t  \"$id\": \"https://woof.dev/schemas/agents.schema.json\",\n     4\t  \"title\": \"woof agent role configuration\",\n     5\t  \"description\": \"Project-side declaration at .woof/agents.toml. Defines which dispatch wrapper (cld/cod), which model, and which extra flags are used per role. Woof builds the full subprocess invocation dynamically from these entries via 'woof dispatch claude --role X' / 'woof dispatch codex --role X' adapter commands; no hard-coded model IDs or shell aliases anywhere in the tool. If absent, defaults apply (in-session planner, cld -p story-executor with default model, cod critiquer with default model, all with empty MCP set).\",\n     6\t  \"type\": \"object\",\n     7\t  \"additionalProperties\": false,\n     8\t  \"required\": [\"roles\"],\n     9\t  \"properties\": {\n    10\t    \"roles\": {\n    11\t      \"type\": \"object\",\n    12\t      \"additionalProperties\": false,\n    13\t      \"properties\": {\n    14\t        \"orchestrator\": { \"$ref\": \"#/$defs/in_session_role\" },\n    15\t        \"planner\": { \"$ref\": \"#/$defs/dispatchable_role\" },\n    16\t        \"story-executor\": { \"$ref\": \"#/$defs/dispatchable_role\" },\n    17\t        \"critiquer\": { \"$ref\": \"#/$defs/dispatchable_role\" },\n    18\t        \"gate-resolver\": { \"$ref\": \"#/$defs/in_session_role\" }\n    19\t      },\n    20\t      \"description\": \"Roles invoked by woof. Any subset may be defined; missing roles fall back to defaults. orchestrator and gate-resolver are constrained to in-session execution (they share the user's interactive Claude Code session) and so use the in_session_role schema; the other three use dispatchable_role.\"\n    21\t    },\n    22\t    \"timeouts\": {\n    23\t      \"type\": \"object\",\n    24\t      \"additionalProperties\": false,\n    25\t      \"properties\": {\n    26\t        \"default_minutes\": {\n    27\t          \"type\": \"integer\",\n    28\t          \"minimum\": 1,\n    29\t          \"default\": 30,\n    30\t          \"description\": \"Per-subprocess timeout. Driver wraps cld/cod invocations with `timeout`. Hitting the timeout writes gate.md with triggered_by=['timeout'].\"\n    31\t        }\n    32\t      }\n    33\t    },\n    34\t    \"review_valve\": {\n    35\t      \"type\": \"object\",\n    36\t      \"additionalProperties\": false,\n    37\t      \"description\": \"Periodic review configuration (Stage 5 Check 9). Opens a review_gate every N completed stories AND once before epic close, surfacing accumulated minor critique findings.\",\n    38\t      \"properties\": {\n    39\t        \"every_n_stories\": {\n    40\t          \"type\": \"integer\",\n    41\t          \"minimum\": 1,\n    42\t          \"default\": 5,\n    43\t          \"description\": \"Open a review_gate after every N successful story commits.\"\n    44\t        },\n    45\t        \"end_of_epic\": {\n    46\t          \"type\": \"boolean\",\n    47\t          \"default\": true,\n    48\t          \"description\": \"Open a review_gate after the last story completes, before epic close. Recommended on.\"\n    49\t        }\n    50\t      }\n    51\t    },\n    52\t    \"audit\": {\n    53\t      \"type\": \"object\",\n    54\t      \"additionalProperties\": false,\n    55\t      \"description\": \"Audit policy for committed artefacts written by woof dispatch. Controls conservative redaction and per-file size cap (Stage 5 Check 8, realised in S2).\",\n    56\t      \"properties\": {\n    57\t        \"enabled\": {\n    58\t          \"type\": \"boolean\",\n    59\t          \"default\": true,\n    60\t          \"description\": \"Apply redaction and size cap before writing audit artefacts. Set to false to disable both filters (not recommended for production use).\"\n    61\t        },\n    62\t        \"max_bytes\": {\n    63\t          \"type\": \"integer\",\n    64\t          \"minimum\": 1,\n    65\t          \"default\": 262144,\n    66\t          \"description\": \"Per-file size cap in bytes. Audit artefacts exceeding this are truncated at commit time; the full output overflows to the gitignored audit/raw/ path. Default 262144 (256 KB).\"\n    67\t        },\n    68\t        \"redact_patterns\": {\n    69\t          \"type\": \"array\",\n    70\t          \"items\": { \"type\": \"string\", \"minLength\": 1 },\n    71\t          \"uniqueItems\": true,\n    72\t          \"default\": [],\n    73\t          \"description\": \"Additional project-specific regex patterns to redact. Each pattern is matched against each output line; matching text is replaced with a [REDACTED:<reason>] marker. Built-in patterns (JWT, AWS keys, bearer tokens) are always applied when enabled=true.\"\n    74\t        }\n    75\t      }\n    76\t    }\n    77\t  },\n    78\t  \"$defs\": {\n    79\t    \"in_session_role\": {\n    80\t      \"type\": \"object\",\n    81\t      \"additionalProperties\": false,\n    82\t      \"required\": [\"harness\"],\n    83\t      \"properties\": {\n    84\t        \"harness\": {\n    85\t          \"type\": \"string\",\n    86\t          \"const\": \"in-session\",\n    87\t          \"description\": \"orchestrator and gate-resolver must share the user's interactive Claude Code session; they cannot dispatch to a subprocess.\"\n    88\t        },\n    89\t        \"notes\": { \"type\": \"string\" }\n    90\t      }\n    91\t    },\n    92\t    \"dispatchable_role\": {\n    93\t      \"type\": \"object\",\n    94\t      \"additionalProperties\": false,\n    95\t      \"required\": [\"harness\"],\n    96\t      \"properties\": {\n    97\t        \"harness\": {\n    98\t          \"type\": \"string\",\n    99\t          \"enum\": [\"cld\", \"cod\", \"in-session\"],\n   100\t          \"description\": \"Dispatch wrapper. cld for Claude subprocesses, cod for Codex subprocesses, in-session for roles that should share the user's interactive session even though they could be dispatched.\"\n   101\t        },\n   102\t        \"model\": {\n   103\t          \"type\": \"string\",\n   104\t          \"minLength\": 1\n   105\t        },\n   106\t        \"think\": {\n   107\t          \"type\": \"boolean\",\n   108\t          \"description\": \"cld only. Toggles extended thinking via the wrapper's -t flag. Schema does not enforce the cld-only constraint; runtime ignores think when harness=cod.\"\n   109\t        },\n   110\t        \"mcp\": {\n   111\t          \"type\": \"array\",\n   112\t          \"items\": { \"type\": \"string\", \"minLength\": 1 },\n   113\t          \"uniqueItems\": true,\n   114\t          \"description\": \"MCP server names. Empty array (default) = no MCPs.\"\n   115\t        },\n   116\t        \"flags\": {\n   117\t          \"type\": \"array\",\n   118\t          \"items\": { \"type\": \"string\" },\n   119\t          \"description\": \"Additional pass-through args appended after the wrapper's '--' separator.\"\n   120\t        }\n   121\t      },\n   122\t      \"allOf\": [\n   123\t        {\n   124\t          \"if\": {\n   125\t            \"properties\": { \"harness\": { \"const\": \"in-session\" } },\n   126\t            \"required\": [\"harness\"]\n   127\t          },\n   128\t          \"then\": {\n   129\t            \"not\": {\n   130\t              \"anyOf\": [\n   131\t                { \"required\": [\"model\"] },\n   132\t                { \"required\": [\"think\"] },\n   133\t                { \"required\": [\"mcp\"] },\n   134\t                { \"required\": [\"flags\"] }\n   135\t              ]\n   136\t            }\n   137\t          }\n   138\t        }\n   139\t      ]\n   140\t    }\n   141\t  }\n   142\t}\n","exit_code":0,"status":"completed"}}
