 577\t\n   578\t    audit_dir = woof_project_small_cap / \".woof\" / \"epics\" / \"E51\" / \"audit\"\n   579\t    output_file = next(audit_dir.glob(\"*.output\"))\n   580\t    committed = output_file.read_text()\n   581\t\n   582\t    # Committed file must be truncated\n   583\t    assert len(committed.encode(\"utf-8\")) < 2000\n   584\t    assert \"truncated\" in committed\n   585\t    assert \"audit/raw/\" in committed\n   586\t\n   587\t    # Raw file must contain the full original output\n   588\t    raw_dir = audit_dir / \"raw\"\n   589\t    assert raw_dir.is_dir(), \"audit/raw/ directory must exist\"\n   590\t    raw_files = list(raw_dir.glob(\"*.output\"))\n   591\t    assert len(raw_files) == 1, f\"expected one raw output file, got: {raw_files}\"\n   592\t    assert len(raw_files[0].read_text().encode(\"utf-8\")) >= 2000\n   593\t\n   594\t\n   595\tdef test_end_to_end_codex_records_thread_and_audit_path(woof_project: Path, tmp_path: Path) -> None:\n   596\t    bin_dir = tmp_path / \"bin\"\n   597\t    codex_stream = \"\\n\".join(\n   598\t        [\n   599\t            json.dumps({\"type\": \"thread.started\", \"thread_id\": \"thr-1\"}),\n   600\t            json.dumps(\n   601\t                {\n   602\t                    \"type\": \"turn.completed\",\n   603\t                    \"usage\": {\n   604\t                        \"input_tokens\": 50,\n   605\t                        \"cached_input_tokens\": 10,\n   606\t                        \"output_tokens\": 5,\n   607\t                        \"reasoning_output_tokens\": 2,\n   608\t                    },\n   609\t                }\n   610\t            ),\n   611\t        ]\n   612\t    )\n   613\t    _make_stub(bin_dir, \"cod\", codex_stream)\n   614\t    env = {\n   615\t        \"PATH\": f\"{bin_dir}:{__import__('os').environ['PATH']}\",\n   616\t        \"HOME\": __import__(\"os\").environ.get(\"HOME\", str(tmp_path)),\n   617\t    }\n   618\t\n   619\t    proc = subprocess.run(\n   620\t        [\n