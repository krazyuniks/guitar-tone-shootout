                 # Open psql to gts_core database\n    rebuild *ARGS           # Rebuild and restart services\n    redis-cli               # Open redis-cli\n    repl                    # Open a Python REPL in the backend container\n    reset                   # Must be run manually by user, not by Claude\n    restart                 # Restart all services\n    run-hooks               # Run prek hooks on all files\n    shell                   # Open a shell in the backend container\n    solve-vercel            # Solve Vercel Security Checkpoint — saves cookies for worker (runs on host)\n    status                  # Show service status\n    t3k-auth                # T3K auth — canonical entry point (check, login if needed, restore session)\n    t3k-auth-status         # T3K auth status — check token health (runs on host, no API calls)\n    t3k-login               # T3K login — authenticate via headless Chromium (runs on host)\n    tdd PATH *EXTRA_ARGS='' # Run a single test file or test (TDD mode, in Docker)\n    test                    # Run all tests except E2E (in Docker)\n    test-docs               # Run documentation tests (on host - requires AGENTS.md/DEVELOPMENT.md)\n    test-golden-path        # Run E2E golden path tests (on host, hits Docker containers)\n    test-integration        # Run integration tests (in Docker)\n    test-quality            # Test quality analysis\n    test-regression         # Tests both internal Docker stack and external URL (Traefik SSL if available)\n    test-unit               # Run unit tests (in Docker, excludes host_only tests like documentation tests)\n    test-woof               # Run woof CLI tests (on host - requires uv and ajv-cli)\n    uninstall-hooks         # Uninstall pre-commit hook\n    up-d                    # Compose files are configured via COMPOSE_FILE in .env.worktree (set by worktree.py setup)\n    verify-astro-sync       # Verify Astro dist is in sync with source\n    video-studio            # Open Remotion Studio for video composition development\n    video-test              # Run video tests (Python + TypeScript)\n    video-types             # Check video types (TypeScript)\n    watch-astro             # Watch Astro logs (chokidar auto-rebuilds on source changes)\n    wf-audit-bundle EPIC    # pruned. Codex audit files already live under .woof/epics/E<N>/audit/.\n    wf-install-hooks        # Install woof's post-commit cartography hook (idempotent fenced block).\n    wf-run *ARGS            # Drive Stage 5 for an epic (story-by-story dispatch loop). Halts on gate.md.\n    woof-validate *ARGS     # Validate woof artefacts against JSON Schemas (on host - requires ajv-cli)\n","exit_code":0,"status":"completed"}}
