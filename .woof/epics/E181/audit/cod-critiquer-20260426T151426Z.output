{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/usr/bin/zsh -lc 'git diff --staged'","aggregated_output":"diff --git a/tests/unit/woof/test_audit_filter.py b/tests/unit/woof/test_audit_filter.py\nnew file mode 100644\nindex 00000000..12928ad7\n--- /dev/null\n+++ b/tests/unit/woof/test_audit_filter.py\n@@ -0,0 +1,123 @@\n+\"\"\"Unit tests for woof/lib/audit_filter.py.\n+\n+Outcome coverage:\n+  O1 — secret-shaped spans are replaced with [REDACTED:<reason>] before the\n+       output file lands on disk.\n+  O2 — subprocess stdout exceeding the per-file cap is truncated; the full\n+       output overflows to the gitignored audit/raw/ path.\n+  O3 — the operator can disable both filters via agents.toml [audit].enabled.\n+\"\"\"\n+\n+from __future__ import annotations\n+\n+import importlib.util\n+import sys\n+from importlib.machinery import SourceFileLoader\n+from pathlib import Path\n+\n+import pytest\n+\n+REPO_ROOT = Path(__file__).resolve().parents[3]\n+AUDIT_FILTER_PATH = REPO_ROOT / \"woof\" / \"lib\" / \"audit_filter.py\"\n+\n+pytestmark = pytest.mark.host_only\n+\n+\n+def _load_module():\n+    loader = SourceFileLoader(\"audit_filter\", str(AUDIT_FILTER_PATH))\n+    spec = importlib.util.spec_from_loader(\"audit_filter\", loader)\n+    assert spec is not None\n+    mod = importlib.util.module_from_spec(spec)\n+    sys.modules[\"audit_filter\"] = mod\n+    loader.exec_module(mod)\n+    return mod\n+\n+\n+# ---------------------------------------------------------------------------\n+# O1 — redaction of built-in secret patterns\n+# ---------------------------------------------------------------------------\n+\n+\n+def test_jwt_redacted() -> None:\n+    \"\"\"O1: a JWT in the output is replaced with [REDACTED:jwt].\"\"\"\n+    mod = _load_module()\n+    jwt = (\n+        \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9\"\n+        \".eyJzdWIiOiIxMjM0NTY3ODkwIn0\"\n+        \".SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c\"\n+    )\n+    result = mod.redact(f\"Authorization: Bearer {jwt}\")\n+    assert jwt not in result\n+    assert \"[REDACTED:jwt]\" in result\n+\n+\n+def test_aws_access_key_redacted() -> None:\n+    \"\"\"O1: an AWS access key is replaced with [REDACTED:aws-access-key].\"\"\"\n+    mod = _load_module()\n+    key = \"[REDACTED:aws-access-key]\"\n+    result = mod.redact(f\"aws_access_key_id = {key}\")\n+    assert key not in result\n+    assert \"[REDACTED:aws-access-key]\" in result\n+\n+\n+def test_bearer_token_redacted() -> None:\n+    \"\"\"O1: a Bearer token value in an auth header is redacted.\"\"\"\n+    mod = _load_module()\n+    line = \"Authorization: [REDACTED:bearer-token]\"\n+    result = mod.redact(line)\n+    assert \"ghp_16C7e42F292c6912E7710c838347Ae178B4a\" not in result\n+    assert \"[REDACTED:bearer-token]\" in result\n+\n+\n+# ---------------------------------------------------------------------------\n+# O2 — size cap truncation\n+# ---------------------------------------------------------------------------\n+\n+\n+def test_size_cap_truncates_and_writes_raw(tmp_path: Path) -> None:\n+    \"\"\"O2: output exceeding max_bytes is truncated; raw file is written.\"\"\"\n+    mod = _load_module()\n+    text = \"x\" * 2000\n+    raw_path = tmp_path / \"raw\" / \"cld-story-executor-20260101T000000Z.output\"\n+    committed = mod.apply_size_cap(text, max_bytes=100, raw_path=raw_path, epic_id=181)\n+\n+    assert len(committed.encode(\"utf-8\")) <= 100 + 200  # footer has some slack\n+    assert \"truncated\" in committed\n+    assert \"audit/raw/\" in committed\n+    assert raw_path.is_file()\n+    assert raw_path.read_text() == text\n+\n+\n+# ---------------------------------------------------------------------------\n+# O3 — operator-configurable filter (enabled=False disables both filters)\n+# ---------------------------------------------------------------------------\n+\n+\n+def test_enabled_false_passthrough(tmp_path: Path) -> None:\n+    \"\"\"O3: enabled=False returns text unchanged; no raw file is written.\"\"\"\n+    mod = _load_module()\n+    jwt = (\n+        \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9\"\n+        \".eyJzdWIiOiIxMjM0NTY3ODkwIn0\"\n+        \".SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c\"\n+    )\n+    raw_path = tmp_path / \"raw\" / \"output\"\n+    result = mod.filter_audit_output(\n+        jwt,\n+        enabled=False,\n+        max_bytes=10,\n+        redact_patterns=(),\n+        raw_path=raw_path,\n+        epic_id=181,\n+    )\n+    assert result == jwt\n+    assert not raw_path.exists()\n+\n+\n+def test_custom_pattern_redacted() -> None:\n+    \"\"\"O3: extra_patterns supplied by the operator are applied after built-ins.\"\"\"\n+    mod = _load_module()\n+    text = \"DB_PASSWORD=supersecret123\"\n+    result = mod.redact(text, extra_patterns=(\"DB_PASSWORD=\\\\S+\",))\n+    assert \"supersecret123\" not in result\n+    assert \"[REDACTED:custom]\" in result\ndiff --git a/tests/unit/woof/test_dispatch.py b/tests/unit/woof/test_dispatch.py\nindex 538778d7..8a309ab5 100644\n--- a/tests/unit/woof/test_dispatch.py\n+++ b/tests/unit/woof/test_dispatch.py\n@@ -485,6 +485,113 @@ def test_end_to_end_claude_writes_audit_and_jsonl(woof_project: Path, tmp_path:\n     assert validate.returncode == 0, validate.stdout + validate.stderr\n \n \n+# ---------------------------------------------------------------------------\n+# audit filter integration (O1, O2, O3)\n+# ---------------------------------------------------------------------------\n+\n+\n+@pytest.fixture\n+def woof_project_small_cap(tmp_path: Path) -> Path:\n+    \"\"\"Woof project with [audit] max_bytes=200 for size-cap integration tests.\"\"\"\n+    project = tmp_path / \"proj_cap\"\n+    woof_dir = project / \".woof\"\n+    woof_dir.mkdir(parents=True)\n+    (woof_dir / \"agents.toml\").write_text(\"\"\"\\\n+[roles.story-executor]\n+harness = \"cld\"\n+model = \"claude-sonnet-4-6\"\n+\n+[roles.critiquer]\n+harness = \"cod\"\n+model = \"gpt-5.3-codex\"\n+\n+[timeouts]\n+default_minutes = 15\n+\n+[audit]\n+enabled = true\n+max_bytes = 200\n+\"\"\")\n+    return project\n+\n+\n+def test_dispatch_redacts_secret_in_output(woof_project: Path, tmp_path: Path) -> None:\n+    \"\"\"O1: dispatch redacts a JWT in subprocess stdout before writing the .output file.\"\"\"\n+    bin_dir = tmp_path / \"bin\"\n+    jwt = (\n+        \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9\"\n+        \".eyJzdWIiOiIxMjM0NTY3ODkwIn0\"\n+        \".SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c\"\n+    )\n+    # Stub cld outputs a line containing a JWT alongside a normal result envelope\n+    result_line = json.dumps(\n+        {\n+            \"type\": \"result\",\n+            \"session_id\": \"aaaaaaaa-0000-0000-0000-000000000001\",\n+            \"usage\": {\"input_tokens\": 1, \"output_tokens\": 1},\n+        }\n+    )\n+    _make_stub(bin_dir, \"cld\", f\"bearer_token={jwt}\\n{result_line}\")\n+    env = {\n+        \"PATH\": f\"{bin_dir}:{__import__('os').environ['PATH']}\",\n+        \"HOME\": __import__(\"os\").environ.get(\"HOME\", str(tmp_path)),\n+    }\n+\n+    proc = subprocess.run(\n+        [str(WOOF_BIN), \"dispatch\", \"claude\", \"--role\", \"story-executor\", \"--epic\", \"50\"],\n+        capture_output=True,\n+        text=True,\n+        input=\"run it\\n\",\n+        cwd=woof_project,\n+        env=env,\n+    )\n+    assert proc.returncode == 0, proc.stderr\n+\n+    audit_dir = woof_project / \".woof\" / \"epics\" / \"E50\" / \"audit\"\n+    output_file = next(audit_dir.glob(\"*.output\"))\n+    committed = output_file.read_text()\n+    assert jwt not in committed, \"JWT must not appear in committed .output\"\n+    assert \"[REDACTED\" in committed\n+\n+\n+def test_dispatch_size_cap_overflow(woof_project_small_cap: Path, tmp_path: Path) -> None:\n+    \"\"\"O2 / O3: dispatch truncates .output to max_bytes (configured in agents.toml [audit]);\n+    the full output overflows to the gitignored audit/raw/ path.\"\"\"\n+    bin_dir = tmp_path / \"bin_cap\"\n+    # Stub cld outputs 2 000 bytes of 'x' — well above the 200-byte cap\n+    _make_stub(bin_dir, \"cld\", \"x\" * 2000)\n+    env = {\n+        \"PATH\": f\"{bin_dir}:{__import__('os').environ['PATH']}\",\n+        \"HOME\": __import__(\"os\").environ.get(\"HOME\", str(tmp_path)),\n+    }\n+\n+    proc = subprocess.run(\n+        [str(WOOF_BIN), \"dispatch\", \"claude\", \"--role\", \"story-executor\", \"--epic\", \"51\"],\n+        capture_output=True,\n+        text=True,\n+        input=\"run it\\n\",\n+        cwd=woof_project_small_cap,\n+        env=env,\n+    )\n+    assert proc.returncode == 0, proc.stderr\n+\n+    audit_dir = woof_project_small_cap / \".woof\" / \"epics\" / \"E51\" / \"audit\"\n+    output_file = next(audit_dir.glob(\"*.output\"))\n+    committed = output_file.read_text()\n+\n+    # Committed file must be truncated\n+    assert len(committed.encode(\"utf-8\")) < 2000\n+    assert \"truncated\" in committed\n+    assert \"audit/raw/\" in committed\n+\n+    # Raw file must contain the full original output\n+    raw_dir = audit_dir / \"raw\"\n+    assert raw_dir.is_dir(), \"audit/raw/ directory must exist\"\n+    raw_files = list(raw_dir.glob(\"*.output\"))\n+    assert len(raw_files) == 1, f\"expected one raw output file, got: {raw_files}\"\n+    assert len(raw_files[0].read_text().encode(\"utf-8\")) >= 2000\n+\n+\n def test_end_to_end_codex_records_thread_and_audit_path(woof_project: Path, tmp_path: Path) -> None:\n     bin_dir = tmp_path / \"bin\"\n     codex_stream = \"\\n\".join(\ndiff --git a/woof/bin/woof b/woof/bin/woof\nindex 72166f9b..8801390a 100755\n--- a/woof/bin/woof\n+++ b/woof/bin/woof\n@@ -37,6 +37,11 @@ import yaml\n REPO_ROOT = Path(__file__).resolve().parents[2]\n SCHEMA_DIR = REPO_ROOT / \"woof\" / \"schemas\"\n \n+# Load audit helpers from woof/lib — not a package import; insert lib dir.\n+sys.path.insert(0, str(REPO_ROOT / \"woof\" / \"lib\"))\n+from audit_config import load_audit_config  # noqa: E402\n+from audit_filter import filter_audit_output  # noqa: E402\n+\n SCHEMAS: dict[str, str] = {\n     \"epic\": \"epic.schema.json\",\n     \"plan\": \"plan.schema.json\",\n@@ -347,6 +352,8 @@ def cmd_dispatch(args: argparse.Namespace) -> int:\n         sys.stderr.write(f\"woof: {agents_path}: schema invalid\\n{output}\\n\")\n         return 2\n \n+    audit_cfg = load_audit_config(agents)\n+\n     role = (agents.get(\"roles\") or {}).get(args.role)\n     if role is None:\n         sys.stderr.write(\n@@ -445,13 +452,33 @@ def cmd_dispatch(args: argparse.Namespace) -> int:\n             \"signal\": \"SIGINT\",\n             \"reason\": \"manual_cancel\",\n         })\n-        output_file.write_text(stdout or \"\")\n+        raw_output_path = audit_dir / \"raw\" / output_file.name\n+        output_file.write_text(\n+            filter_audit_output(\n+                stdout or \"\",\n+                enabled=audit_cfg.enabled,\n+                max_bytes=audit_cfg.max_bytes,\n+                redact_patterns=audit_cfg.redact_patterns,\n+                raw_path=raw_output_path,\n+                epic_id=args.epic,\n+            )\n+        )\n         stderr_file.write_text(stderr or \"\")\n         return 130\n \n     ended_at = datetime.now(timezone.utc)\n     duration_ms = int((ended_at - started_at).total_seconds() * 1000)\n-    output_file.write_text(stdout)\n+    raw_output_path = audit_dir / \"raw\" / output_file.name\n+    output_file.write_text(\n+        filter_audit_output(\n+            stdout,\n+            enabled=audit_cfg.enabled,\n+            max_bytes=audit_cfg.max_bytes,\n+            redact_patterns=audit_cfg.redact_patterns,\n+            raw_path=raw_output_path,\n+            epic_id=args.epic,\n+        )\n+    )\n     stderr_file.write_text(stderr)\n \n     if expected_harness == \"cld\":\ndiff --git a/woof/lib/audit_filter.py b/woof/lib/audit_filter.py\nnew file mode 100644\nindex 00000000..6a304a07\n--- /dev/null\n+++ b/woof/lib/audit_filter.py\n@@ -0,0 +1,89 @@\n+\"\"\"Conservative redaction and per-file size cap for woof dispatch audit artefacts.\n+\n+Built-in patterns cover the three highest-risk secret shapes that appear in\n+woof subprocess transcripts: JWT tokens, AWS access keys, and Bearer/Token\n+auth-header values.  Additional project-specific patterns flow in from\n+AuditConfig.redact_patterns (loaded from .woof/agents.toml [audit]).\n+\"\"\"\n+\n+from __future__ import annotations\n+\n+import re\n+from pathlib import Path\n+\n+_TRUNCATION_FOOTER = (\n+    \"\\n... [truncated, full output at .woof/epics/E{epic_id}/audit/raw/]\\n\"\n+)\n+\n+# Built-in patterns: (compiled regex, reason tag).\n+# Conservative bias: patterns are deliberately broad so false positives leave a\n+# [REDACTED] marker rather than leaking a secret to a committed file.\n+_BUILTIN: list[tuple[re.Pattern[str], str]] = [\n+    # JWT — three base64url segments separated by dots, header starting with eyJ\n+    (re.compile(r\"eyJ[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\"), \"jwt\"),\n+    # AWS access key — AKIA prefix followed by exactly 16 uppercase alphanumerics\n+    (re.compile(r\"AKIA[0-9A-Z]{16}\"), \"aws-access-key\"),\n+    # Bearer token value in HTTP Authorization header lines\n+    (re.compile(r\"(?i)\\bBearer\\s+[A-Za-z0-9._\\-=+/]{8,}\"), \"bearer-token\"),\n+    # token= / [REDACTED:token-value] (e.g. [REDACTED:token-value], [REDACTED:token-value])\n+    (re.compile(r\"(?i)\\btoken[=:]\\s*[A-Za-z0-9._\\-=+/]{8,}\"), \"token-value\"),\n+]\n+\n+\n+def redact(text: str, extra_patterns: tuple[str, ...] = ()) -> str:\n+    \"\"\"Replace all secret-shaped spans in ``text`` with [REDACTED:<reason>].\n+\n+    Built-in patterns run first; project-specific ``extra_patterns`` follow.\n+    \"\"\"\n+    patterns: list[tuple[re.Pattern[str], str]] = list(_BUILTIN)\n+    for pat in extra_patterns:\n+        patterns.append((re.compile(pat), \"custom\"))\n+    for rx, reason in patterns:\n+        text = rx.sub(f\"[REDACTED:{reason}]\", text)\n+    return text\n+\n+\n+def apply_size_cap(\n+    text: str,\n+    *,\n+    max_bytes: int,\n+    raw_path: Path,\n+    epic_id: int,\n+) -> str:\n+    \"\"\"Truncate ``text`` to ``max_bytes`` bytes if it exceeds the cap.\n+\n+    The full pre-truncation text is written to ``raw_path`` (caller ensures\n+    the path is gitignored).  Returns the committed (possibly truncated) text.\n+    \"\"\"\n+    encoded = text.encode(\"utf-8\")\n+    if len(encoded) <= max_bytes:\n+        return text\n+\n+    raw_path.parent.mkdir(parents=True, exist_ok=True)\n+    raw_path.write_text(text, encoding=\"utf-8\")\n+\n+    footer = _TRUNCATION_FOOTER.format(epic_id=epic_id)\n+    footer_bytes = footer.encode(\"utf-8\")\n+    keep = max(0, max_bytes - len(footer_bytes))\n+    truncated = encoded[:keep].decode(\"utf-8\", errors=\"replace\")\n+    return truncated + footer\n+\n+\n+def filter_audit_output(\n+    text: str,\n+    *,\n+    enabled: bool,\n+    max_bytes: int,\n+    redact_patterns: tuple[str, ...],\n+    raw_path: Path,\n+    epic_id: int,\n+) -> str:\n+    \"\"\"Apply redaction then size cap to audit output when ``enabled`` is True.\n+\n+    If ``enabled`` is False the text is returned unchanged and no raw file is\n+    written (allows the operator to opt out via agents.toml [audit].enabled).\n+    \"\"\"\n+    if not enabled:\n+        return text\n+    text = redact(text, redact_patterns)\n+    return apply_size_cap(text, max_bytes=max_bytes, raw_path=raw_path, epic_id=epic_id)\n","exit_code":0,"status":"completed"}}
