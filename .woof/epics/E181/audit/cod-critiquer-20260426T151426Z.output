e.name\n   472\t    output_file.write_text(\n   473\t        filter_audit_output(\n   474\t            stdout,\n   475\t            enabled=audit_cfg.enabled,\n   476\t            max_bytes=audit_cfg.max_bytes,\n   477\t            redact_patterns=audit_cfg.redact_patterns,\n   478\t            raw_path=raw_output_path,\n   479\t            epic_id=args.epic,\n   480\t        )\n   481\t    )\n   482\t    stderr_file.write_text(stderr)\n   483\t\n   484\t    if expected_harness == \"cld\":\n   485\t        tokens, session_id = parse_claude_output(stdout)\n   486\t        thread_id = None\n   487\t    else:\n   488\t        tokens, thread_id = parse_codex_output(stdout)\n   489\t        session_id = None\n   490\t\n   491\t    timed_out = proc.returncode == 124  # GNU timeout(1) exit code\n   492\t    if timed_out:\n   493\t        append_jsonl(dispatch_jsonl, {\n   494\t            \"event\": \"subprocess_killed\",\n   495\t            \"at\": iso_utc(ended_at),\n   496\t            \"epic_id\": args.epic,\n   497\t            \"pid\": proc.pid,\n   498\t            \"signal\": \"SIGTERM\",\n   499\t            \"reason\": \"timeout\",\n   500\t        })\n","exit_code":0,"status":"completed"}}
