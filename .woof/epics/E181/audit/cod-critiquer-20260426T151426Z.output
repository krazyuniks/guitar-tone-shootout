{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/usr/bin/zsh -lc \"nl -ba woof/lib/audit_filter.py | sed -n '1,220p'\"","aggregated_output":"     1\t\"\"\"Conservative redaction and per-file size cap for woof dispatch audit artefacts.\n     2\t\n     3\tBuilt-in patterns cover the three highest-risk secret shapes that appear in\n     4\twoof subprocess transcripts: JWT tokens, AWS access keys, and Bearer/Token\n     5\tauth-header values.  Additional project-specific patterns flow in from\n     6\tAuditConfig.redact_patterns (loaded from .woof/agents.toml [audit]).\n     7\t\"\"\"\n     8\t\n     9\tfrom __future__ import annotations\n    10\t\n    11\timport re\n    12\tfrom pathlib import Path\n    13\t\n    14\t_TRUNCATION_FOOTER = (\n    15\t    \"\\n... [truncated, full output at .woof/epics/E{epic_id}/audit/raw/]\\n\"\n    16\t)\n    17\t\n    18\t# Built-in patterns: (compiled regex, reason tag).\n    19\t# Conservative bias: patterns are deliberately broad so false positives leave a\n    20\t# [REDACTED] marker rather than leaking a secret to a committed file.\n    21\t_BUILTIN: list[tuple[re.Pattern[str], str]] = [\n    22\t    # JWT — three base64url segments separated by dots, header starting with eyJ\n    23\t    (re.compile(r\"eyJ[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\"), \"jwt\"),\n    24\t    # AWS access key — AKIA prefix followed by exactly 16 uppercase alphanumerics\n    25\t    (re.compile(r\"AKIA[0-9A-Z]{16}\"), \"aws-access-key\"),\n    26\t    # Bearer token value in HTTP Authorization header lines\n    27\t    (re.compile(r\"(?i)\\bBearer\\s+[A-Za-z0-9._\\-=+/]{8,}\"), \"bearer-token\"),\n    28\t    # token= / [REDACTED:token-value] (e.g. [REDACTED:token-value], [REDACTED:token-value])\n    29\t    (re.compile(r\"(?i)\\btoken[=:]\\s*[A-Za-z0-9._\\-=+/]{8,}\"), \"token-value\"),\n    30\t]\n    31\t\n    32\t\n    33\tdef redact(text: str, extra_patterns: tuple[str, ...] = ()) -> str:\n    34\t    \"\"\"Replace all secret-shaped spans in ``text`` with [REDACTED:<reason>].\n    35\t\n    36\t    Built-in patterns run first; project-specific ``extra_patterns`` follow.\n    37\t    \"\"\"\n    38\t    patterns: list[tuple[re.Pattern[str], str]] = list(_BUILTIN)\n    39\t    for pat in extra_patterns:\n    40\t        patterns.append((re.compile(pat), \"custom\"))\n    41\t    for rx, reason in patterns:\n    42\t        text = rx.sub(f\"[REDACTED:{reason}]\", text)\n    43\t    return text\n    44\t\n    45\t\n    46\tdef apply_size_cap(\n    47\t    text: str,\n    48\t    *,\n    49\t    max_bytes: int,\n    50\t    raw_path: Path,\n    51\t    epic_id: int,\n    52\t) -> str:\n    53\t    \"\"\"Truncate ``text`` to ``max_bytes`` bytes if it exceeds the cap.\n    54\t\n    55\t    The full pre-truncation text is written to ``raw_path`` (caller ensures\n    56\t    the path is gitignored).  Returns the committed (possibly truncated) text.\n    57\t    \"\"\"\n    58\t    encoded = text.encode(\"utf-8\")\n    59\t    if len(encoded) <= max_bytes:\n    60\t        return text\n    61\t\n    62\t    raw_path.parent.mkdir(parents=True, exist_ok=True)\n    63\t    raw_path.write_text(text, encoding=\"utf-8\")\n    64\t\n    65\t    footer = _TRUNCATION_FOOTER.format(epic_id=epic_id)\n    66\t    footer_bytes = footer.encode(\"utf-8\")\n    67\t    keep = max(0, max_bytes - len(footer_bytes))\n    68\t    truncated = encoded[:keep].decode(\"utf-8\", errors=\"replace\")\n    69\t    return truncated + footer\n    70\t\n    71\t\n    72\tdef filter_audit_output(\n    73\t    text: str,\n    74\t    *,\n    75\t    enabled: bool,\n    76\t    max_bytes: int,\n    77\t    redact_patterns: tuple[str, ...],\n    78\t    raw_path: Path,\n    79\t    epic_id: int,\n    80\t) -> str:\n    81\t    \"\"\"Apply redaction then size cap to audit output when ``enabled`` is True.\n    82\t\n    83\t    If ``enabled`` is False the text is returned unchanged and no raw file is\n    84\t    written (allows the operator to opt out via agents.toml [audit].enabled).\n    85\t    \"\"\"\n    86\t    if not enabled:\n    87\t        return text\n    88\t    text = redact(text, redact_patterns)\n    89\t    return apply_size_cap(text, max_bytes=max_bytes, raw_path=raw_path, epic_id=epic_id)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/usr/bin/zsh -lc \"nl -ba tests/unit/woof/test_audit_filter.py | sed -n '70,140p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/usr/bin/zsh -lc \"nl -ba tests/unit/woof/test_audit_filter.py | sed -n '70,140p'\"","aggregated_output":"    70\t\n    71\t\n    72\t# ---------------------------------------------------------------------------\n    73\t# O2 — size cap truncation\n    74\t# ---------------------------------------------------------------------------\n    75\t\n    76\t\n    77\tdef test_size_cap_truncates_and_writes_raw(tmp_path: Path) -> None:\n    78\t    \"\"\"O2: output exceeding max_bytes is truncated; raw file is written.\"\"\"\n    79\t    mod = _load_module()\n    80\t    text = \"x\" * 2000\n    81\t    raw_path = tmp_path / \"raw\" / \"cld-story-executor-20260101T000000Z.output\"\n    82\t    committed = mod.apply_size_cap(text, max_bytes=100, raw_path=raw_path, epic_id=181)\n    83\t\n    84\t    assert len(committed.encode(\"utf-8\")) <= 100 + 200  # footer has some slack\n    85\t    assert \"truncated\" in committed\n    86\t    assert \"audit/raw/\" in committed\n    87\t    assert raw_path.is_file()\n    88\t    assert raw_path.read_text() == text\n    89\t\n    90\t\n    91\t# ---------------------------------------------------------------------------\n    92\t# O3 — operator-configurable filter (enabled=False disables both filters)\n    93\t# ---------------------------------------------------------------------------\n    94\t\n    95\t\n    96\tdef test_enabled_false_passthrough(tmp_path: Path) -> None:\n    97\t    \"\"\"O3: enabled=False returns text unchanged; no raw file is written.\"\"\"\n    98\t    mod = _load_module()\n    99\t    jwt = (\n   100\t        \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9\"\n   101\t        \".eyJzdWIiOiIxMjM0NTY3ODkwIn0\"\n   102\t        \".SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c\"\n   103\t    )\n   104\t    raw_path = tmp_path / \"raw\" / \"output\"\n   105\t    result = mod.filter_audit_output(\n   106\t        jwt,\n   107\t        enabled=False,\n   108\t        max_bytes=10,\n   109\t        redact_patterns=(),\n   110\t        raw_path=raw_path,\n   111\t        epic_id=181,\n   112\t    )\n   113\t    assert result == jwt\n   114\t    assert not raw_path.exists()\n   115\t\n   116\t\n   117\tdef test_custom_pattern_redacted() -> None:\n   118\t    \"\"\"O3: extra_patterns supplied by the operator are applied after built-ins.\"\"\"\n   119\t    mod = _load_module()\n   120\t    text = \"DB_PASSWORD=supersecret123\"\n   121\t    result = mod.redact(text, extra_patterns=(\"DB_PASSWORD=\\\\S+\",))\n   122\t    assert \"supersecret123\" not in result\n   123\t    assert \"[REDACTED:custom]\" in result\n","exit_code":0,"status":"completed"}}
