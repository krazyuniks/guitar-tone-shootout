{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/usr/bin/zsh -lc \"sed -n '1,260p' woof/schemas/plan.schema.json\"","aggregated_output":"{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"https://woof.dev/schemas/plan.schema.json\",\n  \"title\": \"woof plan\",\n  \"description\": \"Stage 3 Breakdown output: ordered stories implementing an epic. Validates structural shape only; cross-artefact invariants (satisfies[] subset of EPIC.md.observable_outcomes[].id, depends_on[] subset of stories[].id, every CD implemented by exactly one story, paths globs disjoint where required) are enforced by Stage-5 helper Check 5.\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\"epic_id\", \"goal\", \"stories\"],\n  \"properties\": {\n    \"epic_id\": {\n      \"type\": \"integer\",\n      \"minimum\": 1,\n      \"description\": \"GitHub issue number. Mirrors EPIC.md.epic_id.\"\n    },\n    \"goal\": {\n      \"type\": \"string\",\n      \"minLength\": 1,\n      \"description\": \"One-sentence prose summary of the epic outcome.\"\n    },\n    \"stories\": {\n      \"type\": \"array\",\n      \"minItems\": 1,\n      \"uniqueItems\": true,\n      \"items\": { \"$ref\": \"#/$defs/story\" }\n    }\n  },\n  \"$defs\": {\n    \"story\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\n        \"id\",\n        \"title\",\n        \"intent\",\n        \"paths\",\n        \"satisfies\",\n        \"implements_contract_decisions\",\n        \"uses_contract_decisions\",\n        \"depends_on\",\n        \"tests\",\n        \"status\"\n      ],\n      \"properties\": {\n        \"id\": {\n          \"type\": \"string\",\n          \"pattern\": \"^S[1-9]\\\\d*$\",\n          \"description\": \"Story ID. Sequential per epic.\"\n        },\n        \"title\": {\n          \"type\": \"string\",\n          \"minLength\": 1\n        },\n        \"intent\": {\n          \"type\": \"string\",\n          \"minLength\": 1,\n          \"description\": \"Prose, 1-2 sentences: what this story produces.\"\n        },\n        \"paths\": {\n          \"type\": \"array\",\n          \"minItems\": 1,\n          \"uniqueItems\": true,\n          \"items\": { \"type\": \"string\", \"minLength\": 1 },\n          \"description\": \"Glob patterns the story is allowed to touch (using git-pathspec syntax). Stage 5 Check 3 fails if the diff includes files outside these globs.\"\n        },\n        \"satisfies\": {\n          \"type\": \"array\",\n          \"minItems\": 1,\n          \"uniqueItems\": true,\n          \"items\": { \"type\": \"string\", \"pattern\": \"^O[1-9]\\\\d*$\" },\n          \"description\": \"Outcome IDs from EPIC.md.observable_outcomes this story realises. Stage 3 prompt rejects zero-outcome stories.\"\n        },\n        \"implements_contract_decisions\": {\n          \"type\": \"array\",\n          \"uniqueItems\": true,\n          \"items\": { \"type\": \"string\", \"pattern\": \"^CD[1-9]\\\\d*$\" },\n          \"description\": \"Contract-decision IDs this story is the surface creator for. Each CD in EPIC.md must appear in exactly one story's implements_contract_decisions across the plan (helper-validated).\"\n        },\n        \"uses_contract_decisions\": {\n          \"type\": \"array\",\n          \"uniqueItems\": true,\n          \"items\": { \"type\": \"string\", \"pattern\": \"^CD[1-9]\\\\d*$\" },\n          \"description\": \"Contract-decision IDs this story consumes (without creating). Multiple stories may use the same CD.\"\n        },\n        \"depends_on\": {\n          \"type\": \"array\",\n          \"uniqueItems\": true,\n          \"items\": { \"type\": \"string\", \"pattern\": \"^S[1-9]\\\\d*$\" },\n          \"description\": \"Story IDs that must reach status=done before this story runs. Subset relationship to stories[].id is helper-checked.\"\n        },\n        \"tests\": {\n          \"type\": \"object\",\n          \"additionalProperties\": false,\n          \"required\": [\"count\", \"types\"],\n          \"properties\": {\n            \"count\": {\n              \"type\": \"integer\",\n              \"minimum\": 0,\n              \"description\": \"Estimated number of new tests. Not enforced at Stage 5.\"\n            },\n            \"types\": {\n              \"type\": \"array\",\n              \"minItems\": 1,\n              \"uniqueItems\": true,\n              \"items\": { \"type\": \"string\", \"minLength\": 1 },\n              \"description\": \"Test families (unit, integration, e2e, regression, ...). Project-defined.\"\n            }\n          }\n        },\n        \"status\": {\n          \"type\": \"string\",\n          \"enum\": [\"pending\", \"in_progress\", \"done\"]\n        },\n        \"empty_diff\": {\n          \"type\": \"boolean\",\n          \"description\": \"True iff this story completed without producing a diff because earlier stories' changes already realised its outcomes. Only meaningful when status=done. Per current operator policy, empty-diff completions during dogfood open a story_gate (triggered_by includes 'empty_diff_review') rather than auto-completing.\"\n        }\n      },\n      \"allOf\": [\n        {\n          \"if\": {\n            \"required\": [\"empty_diff\"],\n            \"properties\": { \"empty_diff\": { \"const\": true } }\n          },\n          \"then\": {\n            \"properties\": { \"status\": { \"const\": \"done\" } },\n            \"required\": [\"status\"]\n          }\n        }\n      ]\n    }\n  }\n}\n","exit_code":0,"status":"completed"}}
