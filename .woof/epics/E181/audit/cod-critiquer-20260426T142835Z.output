{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/usr/bin/zsh -lc \"rg --files | rg 'critique\\\\.schema\\\\.json|plan\\\\.schema\\\\.json|agents\\\\.schema\\\\.json'; echo '---'; sed -n '1,260p' woof/schemas/agents.schema.json\"","aggregated_output":"scripts/schemas/plan.schema.json\nwoof/schemas/critique.schema.json\nwoof/schemas/plan.schema.json\nwoof/schemas/agents.schema.json\n---\n{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"https://woof.dev/schemas/agents.schema.json\",\n  \"title\": \"woof agent role configuration\",\n  \"description\": \"Project-side declaration at .woof/agents.toml. Defines which dispatch wrapper (cld/cod), which model, and which extra flags are used per role. Woof builds the full subprocess invocation dynamically from these entries via 'woof dispatch claude --role X' / 'woof dispatch codex --role X' adapter commands; no hard-coded model IDs or shell aliases anywhere in the tool. If absent, defaults apply (in-session planner, cld -p story-executor with default model, cod critiquer with default model, all with empty MCP set).\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\"roles\"],\n  \"properties\": {\n    \"roles\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"orchestrator\": { \"$ref\": \"#/$defs/in_session_role\" },\n        \"planner\": { \"$ref\": \"#/$defs/dispatchable_role\" },\n        \"story-executor\": { \"$ref\": \"#/$defs/dispatchable_role\" },\n        \"critiquer\": { \"$ref\": \"#/$defs/dispatchable_role\" },\n        \"gate-resolver\": { \"$ref\": \"#/$defs/in_session_role\" }\n      },\n      \"description\": \"Roles invoked by woof. Any subset may be defined; missing roles fall back to defaults. orchestrator and gate-resolver are constrained to in-session execution (they share the user's interactive Claude Code session) and so use the in_session_role schema; the other three use dispatchable_role.\"\n    },\n    \"timeouts\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"default_minutes\": {\n          \"type\": \"integer\",\n          \"minimum\": 1,\n          \"default\": 30,\n          \"description\": \"Per-subprocess timeout. Driver wraps cld/cod invocations with `timeout`. Hitting the timeout writes gate.md with triggered_by=['timeout'].\"\n        }\n      }\n    },\n    \"review_valve\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"description\": \"Periodic review configuration (Stage 5 Check 9). Opens a review_gate every N completed stories AND once before epic close, surfacing accumulated minor critique findings.\",\n      \"properties\": {\n        \"every_n_stories\": {\n          \"type\": \"integer\",\n          \"minimum\": 1,\n          \"default\": 5,\n          \"description\": \"Open a review_gate after every N successful story commits.\"\n        },\n        \"end_of_epic\": {\n          \"type\": \"boolean\",\n          \"default\": true,\n          \"description\": \"Open a review_gate after the last story completes, before epic close. Recommended on.\"\n        }\n      }\n    }\n  },\n  \"$defs\": {\n    \"in_session_role\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"harness\"],\n      \"properties\": {\n        \"harness\": {\n          \"type\": \"string\",\n          \"const\": \"in-session\",\n          \"description\": \"orchestrator and gate-resolver must share the user's interactive Claude Code session; they cannot dispatch to a subprocess.\"\n        },\n        \"notes\": { \"type\": \"string\" }\n      }\n    },\n    \"dispatchable_role\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"harness\"],\n      \"properties\": {\n        \"harness\": {\n          \"type\": \"string\",\n          \"enum\": [\"cld\", \"cod\", \"in-session\"],\n          \"description\": \"Dispatch wrapper. cld for Claude subprocesses, cod for Codex subprocesses, in-session for roles that should share the user's interactive session even though they could be dispatched.\"\n        },\n        \"model\": {\n          \"type\": \"string\",\n          \"minLength\": 1\n        },\n        \"think\": {\n          \"type\": \"boolean\",\n          \"description\": \"cld only. Toggles extended thinking via the wrapper's -t flag. Schema does not enforce the cld-only constraint; runtime ignores think when harness=cod.\"\n        },\n        \"mcp\": {\n          \"type\": \"array\",\n          \"items\": { \"type\": \"string\", \"minLength\": 1 },\n          \"uniqueItems\": true,\n          \"description\": \"MCP server names. Empty array (default) = no MCPs.\"\n        },\n        \"flags\": {\n          \"type\": \"array\",\n          \"items\": { \"type\": \"string\" },\n          \"description\": \"Additional pass-through args appended after the wrapper's '--' separator.\"\n        }\n      },\n      \"allOf\": [\n        {\n          \"if\": {\n            \"properties\": { \"harness\": { \"const\": \"in-session\" } },\n            \"required\": [\"harness\"]\n          },\n          \"then\": {\n            \"not\": {\n              \"anyOf\": [\n                { \"required\": [\"model\"] },\n                { \"required\": [\"think\"] },\n                { \"required\": [\"mcp\"] },\n                { \"required\": [\"flags\"] }\n              ]\n            }\n          }\n        }\n      ]\n    }\n  }\n}\n","exit_code":0,"status":"completed"}}
