{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/usr/bin/zsh -lc \"set -euo pipefail\nEPIC=.woof/epics/E181/EPIC.md\nPLAN=.woof/epics/E181/plan.json\n\necho '== Outcomes in EPIC =='\npython - <<'PY'\nimport yaml, json\nfrom pathlib import Path\ntext=Path('.woof/epics/E181/EPIC.md').read_text()\nfm=text.split('---',2)[1]\ndata=yaml.safe_load(fm)\nprint('epic_id',data['epic_id'])\nprint('outcomes', [o['id'] for o in data.get('observable_outcomes',[])])\nprint('contract_decisions', [c['id'] for c in data.get('contract_decisions',[])])\nPY\n\necho '== Outcomes satisfied by stories =='\njq -r '[.stories[] | .id as \"'$sid | .satisfies[] | {story:$sid, outcome:.}]'\"' \\\"\"'$PLAN\"\n\necho '\"'== Uncovered outcomes =='\npython - <<'PY'\nimport yaml, json\nfrom pathlib import Path\ntext=Path('.woof/epics/E181/EPIC.md').read_text()\nfm=text.split('---',2)[1]\nepic=yaml.safe_load(fm)\nplan=json.loads(Path('.woof/epics/E181/plan.json').read_text())\nout={o['id'] for o in epic.get('observable_outcomes',[])}\ncovered={o for s in plan['stories'] for o in s.get('satisfies',[])}\nprint(sorted(out-covered))\nPY\n\necho '== Contract decision implementation counts =='\npython - <<'PY'\nimport yaml, json\nfrom collections import Counter\nfrom pathlib import Path\ntext=Path('.woof/epics/E181/EPIC.md').read_text()\nfm=text.split('---',2)[1]\nepic=yaml.safe_load(fm)\nplan=json.loads(Path('.woof/epics/E181/plan.json').read_text())\ncds=[c['id'] for c in epic.get('contract_decisions',[])]\ncounter=Counter(cd for s in plan['stories'] for cd in s.get('implements_contract_decisions',[]))\nfor cd in cds:\n    print(cd, counter.get(cd,0))\nprint('extra_impl_ids', sorted(set(counter)-set(cds)))\nPY\n\necho '== Path overlap =='\npython - <<'PY'\nimport json\nfrom pathlib import Path\nfrom collections import defaultdict\nplan=json.loads(Path('.woof/epics/E181/plan.json').read_text())\nowners=defaultdict(list)\nfor s in plan['stories']:\n    for p in s.get('paths',[]):\n        owners[p].append(s['id'])\ndups={p:v for p,v in owners.items() if len(v)>1}\nprint(dups)\nPY\n\necho '== Dependency edges + cycle check =='\npython - <<'PY'\nimport json\nfrom pathlib import Path\nplan=json.loads(Path('.woof/epics/E181/plan.json').read_text())\nstories={s['id']:s for s in plan['stories']}\nedges={sid:set(s['depends_on']) for sid,s in stories.items()}\nprint('edges', {k:sorted(v) for k,v in edges.items()})\n# missing refs\nmissing=[(sid,d) for sid,deps in edges.items() for d in deps if d not in stories]\nprint('missing_dep_refs', missing)\n# cycle detect DFS\nseen,stack=set(),set()\ncycle=[]\ndef dfs(n,path):\n    seen.add(n); stack.add(n)\n    for m in edges[n]:\n        if m not in seen:\n            if dfs(m,path+[m]):\n                return True\n        elif m in stack:\n            cycle.extend(path+[m]);\n            return True\n    stack.remove(n)\n    return False\nfor n in stories:\n    if n not in seen:\n        if dfs(n,[n]):\n            break\nprint('cycle', cycle)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/usr/bin/zsh -lc \"set -euo pipefail\nEPIC=.woof/epics/E181/EPIC.md\nPLAN=.woof/epics/E181/plan.json\n\necho '== Outcomes in EPIC =='\npython - <<'PY'\nimport yaml, json\nfrom pathlib import Path\ntext=Path('.woof/epics/E181/EPIC.md').read_text()\nfm=text.split('---',2)[1]\ndata=yaml.safe_load(fm)\nprint('epic_id',data['epic_id'])\nprint('outcomes', [o['id'] for o in data.get('observable_outcomes',[])])\nprint('contract_decisions', [c['id'] for c in data.get('contract_decisions',[])])\nPY\n\necho '== Outcomes satisfied by stories =='\njq -r '[.stories[] | .id as \"'$sid | .satisfies[] | {story:$sid, outcome:.}]'\"' \\\"\"'$PLAN\"\n\necho '\"'== Uncovered outcomes =='\npython - <<'PY'\nimport yaml, json\nfrom pathlib import Path\ntext=Path('.woof/epics/E181/EPIC.md').read_text()\nfm=text.split('---',2)[1]\nepic=yaml.safe_load(fm)\nplan=json.loads(Path('.woof/epics/E181/plan.json').read_text())\nout={o['id'] for o in epic.get('observable_outcomes',[])}\ncovered={o for s in plan['stories'] for o in s.get('satisfies',[])}\nprint(sorted(out-covered))\nPY\n\necho '== Contract decision implementation counts =='\npython - <<'PY'\nimport yaml, json\nfrom collections import Counter\nfrom pathlib import Path\ntext=Path('.woof/epics/E181/EPIC.md').read_text()\nfm=text.split('---',2)[1]\nepic=yaml.safe_load(fm)\nplan=json.loads(Path('.woof/epics/E181/plan.json').read_text())\ncds=[c['id'] for c in epic.get('contract_decisions',[])]\ncounter=Counter(cd for s in plan['stories'] for cd in s.get('implements_contract_decisions',[]))\nfor cd in cds:\n    print(cd, counter.get(cd,0))\nprint('extra_impl_ids', sorted(set(counter)-set(cds)))\nPY\n\necho '== Path overlap =='\npython - <<'PY'\nimport json\nfrom pathlib import Path\nfrom collections import defaultdict\nplan=json.loads(Path('.woof/epics/E181/plan.json').read_text())\nowners=defaultdict(list)\nfor s in plan['stories']:\n    for p in s.get('paths',[]):\n        owners[p].append(s['id'])\ndups={p:v for p,v in owners.items() if len(v)>1}\nprint(dups)\nPY\n\necho '== Dependency edges + cycle check =='\npython - <<'PY'\nimport json\nfrom pathlib import Path\nplan=json.loads(Path('.woof/epics/E181/plan.json').read_text())\nstories={s['id']:s for s in plan['stories']}\nedges={sid:set(s['depends_on']) for sid,s in stories.items()}\nprint('edges', {k:sorted(v) for k,v in edges.items()})\n# missing refs\nmissing=[(sid,d) for sid,deps in edges.items() for d in deps if d not in stories]\nprint('missing_dep_refs', missing)\n# cycle detect DFS\nseen,stack=set(),set()\ncycle=[]\ndef dfs(n,path):\n    seen.add(n); stack.add(n)\n    for m in edges[n]:\n        if m not in seen:\n            if dfs(m,path+[m]):\n                return True\n        elif m in stack:\n            cycle.extend(path+[m]);\n            return True\n    stack.remove(n)\n    return False\nfor n in stories:\n    if n not in seen:\n        if dfs(n,[n]):\n            break\nprint('cycle', cycle)\nPY\"","aggregated_output":"== Outcomes in EPIC ==\nepic_id 181\noutcomes ['O1', 'O2', 'O3']\ncontract_decisions ['CD1']\n== Outcomes satisfied by stories ==\n[\n  {\n    \"story\": \"S1\",\n    \"outcome\": \"O3\"\n  },\n  {\n    \"story\": \"S2\",\n    \"outcome\": \"O1\"\n  },\n  {\n    \"story\": \"S2\",\n    \"outcome\": \"O2\"\n  },\n  {\n    \"story\": \"S2\",\n    \"outcome\": \"O3\"\n  }\n]\n== Uncovered outcomes ==\n[]\n== Contract decision implementation counts ==\nCD1 1\nextra_impl_ids []\n== Path overlap ==\n{}\n== Dependency edges + cycle check ==\nedges {'S1': [], 'S2': ['S1']}\nmissing_dep_refs []\ncycle []\n","exit_code":0,"status":"completed"}}
