# Copy to env.local.sh and fill in values.
#
# Loaded by:
#   - direnv, via .envrc, into your interactive shell
#   - scripts/dc, before invoking `docker compose`
#
# Gitignored. Human-managed. worktree.py setup will seed it on first run
# (generating DB_PASSWORD and OAUTH_ENCRYPTION_KEY) but will never overwrite
# an existing env.local.sh afterwards.

# Database password (shared between postgres init and DATABASE_URL interpolation)
export DB_PASSWORD=

# OAuth token encryption key (Fernet — MUST be generated, not hand-typed).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Webapp reads it as GTS_ENCRYPTION_KEY (aliased in docker-compose.yml).
export OAUTH_ENCRYPTION_KEY=

# Session signing key.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
export SECRET_KEY=dev_secret_key_change_in_production

# Admin-only endpoints password (workflow viewer, etc).
export GTS_ADMIN_PASSWORD=

# T3K source adapter API key (only needed if running t3k-sync with API-key auth).
export T3K_API_KEY=
