---
/**
 * Report Error Thank You page - Displayed after successfully submitting an error report.
 *
 * Features:
 * - Appreciative messaging thanking the user
 * - Link to the created GitHub issue
 * - Encouragement to participate in the community
 * - Navigation back to the app
 *
 * Part of STORY-014: Error Report Thank You Page.
 */
import Layout from '../../layouts/Layout.astro';

// Parse URL params for GitHub issue context
const issueUrl = Astro.url.searchParams.get('issue_url') || null;
const issueNumber = Astro.url.searchParams.get('issue_number');
const parsedNumber = issueNumber ? parseInt(issueNumber, 10) : null;
---

<Layout title="Thank You - Report Submitted">
  <div class="container mx-auto px-4 py-8">
    <div class="max-w-lg mx-auto space-y-6 text-center">
      <!-- Success Icon -->
      <div class="flex justify-center">
        <div class="flex h-16 w-16 items-center justify-center rounded-full bg-green-500/10">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-8 w-8 text-green-500"
            aria-hidden="true"
          >
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
          </svg>
        </div>
      </div>

      <!-- Thank You Header -->
      <div>
        <h1 class="mb-2 text-2xl font-bold tracking-tight">
          Thank You for Your Report!
        </h1>
        <p class="text-muted-foreground">
          Your report helps us improve Guitar Tone Shootout for everyone.
        </p>
      </div>

      <!-- GitHub Issue Information -->
      {issueUrl && (
        <div class="rounded-lg border border-border bg-bg-surface p-6 space-y-4">
          <div class="flex items-center justify-center gap-2">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-5 w-5 text-muted-foreground"
              aria-hidden="true"
            >
              <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
            </svg>
            <p class="font-medium text-foreground">
              We've created a GitHub issue to track this problem
            </p>
          </div>

          <a
            href={issueUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-[var(--color-accent-primary)] hover:underline font-medium"
          >
            {parsedNumber && !isNaN(parsedNumber) ? (
              <>Issue #{parsedNumber}</>
            ) : (
              <>View Issue</>
            )}
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-4 w-4"
              aria-hidden="true"
            >
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
          </a>

          <div class="border-t border-border pt-4">
            <p class="text-sm text-muted-foreground">
              Follow the issue to see updates, or add more details if you have them.
              Your participation helps us resolve the problem faster!
            </p>
          </div>
        </div>
      )}

      <!-- Navigation Actions -->
      <div class="flex flex-col gap-3 sm:flex-row sm:justify-center">
        <button
          onclick="history.go(-2)"
          class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-10 px-4 py-2 flex-1 sm:flex-none"
        >
          Go Back
        </button>
        <a href="/" class="flex-1 sm:flex-none">
          <button
            class="w-full inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-[var(--color-accent-primary)] text-primary-foreground hover:bg-[var(--color-accent-primary)]/90 h-10 px-4 py-2"
          >
            Return Home
          </button>
        </a>
      </div>
    </div>
  </div>
</Layout>
