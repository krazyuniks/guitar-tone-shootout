---
// Login redirect page - uses client-side JS to preserve ?next= parameter
// Uses relative URL since nginx proxies /api/ to the backend
---
<html>
<head>
  <meta charset="utf-8" />
  <title>Redirecting to login...</title>
</head>
<body>
  <p>Redirecting to login...</p>
  <script>
    // Read ?next= parameter and pass to backend OAuth login
    const params = new URLSearchParams(window.location.search);
    const next = params.get('next');

    let loginUrl = '/api/v1/auth/login';
    if (next && next.startsWith('/')) {
      loginUrl += '?next=' + encodeURIComponent(next);
    }

    window.location.replace(loginUrl);
  </script>
</body>
</html>
