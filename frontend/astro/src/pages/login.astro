---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Sign In">
  <div class="flex min-h-[80vh] items-center justify-center px-4">
    <div class="w-full max-w-md rounded-xl border border-[var(--color-border)] bg-[var(--color-surface-elevated)] p-8 shadow-xl">
      <div class="mb-8 text-center">
        <h1 class="text-2xl font-bold text-[var(--color-text-primary)]">
          Welcome Back
        </h1>
        <p class="mt-2 text-sm text-[var(--color-text-secondary)]">
          Sign in to access your gear library, signal chains, and shootouts
        </p>
      </div>

      <!-- Error message -->
      <div id="login-error" class="mb-6 hidden rounded-lg border border-red-500/30 bg-red-500/10 p-3 text-sm text-red-400" data-testid="login-error">
      </div>

      <div class="space-y-3">
        <!-- T3K (active) -->
        <a
          id="login-t3k-link"
          href="/api/v1/auth/login/t3k"
          data-astro-reload
          data-testid="login-t3k"
          class="flex w-full items-center justify-center gap-3 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] px-4 py-3 text-sm font-medium text-[var(--color-text-primary)] transition-colors hover:bg-[var(--color-surface-hover)] hover:border-[var(--color-accent)]"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 19V6l12-3v13" />
            <circle cx="6" cy="18" r="3" />
            <circle cx="18" cy="15" r="3" />
          </svg>
          Sign in with Tone3000
        </a>

        <!-- Google (disabled) -->
        <button
          disabled
          data-testid="login-google"
          class="flex w-full cursor-not-allowed items-center justify-center gap-3 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] px-4 py-3 text-sm font-medium text-[var(--color-text-muted)] opacity-50"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" />
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" />
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" />
          </svg>
          Sign in with Google
          <span class="ml-auto rounded-full bg-[var(--color-surface-elevated)] px-2 py-0.5 text-xs text-[var(--color-text-muted)]">Coming Soon</span>
        </button>

        <!-- GitHub (disabled) -->
        <button
          disabled
          data-testid="login-github"
          class="flex w-full cursor-not-allowed items-center justify-center gap-3 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] px-4 py-3 text-sm font-medium text-[var(--color-text-muted)] opacity-50"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
          </svg>
          Sign in with GitHub
          <span class="ml-auto rounded-full bg-[var(--color-surface-elevated)] px-2 py-0.5 text-xs text-[var(--color-text-muted)]">Coming Soon</span>
        </button>

        <!-- Facebook (disabled) -->
        <button
          disabled
          data-testid="login-facebook"
          class="flex w-full cursor-not-allowed items-center justify-center gap-3 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] px-4 py-3 text-sm font-medium text-[var(--color-text-muted)] opacity-50"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
          </svg>
          Sign in with Facebook
          <span class="ml-auto rounded-full bg-[var(--color-surface-elevated)] px-2 py-0.5 text-xs text-[var(--color-text-muted)]">Coming Soon</span>
        </button>
      </div>

      <p class="mt-6 text-center text-xs text-[var(--color-text-muted)]">
        By signing in, you agree to our Terms of Service and Privacy Policy.
      </p>
    </div>
  </div>

  <script>
    // Read ?next= param and append to T3K link
    const params = new URLSearchParams(window.location.search);
    const next = params.get('next');
    const link = document.getElementById('login-t3k-link');

    if (next && next.startsWith('/') && link) {
      const url = new URL(link.getAttribute('href')!, window.location.origin);
      url.searchParams.set('next', next);
      link.setAttribute('href', url.pathname + url.search);
    }

    // Show error message if ?error= param present
    const error = params.get('error');
    if (error) {
      const errorDiv = document.getElementById('login-error');
      if (errorDiv) {
        const messages: Record<string, string> = {
          'missing_api_key': 'Authentication failed: no API key received.',
          'token_exchange_failed': 'Authentication failed: could not exchange token.',
          'callback_failed': 'Authentication failed. Please try again.',
          'no_session': 'No saved session found. Please sign in.',
          'invalid_session': 'Saved session is invalid. Please sign in again.',
          'user_not_found': 'User account not found. Please sign in again.',
        };
        errorDiv.textContent = messages[error] || `Authentication error: ${error}`;
        errorDiv.classList.remove('hidden');
      }
    }
  </script>
</Layout>
