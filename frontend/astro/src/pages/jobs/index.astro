---
/**
 * Job progress page - HTMX-powered with auto-polling.
 *
 * This single file handles all /jobs/{id} URLs:
 * - nginx serves this page for any /jobs/* request
 * - Client-side script extracts ID from URL and triggers HTMX load
 * - HTMX polls server every 2s while job is running (data-polling="true")
 */

import Layout from '../../layouts/Layout.astro';
---

<Layout title="Job Progress" description="View job processing status and progress.">
  <div
    id="job-container"
    hx-get=""
    hx-trigger="load, every 2s [data-polling='true']"
    hx-swap="innerHTML"
    hx-indicator="#loading"
  >
    <!-- Loading state -->
    <div id="loading" class="container mx-auto px-4 py-8 max-w-2xl animate-pulse">
      <div class="h-6 bg-[var(--color-bg-elevated)] rounded w-24 mb-6"></div>
      <div class="bg-[var(--color-bg-surface)] rounded-lg border border-[var(--border)] p-6">
        <div class="h-8 bg-[var(--color-bg-elevated)] rounded w-1/3 mb-4"></div>
        <div class="h-4 bg-[var(--color-bg-elevated)] rounded w-full mb-4"></div>
        <div class="h-4 bg-[var(--color-bg-elevated)] rounded w-2/3"></div>
      </div>
    </div>
  </div>

  <script>
    // Extract job ID from URL path and set hx-get attribute
    // URL format: /jobs/{uuid}
    const pathParts = window.location.pathname.split('/');
    const jobId = pathParts[pathParts.length - 1];

    // UUID validation regex
    const uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

    const container = document.getElementById('job-container');

    if (!container) {
      console.error('Job container not found');
    } else if (jobId && uuidRegex.test(jobId)) {
      // Valid UUID - set HTMX get URL
      container.setAttribute('hx-get', `/api/v1/html/jobs/${jobId}`);
    } else {
      // Invalid job ID - show error
      container.innerHTML = `
        <div class="container mx-auto px-4 py-16 max-w-2xl text-center">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            class="w-16 h-16 mx-auto mb-4 text-red-500"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"
            />
          </svg>
          <h2 class="text-xl font-semibold text-[var(--color-text-primary)] mb-2">
            Invalid Job ID
          </h2>
          <p class="text-[var(--color-text-secondary)] mb-6">
            The job ID in the URL is not valid.
          </p>
          <a
            href="/"
            class="inline-flex items-center gap-2 text-amber-500 hover:text-amber-400 transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 20 20"
              fill="currentColor"
              class="w-5 h-5"
            >
              <path
                fill-rule="evenodd"
                d="M17 10a.75.75 0 01-.75.75H5.612l4.158 3.96a.75.75 0 11-1.04 1.08l-5.5-5.25a.75.75 0 010-1.08l5.5-5.25a.75.75 0 111.04 1.08L5.612 9.25H16.25A.75.75 0 0117 10z"
                clip-rule="evenodd"
              />
            </svg>
            Go Home
          </a>
        </div>
      `;
    }
  </script>
</Layout>
