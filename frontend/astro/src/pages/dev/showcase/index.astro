---
import Layout from "../../../layouts/Layout.astro";
import Container from "../../../components/ui/Container.astro";
import Button from "../../../components/ui/Button.astro";
import Card from "../../../components/ui/Card.astro";
import Badge from "../../../components/ui/Badge.astro";
---

<Layout title="Design Showcase">
  <!-- Hero Section -->
  <div class="relative overflow-hidden bg-[#0a0a0a] py-24 sm:py-32">
    <!-- Background Effects -->
    <div class="absolute inset-0 z-0">
      <div class="absolute -top-[20%] -left-[10%] h-[500px] w-[500px] rounded-full bg-blue-600/10 blur-[100px]"></div>
      <div class="absolute top-[20%] -right-[10%] h-[600px] w-[600px] rounded-full bg-purple-600/10 blur-[120px]"></div>
      <div class="absolute -bottom-[20%] left-[20%] h-[400px] w-[400px] rounded-full bg-amber-600/5 blur-[80px]"></div>

      <!-- Grid Pattern -->
      <div class="absolute inset-0 bg-[url('/grid.svg')] bg-center [mask-image:linear-gradient(180deg,white,rgba(255,255,255,0))] opacity-20"></div>
    </div>

    <Container class="relative z-10">
      <div class="mx-auto max-w-2xl text-center">
        <Badge variant="blue" class="mb-6">v0.1.0 Design System</Badge>
        <h1 class="text-4xl font-bold tracking-tight text-white sm:text-6xl mb-6">
          Guitar Tone <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-purple-400">Shootout</span>
        </h1>
        <p class="text-lg leading-8 text-gray-400 mb-10">
          The ultimate platform for comparing guitar gear. Listen to real DI tracks re-amped through legendary amplifiers, cabinets, and pedals.
        </p>
        <div class="flex items-center justify-center gap-x-6">
          <Button href="/dev/showcase/components" size="lg">View Components</Button>
          <Button href="/dev/showcase/styleguide" variant="ghost" size="lg">Style Guide <span aria-hidden="true">→</span></Button>
        </div>
      </div>

      <!-- Gear Preview (Artistic Representation) -->
      <div class="mt-16 flow-root sm:mt-24">
        <div class="-m-2 rounded-xl bg-white/5 p-2 ring-1 ring-inset ring-white/10 lg:-m-4 lg:rounded-2xl lg:p-4">
          <div class="rounded-md bg-[#141414] shadow-2xl ring-1 ring-white/10 overflow-hidden">
             <!-- Placeholder for Gear UI Screenshot -->
             <div class="aspect-[16/9] w-full bg-gradient-to-br from-[#1f1f1f] to-[#0a0a0a] flex items-center justify-center relative">
                <div class="absolute inset-0 flex items-center justify-center opacity-30">
                  <span class="text-9xl font-bold text-white/5 select-none">GEAR</span>
                </div>
                <div class="grid grid-cols-3 gap-8 p-12 w-full max-w-4xl">
                   <!-- Abstract Gear Blocks -->
                   <div class="h-32 rounded-lg bg-blue-500/10 border border-blue-500/20 animate-pulse"></div>
                   <div class="h-32 rounded-lg bg-amber-500/10 border border-amber-500/20 animate-pulse delay-100"></div>
                   <div class="h-32 rounded-lg bg-green-500/10 border border-green-500/20 animate-pulse delay-200"></div>
                </div>
             </div>
          </div>
        </div>
      </div>
    </Container>
  </div>

  <!-- Features Grid -->
  <div class="py-24 bg-[#0a0a0a]">
    <Container>
      <div class="mx-auto max-w-2xl lg:text-center">
        <h2 class="text-base font-semibold leading-7 text-blue-400">Deploy Faster</h2>
        <p class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">Everything you need to compare tones</p>
      </div>
      <div class="mx-auto mt-16 max-w-2xl sm:mt-20 lg:mt-24 lg:max-w-none">
        <div class="grid max-w-xl grid-cols-1 gap-x-8 gap-y-16 lg:max-w-none lg:grid-cols-3">
            <Card>
                <h3 class="text-lg font-semibold text-white mb-2">High Fidelity Audio</h3>
                <p class="text-gray-400">Lossless audio processing ensures you hear every nuance of the gear.</p>
            </Card>
            <Card>
                <h3 class="text-lg font-semibold text-white mb-2">Real Gear, No Emulation</h3>
                <p class="text-gray-400">All clips are re-amped through actual hardware, not digital plugins.</p>
            </Card>
             <Card>
                <h3 class="text-lg font-semibold text-white mb-2">Blind Testing</h3>
                <p class="text-gray-400">Remove bias with our automated A/B blind testing tools.</p>
            </Card>
        </div>
      </div>
    </Container>
  </div>
</Layout>
