---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About" description="Learn about Guitar Tone Shootout - a platform for comparing guitar amp tones using NAM models, IRs, and AIDA-X profiles.">
  <div class="container mx-auto px-4 py-16">
    <!-- Hero Section -->
    <section class="mb-16 text-center">
      <h1 class="mb-6 text-4xl font-bold text-white md:text-5xl">
        About Guitar Tone Shootout
      </h1>
      <p class="mx-auto max-w-2xl text-lg text-zinc-400">
        The platform for comparing guitar amp tones with precision and clarity.
      </p>
    </section>

    <!-- What We Do Section -->
    <section class="mb-16">
      <div class="mx-auto max-w-3xl">
        <h2 class="mb-6 text-2xl font-semibold text-white">What We Do</h2>
        <div class="space-y-4 text-zinc-300">
          <p>
            Guitar Tone Shootout helps guitarists compare amp tones side-by-side
            using neural amp modeling technology. Whether you're exploring NAM models,
            impulse responses, or AIDA-X profiles, our platform makes it easy to
            hear the differences.
          </p>
          <p>
            Upload your DI track, build signal chains with your favorite gear models,
            and create video comparisons that showcase the sonic differences between
            different amp setups.
          </p>
        </div>
      </div>
    </section>

    <!-- Features Section -->
    <section class="mb-16">
      <div class="mx-auto max-w-3xl">
        <h2 class="mb-6 text-2xl font-semibold text-white">Key Features</h2>
        <ul class="space-y-4 text-zinc-300">
          <li class="flex items-start gap-3">
            <span class="mt-1 text-amber-500">●</span>
            <span><strong class="text-white">Signal Chain Builder</strong> - Create complex signal chains with drag-and-drop simplicity</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-1 text-amber-500">●</span>
            <span><strong class="text-white">Video Comparisons</strong> - Generate side-by-side video shootouts of your tones</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-1 text-amber-500">●</span>
            <span><strong class="text-white">Tone3000 Integration</strong> - Access thousands of NAM models and profiles</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-1 text-amber-500">●</span>
            <span><strong class="text-white">Share & Discover</strong> - Browse public shootouts and share your own</span>
          </li>
        </ul>
      </div>
    </section>

    <!-- Technology Section -->
    <section class="mb-16">
      <div class="mx-auto max-w-3xl">
        <h2 class="mb-6 text-2xl font-semibold text-white">Technology</h2>
        <div class="space-y-4 text-zinc-300">
          <p>
            Guitar Tone Shootout leverages cutting-edge neural amp modeling technology:
          </p>
          <ul class="ml-6 list-disc space-y-2">
            <li><strong class="text-white">NAM (Neural Amp Modeler)</strong> - Open-source neural network amp captures</li>
            <li><strong class="text-white">AIDA-X</strong> - AI-powered amp and effect modeling</li>
            <li><strong class="text-white">IRs (Impulse Responses)</strong> - Cabinet and microphone captures</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="text-center">
      <div class="mx-auto max-w-2xl rounded-lg border border-zinc-800 bg-zinc-900 p-8">
        <h2 class="mb-4 text-2xl font-semibold text-white">Ready to Compare Tones?</h2>
        <p class="mb-6 text-zinc-400">
          Start building your signal chains and create your first shootout.
        </p>
        <a
          href="/shootouts"
          data-astro-reload
          class="inline-block rounded-lg bg-amber-600 px-6 py-3 font-medium text-white transition-colors hover:bg-amber-500"
        >
          Browse Shootouts
        </a>
      </div>
    </section>
  </div>
</Layout>
