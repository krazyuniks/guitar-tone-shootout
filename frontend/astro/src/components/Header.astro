---
// STORY-006: Redesigned navigation - no dropdowns, centered nav, increased height
// This Astro header matches the Jinja2 header structure exactly
// Auth state is fetched via API since Astro pages are statically generated
// Design reference: JHS Pedals style - clean, prominent navigation
---

<header
  class="sticky top-0 z-50 w-full border-b border-border bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60"
  x-data="authNav()"
  x-init="init()"
>
  <nav class="container mx-auto flex h-20 items-center px-4" hx-boost="true">
    <!-- Logo - Left aligned -->
    <a href="/" class="flex items-center gap-2 text-xl font-bold shrink-0">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="h-7 w-7 text-amber-500"
        aria-hidden="true"
      >
        <path d="m11.9 12.1 4.514-4.514" />
        <path d="M20.1 2.3a1 1 0 0 0-1.4 0l-1.114 1.114A2 2 0 0 0 17 4.828v1.344a2 2 0 0 1-.586 1.414A2 2 0 0 1 17.828 7h1.344a2 2 0 0 0 1.414-.586L21.7 5.3a1 1 0 0 0 0-1.4z" />
        <path d="m6 16 2 2" />
        <path d="M8.2 9.9C8.7 8.8 9.8 8 11 8c2.8 0 5 2.2 5 5 0 1.2-.8 2.3-1.9 2.8l-.9.4A2 2 0 0 0 12 18a4 4 0 0 1-4 4c-3.3 0-6-2.7-6-6a4 4 0 0 1 4-4 2 2 0 0 0 1.8-1.2z" />
        <path d="m6 12 2-2" />
      </svg>
      <span class="text-amber-500">Tone Shootout</span>
    </a>

    <!-- Central Navigation - Desktop -->
    <div class="hidden md:flex flex-1 justify-center" data-testid="nav-main-links">
      <!-- Loading state -->
      <span x-show="loading" class="text-gray-400">...</span>

      <!-- Browse Links (visible to all, shown after loading) -->
      <template x-if="!loading">
        <div class="flex items-center gap-1">
          <!-- Browse: Shootouts (SSR page - force full reload) -->
          <a
            href="/shootouts"
            data-astro-reload
            class="px-4 py-2 text-sm font-medium rounded-lg transition-colors text-[var(--color-text-secondary)] hover:text-amber-400 hover:bg-amber-400/10"
            data-testid="nav-shootouts"
          >
            Shootouts
          </a>

          <!-- Browse: Gear (SSR page - force full reload) -->
          <a
            href="/gear"
            data-astro-reload
            class="px-4 py-2 text-sm font-medium rounded-lg transition-colors text-[var(--color-text-secondary)] hover:text-amber-400 hover:bg-amber-400/10"
            data-testid="nav-gear"
          >
            Gear
          </a>

          <!-- Browse: DI Tracks (SSR page - force full reload) -->
          <a
            href="/di-tracks"
            data-astro-reload
            class="px-4 py-2 text-sm font-medium rounded-lg transition-colors text-[var(--color-text-secondary)] hover:text-amber-400 hover:bg-amber-400/10"
            data-testid="nav-di-tracks"
          >
            DI Tracks
          </a>

          <!-- Divider (authenticated only) -->
          <template x-if="authenticated">
            <span class="mx-2 h-6 w-px bg-border"></span>
          </template>

          <!-- Library Links (authenticated only, SSR pages - force full reload) -->
          <template x-if="authenticated">
            <div class="flex items-center gap-1">
              <a
                href="/library/my-gear"
                data-astro-reload
                class="px-4 py-2 text-sm font-medium rounded-lg transition-colors text-[var(--color-text-secondary)] hover:text-amber-400 hover:bg-amber-400/10"
                data-testid="nav-my-gear"
              >
                My Gear
              </a>
              <a
                href="/library/di-tracks"
                data-astro-reload
                class="px-4 py-2 text-sm font-medium rounded-lg transition-colors text-[var(--color-text-secondary)] hover:text-amber-400 hover:bg-amber-400/10"
                data-testid="nav-my-di-tracks"
              >
                My DI Tracks
              </a>
              <a
                href="/library/chains"
                data-astro-reload
                class="px-4 py-2 text-sm font-medium rounded-lg transition-colors text-[var(--color-text-secondary)] hover:text-amber-400 hover:bg-amber-400/10"
                data-testid="nav-my-chains"
              >
                Chains
              </a>
              <a
                href="/library/shootouts"
                data-astro-reload
                class="px-4 py-2 text-sm font-medium rounded-lg transition-colors text-[var(--color-text-secondary)] hover:text-amber-400 hover:bg-amber-400/10"
                data-testid="nav-my-shootouts"
              >
                My Shootouts
              </a>

              <!-- Divider -->
              <span class="mx-2 h-6 w-px bg-border"></span>

              <!-- Create Shootout (SSR page - force full reload) -->
              <a
                href="/shootout/create"
                data-astro-reload
                class="px-4 py-2 text-sm font-medium rounded-lg transition-colors bg-amber-500/10 text-amber-400 hover:bg-amber-500/20"
                data-testid="nav-create-shootout"
              >
                Create
              </a>
            </div>
          </template>
        </div>
      </template>
    </div>

    <!-- Right side - Auth -->
    <div class="hidden md:flex items-center gap-4 shrink-0">
      <!-- Loading state -->
      <span x-show="loading" class="text-gray-400">...</span>

      <!-- User Menu (authenticated) -->
      <div x-show="!loading && authenticated" x-cloak class="flex items-center gap-3">
        <span class="text-sm text-[var(--color-text-muted)]" x-text="username"></span>
        <button
          type="button"
          @click.prevent.stop="logout()"
          class="text-sm text-[var(--color-text-muted)] hover:text-amber-400 transition-colors"
          data-testid="nav-logout"
        >
          Logout
        </button>
      </div>

      <!-- Login Link (unauthenticated) - hx-boost=false to prevent AJAX on OAuth redirect -->
      <a
        href="/login"
        hx-boost="false"
        x-show="!loading && !authenticated"
        x-cloak
        class="px-4 py-2 text-sm font-medium rounded-lg text-[var(--color-text-secondary)] hover:text-amber-400 hover:bg-amber-400/10 transition-colors"
        data-testid="nav-login"
      >
        Login
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button
      type="button"
      class="inline-flex items-center justify-center rounded-md p-2 text-muted-foreground hover:bg-accent hover:text-accent-foreground md:hidden ml-auto"
      aria-label="Toggle menu"
      @click="mobileMenuOpen = !mobileMenuOpen"
      data-testid="nav-mobile-toggle"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-6 w-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>

  <!-- Mobile Navigation -->
  <div
    class="border-t border-border md:hidden bg-background"
    x-show="mobileMenuOpen"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 -translate-y-1"
    x-transition:enter-end="opacity-100 translate-y-0"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100 translate-y-0"
    x-transition:leave-end="opacity-0 -translate-y-1"
    x-cloak
    hx-boost="true"
  >
    <div class="px-4 py-4 space-y-1">
      <!-- Loading state -->
      <span x-show="loading" class="text-gray-400">...</span>

      <!-- Browse Links (visible to all, SSR pages - force full reload) -->
      <template x-if="!loading">
        <div class="space-y-1">
          <a
            href="/shootouts"
            data-astro-reload
            class="block rounded-lg px-4 py-3 text-base font-medium text-[var(--color-text-secondary)] hover:bg-amber-400/10 hover:text-amber-400"
            data-testid="nav-mobile-shootouts"
          >
            Shootouts
          </a>
          <a
            href="/gear"
            data-astro-reload
            class="block rounded-lg px-4 py-3 text-base font-medium text-[var(--color-text-secondary)] hover:bg-amber-400/10 hover:text-amber-400"
            data-testid="nav-mobile-gear"
          >
            Gear
          </a>
          <a
            href="/di-tracks"
            data-astro-reload
            class="block rounded-lg px-4 py-3 text-base font-medium text-[var(--color-text-secondary)] hover:bg-amber-400/10 hover:text-amber-400"
            data-testid="nav-mobile-di-tracks"
          >
            DI Tracks
          </a>
        </div>
      </template>

      <!-- Library Links (authenticated only, SSR pages - force full reload) -->
      <template x-if="!loading && authenticated">
        <div class="border-t border-border pt-4 mt-4 space-y-1">
          <a
            href="/library/my-gear"
            data-astro-reload
            class="block rounded-lg px-4 py-3 text-base font-medium text-[var(--color-text-secondary)] hover:bg-amber-400/10 hover:text-amber-400"
            data-testid="nav-mobile-my-gear"
          >
            My Gear
          </a>
          <a
            href="/library/di-tracks"
            data-astro-reload
            class="block rounded-lg px-4 py-3 text-base font-medium text-[var(--color-text-secondary)] hover:bg-amber-400/10 hover:text-amber-400"
            data-testid="nav-mobile-my-di-tracks"
          >
            My DI Tracks
          </a>
          <a
            href="/library/chains"
            data-astro-reload
            class="block rounded-lg px-4 py-3 text-base font-medium text-[var(--color-text-secondary)] hover:bg-amber-400/10 hover:text-amber-400"
            data-testid="nav-mobile-my-chains"
          >
            Chains
          </a>
          <a
            href="/library/shootouts"
            data-astro-reload
            class="block rounded-lg px-4 py-3 text-base font-medium text-[var(--color-text-secondary)] hover:bg-amber-400/10 hover:text-amber-400"
            data-testid="nav-mobile-my-shootouts"
          >
            My Shootouts
          </a>

          <!-- Create Shootout (SSR page - force full reload) -->
          <a
            href="/shootout/create"
            data-astro-reload
            class="block rounded-lg px-4 py-3 text-base font-medium bg-amber-500/10 text-amber-400 hover:bg-amber-500/20"
            data-testid="nav-mobile-create-shootout"
          >
            Create Shootout
          </a>
        </div>
      </template>

      <!-- User Section (authenticated) -->
      <template x-if="!loading && authenticated">
        <div class="border-t border-border pt-4 mt-4 px-4">
          <span class="block py-2 text-sm text-[var(--color-text-muted)]" x-text="username"></span>
          <button
            type="button"
            @click.prevent.stop="logout()"
            class="block w-full text-left py-2 text-base font-medium text-[var(--color-text-muted)] hover:text-amber-400"
            data-testid="nav-mobile-logout"
          >
            Logout
          </button>
        </div>
      </template>

      <!-- Login (unauthenticated) - hx-boost=false to prevent AJAX on OAuth redirect -->
      <div x-show="!loading && !authenticated" x-cloak class="border-t border-border pt-4 mt-4">
        <a
          href="/login"
          hx-boost="false"
          class="block rounded-lg px-4 py-3 text-base font-medium text-[var(--color-text-secondary)] hover:bg-amber-400/10 hover:text-amber-400"
          data-testid="nav-mobile-login"
        >
          Login
        </a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  // Register authNav component before Alpine starts
  // This event fires from Layout.astro right before Alpine.start()
  document.addEventListener('alpine:init', function() {
    window.Alpine.data('authNav', function() {
      return {
        loading: true,
        authenticated: false,
        username: '',
        mobileMenuOpen: false,

        init: async function() {
          try {
            var res = await fetch('/api/v1/auth/me', {
              credentials: 'include',
            });
            var data = await res.json();
            this.authenticated = data.authenticated;
            this.username = data.user?.username || '';
          } catch {
            this.authenticated = false;
            this.username = '';
          } finally {
            this.loading = false;
          }
        },

        logout: async function() {
          await fetch('/api/v1/auth/logout', {
            method: 'POST',
            credentials: 'include',
          });
          this.authenticated = false;
          this.username = '';
          // Redirect to login with prompt=login to try forcing T3K re-authentication
          window.location.href = '/api/v1/auth/login?prompt=login';
        },
      };
    });
  });
</script>

<style>
  [x-cloak] {
    display: none !important;
  }
</style>
