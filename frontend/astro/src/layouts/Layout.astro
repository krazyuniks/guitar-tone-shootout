---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// HTMX and Alpine.js are loaded as client-side scripts
// These provide progressive enhancement for HTMX-driven interactions and Alpine state

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Compare guitar amp tones with NAM models, IRs, and AIDA-X profiles. Create side-by-side video comparisons.',
} = Astro.props;

const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : Astro.url;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="color-scheme" content="dark" />

    <!-- Fonts: Inter (UI) and JetBrains Mono (code) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph -->
    <meta property="og:title" content={`${title} | Guitar Tone Shootout`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Guitar Tone Shootout`} />
    <meta name="twitter:description" content={description} />

    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Guitar Tone Shootout</title>

    <!-- Astro ClientRouter: SPA-like navigation with smooth transitions -->
    <ClientRouter />

    <!-- HTMX: Progressive enhancement for server-driven interactions -->
    <script>
      import htmx from 'htmx.org';
      // Make htmx globally available for debugging and external access
      (window as unknown as { htmx: typeof htmx }).htmx = htmx;

      // Reinitialize HTMX after View Transitions swap content
      document.addEventListener('astro:after-swap', () => {
        htmx.process(document.body);
      });
    </script>

    <!-- Alpine.js: Lightweight reactivity for UI state -->
    <script>
      import Alpine from 'alpinejs';
      // Make Alpine globally available
      (window as unknown as { Alpine: typeof Alpine }).Alpine = Alpine;
      // Dispatch alpine:init event so components can register before start
      document.dispatchEvent(new CustomEvent('alpine:init'));
      // Start Alpine.js
      Alpine.start();

      // Reinitialize Alpine after View Transitions swap content
      document.addEventListener('astro:after-swap', () => {
        Alpine.initTree(document.body);
      });
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
