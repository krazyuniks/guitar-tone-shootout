# pnpm configuration
# Allow build scripts for packages that need native compilation

# Required for Vite/Astro to work with esbuild
# Required for image processing with sharp
# Required for MSW test mocking
onlyBuiltDependencies[]=esbuild
onlyBuiltDependencies[]=sharp
onlyBuiltDependencies[]=msw
onlyBuiltDependencies[]=@mswjs/interceptors
