{
  "name": "@gts/astro-frontend",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/inject-css-hash.js",
    "build:islands": "vite build --config vite.config.island.ts",
