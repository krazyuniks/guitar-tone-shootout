{
  "name": "@gts/app",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "gen:api": "openapi-typescript http://webapp:8000/openapi.json -o src/api/schema.d.ts",
    "check:api": "openapi-typescript http://webapp:8000/openapi.json -o /tmp/gts-app-schema.d.ts && cmp -s /tmp/gts-app-schema.d.ts src/api/schema.d.ts || (echo 'frontend/app/src/api/schema.d.ts is stale; run just gen-app-api' >&2 && exit 1)",
    "preview": "vite preview",
    "test:unit": "node --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-router": "^1.0.0",
    "openapi-fetch": "^0.15.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.1.0",
    "openapi-typescript": "^7.10.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.3",
    "vite": "^7.3.0"
  }
}
